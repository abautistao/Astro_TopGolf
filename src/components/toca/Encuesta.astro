---
interface Props {
    url: string;
    padding_top: string;
    padding_bottom: string;
    background: string;
}

const { url, padding_top, padding_bottom, background } = Astro.props;

const paddingTop = padding_top ?? '45px';
const paddingBottom = padding_bottom ?? '45px';
const bg = background ?? '#ebe8e1';
---
<div style="position: relative; height:80dvh; overflow:auto;"> 
  <iframe 
    src={url}
    frameborder="0" style="position: absolute; left:0; top:0; width:100%; height:100%; border:0;">
  </iframe>
</div>

<style define:vars={{ paddingTop, paddingBottom, bg }}>
    #bokun_widget {
        background-color: var(--bg);
        padding-top: var(--paddingTop);
        padding-bottom: var(--paddingBottom);
    }

    @media (max-width: 480px) {
        #bokun_widget {
            padding-top: 80px;
        }
    }
</style>