---
// src/components/toca/Component_5.astro
import { getStrapiUrl, stringifyRichText, getLocalizedUrl } from '../../lib/strapi.js';
import { Image } from "astro:assets";

interface CardData {
    id: number;
    badge: string;
    image_1: any;
    image_2: any;
    title_1: string;
    title_2: string;
    title: any;
    subtitle: any;
    subtitle_2: string
    description: string
    description_2: string
    linkUrl: string;
}

interface Props {
    titulo_seccion?: string;
    tarjetas: CardData[];
}

const {
    titulo_seccion = "Titulo Sección",
    tarjetas = []
} = Astro.props;


const defaultEvents = [
    { id: 101, titulo: "Titulo Ejemplo 1", descripcion: "Descripción Ejemplo 1", imagen: null, link: "#" },
    { id: 102, titulo: "Titulo Ejemplo 2", descripcion: "Descripción Ejemplo 2", imagen: null, link: "#" },
    { id: 103, titulo: "Titulo Ejemplo 3", descripcion: "Descripción Ejemplo 3", imagen: null, link: "#" },
    { id: 104, titulo: "Titulo Ejemplo 4", descripcion: "Descripción Ejemplo 4", imagen: null, link: "#" },
    { id: 105, titulo: "Titulo Ejemplo 5", descripcion: "Descripción Ejemplo 5 (Extra)", imagen: null, link: "#" }
];

const dataToRender = tarjetas.length > 0 ? tarjetas : defaultEvents;
---

<section class="trigger-anim-events bg-[var(--surface-brand-primary)] py-4 px-4 md:px-12 w-full relative">

    <div class="font-(family-name:--font-titling-gothic-fb-extended-bold) anim-element relative flex justify-end items-center  max-w-[1600px] mx-auto">

        <h2 class="font-(family-name:--font-titling-gothic-fb-extended-bold) hidden md:block text-lg md:text-xl font-bold uppercase tracking-wide text-[var(--accent-feedback-strong)]
            absolute left-1/2 -translate-x-1/2 text-center w-full pointer-events-none">
            {titulo_seccion}
        </h2>

        <div class="flex gap-4 mb-1 z-10 relative">
            <button id="prevBtn" class="text-[var(--brand-interactive-base)] hover:opacity-75 transition-colors focus:outline-none p-1 cursor-pointer">
                <i class="fa-solid fa-caret-left text-4xl leading-none"></i>
            </button>

            <button id="nextBtn" class="text-[var(--brand-interactive-base)] hover:opacity-75 transition-colors focus:outline-none p-1 cursor-pointer">
                <i class="fa-solid fa-caret-right text-4xl leading-none"></i>
            </button>
        </div>
    </div>

    <div
            id="sliderContainer" 
            class="anim-element flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 max-w-400 mx-auto scrollbar-hide pt-6"
            style="--anim-delay: 0.2s;"
        >
            {
                Array.isArray(tarjetas) && tarjetas.map((item) => {
                    const imgSrc = getStrapiUrl(item.image_1) || item.image_1;
                    const img2Src = getStrapiUrl(item.image_2) || item.image_2;
                    const isLink = item.linkUrl && item.linkUrl !== "#";
                    const Tag = isLink ? "a" : "div";

                    return (
                        <div class="basis-1/3 min-w-full md:min-w-[calc(33%-12px)] h-full snap-start">
                            <div class="snap-center flex flex-col h-full group w-full">

                            <Tag
                                href={isLink ? item.linkUrl : undefined}
                                class={`transition-all duration-300 group-hover:-translate-y-3 ${isLink ? "cursor-pointer" : ""}`}
                            >
                                <!-- IMAGEN CON OVERLAY CYAN -->
                                <div class="mb-4">
                                    <div class="flex flex-col min-h-64.25 p-4 justify-between relative overflow-hidden border-[6px] border-(--brand-interactive-base)">
                                        <div class="flex gap-4 flex-wrap mb-4 mr-auto relative">
                                            <div class="font-(family-name:--font-sharp-sans-medium) bg-(--surface-brand-secondary) min-h-[35px] text-[1.125rem] py-[.25rem] px-[.5rem] decoration-none text-(--accent-feedback-strong)">{item.badge}</div>
                                        </div>

                                        <div class="grid grid-rows-auto grid-cols-[1fr_auto_1fr] self-stretch items-end gap-2 font-(family-name:--font-titling-gothic-fb-extended-bold)">
                                            <div class="flex flex-col gap-2">
                                                {imgSrc && (
                                                    <Image
                                                        src={imgSrc}
                                                        alt={item.title_1}
                                                        width={800}
                                                        height={480}
                                                        class="w-full h-full"
                                                    />
                                                )}
                                                <span class="text-(--accent-feedback-strong) text-center">{item.title_1}</span>
                                            </div>

                                            <span class="text-[.5rem] text-(--accent-feedback-strong)">VS</span>

                                            <div class="flex flex-col gap-2">
                                                {img2Src && (
                                                    <Image
                                                        src={img2Src}
                                                        alt={item.title_2}
                                                        width={800}
                                                        height={480}
                                                        class="w-full h-full"
                                                    />
                                                )}
                                                <span class="text-(--accent-feedback-strong) text-center">{item.title_2}</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- TÍTULO -->
                                <h3 class="text-left font-(family-name:--font-titling-gothic-fb-extended-bold) font-bold text-[.875rem] lg:text-base text-(--brand-interactive-base) uppercase tracking-wide">
                                    {item.title}
                                </h3>
                                <h4 class="text-left font-(family-name:--font-sharp-sans-medium) text-base text-(--accent-feedback-strong)  tracking-wide">
                                    {item.subtitle}
                                </h4>
                                <h4 class="text-left font-(family-name:--font-sharp-sans-medium) text-base text-(--accent-feedback-strong)  tracking-wide">
                                    {item.subtitle_2}
                                </h4>
                                <p class="text-left ont-(family-name:--font-sharp-sans-medium) text-base text-(--surface-brand-secondary)  tracking-wide">
                                    {item.description}
                                </p>
                                <p class="text-left font-(family-name:--font-sharp-sans-medium) italic text-base text-(--surface-brand-secondary)  tracking-wide">
                                    {item.description_2}
                                </p>

                            </Tag>
                            </div>
                        </div>
                    );
                })
            }
        </div>

</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        initSlider();
        initObserver();
    });

    function initSlider() {
        const container = document.getElementById('sliderContainer');
        const prevBtn = document.getElementById('prevBtn');
        const nextBtn = document.getElementById('nextBtn');

        if (container && prevBtn && nextBtn) {
            nextBtn.addEventListener('click', () => {
                const scrollAmount = container.clientWidth;
                container.scrollBy({ left: scrollAmount, behavior: 'smooth' });
            });

            prevBtn.addEventListener('click', () => {
                const scrollAmount = container.clientWidth;
                container.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
            });
        }
    }

    function initObserver() {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.2
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-events');
        targets.forEach(target => observer.observe(target));
    }
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar { display: none; }
    .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .anim-element {
        opacity: 0;
    }

    :global(.trigger-anim-events.is-visible) .anim-element {
        animation: fadeInUp 0.8s ease-out forwards;
        animation-delay: var(--anim-delay, 0s);
    }
</style>