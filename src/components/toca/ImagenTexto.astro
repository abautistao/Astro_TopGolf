---
import { resolverTag } from "../../utils/html-tag";
import FotoInclinada from "./cards/FotoInclinada.astro";

interface Props {
    etiqueta?: string;
    titulo?: string;
    tituloHtmlTag?: string | null;
    subtitulo?: string;
    subtituloHtmlTag?: string | null;
    descripcion?: string;
    lista?: { id?: number; texto?: string }[];
    texto_boton?: string;
    url_boton?: string;
    imagen?: any;
    texto_foto?: string;
    imagen_posicion?: string | null;
    badge_pre?: string;
    badge_valor?: string;
    badge_post?: string;
    color_fondo_override?: string | null;
}

const {
    etiqueta = "",
    titulo = "",
    tituloHtmlTag = null,
    subtitulo = "",
    subtituloHtmlTag = null,
    descripcion = "",
    lista = [],
    texto_boton = "",
    url_boton = "",
    imagen = null,
    texto_foto = "",
    imagen_posicion = null,
    badge_pre = "",
    badge_valor = "",
    badge_post = "",
    color_fondo_override = null
} = Astro.props;

const TituloTag = resolverTag(tituloHtmlTag, "h2");
const SubtituloTag = resolverTag(subtituloHtmlTag, "p");
const imagenIzquierda = imagen_posicion === "izquierda";
// Cada salto de linea doble del campo de texto es un parrafo.
const parrafos = (descripcion ?? "")
    .split(/\n{2,}/)
    .map((p) => p.trim())
    .filter(Boolean);
const hayBadge = Boolean(badge_pre || badge_valor || badge_post);
---

<section class="imagen-texto" style={color_fondo_override ? `background: ${color_fondo_override}` : undefined}>
    <div class:list={["contenedor", imagenIzquierda && "contenedor--invertido"]}>
        <div class="texto">
            {etiqueta && <span class="etiqueta">{etiqueta}</span>}
            {titulo && <TituloTag class="titulo">{titulo}</TituloTag>}
            {subtitulo && <SubtituloTag class="subtitulo">{subtitulo}</SubtituloTag>}
            {parrafos.map((p) => <p class="parrafo">{p}</p>)}

            {
                Array.isArray(lista) && lista.length > 0 && (
                    <ul class="lista">
                        {lista.map((el) => (
                            <li class="lista-fila">
                                <i class="fa-solid fa-circle-check" aria-hidden="true" />
                                <span>{el.texto}</span>
                            </li>
                        ))}
                    </ul>
                )
            }

            {
                texto_boton && (
                    <a href={url_boton || "#"} class="boton">
                        {texto_boton}
                    </a>
                )
            }
        </div>

        <div class="foto">
            <FotoInclinada imagen={imagen} alt={titulo} texto_foto={texto_foto} rotacion={imagenIzquierda ? "-3deg" : "3deg"} borde="mint">
                {
                    hayBadge && (
                        <div class="badge">
                            {badge_pre && <span class="badge-pre">{badge_pre}</span>}
                            {badge_valor && <span class="badge-valor">{badge_valor}</span>}
                            {badge_post && <span class="badge-post">{badge_post}</span>}
                        </div>
                    )
                }
            </FotoInclinada>
        </div>
    </div>
</section>

<style>
    .imagen-texto {
        background: var(--surface-brand-primary);
        padding: 3rem 1rem 3.5rem;
    }

    .contenedor {
        max-width: 1440px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 3rem;
        align-items: center;
    }

    .texto {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        min-width: 0;
    }

    .foto {
        min-width: 0;
        padding: 1rem;
    }

    .etiqueta {
        font-family: var(--font-sharp-sans-bold);
        color: var(--surface-brand-secondary);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.08em;
    }

    .titulo {
        margin: 0.5rem 0 0;
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        text-transform: uppercase;
        color: var(--neutral-text-inverted);
        font-size: clamp(1.75rem, 7vw, 3.25rem);
        line-height: 0.95;
        overflow-wrap: break-word;
    }

    .subtitulo {
        margin: 1.25rem 0 0;
        font-family: var(--font-sharp-sans-bold);
        color: var(--brand-interactive-base);
        font-size: 1.15rem;
        line-height: 1.4;
        font-weight: inherit;
    }

    .parrafo {
        margin: 1.1rem 0 0;
        max-width: 38rem;
        font-family: var(--font-sharp-sans-medium);
        color: var(--accent-highlight-primary);
        font-size: 1rem;
        line-height: 1.6;
    }

    .lista {
        list-style: none;
        margin: 1.25rem 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .lista-fila {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        font-family: var(--font-sharp-sans-bold);
        color: var(--neutral-text-inverted);
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    .lista-fila i {
        color: var(--brand-interactive-base);
    }

    .boton {
        display: inline-block;
        margin-top: 1.75rem;
        background: var(--surface-brand-primary);
        color: var(--neutral-text-inverted);
        border: 2px solid var(--brand-interactive-base);
        box-shadow: 5px 5px 0 0 var(--brand-interactive-base);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        text-transform: uppercase;
        font-size: 1rem;
        line-height: 1.1;
        padding: 0.85rem 1.5rem;
        transition: transform 0.2s ease;
    }

    .boton:hover {
        transform: translate(-2px, -2px);
    }

    /* Sello rosa en la esquina de la foto ("HASTA 12 PERSONAS"). */
    .badge {
        position: absolute;
        top: -0.5rem;
        right: -0.25rem;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: var(--surface-brand-secondary);
        color: var(--surface-brand-primary);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        text-transform: uppercase;
        text-align: center;
        padding: 0.5rem 0.9rem;
        line-height: 1;
        transform: rotate(3deg);
    }

    .badge-pre,
    .badge-post {
        font-size: 0.7rem;
        letter-spacing: 0.04em;
    }

    .badge-valor {
        font-size: 2.5rem;
    }

    @media (min-width: 1024px) {
        .contenedor {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 4rem;
        }

        .contenedor--invertido .foto {
            order: -1;
        }
    }
</style>
