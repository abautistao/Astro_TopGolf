---
// src/components/toca/Component_1.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';

interface Props {
    titulo: string;
    descripcion: string;
    imagen: any;
    social:any 
}

const { 
    titulo = "Titulo de Ejemplo",
    descripcion = "Descripcion de Ejemplo",
    imagen ,
    social = [
    {
        name: "Reserva Ahora",
        url: "#",
        icon: "version_1",
    },
]
 } = Astro.props;


 const imagenUrl = getStrapiUrl(imagen);
 const descripcionHtml = stringifyRichText(descripcion);
---

<section class="w-full bg-[#0f0b29] text-white overflow-hidden">
    <div class="flex flex-col lg:flex-row h-full min-h-[600px] lg:h-[80vh]">

        <div class="w-full lg:w-5/12 p-8 lg:p-16 flex flex-col justify-between relative z-10">

            <div class="mt-8 lg:mt-16">
                <h1 class="font-black uppercase leading-[0.9] tracking-tighter mb-8">
                    <span class="block text-5xl md:text-7xl lg:text-8xl xl:text-9xl">{titulo}</span>
                </h1>

                <div class="text-base md:text-lg lg:text-xl font-medium max-w-md leading-relaxed text-gray-200" set:html={descripcionHtml}>
                    
                </div>
            </div>

            <div class="flex items-center gap-6 mt-12 lg:mt-0">
                {social.map((social_item: any) => (
                   <a href={social_item.url} target="_blank" rel="noopener noreferrer" class="text-[#7FFFD4] hover:text-white transition-colors duration-200 group">
                   {social_item.name}  {social_item.icon}
                   </a>
                ))}
            </div>
        </div>

        <div class="w-full lg:w-7/12 h-[400px] lg:h-auto relative">
            <div class="absolute inset-0 bg-black/10 z-10"></div>

            <Image
                src={imagenUrl || "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo"}
                alt={titulo}
                class="w-full h-full object-cover object-center"
                inferSize={true}
            />

        </div>

    </div>
</section>