---
// src/components/toca/Component_1.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";
import { Image } from "astro:assets";

interface Props {
    titulo: string;
    descripcion: string;
    imagen: any;
    social: any;
}

const {
    titulo,
    descripcion = "Descripcion de Ejemplo",
    imagen,
    social = [
        {
            name: "Reserva Ahora",
            url: "#",
            icon: "version_1",
        },
    ],
} = Astro.props;

// Para el salto de línea en el código, simplemente usa \n en el string que pases
// Ejemplo al usar el componente: titulo="Hola Mundo\nSegunda Linea"
const tituloMostrar = titulo || "TÍTULO DE EJEMPLO";

const strapiImageUrl = getStrapiUrl(imagen);
const descripcionHtml = stringifyRichText(descripcion);

const altText =
    imagen?.data?.attributes?.alternativeText ||
    tituloMostrar ||
    "Imagen destacada";
---

<section
    class="w-full bg-[var(--surface-brand-primary)] min-h-[600px] lg:h-[85vh] flex items-center overflow-hidden pl-4"
>
    <div class="flex flex-col lg:flex-row w-full h-full items-stretch">

        <div
            class="w-full lg:w-[20%] px-8 md:px-12 lg:px-10 pb-10 lg:pb-12 pt-10 flex flex-col justify-between z-10 bg-[var(--surface-brand-primary)]"
        >
            <div class="mt-0 lg:mt-4">
                <h1
                    class="font-bold uppercase leading-[0.85] tracking-tighter mb-8 flex flex-col text-[var(--accent-feedback-strong)] relative z-20 lg:w-[60vw] min-w-[300px]"
                >
                    <span
                        class="whitespace-pre-line text-3xl lg:text-[64px] font-(family-name:--font-titling-gothic-fb-extended-bold)"
                    >
                        {tituloMostrar}
                    </span>
                </h1>

                <div
                    class="text-[var(--surface-brand-secondary)] text-sm lg:text-base font-bold leading-relaxed strapi-rich-text font-(family-name:--font-sharp-sans-bold)"
                >
                    <Fragment set:html={descripcionHtml} />
                </div>
            </div>

            <div class="flex items-center gap-5 mt-8 lg:mt-0">
                {
                    social &&
                        social.map((social_item: any) => (
                            <a
                                href={social_item.url}
                                target="_blank"
                                class="text-[var(--brand-interactive-base)] text-lg md:text-xl hover:text-[var(brand-interactive-base)] transition-colors"
                            >
                                <Fragment set:html={social_item.icon} />
                            </a>
                        ))
                }
            </div>
        </div>

        <div
            class="w-full lg:w-[80%] h-[500px] lg:h-full relative flex items-center justify-center p-0 lg:p-15"
        >
            <div class="w-full h-full z-0 relative">
                <Image
                    src={strapiImageUrl ||
                        "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo"}
                    alt={altText}
                    class="w-full h-full object-cover object-center"
                    inferSize={true}
                />
            </div>
        </div>
    </div>
</section>

<style>
    /* Ajusté el margen negativo del H1 para que no se encime tanto ahora que cambiamos los anchos */
    h1 {
        margin-right: -10%;
    }

    @media (max-width: 1024px) {
        h1 {
            margin-right: 0;
        }
    }
    .strapi-rich-text :global(strong) {
        font-weight: bold;
    }
    .strapi-rich-text :global(u) {
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
</style>