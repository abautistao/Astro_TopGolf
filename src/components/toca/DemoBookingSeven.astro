{/* Styling for Active State classes & dynamics */}
<style>
    .tab-btn.active, .tab-btn-type.active {
        background-color: var(--brand-interactive-base);
        color: var(--surface-brand-primary);
    }
</style>

{/* Interactive JavaScript */}
<script>
    const initDemoBooking = () => {
        const calendarGrid = document.getElementById('calendar-days-grid');
        if (!calendarGrid) {
            console.log("DemoBookingSeven: calendar-days-grid not found yet, retrying in 50ms...");
            setTimeout(initDemoBooking, 50);
            return;
        }
        if (calendarGrid.dataset.initialized) {
            console.log("DemoBookingSeven calendar already initialized, skipping duplicate setup.");
            return;
        }
        calendarGrid.dataset.initialized = 'true';

        // --- Day selector tabs ---
        const tabBtns = document.querySelectorAll('.tab-btn');
        let currentDayTab = 'lun-jue'; // Default state

        const tabBtnsType = document.querySelectorAll('.tab-btn-type');
        let currentTypeTab = 'sin-juego'; // Default state

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabValue = btn.getAttribute('data-tab-value');
                if (!tabValue || tabValue === currentDayTab) return;

                // Toggle active class on tabs
                tabBtns.forEach(b => {
                    b.classList.remove('active');
                    b.classList.remove('text-[var(--surface-brand-primary)]');
                    b.classList.add('text-white/60');
                });
                btn.classList.add('active');
                btn.classList.remove('text-white/60');

                currentDayTab = tabValue;

                // Update prices
                updateBookingPrices(currentDayTab, currentTypeTab);
            });
        });

        tabBtnsType.forEach(btn => {
            btn.addEventListener('click', () => {
                const tabValue = btn.getAttribute('data-tab-value');
                console.log(tabValue)
                if (!tabValue || tabValue === currentTypeTab) return;

                // Toggle active class on tabs
                tabBtnsType.forEach(b => {
                    b.classList.remove('active');
                    b.classList.remove('text-[var(--surface-brand-primary)]');
                    b.classList.add('text-white/60');
                });
                btn.classList.add('active');
                btn.classList.remove('text-white/60');

                currentTypeTab = tabValue;

                // Update prices
                updateBookingPrices(currentDayTab, currentTypeTab);
            });
        });

        // --- Option Selector Rows ---
        const groupRows = document.querySelectorAll('.group-row');
        groupRows.forEach(row => {
            row.addEventListener('click', () => {
                const cardName = row.getAttribute('data-card');
                if (!cardName) return;

                // Deselect other rows inside this card
                const siblingRows = document.querySelectorAll(`.group-row[data-card="${cardName}"]`);
                siblingRows.forEach(r => {
                    r.classList.remove('active');
                    r.classList.remove('border-[var(--brand-interactive-base)]');
                    r.classList.remove('bg-black/50');
                    r.classList.add('border-white/10');
                    r.classList.add('bg-black/30');

                    const badge = r.querySelector('.player-badge');
                    if (badge) {
                        badge.classList.remove('bg-[var(--brand-interactive-base)]');
                        badge.classList.remove('text-[var(--surface-brand-primary)]');
                        badge.classList.add('bg-black/40');
                        badge.classList.add('text-white/60');
                    }

                    const total = r.querySelector('.row-total');
                    if (total) {
                        total.classList.remove('text-[var(--brand-interactive-base)]');
                        total.classList.add('text-white/80');
                    }
                });

                // Select current clicked row
                row.classList.add('active');
                row.classList.add('border-[var(--brand-interactive-base)]');
                row.classList.add('bg-black/50');
                row.classList.remove('border-white/10');
                row.classList.remove('bg-black/30');

                const badge = row.querySelector('.player-badge');
                if (badge) {
                    badge.classList.add('bg-[var(--brand-interactive-base)]');
                    badge.classList.add('text-[var(--surface-brand-primary)]');
                    badge.classList.remove('bg-black/40');
                    badge.classList.remove('text-white/60');
                }

                const total = row.querySelector('.row-total');
                if (total) {
                    total.classList.add('text-[var(--brand-interactive-base)]');
                    total.classList.remove('text-white/80');
                }

                // Update bottom card button text
                const players = row.getAttribute('data-players');
                const cardElement = document.querySelector(`.card-booking[data-card-id="${cardName}"]`);
                if (cardElement) {
                    const actionBtn = cardElement.querySelector('.card-action-btn');
                    if (actionBtn) {
                        const cardTitle = cardName.charAt(0).toUpperCase() + cardName.slice(1);
                        actionBtn.textContent = `Reservar ${cardTitle} (${players} pers) →`;
                        actionBtn.setAttribute('href', '/reservar?party_size=' + players);
                    }
                }

                // Sync with calendar date and time
                updateAllBookingUrls();
            });
        });

        // --- Recalculate Prices Function ---
        function updateBookingPrices(dayTab: string, type: string) {
            let basePrice: string;
            let cashbackPrice: string;
            let labelPlayerType = type === 'sin-juego' ? 'personas' : 'jugadores';


            if(dayTab == 'lun-jue') {
                if(type === 'sin-juego') {
                    basePrice = '250';
                    cashbackPrice = '250';
                }else {
                    basePrice = '500';
                    cashbackPrice = '250';
                }
            } else if(dayTab == 'vie-dom') {
                if(type === 'sin-juego') {
                    basePrice = '300';
                    cashbackPrice = '300';
                }else {
                    basePrice = '600';
                    cashbackPrice = '300';
                }
            }
            

            // 1. Update Card level price labels
            const cardPriceLabels = document.querySelectorAll('.card-price-label');
            cardPriceLabels.forEach(label => {
                label.textContent = `$${basePrice}`;
            });

            // 2. Update Card level cashback labels
            const cardCashbackLabels = document.querySelectorAll('.card-cashback-label');
            cardCashbackLabels.forEach(label => {
                label.textContent = `$${cashbackPrice}`;
            });

            // 3. Update Card level cashback labels
            const cardTypeLabels = document.querySelectorAll('.player-type');
            cardTypeLabels.forEach(label => {
                label.textContent = `${labelPlayerType}`;
            });

            // 2. Update Group rows calculations
            const allRows = document.querySelectorAll('.group-row');
            allRows.forEach(row => {
                const playerCountAttr = row.getAttribute('data-players');
                if (!playerCountAttr) return;

                const playersCount = parseInt(playerCountAttr, 10);
                const newTotal = basePrice * playersCount;

                // Update row-total label text formatted with comma if necessary
                const totalLabel = row.querySelector('.row-total');
                if (totalLabel) {
                    totalLabel.textContent = `$${newTotal.toLocaleString()}`;
                }
            });
        }

        // --- Accordion FAQs ---
        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
            item.addEventListener('click', () => {
                const answer = item.querySelector('.faq-answer') as HTMLElement;
                const icon = item.querySelector('.faq-icon') as HTMLElement;
                if (!answer || !icon) return;

                const isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';

                // Close other accordion items
                faqItems.forEach(otherItem => {
                    const otherAnswer = otherItem.querySelector('.faq-answer') as HTMLElement;
                    const otherIcon = otherItem.querySelector('.faq-icon') as HTMLElement;
                    if (otherAnswer && otherIcon) {
                        otherAnswer.style.maxHeight = '0px';
                        otherIcon.style.transform = 'rotate(0deg)';
                        otherIcon.classList.remove('text-[var(--surface-brand-primary)]');
                    }
                });

                if (!isOpen) {
                    answer.style.maxHeight = answer.scrollHeight + 'px';
                    icon.style.transform = 'rotate(45deg)';
                    icon.classList.add('text-[var(--surface-brand-primary)]');
                } else {
                    answer.style.maxHeight = '0px';
                    icon.style.transform = 'rotate(0deg)';
                    icon.classList.remove('text-[var(--surface-brand-primary)]');
                }
            });
        });

        // ==========================================
        // --- CALENDAR LOGIC ---
        // ==========================================
        const today = new Date();
        // Default to May 29, 2026 as per mockup, or today if that date is in the past
        let selectedDate = new Date(2026, 4, 29);
        let displayDate = new Date(2026, 4, 1);

        if (today > new Date(2026, 4, 29)) {
            selectedDate = new Date(today.getFullYear(), today.getMonth(), today.getDate());
            displayDate = new Date(today.getFullYear(), today.getMonth(), 1);
        }

        let selectedTime = '5:00 PM'; // Default selected time slot

        const monthNames = [
            "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
            "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
        ];

        // Deterministic slot generation based on date to keep UI alive and dynamic
        function getSlotsForDate(date: Date) {
            const day = date.getDay();
            
            const isWeekend=(day===5||day===6);
            const isSunday=(day===0);
            const endHour= isSunday ? 22 : isWeekend ? 24 : 23;
            
            console.log(day)
            const slots=[];
            const seed=date.getDate()*31+date.getMonth()*7;
            for(let h=10;h<=endHour;h++){
                const soldout=false;
                let label;
                if(h<12) label=h+':00 AM';
                else if(h===12) label='12:00 PM';
                else if(h<24) label=(h-12)+':00 PM';
                else label='12:00 AM';
                slots.push({time:label,status:soldout?'Agotado':'Disponible'});
            }
            return slots;

        }

        function renderCalendar() {
            const currentMonthLabel = document.getElementById('current-month-label');
            const daysGrid = document.getElementById('calendar-days-grid');
            if (!currentMonthLabel || !daysGrid) return;

            const year = displayDate.getFullYear();
            const monthIndex = displayDate.getMonth();
            currentMonthLabel.textContent = `${monthNames[monthIndex]} ${year}`;

            daysGrid.innerHTML = '';

            const firstDay = new Date(year, monthIndex, 1);
            const lastDay = new Date(year, monthIndex + 1, 0);
            const totalDays = lastDay.getDate();

            // Monday-first offset
            let startOffset = firstDay.getDay();
            startOffset = startOffset === 0 ? 6 : startOffset - 1;

            // Offset padding
            for (let i = 0; i < startOffset; i++) {
                const emptyCell = document.createElement('div');
                emptyCell.className = 'py-2.5';
                daysGrid.appendChild(emptyCell);
            }

            const todayNormalized = new Date(today.getFullYear(), today.getMonth(), today.getDate());

            // Days cells
            for (let day = 1; day <= totalDays; day++) {
                const cellDate = new Date(year, monthIndex, day);
                const dayBtn = document.createElement('button');
                dayBtn.textContent = day.toString();
                dayBtn.type = 'button';

                const isPast = todayNormalized > cellDate;
                const isToday = today.getFullYear() === year && today.getMonth() === monthIndex && today.getDate() === day;
                const isSelected = selectedDate.getFullYear() === year && selectedDate.getMonth() === monthIndex && selectedDate.getDate() === day;

                let classes = 'w-10 h-10 mx-auto flex items-center justify-center rounded-xl text-sm font-semibold transition-all duration-200 ';

                if (isPast) {
                    classes += 'text-white/20 cursor-not-allowed pointer-events-none';
                } else if (isSelected) {
                    classes += 'bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)] font-bold shadow-md shadow-[var(--brand-interactive-base)]/20';
                } else {
                    classes += 'text-white/80 hover:bg-white/10 hover:text-white cursor-pointer';
                    if (isToday) {
                        classes += ' border border-[var(--brand-interactive-base)]/50 text-[var(--brand-interactive-base)]';
                    }
                }

                dayBtn.className = classes;

                if (!isPast) {
                    dayBtn.addEventListener('click', () => {
                        selectedDate = cellDate;
                        console.log(selectedDate)
                        // Check if selected time is valid for the new date, otherwise pick first available
                        const newSlots = getSlotsForDate(selectedDate);
                        const existsAndAvailable = newSlots.some(s => s.time === selectedTime && s.status !== 'Agotado');
                        if (!existsAndAvailable) {
                            const firstAvailable = newSlots.find(s => s.status !== 'Agotado');
                            if (firstAvailable) {
                                selectedTime = firstAvailable.time;
                            }
                        }

                        syncTabAndPriceWithDate(selectedDate);
                        renderCalendar();
                        renderTimeSlots();
                        updateAllBookingUrls();
                    });
                }

                daysGrid.appendChild(dayBtn);
            }
        }

        function renderTimeSlots() {
            const timesGrid = document.getElementById('calendar-times-grid');
            if (!timesGrid) return;

            timesGrid.innerHTML = '';
            const slots = getSlotsForDate(selectedDate);

            slots.forEach(slot => {
                const slotBtn = document.createElement('button');
                slotBtn.type = 'button';
                
                const isSelected = selectedTime === slot.time && slot.status !== 'Agotado';
                const isAgotado = slot.status === 'Agotado';

                let btnClasses = 'flex flex-col items-start p-4 rounded-2xl border transition-all duration-300 text-left w-full ';
                let timeClasses = 'font-[family-name:var(--font-principal)] text-base font-bold ';
                let statusClasses = 'font-[family-name:var(--font-secundaria)] text-xs mt-1 ';

                if (isAgotado) {
                    btnClasses += 'bg-black/10 border-white/5 opacity-30 cursor-not-allowed';
                    timeClasses += 'text-white/40';
                    statusClasses += 'text-white/30';
                } else if (isSelected) {
                    btnClasses += 'bg-[var(--brand-interactive-base)] border-transparent text-[var(--surface-brand-primary)] shadow-lg shadow-[var(--brand-interactive-base)]/10 scale-[1.02]';
                    timeClasses += 'text-[var(--surface-brand-primary)]';
                    statusClasses += 'text-[var(--surface-brand-primary)]/80 font-medium';
                } else {
                    btnClasses += 'bg-black/30 border-white/10 text-white hover:border-[var(--brand-interactive-base)]/50 hover:bg-black/50 cursor-pointer';
                    timeClasses += 'text-white';
                    statusClasses += 'text-white/50';
                }

                slotBtn.className = btnClasses;

                const timeSpan = document.createElement('span');
                timeSpan.className = timeClasses;
                timeSpan.textContent = slot.time;
                slotBtn.appendChild(timeSpan);

                const statusSpan = document.createElement('span');
                statusSpan.className = statusClasses;
                statusSpan.textContent = isSelected ? 'Seleccionado' : slot.status;
                slotBtn.appendChild(statusSpan);

                if (!isAgotado) {
                    slotBtn.addEventListener('click', () => {
                        selectedTime = slot.time;
                        renderTimeSlots();
                        updateAllBookingUrls();
                    });
                }

                timesGrid.appendChild(slotBtn);
            });
        }

        function syncTabAndPriceWithDate(date: Date) {
            const dayOfWeek = date.getDay(); // 0=Sun, 1=Mon, ..., 6=Sat
            const isWeekend = dayOfWeek === 0 || dayOfWeek === 5 || dayOfWeek === 6;
            const targetTabValue = isWeekend ? 'vie-dom' : 'lun-jue';
            const targetTabTypeValue = document.querySelector('.tab-btn-type.active')?.getAttribute('data-tab-value');
            
            if (currentDayTab !== targetTabValue) {
                currentDayTab = targetTabValue;
                
                tabBtns.forEach(btn => {
                    const val = btn.getAttribute('data-tab-value');
                    if (val === targetTabValue) {
                        btn.classList.add('active');
                        btn.classList.remove('text-white/60');
                    } else {
                        btn.classList.remove('active');
                        btn.classList.remove('text-[var(--surface-brand-primary)]');
                        btn.classList.add('text-white/60');
                    }
                });
                
                if(targetTabTypeValue)
                    updateBookingPrices(currentDayTab, targetTabTypeValue);
            }
        }

        function updateAllBookingUrls() {
            const year = selectedDate.getFullYear();
            const month = String(selectedDate.getMonth() + 1).padStart(2, '0');
            const day = String(selectedDate.getDate()).padStart(2, '0');
            const dateStr = `${year}-${month}-${day}`;

            let timeStr = '';
            const match = selectedTime.match(/(\d+):(\d+)\s*(AM|PM)/i);
            if (match) {
                let hour = parseInt(match[1], 10);
                const min = match[2];
                const ampm = match[3].toUpperCase();
                if (ampm === 'PM' && hour < 12) hour += 12;
                if (ampm === 'AM' && hour === 12) hour = 0;
                timeStr = `${String(hour).padStart(2, '0')}:${min}`;
            } else {
                timeStr = selectedTime;
            }

            // Update card action buttons
            const cardActionBtns = document.querySelectorAll('.card-action-btn');
            cardActionBtns.forEach(btn => {
                const href = btn.getAttribute('href');
                if (href) {
                    try {
                        const url = new URL(href, window.location.origin);
                        url.searchParams.set('date', dateStr);
                        url.searchParams.set('time', timeStr);
                        btn.setAttribute('href', url.pathname + url.search);
                    } catch (e) {
                        btn.setAttribute('href', `/reservar?date=${dateStr}&time=${timeStr}`);
                    }
                }
            });

            // Update final booking button
            const finalBookingBtns = document.querySelectorAll('.final-booking-btn');
            finalBookingBtns.forEach(btn => {
                const href = btn.getAttribute('href');
                if (href) {
                    try {
                        const url = new URL(href, window.location.origin);
                        url.searchParams.set('date', dateStr);
                        url.searchParams.set('time', timeStr);
                        btn.setAttribute('href', url.pathname + url.search);
                    } catch (e) {
                        btn.setAttribute('href', `/reservar?date=${dateStr}&time=${timeStr}`);
                    }
                }
            });
        }

        // Navigation
        const prevMonthBtn = document.getElementById('prev-month-btn');
        const nextMonthBtn = document.getElementById('next-month-btn');

        if (prevMonthBtn) {
            prevMonthBtn.addEventListener('click', () => {
                const minMonth = new Date(today.getFullYear(), today.getMonth(), 1);
                const prevMonth = new Date(displayDate.getFullYear(), displayDate.getMonth() - 1, 1);
                if (prevMonth >= minMonth) {
                    displayDate = prevMonth;
                    renderCalendar();
                }
            });
        }

        if (nextMonthBtn) {
            nextMonthBtn.addEventListener('click', () => {
                displayDate = new Date(displayDate.getFullYear(), displayDate.getMonth() + 1, 1);
                renderCalendar();
            });
        }

        // Initialize Calendar
        renderCalendar();
        renderTimeSlots();
        updateAllBookingUrls();
    };

    // Run on initial load and after Astro View Transitions
    initDemoBooking();
    document.addEventListener('astro:page-load', initDemoBooking);
</script>
