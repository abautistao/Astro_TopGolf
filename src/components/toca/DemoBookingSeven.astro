---
// src/components/toca/DemoBookingSeven.astro
---

<section class="w-full bg-[var(--surface-brand-secondary)] text-[var(--surface-brand-primary)] py-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
        
        {/* --- SECCIÓN 1: ELIGE TU NIVEL DE JUEGO (Booking Grid) --- */}
        <div class="flex flex-col gap-10">
            {/* Header Area */}
            <div class="flex flex-col md:flex-row md:justify-between md:items-end gap-6">
                <div class="flex flex-col items-start gap-4 max-w-2xl">
                    <span class="inline-block border border-[var(--surface-brand-primary)] text-[var(--surface-brand-primary)] text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-widest font-[family-name:var(--font-principal)]">
                        • Precios Transparentes
                    </span>
                    <h2 class="font-[family-name:var(--font-principal)] text-[40px] sm:text-[56px] md:text-[60px] font-bold uppercase leading-none tracking-tight text-[var(--surface-brand-primary)]">
                        ¿Listos para <span class="bg-[var(--surface-brand-primary)] text-[var(--brand-interactive-base)] px-2 py-0.5 inline-block transform -rotate-1 rounded">jugar?</span> Reserva aquí
                    </h2>
                    <p class="font-[family-name:var(--font-secundaria)] text-[16px] font-normal text-[var(--surface-brand-primary)]/80 max-w-md leading-relaxed">
                        Un precio fijo por persona, sin costos ocultos. Entre más jugadores, más minutos de juego. Así de simple.
                    </p>
                </div>
                
                {/* Price Legend */}
                <div class="bg-[var(--surface-brand-primary)] border border-white/10 p-4 rounded-xl shadow-lg">
                    <p class="text-lg text-(--accent-feedback-strong)">Acceso desde:</p>
                    <div class="flex gap-8 items-center">
                        <div class="flex flex-col">
                            <span class="text-3xl font-extrabold text-[var(--brand-interactive-base)] font-[family-name:var(--font-principal)]">$250</span>
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">P/P • Lun - Jue</span>
                        </div>
                        <div class="h-8 w-px bg-white/20"></div>
                        <div class="flex flex-col">
                            <span class="text-3xl font-extrabold text-[var(--surface-brand-secondary)] font-[family-name:var(--font-principal)]">$300</span>
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">P/P • Vie - Dom</span>
                        </div>
                    </div>
                </div>
            </div>

            {/* Tab Selector */}
            <div class="flex justify-center mt-4">
                <div class="inline-flex bg-[var(--surface-brand-primary)] border border-white/10 p-1.5 rounded-full shadow-md">
                    <button 
                        class="tab-btn active relative px-6 py-2 rounded-full font-[family-name:var(--font-principal)] text-sm font-bold uppercase tracking-wider transition-all duration-1000"
                        data-tab-value="lun-jue"
                    >
                        <span class="absolute inset-0 rounded-full bg-[var(--brand-interactive-base)] opacity-0 transition-all pointer-events-none [.active_&]:animate-ping [.active_&]:opacity-75"></span>
                        
                        <span class="relative z-10">Lunes - Jueves</span>
                    </button>
                    
                    <button 
                        class="tab-btn relative px-6 py-2 rounded-full font-[family-name:var(--font-principal)] text-sm font-bold uppercase tracking-wider transition-all duration-1000 text-white/60 hover:text-white"
                        data-tab-value="vie-dom"
                    >
                        <span class="absolute inset-0 rounded-full bg-[var(--brand-interactive-base)] opacity-0 transition-all pointer-events-none [.active_&]:animate-ping [.active_&]:opacity-75"></span>
                        <span class="relative z-10">Viernes - Domingo</span>
                    </button>
                </div>
            </div>

            <div class="">
                <h2 class="text-lg text-left">Selecciona la fecha y hora de tu visita</h2>    
            </div> 

        <!-- CALENDAR SECTION -->
        <div class=" bg-[var(--surface-brand-primary)] border border-white/10 rounded-3xl p-6 md:p-8 shadow-xl text-white mb-8 transition-colors duration-300 flex flex-col gap-6">
            <!-- Header -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-white/10 pb-6">
                <div class="flex flex-col gap-1">
                    <h3 class="font-[family-name:var(--font-principal)] text-[28px] md:text-[32px] font-bold uppercase tracking-tight text-white leading-none">
                        TOCA SOCIAL MONTERREY
                    </h3>
                    <p class="font-[family-name:var(--font-secundaria)] text-[16px] font-normal text-white/60">
                        Galerías Valle Oriente · Reserva
                    </p>
                </div>
                <!-- Month Selector Badge -->
                <div class="flex items-center gap-3 bg-black/40 border border-white/10 px-4 py-2 rounded-full">
                    <button type="button" id="prev-month-btn" class="text-white hover:text-[var(--brand-interactive-base)] transition-colors duration-200 focus:outline-none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
                        </svg>
                    </button>
                    <span id="current-month-label" class="font-[family-name:var(--font-principal)] text-sm font-bold uppercase tracking-wider text-[var(--brand-interactive-base)] min-w-[100px] text-center">
                        Mayo 2026
                    </span>
                    <button type="button" id="next-month-btn" class="text-white hover:text-[var(--brand-interactive-base)] transition-colors duration-200 focus:outline-none">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Calendar Content Columns -->
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                <!-- Date Selector (Left) -->
                <div class="lg:col-span-7 flex flex-col gap-6">
                    <h4 class="font-[family-name:var(--font-principal)] text-xs font-bold uppercase tracking-widest text-white/50">
                        Selecciona una fecha
                    </h4>
                    
                    <div class="flex flex-col gap-4">
                        <!-- Weekday Headers -->
                        <div class="grid grid-cols-7 text-center font-[family-name:var(--font-principal)] text-xs font-bold text-white/40 uppercase">
                            <div>L</div>
                            <div>M</div>
                            <div>X</div>
                            <div>J</div>
                            <div>V</div>
                            <div>S</div>
                            <div>D</div>
                        </div>
                        <!-- Days Grid -->
                        <div id="calendar-days-grid" class="grid grid-cols-7 gap-y-3 gap-x-2 text-center">
                            <!-- Dynamic rendering in JS -->
                        </div>
                    </div>
                </div>

                <!-- Time Selector (Right) -->
                <div class="lg:col-span-5 flex flex-col gap-6 lg:border-l lg:border-white/10 lg:pl-8">
                    <h4 class="font-[family-name:var(--font-principal)] text-xs font-bold uppercase tracking-widest text-white/50">
                        Horarios disponibles
                    </h4>
                    
                    <div id="calendar-times-grid" class="grid grid-cols-3 gap-4">
                        <!-- Dynamic rendering in JS -->
                    </div>
                </div>
            </div>
        </div>

            <div class="flex">
                <h2 class="text-lg text-left">Selecciona tu grupo para desbloquear tu experiencia en TOCA Social</h2>    
            </div> 

            {/* Tab Selector */}
            <div class="flex justify-center mt-4">
                <div class="inline-flex bg-[var(--surface-brand-primary)] border border-white/10 p-1.5 rounded-full shadow-md">
                    <button 
                        class="tab-btn-type active relative px-6 py-2 rounded-full font-[family-name:var(--font-principal)] text-sm font-bold uppercase tracking-wider transition-all duration-1000"
                        data-tab-value="sin-juego"
                    >
                        <span class="absolute inset-0 rounded-full bg-[var(--brand-interactive-base)] opacity-0 transition-all pointer-events-none [.active_&]:animate-ping [.active_&]:opacity-75"></span>
                        
                        <span class="relative z-10">TOCA Access</span>
                    </button>
                    
                    <button 
                        class="tab-btn-type relative px-6 py-2 rounded-full font-[family-name:var(--font-principal)] text-sm font-bold uppercase tracking-wider transition-all duration-1000 text-white/60 hover:text-white"
                        data-tab-value="juego"
                    >
                        <span class="absolute inset-0 rounded-full bg-[var(--brand-interactive-base)] opacity-0 transition-all pointer-events-none [.active_&]:animate-ping [.active_&]:opacity-75"></span>
                        <span class="relative z-10">TOCA The match pac </span>
                    </button>
                </div>
            </div>
            {/* Cards Grid */}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-4">
                
                {/* CARD 1: STARTER */}
                <div class="card-booking bg-[var(--surface-brand-primary)] border border-white/10 hover:border-[var(--brand-interactive-base)]/80 rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 gap-6 shadow-md text-white" data-card-id="starter">
                    <div class="flex flex-col gap-4">
                        <div class="flex justify-between items-start">
                            <span class="text-xs uppercase tracking-widest text-[var(--brand-interactive-base)] font-bold font-[family-name:var(--font-principal)]">1 - 3 <span class="player-type">PERSONAS</span></span>
                        </div>
                        <div>
                            <h3 class="font-[family-name:var(--font-principal)] text-[28px] font-bold uppercase text-white leading-tight">STARTER</h3>
                            <span class="inline-flex items-center gap-1.5 text-xs text-white/60 bg-black/30 px-2.5 py-1 rounded-full mt-2 font-[family-name:var(--font-secundaria)]">
                                ⏱️ 45 minutos de juego
                            </span>
                        </div>
                        <div class="py-2 border-y border-white/10 flex justify-between items-center">
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">Precio p/persona:</span>
                            <span class="text-xl font-bold font-[family-name:var(--font-principal)] text-[var(--brand-interactive-base)] card-price-label" data-price-lun-jue="250" data-price-vie-dom="300">$250</span>
                        </div>
                        <div class="py-2 border-y border-white/10 flex justify-between items-center">
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">Cashback p/persona:</span>
                            <span class="text-xl font-bold font-[family-name:var(--font-principal)] text-[var(--brand-interactive-base)] card-cashback-label">$250</span>
                        </div>
                        <p class="font-[family-name:var(--font-secundaria)] text-xs text-white/60 leading-relaxed min-h-[36px]">
                            Precio fijo independiente del número de jugadores.
                        </p>
                    </div>

                    <div class="flex flex-col gap-4">
                        <span class="text-xs uppercase tracking-widest text-white/40 font-bold font-[family-name:var(--font-principal)]">Selecciona tu grupo:</span>
                        <div class="flex flex-col gap-2">
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200 active" data-players="1" data-card="starter">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)]">1</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">1 persona</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-[var(--brand-interactive-base)] row-total">$250</span>
                            </div>
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200" data-players="2" data-card="starter">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-black/40 text-white/60">2</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">2 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-white/80 row-total">$500</span>
                            </div>
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200" data-players="3" data-card="starter">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-black/40 text-white/60">3</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">3 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-white/80 row-total">$750</span>
                            </div>
                        </div>
                    </div>

                    <a href="/reservar?party_size=1" class="w-full py-3 px-4 rounded-xl border-2 border-[var(--brand-interactive-base)] text-[var(--brand-interactive-base)] hover:bg-[var(--brand-interactive-base)] hover:text-[var(--surface-brand-primary)] font-[family-name:var(--font-principal)] font-bold uppercase text-xs tracking-wider transition-all duration-300 mt-2 card-action-btn">
                        Reservar Starter (1 pers) →
                    </a>
                </div>

                {/* CARD 2: SOCIAL (Popular) */}
                <div class="card-booking bg-[var(--surface-brand-primary)] border-2 border-[var(--brand-interactive-base)] rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 gap-6 relative shadow-lg text-white" data-card-id="social">
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)] text-[10px] font-extrabold uppercase px-3 py-1 rounded-full tracking-widest font-[family-name:var(--font-principal)]">
                        Popular
                    </div>
                    <div class="flex flex-col gap-4">
                        <div class="flex justify-between items-start mt-2">
                            <span class="text-xs uppercase tracking-widest text-[var(--brand-interactive-base)] font-bold font-[family-name:var(--font-principal)]">4 - 6 <span class="player-type">PERSONAS</span></span>
                        </div>
                        <div>
                            <h3 class="font-[family-name:var(--font-principal)] text-[28px] font-bold uppercase text-white leading-tight">SOCIAL</h3>
                            <span class="inline-flex items-center gap-1.5 text-xs text-white/60 bg-black/30 px-2.5 py-1 rounded-full mt-2 font-[family-name:var(--font-secundaria)]">
                                ⏱️ 1:15 hrs de juego
                            </span>
                        </div>
                        <div class="py-2 border-y border-white/10 flex justify-between items-center">
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">Precio p/persona:</span>
                            <span class="text-xl font-bold font-[family-name:var(--font-principal)] text-[var(--brand-interactive-base)] card-price-label" data-price-lun-jue="250" data-price-vie-dom="300">$250</span>
                        </div>
                        <div class="py-2 border-y border-white/10 flex justify-between items-center">
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">Cashback p/persona:</span>
                            <span class="text-xl font-bold font-[family-name:var(--font-principal)] text-[var(--brand-interactive-base)] card-cashback-label">$250</span>
                        </div>
                        <p class="font-[family-name:var(--font-secundaria)] text-xs text-white/60 leading-relaxed min-h-[36px]">
                            El doble de tiempo, el mismo precio p/persona.
                        </p>
                    </div>

                    <div class="flex flex-col gap-4">
                        <span class="text-xs uppercase tracking-widest text-white/40 font-bold font-[family-name:var(--font-principal)]">Selecciona tu grupo:</span>
                        <div class="flex flex-col gap-2">
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200 active" data-players="4" data-card="social">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)]">4</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">4 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-[var(--brand-interactive-base)] row-total">$1000</span>
                            </div>
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200" data-players="5" data-card="social">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-black/40 text-white/60">5</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">5 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-white/80 row-total">$1,250</span>
                            </div>
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200" data-players="6" data-card="social">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-black/40 text-white/60">6</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">6 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-white/80 row-total">$1,500</span>
                            </div>
                        </div>
                    </div>

                    <a href="/reservar?party_size=4" class="w-full py-3 px-4 rounded-xl bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)] hover:bg-white hover:text-[var(--surface-brand-primary)] font-[family-name:var(--font-principal)] font-bold uppercase text-xs tracking-wider transition-all duration-300 mt-2 card-action-btn">
                        Reservar Social (4 pers) →
                    </a>
                </div>

                {/* CARD 3: SQUAD */}
                <div class="card-booking bg-[var(--surface-brand-primary)] border border-white/10 hover:border-[var(--brand-interactive-base)]/80 rounded-2xl p-6 flex flex-col justify-between transition-all duration-300 gap-6 shadow-md text-white" data-card-id="squad">
                    <div class="flex flex-col gap-4">
                        <div class="flex justify-between items-start">
                            <span class="text-xs uppercase tracking-widest text-[var(--brand-interactive-base)] font-bold font-[family-name:var(--font-principal)]">7 - 9 <span class="player-type">PERSONAS</span></span>
                        </div>
                        <div>
                            <h3 class="font-[family-name:var(--font-principal)] text-[28px] font-bold uppercase text-white leading-tight">SQUAD</h3>
                            <span class="inline-flex items-center gap-1.5 text-xs text-white/60 bg-black/30 px-2.5 py-1 rounded-full mt-2 font-[family-name:var(--font-secundaria)]">
                                ⏱️ 2 hrs de juego
                            </span>
                        </div>
                        <div class="py-2 border-y border-white/10 flex justify-between items-center">
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">Precio p/persona:</span>
                            <span class="text-xl font-bold font-[family-name:var(--font-principal)] text-[var(--brand-interactive-base)] card-price-label" data-price-lun-jue="250" data-price-vie-dom="300">$250</span>
                        </div>
                        <div class="py-2 border-y border-white/10 flex justify-between items-center">
                            <span class="text-xs uppercase tracking-wider text-white/50 font-[family-name:var(--font-secundaria)]">Cashback p/persona:</span>
                            <span class="text-xl font-bold font-[family-name:var(--font-principal)] text-[var(--brand-interactive-base)] card-cashback-label">$250</span>
                        </div>
                        <p class="font-[family-name:var(--font-secundaria)] text-xs text-white/60 leading-relaxed min-h-[36px]">
                            2 hrs completas para jugar de verdad.
                        </p>
                    </div>

                    <div class="flex flex-col gap-4">
                        <span class="text-xs uppercase tracking-widest text-white/40 font-bold font-[family-name:var(--font-principal)]">Selecciona tu grupo:</span>
                        <div class="flex flex-col gap-2">
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200 active" data-players="7" data-card="squad">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)]">7</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">7 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-[var(--brand-interactive-base)] row-total">$1,750</span>
                            </div>
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200" data-players="8" data-card="squad">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-black/40 text-white/60">8</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">8 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-white/80 row-total">$2,000</span>
                            </div>
                            <div class="group-row flex items-center justify-between p-3 rounded-xl border border-white/10 bg-black/30 hover:border-[var(--brand-interactive-base)]/50 cursor-pointer transition-all duration-200" data-players="9" data-card="squad">
                                <div class="flex items-center gap-3">
                                    <span class="player-badge w-7 h-7 rounded-full flex items-center justify-center font-bold text-xs bg-black/40 text-white/60">9</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-sm font-medium">9 personas</span>
                                </div>
                                <span class="font-[family-name:var(--font-principal)] text-sm font-bold text-white/80 row-total">$2,250</span>
                            </div>
                        </div>
                    </div>

                    <a  href="/reservar?party_size=7" class="w-full py-3 px-4 rounded-xl border-2 border-[var(--brand-interactive-base)] text-[var(--brand-interactive-base)] hover:bg-[var(--brand-interactive-base)] hover:text-[var(--surface-brand-primary)] font-[family-name:var(--font-principal)] font-bold uppercase text-xs tracking-wider transition-all duration-300 mt-2 card-action-btn">
                        Reservar Squad (7 pers) →
                    </a>
