---
// src/components/toca/Component_23.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';

interface Estadistica {
    id: number;
    icono: string;
    texto: string;
    valor: string;
    image: any;
}

interface TarjetaData {
    id: number;
    titulo: string;
    descripcion: any;
    imagen: any;
    Item_Estadistica: Estadistica[];
    imagen_decoracion: any;
}

interface Props {
    titulo_seccion?: string;
    tarjetas?: TarjetaData[];
}

const {
    titulo_seccion = "SPACES AT GRANDSCAPE, DALLAS",
    tarjetas = []
} = Astro.props;

const defaultSpace = [
    {
        id: 0,
        titulo: "SPACE NAME",
        descripcion: "Description placeholder...",
        Item_Estadistica: [],
        imagen: null,
        imagen_decoracion: null
    }
];

const dataToRender = tarjetas && tarjetas.length > 0 ? tarjetas : defaultSpace;
---

<section class="trigger-anim-games w-full bg-[var(--surface-brand-primary)] py-6 lg:py-10 overflow-hidden relative text-[var(--accent-feedback-strong)]">
    <div class="anim-fade max-w-[1280px] mx-auto px-6 sm:px-8 relative z-10">

        <h2 class="w-fit mx-auto font-(family-name:--font-titling-gothic-fb-extended-bold) font-bold text-2xl lg:text-2xl uppercase leading-[1] tracking-normal text-center mb-2 lg:mb-15 text-[var(--accent-feedback-strong)]">
            {titulo_seccion}
        </h2>

        <div class="flex lg:hidden justify-between items-center mb-6 w-full  pb-2">
            <div class="flex gap-2 pagination-dots mobile-dots">
                {dataToRender.map((_, index) => (
                    <div class={`w-3 h-3 rounded-full transition-colors duration-300 ${
                        index === 0
                        ? 'bg-[var(--brand-interactive-base)]'
                        : 'bg-[var(--accent-feedback-strong)]'
                    }`}></div>
                ))}
            </div>
            <div class="flex gap-8 items-center">
                <button class="prev-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors focus:outline-none active:scale-90">
                    <i class="fa-solid fa-play fa-rotate-180 text-2xl"></i>
                </button>
                <button class="next-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors focus:outline-none active:scale-90">
                    <i class="fa-solid fa-play text-2xl"></i>
                </button>
            </div>
        </div>

        <div id="games-slider" class="flex w-full overflow-x-auto overflow-y-hidden scroll-smooth snap-x snap-mandatory pb-8 lg:pb-16 no-scrollbar">
            {dataToRender.map((item: any, index: number) => {

                // Manejo de imágenes (Array u Objeto)
                const imgData = Array.isArray(item.imagen) ? item.imagen[0] : item.imagen;
                const imgUrl = getStrapiUrl(imgData);
                const decoUrl = getStrapiUrl(item.imagen_decoracion);

                // Procesamiento de Rich Text para la DESCRIPCIÓN
                const descHtml = typeof item.descripcion === 'string'
                    ? `<p>${item.descripcion}</p>`
                    : stringifyRichText(item.descripcion);

                return (
                    <div class="w-full min-w-full shrink-0 snap-center relative flex justify-center" data-index={index}>

                        <div class="w-full grid grid-cols-1 lg:grid-cols-[1.4fr_1fr] gap-y-2 lg:gap-x-12 items-start">

                            {/* COLUMNA IZQUIERDA: IMAGEN Y TÍTULO */}
                            <div class="order-1 relative group flex flex-col">

                                <h3 class="font-(family-name:--font-titling-gothic-fb-extended-bold) font-bold text-2xl lg:text-4xl mb-5 uppercase text-[var(--accent-feedback-strong)] leading-none text-left w-full whitespace-nowrap lg:w-auto">
                                    {item.titulo}
                                </h3>

                                <div class="w-full aspect-[4/3] lg:aspect-[4/3] relative z-10 bg-[var(--surface-brand-primary)]">
                                    <Image
                                        src={imgUrl || "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo"}
                                        alt={item.titulo}
                                        class="w-full h-full object-cover"
                                        width={1000}
                                        height={600}
                                    />
                                </div>

                                {decoUrl && (
                                    <div class="hidden lg:block absolute lg:-bottom-12 lg:-right-25 z-30 pointer-events-none lg:w-[160px] lg:h-[160px]">
                                        <Image
                                            src={decoUrl}
                                            alt="Decoration"
                                            width={160}
                                            height={160}
                                            class="w-full h-full object-contain animate-pulse-slow mix-blend-screen"
                                        />
                                    </div>
                                )}
                            </div>

                            <div class="order-2 flex flex-col relative mt-4 ">
                                <div class="mb-6 grid grid-cols-2 lg:grid-cols-3 gap-x-4 gap-y-4 leading-tight text-[var(--brand-interactive-base)]">
                                    {item.Item_Estadistica && item.Item_Estadistica.length > 0 ? (
                                        item.Item_Estadistica.map((stat: Estadistica) => {

                                            const imageUrl = getStrapiUrl(stat.image);
                                            const iconHtml = stat.icono;

                                            return (
                                                <div class="flex items-center gap-1">
                                                    <div class="text-[var(--brand-interactive-base)] text-lg lg:text-lg shrink-0 flex justify-center items-center w-10 h-10">

                                                        {imageUrl ? (
                                                            <img
                                                                src={imageUrl}
                                                                alt={stat.texto || "Icon"}
                                                                class="w-full h-full object-contain"
                                                            />
                                                        ) : iconHtml ? (
                                                            <Fragment set:html={iconHtml} />
                                                        ) : (
                                                            null
                                                        )}

                                                    </div>

                                                    <div class="font-(family-name:--font-sharp-sans-bold) font-normal text-base lg:text-base whitespace-nowrap">
                                                        <span class="text-[var(--brand-interactive-base)]">{stat.texto}:</span>
                                                        <span class="text-[var(--accent-feedback-strong)] ml-1">{stat.valor}</span>
                                                    </div>
                                                </div>
                                            );
                                        })
                                    ) : (
                                        <div class="hidden"></div>
                                    )}
                                </div>
                                <div class="strapi-bullets text-[var(--accent-feedback-strong)] text-base lg:text-base font-normal leading-relaxed">
                                    <Fragment set:html={descHtml} />
                                </div>
                            </div>

                        </div>
                    </div>
                );
            })}
        </div>

        {/* Controles Escritorio */}
        <div class="hidden lg:flex justify-between items-end mt-2 lg:-mt-16 relative z-20 px-1">
            <div class="flex gap-3 pagination-dots desktop-dots items-center h-12">
                {dataToRender.map((_, index) => (
                    <button
                        class={`dot-trigger w-2 h-2 rounded-full transition-all duration-300 border border-transparent focus:outline-none ${index === 0 ? 'bg-[var(--brand-interactive-base)] scale-125' : 'bg-gray-600 hover:bg-gray-400'}`}
                        data-target={index}
                        aria-label={`Go to slide ${index + 1}`}
                    >
                    </button>
                ))}
            </div>

            <div class="flex gap-8 items-center">
                <button class="prev-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors">
                    <i class="fa-solid fa-play fa-rotate-180 text-3xl"></i>
                </button>
                <button class="next-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors">
                    <i class="fa-solid fa-play text-3xl"></i>
                </button>
            </div>
        </div>

    </div>
</section>

<script>
    // El SCRIPT se mantiene intacto ya que la lógica del slider no cambia
    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('DOMContentLoaded', initAll);

    function initAll() {
        initGameSlider();
        initObserver();
    }

    function initObserver() {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-games');
        targets.forEach(target => observer.observe(target));
    }

    function initGameSlider() {
        const slider = document.getElementById('games-slider');
        if (!slider || slider.children.length === 0) return;

        const prevBtns = document.querySelectorAll('.prev-slide');
        const nextBtns = document.querySelectorAll('.next-slide');
        const dotTriggers = document.querySelectorAll('.dot-trigger');

        let currentIndex = 0;
        const totalSlides = slider.children.length;

        const updateDotsState = (index: number) => {
            const mobileContainer = document.querySelector('.mobile-dots');
            if (mobileContainer) {
                Array.from(mobileContainer.children).forEach((dot, i) => {
                    dot.className = `w-3 h-3 rounded-full transition-colors duration-300 ${i === index ? 'bg-[var(--brand-interactive-base)]' : 'bg-gray-600'}`;
                });
            }

            const desktopContainer = document.querySelector('.desktop-dots');
            if (desktopContainer) {
                Array.from(desktopContainer.children).forEach((btn, i) => {
                    const baseClasses = "dot-trigger w-3 h-3 rounded-full transition-all duration-300 border border-transparent focus:outline-none";
                    if (i === index) {
                        btn.className = `${baseClasses} bg-[var(--brand-interactive-base)] scale-125`;
                    } else {
                        btn.className = `${baseClasses} bg-gray-600 hover:bg-gray-400`;
                    }
                });
            }
        };

        const scrollToIndex = (index: number) => {
            if (index < 0) index = totalSlides - 1;
            if (index >= totalSlides) index = 0;

            currentIndex = index;
            const slideWidth = slider.clientWidth;

            slider.scrollTo({
                left: slideWidth * index,
                behavior: 'smooth'
            });
            updateDotsState(index);
        };

        prevBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            if(btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', () => scrollToIndex(currentIndex - 1));
        });

        nextBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            if(btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', () => scrollToIndex(currentIndex + 1));
        });

        dotTriggers.forEach((trigger) => {
            trigger.addEventListener('click', (e) => {
                const button = (e.target as HTMLElement).closest('button');
                if(!button) return;
                const targetIndex = parseInt(button.dataset.target || '0');
                scrollToIndex(targetIndex);
            });
        });

        let isScrolling: ReturnType<typeof setTimeout>;
        slider.addEventListener('scroll', () => {
            window.clearTimeout(isScrolling);
            isScrolling = setTimeout(() => {
                const slideWidth = slider.clientWidth;
                const newIndex = Math.round(slider.scrollLeft / slideWidth);

                if (newIndex !== currentIndex && newIndex >= 0 && newIndex < totalSlides) {
                    currentIndex = newIndex;
                    updateDotsState(currentIndex);
                }
            }, 100);
        });
    }
</script>

<style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .strapi-bullets :global(p) { margin-bottom: 1rem; }
    .strapi-bullets :global(strong) { color: inherit; font-weight: 900; }
    .strapi-bullets :global(ul) {
        list-style: none;
        padding-left: 0;
        margin-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .strapi-bullets :global(li) {
        position: relative;
        padding-left: 1.25rem;
        font-weight: 500;
        line-height: 1.375;
        letter-spacing: 0.025em;
    }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .anim-fade { opacity: 0; }
    :global(.trigger-anim-games.is-visible) .anim-fade {
        animation: fadeInUp 3s ease-out forwards;
    }
</style>