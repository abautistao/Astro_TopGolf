---
// src/components/toca/Component_2.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';
import Button from './elements/Button.astro';

interface Props {
    descripcion_principal: string;
    descripcion_secundaria: string;
    imagen_izquierda: any;
    imagen_derecha: any;
    boton_primario: {
        id: number;
        texto: string;
        url: string | null;
        tipo: string;
    };
    boton_secundario: {
        id: number;
        texto: string;
        url: string | null;
        tipo: string;
    };
}

const {
    descripcion_principal = "Descripcion de Ejemplo.",
    descripcion_secundaria = "Descripcion Secundaria de Ejemplo.",
    imagen_izquierda,
    imagen_derecha,
    boton_primario,
    boton_secundario
} = Astro.props;

const imgLeftUrl    = getStrapiUrl(imagen_izquierda);
const imgRightUrl   = getStrapiUrl(imagen_derecha);
const mainTextHtml  = stringifyRichText(descripcion_principal);
const secondaryTextHtml = stringifyRichText(descripcion_secundaria);
---

<section class="trigger-anim-split section-animate w-full bg-[var(--surface-brand-primary)] overflow-visible relative">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 bg-split pt-12 pb-12 lg:pt-26 lg:pb-40">
        <div class="flex flex-col lg:flex-row items-end justify-between gap-8 lg:gap-4 lg:max-w-[50vw] lg:mx-auto ">

            <div class="image-left hidden lg:flex w-full lg:w-1/4 justify-center lg:justify-end order-2 lg:order-1 -mb-12 lg:-mb-24 z-30 absolute left-0 2xl:left-[10%]">
                 <Image
                    src={imgLeftUrl || "https://placehold.co/100x720/2d3748/ffffff?text=Imagen+Fondo"}
                    alt="Playing"
                    class="w-full"
                    inferSize={true}
                />
            </div>

            <div class="w-full text-center flex flex-col items-center justify-center order-1 lg:order-2 z-20 mb-0 lg:mb-0 pb-0 lg:pb-0">

                <div class="prose font-(family-name:--font-sharp-sans-bold) font-bold text-[var(--surface-brand-primary)] text-base md:text-base mb-4 mx-auto px-8 lg:px-12 text-center">
                    <Fragment set:html={mainTextHtml} />
                </div>
                
                <div class="w-full">
                    <Button
                        botones={[boton_primario, boton_secundario].filter(Boolean)}
                        clase="flex flex-row gap-4 sm:gap-6 justify-center items-center flex-wrap sm:flex-nowrap mb-6"
                    />
                </div>

                <div class="font-(family-name:--font-sharp-sans-medium) font-normal text-[var(--surface-brand-primary)] text-base md:text-sm mb-4 mx-auto px-8 lg:px-20 text-center">
                    <Fragment set:html={secondaryTextHtml} />
                </div>
            </div>
            <div class="image-right hidden lg:flex w-full lg:w-1/4 justify-center lg:justify-start order-3 -mb-12 lg:-mb-24 z-30 absolute right-0 2xl:right-[10%]">
                <Image
                    src={imgRightUrl || "https://placehold.co/100x720/2d3748/ffffff?text=Imagen+Fondo"}
                    alt="Dining"
                    class="w-full "
                    inferSize={true}
                    loading="lazy"
                />
            </div>

        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.2 // Se activa cuando el 20% es visible
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-split');
        targets.forEach(target => observer.observe(target));
    });
</script>

<style>
    .bg-split {
        background-color: var(--surface-brand-secondary);
    }

    @media (min-width: 1024px) {
        .bg-split {
            background: linear-gradient(to bottom, var(--surface-brand-secondary) 85%, var(--surface-brand-primary) 85%);
        }
    }

    .image-left, .image-right{ 
        border: 6px solid var(--surface-brand-primary);
        object-fit: contain;
        min-width: 200px;
        max-width: 280px;
        top: 50%;
        margin-top: -204px;
     }


    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .section-animate {
        opacity: 0;
    }

    .section-animate.is-visible {
        animation: fadeInUp 0.8s ease-out forwards;
    }

    .prose :global(h3) {
        font-family: var(--font-titling-gothic-fb-extended-bold);
        text-transform: uppercase;
        font-size: 1.15rem;
        margin-bottom: 2rem;
    }

    .prose :global(em) {
        font-family: var(--font-sharp-sans-medium-italic);
        font-size: .8rem;
    }
</style>