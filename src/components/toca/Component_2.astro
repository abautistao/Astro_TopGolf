---
// src/components/toca/Component_2.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';
import Button from './elements/Button.astro';

interface Props {
    descripcion_principal: string;
    descripcion_secundaria: string;
    imagen_izquierda: any;
    imagen_derecha: any;
    boton_primario: {
        id: number;
        texto: string;
        url: string | null;
        tipo: string;
    };
    boton_secundario: {
        id: number;
        texto: string;
        url: string | null;
        tipo: string;
    };
}

const {
    descripcion_principal = "Descripcion de Ejemplo.",
    descripcion_secundaria = "Descripcion Secundaria de Ejemplo.",
    imagen_izquierda,
    imagen_derecha,
    boton_primario,
    boton_secundario
} = Astro.props;

const imgLeftUrl    = getStrapiUrl(imagen_izquierda);
const imgRightUrl   = getStrapiUrl(imagen_derecha);
const mainTextHtml  = stringifyRichText(descripcion_principal);
const secondaryTextHtml = stringifyRichText(descripcion_secundaria);
---

<section class="trigger-anim-split section-animate w-full bg-split pt-12 pb-12 lg:pt-5 lg:pb-28 overflow-visible relative">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6">
        <div class="flex flex-col lg:flex-row items-end justify-between gap-8 lg:gap-4">

            <div class="hidden lg:flex w-full lg:w-1/4 justify-center lg:justify-end order-2 lg:order-1 -mb-12 lg:-mb-24 z-30 relative">
                <div class="photo-card rotate-card-left">
                    <div class="bg-[var(--surface-brand-primary)] border-2 border-[var(--surface-brand-primary)] shadow-xl">
                        <div class="overflow-hidden aspect-[3/4] relative w-[260px] sm:w-[300px]">
                            <Image
                                src={imgLeftUrl || "https://placehold.co/100x720/2d3748/ffffff?text=Imagen+Fondo"}
                                alt="Playing"
                                class="w-full h-full object-cover"
                                width={400}
                                height={600}
                            />
                        </div>
                    </div>
                </div>
            </div>

            <div class="w-full lg:w-2/4 text-center flex flex-col items-center justify-center order-1 lg:order-2 z-20 mb-0 lg:mb-0 pb-0 lg:pb-0">

                <div class="font-(family-name:--font-sharp-sans-bold) font-bold text-[var(--surface-brand-primary)] text-base md:text-base mb-4 max-w-xl mx-auto px-8 lg:px-20 text-center">
                    <Fragment set:html={mainTextHtml} />
                </div>

                <div class="font-(family-name:--font-sharp-sans-medium) font-normal text-[var(--surface-brand-primary)] text-base md:text-base mb-4 max-w-xl mx-auto px-8 lg:px-20 text-center">
                    <Fragment set:html={secondaryTextHtml} />
                </div>

                <Button
                    botones={[boton_primario, boton_secundario].filter(Boolean)}
                    clase="flex flex-row gap-4 sm:gap-6 w-full md:w-1/2 justify-center items-center flex-wrap sm:flex-nowrap"
                />
            </div>
            <div class="hidden lg:flex w-full lg:w-1/4 justify-center lg:justify-start order-3 -mb-12 lg:-mb-24 z-30 relative">
                <div class="photo-card rotate-card-right">
                    <div class="bg-[var(--surface-brand-primary)] border-2 border-[var(--surface-brand-primary)] shadow-xl">
                        <div class="overflow-hidden aspect-[3/4] relative w-[260px] sm:w-[300px]">
                            <Image
                                src={imgRightUrl || "https://placehold.co/100x720/2d3748/ffffff?text=Imagen+Fondo"}
                                alt="Dining"
                                class="w-full h-full object-cover"
                                width={400}
                                height={600}
                                inferSize={true}
                                loading="lazy"
                            />
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.2 // Se activa cuando el 20% es visible
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-split');
        targets.forEach(target => observer.observe(target));
    });
</script>

<style>
    .bg-split {
        background-color: var(--surface-brand-secondary);
    }

    @media (min-width: 1024px) {
        .bg-split {
            background: linear-gradient(to bottom, var(--surface-brand-secondary) 85%, var(--surface-brand-primary) 85%);
        }
    }

    .rotate-card-left { transform: rotate(-6deg); }
    .rotate-card-right { transform: rotate(6deg); }


    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .section-animate {
        opacity: 0;
    }

    .section-animate.is-visible {
        animation: fadeInUp 0.8s ease-out forwards;
    }
</style>