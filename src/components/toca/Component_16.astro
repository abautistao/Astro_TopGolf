---
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi";
import "swiper/css";
import "swiper/css/navigation";

// Fallback data
const fallbackItems = [
    {
        titulo: "PACKAGES FOR THE SQUAD",
        descripcion: "Fuel your game with our pre-ordered food & drink packages. The perfect way to kick things off, and make sure you stay 'hydrated'.",
        imagen: { data: { attributes: { url: "https://placehold.co/600x600" } } },
        boton_texto: "PACKAGES MENU",
        boton_url: "#"
    },
    {
        titulo: "HYDRATION MENU",
        descripcion: "Our menu includes iced teas, coffees, Matchas, and milkshakes – the perfect mix for catching up, cooling down, and keeping the vibes high.",
        imagen: { data: { attributes: { url: "https://placehold.co/600x600" } } },
        boton_texto: "HYDRATION MENU",
        boton_url: "#"
    },
    {
        titulo: "HAPPIEST MEALS",
        descripcion: "Our Little Ballers food and drink menu is the perfect way to fuel, delight, and keep our younger players energised, crafted exclusively with them in mind.",
        imagen: { data: { attributes: { url: "https://placehold.co/600x600" } } },
        boton_texto: "KID'S MENU",
        boton_url: "#"
    }
];

interface Props {
    items: any[];
}

const { items = [] } = Astro.props;
const dataToShow = items.length > 0 ? items : fallbackItems;
---

<section class="w-full bg-[var(--surface-brand-primary)] py-12 lg:py-20 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
        
        <!-- Swiper Container -->
        <div class="swiper swiper-component-16 relative">
            <div class="swiper-wrapper lg:grid lg:grid-cols-3 lg:gap-8">
                {dataToShow.map((item, index) => {
                     const imageUrl = getStrapiUrl(item.imagen);
                     const descripcionHtml = stringifyRichText(item.descripcion);

                     return (
                        <div class="swiper-slide h-auto flex flex-col">
                            <!-- Helper container for alignment -->
                            <div class="flex flex-col h-full w-full">
                                
                                <!-- Header (Title & Desc) -->
                                <div class="text-center mb-6 lg:mb-8 flex-grow-0">
                                    <h3 class="text-white text-2xl lg:text-3xl font-bold uppercase mb-4 font-(family-name:--font-titling-gothic-fb-extended-bold) leading-tight min-h-[3rem] flex items-center justify-center">
                                        {item.titulo}
                                    </h3>
                                    <div class="text-[var(--brand-interactive-base)] text-sm lg:text-base font-(family-name:--font-sharp-sans-medium) leading-relaxed opacity-90 min-h-[5rem]">
                                         <Fragment set:html={descripcionHtml} />
                                    </div>
                                </div>

                                <!-- Image -->
                                <div class="w-full aspect-square relative rounded-xl overflow-hidden mb-6 lg:mb-8 shrink-0">
                                    <Image 
                                        src={imageUrl || "https://placehold.co/600x600"} 
                                        alt={item.titulo} 
                                        inferSize={true}
                                        class="w-full h-full object-cover"
                                    />
                                    
                                    <!-- Mobile Overlay Icon or Decor could go here if needed -->
                                </div>

                                <!-- Button -->
                                <div class="mt-auto">
                                    <a href={item.boton_url || "#"} class="block w-full text-center bg-[var(--brand-interactive-base)] text-black font-bold uppercase py-3 text-lg lg:text-xl font-(family-name:--font-titling-gothic-fb-extended-bold) hover:opacity-90 transition-opacity">
                                        {item.boton_texto}
                                        <!-- Download Icon can be added via CSS or SVG if needed -->
                                    </a>
                                </div>

                            </div>
                        </div>
                     )
                })}
            </div>

            <!-- Mobile Custom Navigation Arrows -->
            <div class="flex lg:hidden justify-end items-center gap-4 mt-8">
                <button class="swiper-button-prev-c16 text-[var(--brand-interactive-base)] hover:text-white transition-colors">
                     <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button class="swiper-button-next-c16 text-[var(--brand-interactive-base)] hover:text-white transition-colors">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            </div>

        </div>

    </div>
</section>

<script>
    import Swiper from "swiper";
    import { Navigation } from "swiper/modules";

    document.addEventListener("astro:page-load", () => {
        initSwiper();
    });

    // Fallback for non-view-transitions
    if (!document.startViewTransition) {
        initSwiper();
        document.addEventListener("DOMContentLoaded", initSwiper);
    }

    function initSwiper() {
        // Destroy existing instance if any (to prevent duplicates on navigation)
        const existingSwiper = document.querySelector('.swiper-component-16')?.swiper;
        if (existingSwiper) existingSwiper.destroy();

        const swiperEl = document.querySelector(".swiper-component-16");
        if (!swiperEl) return;

        /**
         * Logic: 
         * Mobile (< 1024px): Initialize Swiper.
         * Desktop (>= 1024px): "Unset" swiper or ensure grid layout works.
         * Actually, we can just init swiper but with 'enabled' breakpoint.
         */
        
        new Swiper(swiperEl, {
            modules: [Navigation],
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true,
            navigation: {
                nextEl: ".swiper-button-next-c16",
                prevEl: ".swiper-button-prev-c16",
            },
            breakpoints: {
                1024: {
                    enabled: false, // Disable swiper on desktop to let CSS Grid take over
                    slidesPerView: 3,
                    spaceBetween: 0
                }
            }
        });
    }
</script>

<style>
    /* 
       When Swiper is disabled (Desktop), we need to ensure the wrapper 
       behaves like a normal Grid container. 
       Swiper adds 'display: flex' to wrapper by default.
    */
    @media (min-width: 1024px) {
        .swiper-wrapper {
            display: grid !important; 
            /* grid-template-columns: repeat(3, 1fr);  <-- handled by Tailwind classes lg:grid lg:grid-cols-3 */
            transform: none !important; /* Remove swiper translate */
            width: 100% !important;
        }
        .swiper-slide {
            width: auto !important;
            margin-right: 0 !important;
        }
    }
</style>
