---
// src/components/toca/elements/SplitSection.astro
import Button from './Button.astro';
import { Image } from 'astro:assets';

interface Props {
    titulo: string;
    htmlContent: string;
    imgUrl: string;
    imgAlt: string;
    botonData: any[] | null;
    tipo: 'version_1' | 'version_2';
}

const {
    titulo,
    htmlContent,
    imgUrl,
    imgAlt,
    botonData,
    tipo = 'version_2' // Por defecto
} = Astro.props;

// --- LÓGICA DE IMAGEN DEFAULT ---
// Usamos la URL que proporcionaste como imagen de respaldo
const DEFAULT_IMAGE = "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo";

// Si imgUrl es nulo, indefinido o vacío, se usa DEFAULT_IMAGE
const finalImgUrl = imgUrl || DEFAULT_IMAGE;
const finalImgAlt = imgAlt || "Imagen por defecto";

// --- DICCIONARIO DE ESTILOS ---
const configs = {
    version_1: {
    // (Rosa)
    bg: 'bg-[var(--surface-brand-secondary)]',
    textTitle: 'text-[var(--surface-brand-primary)]',
    textContent: 'text-[var(--surface-brand-primary)]',
    direction: 'md:flex-row',         // Img a la derecha
    textPadding: 'md:pl-20 md:pr-10', // Padding normal
    showDecoration: true
    },
    version_2: {
        // (Azul Oscuro)
        bg: 'bg-[var(--surface-brand-primary)]',
        textTitle: 'text-[var(--accent-feedback-strong)]',
        textContent: 'text-[var(--accent-feedback-strong)]',
        direction: 'md:flex-row-reverse', // Img a la izquierda
        textPadding: 'md:pr-20 md:pl-10', // Padding invertido
        showDecoration: false
    }
};

// Safety check: si el tipo no existe, usa version_1
const currentStyle = configs[tipo] || configs.version_1;
---

<section class={`flex flex-col w-full overflow-hidden ${currentStyle.direction} ${currentStyle.bg}`}>

  {/* LADO DE TEXTO */}
    <div class={`w-full md:w-1/2 flex flex-col justify-center items-start py-12 px-8 z-10 ${currentStyle.textPadding}`}>

        <h2 class={`${currentStyle.textTitle} font-bold uppercase text-4xl md:text-5xl leading-none mb-5 tracking-wide`}>
        {titulo}
        </h2>

        <div class={`${currentStyle.textContent} text-base font-medium leading-relaxed mb-8 max-w-lg [&>p]:mb-4 [&>p:last-child]:mb-0`}>
        <Fragment set:html={htmlContent} />
        </div>

        {botonData && (
        <Button
            botones={botonData}
            clase="flex items-center"
        />
        )}
    </div>

  {/* LADO DE IMAGEN */}
    <div class="w-full md:w-1/2 flex justify-center items-center p-8 md:p-12 relative">
        <div class="relative w-full max-w-md">

        {currentStyle.showDecoration && (
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full -z-10 flex items-center justify-center pointer-events-none">
            <img
                src="https://media.graphassets.com/D9j8kF5sRny1q7gXwZ0A"
                alt="Decoration"
                class="w-[140%] max-w-none h-auto animate-[spin_10s_linear_infinite] opacity-80 mix-blend-screen"
            />
            </div>
        )}

        {/* Usamos la variable finalImgUrl que calculamos arriba */}
        <Image
            src={finalImgUrl}
            alt={finalImgAlt}
            class="w-full aspect-[3/2] object-cover relative z-10 shadow-lg"
            inferSize={true}
        />
        </div>
    </div>

</section>