---
// src/components/toca/elements/EventCard.astro
import { getStrapiUrl, stringifyRichText } from '../../../lib/strapi.js';

export interface Props {
    evento: any;
    tipo?: 'version_1' | 'version_2';
}

const { evento, tipo = 'version_1' } = Astro.props;
const PLACEHOLDER_IMG = "https://placehold.co/600x750/2d3748/ffffff?text=Event";

const descHtml = typeof evento.descripcion === 'string'
    ? evento.descripcion
    : stringifyRichText(evento.descripcion);

const finalImgUrl = getStrapiUrl(evento.imagen) || PLACEHOLDER_IMG;

// Definir la URL de destino.
const eventLink = evento.slug ? `/eventos/${evento.slug}` : '#';

const theme = {
    v1: { text: 'text-[var(--surface-brand-secondary)]', bg: 'bg-[var(--surface-brand-primary)]' },
    v2: { text: 'text-[var(--brand-interactive-base)]', bg: 'bg-[var(--surface-brand-secondary)]' }
};
const currentTheme = tipo === 'version_1' ? theme.v1 : theme.v2;
---

<article class="snap-center flex flex-col h-full group w-full">
    <a href={eventLink} class:list={[
        "block w-full relative overflow-hidden mb-2",
        currentTheme.bg,
        tipo === 'version_1' ? 'aspect-[4/5]' : 'aspect-[3/2]',
        "transition-all duration-300 ease-out cursor-pointer group-hover:-translate-y-3 group-hover:scale-[1.01]"
    ]}>
        <img
            src={finalImgUrl}
            alt={evento.titulo}
            class="w-full h-full object-cover"
            onerror={`this.onerror=null; this.src='${PLACEHOLDER_IMG}';`}
        />
    </a>

    <div class="flex flex-col flex-grow font-(family-name:--font-sharp-sans-medium)">
        <h3 class:list={["text-base font-bold uppercase mb-1 font-(family-name:--font-titling-gothic-fb-extended-bold)", currentTheme.text]}>
            <a href={eventLink} class="hover:underline">
                {evento.titulo}
            </a>
        </h3>
        <div class="font-(family-name:--font-sharp-sans-medium) text-base font-medium mb-2 line-clamp-3 leading-relaxed text-[var(--accent-feedback-strong)]">
            <span set:html={descHtml} />
        </div>
        <a
            href={eventLink}
            class:list={["text-base font-medium self-start text-left transition-colors font-(family-name:--font-sharp-sans-medium) hover:underline", currentTheme.text]}
        >
            Leer más...
        </a>
    </div>
</article>