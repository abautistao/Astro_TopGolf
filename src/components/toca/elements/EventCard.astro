---
// src/components/toca/elements/EventCard.astro
import { getStrapiUrl, stringifyRichText } from '../../../lib/strapi.js';

export interface Props {
    evento: any;
    tipo?: 'version_1' | 'version_2';
}

const { evento, tipo = 'version_1' } = Astro.props;
const PLACEHOLDER_IMG = "https://placehold.co/600x750/2d3748/ffffff?text=Event";

const descHtml = typeof evento.descripcion === 'string'
    ? evento.descripcion
    : stringifyRichText(evento.descripcion);

const finalImgUrl = getStrapiUrl(evento.imagen) || PLACEHOLDER_IMG;

const theme = {
    v1: { text: 'text-[var(--surface-brand-secondary)]', bg: 'bg-[var(--surface-brand-primary)]' },
    v2: { text: 'text-[var(--brand-interactive-base)]', bg: 'bg-[var(--surface-brand-secondary)]' }
};
const currentTheme = tipo === 'version_1' ? theme.v1 : theme.v2;
---

<article class="snap-center flex flex-col h-full group w-full">
    <div class:list={["w-full relative overflow-hidden mb-2", currentTheme.bg, tipo === 'version_1' ? 'aspect-[4/5]' : 'aspect-[3/2]']}>
        <img
            src={finalImgUrl}
            alt={evento.titulo}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            onerror={`this.onerror=null; this.src='${PLACEHOLDER_IMG}';`}
        />
    </div>

    <div class="flex flex-col flex-grow">
        <h3 class:list={["text-sm font-bold uppercase mb-1 leading-tight", currentTheme.text]}>
            {evento.titulo}
        </h3>
        <div class="text-sm font-bold mb-2 line-clamp-3 leading-relaxed text-[var(--accent-feedback-strong)]">
            <span set:html={descHtml} />
        </div>

        <button
            class:list={["js-trigger-modal text-sm font-medium self-start text-left transition-colors", currentTheme.text]}
            data-title={evento.titulo}
            data-image={finalImgUrl}
            data-description={descHtml}
        >
            Read more...
        </button>
    </div>
</article>