---
// src/components/toca/elements/Button.astro
import { formatUrl } from '../../../lib/strapi';

export interface Boton {
    id: number;
    texto: string;
    url: string;
    tipo: 'version_1' | 'version_2' | 'version_3' | 'version_4';
}

export interface Props {
    botones: Boton[];
    clase?: string;
    tamanoTexto?: string; // Nueva propiedad opcional
}

const {
    botones,
    clase = "flex items-center",
    tamanoTexto = "text-sm"
} = Astro.props;
---

<div class={clase}>
    {botones.map(boton => (
        <a
            href={formatUrl(boton.url)}
            class:list={[
                'max-w-1/4 font-(family-name:--font-titling-gothic-fb-extended-bold) block border-2 border-(--surface-brand-primary) font-bold! uppercase! tracking-tight leading-tight',
                'transition-all duration-200 whitespace-normal text-center! max-w-full break-words',
                tamanoTexto,
                'px-4! py-2! md:px-6! md:py-2!',
                'shadow-[3px_3px_0px_0px_black] md:shadow-[4px_4px_0px_0px_black]',
                'active:translate-x-[2px] active:translate-y-[2px] active:shadow-none',
                'hover:md:translate-x-[1px] hover:md:translate-y-[1px]',
                'hover:md:shadow-[2px_2px_0px_0px_black]',

                // --- Variantes de Color (Tipos) ---
                {
                    // Version 1: El clásico "BOOK NOW" rosa
                    'bg-(--surface-brand-secondary)! text-(--surface-brand-primary)! hover:bg-(--surface-brand-secondary)!': boton.tipo === 'version_1' || !boton.tipo,

                    // Version 2: Variante oscura (Fondo negro, texto blanco)
                    'bg-(--surface-brand-primary)! text-(--accent-feedback-strong)! hover:bg-(--surface-brand-primary)! hover:text-(--surface-brand-secondary)!': boton.tipo === 'version_2',

                    // Version 3: Solo borde (Fondo blanco/transparente)
                    'bg-(--brand-interactive-base)! text-(--surface-brand-primary)! hover:bg-(--brand-interactive-base)!': boton.tipo === 'version_3',

                    // Version 4: Estilo "KIDS MENU" (Fondo Blanco Puro, Texto Primary)
                    'bg-(--accent-feedback-strong)! text-(--surface-brand-primary)! hover:bg-(--accent-feedback-strong)! hover:text-(--surface-brand-primary)!': boton.tipo === 'version_4',
                }
            ]}
            set:html={boton.texto}
        >
        </a>
    ))}
</div>