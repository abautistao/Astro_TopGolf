---
// src/components/toca/elements/Button.astro
import { formatUrl } from '../../../lib/strapi';

export interface Boton {
    id: number;
    texto: string;
    url: string;
    tipo: 'version_1' | 'version_2' | 'version_3' | 'version_4';
}

export interface Props {
    botones: Boton[];
    clase?: string;
}

const {
    botones,
    clase = "flex items-center"
} = Astro.props;
---

<div class={clase}>
    {botones.map(boton => (
        <a
            href={formatUrl(boton.url)}
            class:list={[
                // --- Estilos Base (Tipografía, Bordes, Animación) ---
                // CAMBIO: 'leading-none' a 'leading-tight' para que no se peguen las líneas si hace salto de línea
                'inline-block border-2 border-[var(--surface-brand-primary)] font-black uppercase tracking-tight leading-tight',

                // CAMBIO: Quitamos 'whitespace-nowrap' y agregamos 'whitespace-normal text-center max-w-full'
                // Esto permite que el texto baje y se centre si es muy largo
                'transition-all duration-200 whitespace-normal text-center max-w-full break-words',

                // --- Tamaños Responsivos (Móvil vs Desktop) ---
                // Ajustado para que se vea bien en el header (más pequeño en móvil)
                'px-4 py-2 text-lg md:px-6 md:py-2 md:text-xl',

                // --- Sombras Duras (Hard Shadows) ---
                'shadow-[3px_3px_0px_0px_black] md:shadow-[4px_4px_0px_0px_black]',

                // --- Efectos Hover/Active (Presionar botón) ---
                'active:translate-x-[2px] active:translate-y-[2px] active:shadow-none',
                'hover:md:translate-x-[1px] hover:md:translate-y-[1px]',
                'hover:md:shadow-[2px_2px_0px_0px_black]',

                // --- Variantes de Color (Tipos) ---
                {
                    // Version 1: El clásico "BOOK NOW" rosa
                    'bg-[var(--surface-brand-secondary)] text-[var(--surface-brand-primary)] hover:bg-[var(--surface-brand-secondary)]': boton.tipo === 'version_1' || !boton.tipo,

                    // Version 2: Variante oscura (Fondo negro, texto blanco)
                    'bg-[var(--surface-brand-primary)] text-[var(--accent-feedback-strong)] hover:bg-[var(--surface-brand-primary)] hover:text-[var(--surface-brand-secondary)]': boton.tipo === 'version_2',

                    // Version 3: Solo borde (Fondo blanco/transparente)
                    'bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)] hover:bg-[var(--brand-interactive-base)]': boton.tipo === 'version_3',

                    // Version 4: Estilo "KIDS MENU" (Fondo Blanco Puro, Texto Primary)
                    'bg-[var(--accent-feedback-strong)] text-[var(--surface-brand-primary)] hover:bg-[var(--accent-feedback-strong)] hover:text-[var(--surface-brand-primary)]': boton.tipo === 'version_4',
                }
            ]}
            set:html={boton.texto}
        >
        </a>
    ))}
</div>