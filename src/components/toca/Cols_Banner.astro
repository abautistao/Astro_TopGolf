---
import { stringifyRichText } from "../../lib/strapi";
import type { Boton } from "./elements/Button.astro";
import Button from "./elements/Button.astro";

export interface Props {
    color_fondo?: string;
    card_1_color_fondo?: string;
    card_title_1?: string;
    card_title_1_color?: any;
    card_description_1?: any[];
    card_description_1_color?: any[];
    card_subtitle_1?: string;
    card_subtitle_1_color?: string;
    card_1_Boton?: Boton[];
    card_2_color_fondo?: string;
    card_title_2?: string;
    card_title_2_color?: any;
    card_description_2?: any[];
    card_description_2_color?: any[];
    card_subtitle_2?: string;
    card_subtitle_2_color?: string;
    card_2_Boton?: Boton[];
    is_full_width: boolean;
}

const {
    color_fondo,
    card_1_color_fondo,
    card_title_1,
    card_title_1_color,
    card_description_1,
    card_description_1_color,
    card_subtitle_1,
    card_subtitle_1_color,
    card_1_Boton,
    card_2_color_fondo,
    card_title_2,
    card_title_2_color,
    card_description_2,
    card_description_2_color,
    card_subtitle_2,
    card_subtitle_2_color,
    card_2_Boton,
    is_full_width

} = Astro.props;


console.log(is_full_width)
---
<section 
    class="colsBanner bg-(--surface-brand-secondary)" 
    class:list={[
        {
            'py-8' : !is_full_width
        }
    ]}
    style={!is_full_width && color_fondo ? `background-color: ${color_fondo}`: ""}>
    <div class={!is_full_width ? "container mx-auto px-4 md:px-0" : ""}>
        <div 
            class="w-full grid md:grid-cols-2"
            class:list={[
                {
                    'gap-8' : !is_full_width
                }
            ]}
            >
            <div class="colsBanner-card1 font-(family-name:--font-titling-gothic-fb-extended-bold)! text-(--surface-brand-primary) p-6 flex flex-col gap-4" style={is_full_width && card_1_color_fondo ? `background-color: ${card_1_color_fondo}`: `background-color: transparent; border: 2px solid ${card_1_color_fondo}`}>
                {card_subtitle_1 && (
                    <span class="text-[12px] text-(--accent-feedback-strong)" style={is_full_width && card_title_1_color ? `color: ${card_subtitle_1_color}`: ""}>{card_subtitle_1}</span>
                )}
                
                {card_title_1 && (
                    <h2 class="text-2xl md:text-2xl text-(--accent-feedback-strong)" style={is_full_width && card_title_1_color ? `color: ${card_title_1_color}`: ""}>{card_title_1}</h2>
                )}

                {card_description_1 && (
                    <div set:html={stringifyRichText(card_description_1)} class="font-(family-name:--font-sharp-sans-medium) text-(--accent-feedback-strong) mb-4 md:mb-0" style={is_full_width && card_description_1_color ? `color: ${card_description_1_color}`: ""}></div>
                )}

                {card_1_Boton && (
                    <div class="relative animate-fade-in-up delay-300">
                        <Button botones={card_1_Boton} clase="flex flex-col md:flex-row gap-4"/>
                    </div>
                )}
            </div>

            <div class="colsBanner-card2 font-(family-name:--font-titling-gothic-fb-extended-bold)! text-(--surface-brand-primary) p-6 flex flex-col gap-4" style={is_full_width && card_2_color_fondo ? `background-color: ${card_2_color_fondo}`: `background-color: transparent; border: 2px solid ${card_2_color_fondo}`}>
                {card_subtitle_2 && (
                    <span class="text-[12px] text-(--accent-feedback-strong)" style={is_full_width && card_title_2_color ? `color: ${card_subtitle_2_color}`: ""}>{card_subtitle_2}</span>
                )}
                
                {card_title_2 && (
                    <h2 class="text-2xl md:text-2xl text-(--accent-feedback-strong)" style={is_full_width && card_title_2_color ? `color: ${card_title_2_color}`: ""}>{card_title_2}</h2>
                )}

                {card_description_2 && (
                    <div set:html={stringifyRichText(card_description_2)} class="font-(family-name:--font-sharp-sans-medium) text-(--accent-feedback-strong) mb-4 md:mb-0" style={is_full_width && card_description_2_color ? `color: ${card_description_2_color}`: ""}></div>
                )}

                {card_2_Boton && (
                    <div class="relative animate-fade-in-up delay-300">
                        <Button botones={card_2_Boton} clase="flex flex-col md:flex-row gap-4"/>
                    </div>
                )}
            </div>
        </div>
    </div>
</section>