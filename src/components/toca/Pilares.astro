---
import Pilar from "./steps/Pilar.astro";

interface Props {
    titulo_seccion?: string;
    subtitulo?: string;
    tituloHtmlTag?: string | null;
    subtituloHtmlTag?: string | null;
    color_fondo_override?: string | null;
    steps?: any[];
}

const {
    titulo_seccion = "",
    subtitulo = "",
    tituloHtmlTag = null,
    subtituloHtmlTag = null,
    color_fondo_override = null,
    steps = []
} = Astro.props;

// El editor elige en el CMS la etiqueta HTML del titulo y del subtitulo. Los
// registros ya publicados mandan `null` en los campos nuevos (no `undefined`),
// asi que el default del destructuring no se aplica: normalizamos contra una
// lista blanca y caemos en las etiquetas por defecto (h2 y p) cuando el valor
// no llega o no es valido.
const TAGS_HTML = ["h1", "h2", "h3", "h4", "h5", "h6", "span", "p"] as const;

type TagHtml = (typeof TAGS_HTML)[number];

const resolverTag = (valor: string | null | undefined, porDefecto: TagHtml): TagHtml => {
    const normalizado = (valor ?? "").trim().toLowerCase();
    return (TAGS_HTML as readonly string[]).includes(normalizado)
        ? (normalizado as TagHtml)
        : porDefecto;
};

const TituloTag = resolverTag(tituloHtmlTag, "h2");
const SubtituloTag = resolverTag(subtituloHtmlTag, "p");
---

<section class="pilares" style={color_fondo_override ? `background: ${color_fondo_override}` : undefined}>
    <div class="pilares-contenedor">
        {
            (titulo_seccion || subtitulo) && (
                <header class="pilares-encabezado">
                    {titulo_seccion && <TituloTag class="pilares-titulo">{titulo_seccion}</TituloTag>}
                    {subtitulo && <SubtituloTag class="pilares-subtitulo">{subtitulo}</SubtituloTag>}
                </header>
            )
        }

        <div class="pilares-tira">
            <div class="pilares-grid">
                {Array.isArray(steps) && steps.map((step) => <Pilar {...step} />)}
            </div>
        </div>
    </div>
</section>

<style>
    .pilares {
        background: var(--surface-brand-primary);
        padding: 3rem 1rem 4rem;
    }

    .pilares-contenedor {
        max-width: 1440px;
        margin: 0 auto;
    }

    .pilares-encabezado {
        margin-bottom: 2rem;
    }

    .pilares-titulo {
        display: block;
        margin: 0;
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        font-size: clamp(1.75rem, 4vw, 2.75rem);
        line-height: 0.95;
        text-transform: uppercase;
        color: var(--neutral-text-inverted);
    }

    .pilares-subtitulo {
        display: block;
        margin: 0.75rem 0 0;
        font-family: var(--font-sharp-sans-medium);
        font-size: 0.95rem;
        line-height: 1.45;
        color: var(--brand-interactive-base);
    }

    /* Borde exterior de la tira. */
    .pilares-tira {
        border: 2px solid var(--brand-interactive-base);
        /* El borde derecho e inferior de la ultima celda queda debajo del
           borde exterior: con el margen negativo la rejilla se sale 1px y
           overflow lo recorta. Asi la linea interior sigue siendo de 1px. */
        overflow: hidden;
    }

    .pilares-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        margin-right: -1px;
        margin-bottom: -1px;
    }

    @media (min-width: 768px) {
        .pilares-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1280px) {
        .pilares-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
</style>
