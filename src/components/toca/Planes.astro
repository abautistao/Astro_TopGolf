---
import TituloSeccion from "./cards/TituloSeccion.astro";
import CardPlan from "./cards/Plan.astro";

interface Props {
    titulo_seccion?: string;
    subtitulo?: string;
    texto_enlace?: string;
    url_enlace?: string;
    tituloHtmlTag?: string | null;
    subtituloHtmlTag?: string | null;
    color_fondo_override?: string | null;
    cards?: any[];
}

const {
    titulo_seccion = "",
    subtitulo = "",
    texto_enlace = "",
    url_enlace = "",
    tituloHtmlTag = null,
    subtituloHtmlTag = null,
    color_fondo_override = null,
    cards = []
} = Astro.props;
---

<section class="planes" style={color_fondo_override ? `background: ${color_fondo_override}` : undefined}>
    <div class="planes-contenedor">
        <TituloSeccion
            titulo={titulo_seccion}
            subtitulo={subtitulo}
            tituloTag={tituloHtmlTag}
            subtituloTag={subtituloHtmlTag}
            texto_enlace={texto_enlace}
            url_enlace={url_enlace}
        />

        <div class="planes-grid">
            {Array.isArray(cards) && cards.map((card) => <CardPlan {...card} />)}
        </div>
    </div>
</section>

<style>
    .planes {
        background: var(--neutral-background-strong);
        padding: 3rem 1rem 4rem;
    }

    .planes-contenedor {
        max-width: 1440px;
        margin: 0 auto;
    }

    .planes-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.5rem;
        margin-top: 3rem;
    }

    @media (min-width: 768px) {
        .planes-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1280px) {
        .planes-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }
    }
</style>
