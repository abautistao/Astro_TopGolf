---
// src/components/toca/Component_4.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import Button from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

interface Props {
    titulo_seccion?: string;
    titulo_header?: string;
    precio: string;
    descripcion: any;
    button: Boton | null;
    claseSection?: string;
}

const {
    titulo_seccion,
    titulo_header,
    precio = "Precio Ejemplo",
    descripcion = [],
    button = null,
    claseSection = "pt-0 pb-12 lg:py-12"
} = Astro.props;

const descripcionHtml = stringifyRichText(descripcion);

const boton_pricing: Boton[] = button
    ? [button]
    : [{
        id: 1,
        texto: "Botón 1",
        url: "#",
        tipo: 'version_1'
    }];
---

<section class={`w-full bg-[var(--surface-brand-primary)] ${claseSection}`}>
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 flex flex-col items-center justify-center">

        {titulo_seccion && (
            <h2 class="text-center font-bold text-2xl lg:text-7xl uppercase tracking-tighter text-[var(--accent-feedback-strong)] mb-8 lg:mb-10 title-extended">
                {titulo_seccion}
            </h2>
        )}

        <div class="w-full max-w-[682px] border-2 border-[var(--brand-interactive-base)] flex flex-col shadow-lg">
            {titulo_header && (
                <div class="font-(family-name:--font-titling-gothic-fb-extended-bold) w-full bg-[var(--brand-interactive-base)] py-1 text-center">
                    <h2 class="font-bold text-[var(--surface-brand-primary)] text-xl uppercase">
                        {titulo_header}
                    </h2>
                </div>
            )}

            <div class="bg-[var(--surface-brand-primary)] p-6 lg:p-4 text-center flex flex-col items-center justify-center">

                <h3 class="font-(family-name:--font-titling-gothic-fb-extended-bold) font-medium text-[var(--accent-feedback-strong)] lg:text-5xl uppercase leading-none mb-3">
                    {precio}
                </h3>

                <div class="font-(family-name:--font-sharp-sans-bold) text-[var(--brand-interactive-base)] text-base font-bold mb-6 w-full px-2 leading-tight strapi-rich-text">
                    <Fragment set:html={descripcionHtml} />
                </div>

                <div class="scale-90 lg:scale-100">
                    <Button
                        botones={boton_pricing}
                        clase="flex justify-center"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

<style>

    .strapi-rich-text :global(p) {
        margin-bottom: 0;
        color: inherit;
    }
    .strapi-rich-text :global(strong) {
        font-weight: bold;
        color: inherit;
    }
</style>