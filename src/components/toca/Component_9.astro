---
// src/components/toca/Component_9.astro
import { getStrapiUrl, stringifyRichText} from '../../lib/strapi.js';
import { Image } from 'astro:assets';

// 1. Interfaces ajustadas exactamente a tu JSON
interface TarjetaItem {
    id: number;
    titulo: string;
    descripcion: any;
    imagen: any;
    link?: string;
}

interface TarjetaWrapper {
    id: number;
    titulo_seccion: string | null;
    tarjetas: TarjetaItem[];
}

interface Props {
    tarjetas: TarjetaWrapper;
}

const { tarjetas } = Astro.props;

const sectionTitle = tarjetas?.titulo_seccion;
const tarjetasArray = tarjetas?.tarjetas || [];

const defaultCards = [
    {
        titulo: "Ejemplo 1",
        descripcion: "Description for example card 1 goes here.",
        imagen: null,
        link: "#"
    },
    {
        titulo: "Ejemplo 2",
        descripcion: "Description for example card 2 goes here.",
        imagen: null,
        link: "#"
    },
    {
        titulo: "Ejemplo 3",
        descripcion: "Description for example card 3 goes here.",
        imagen: null,
        link: "#"
    }
];

const rawData = tarjetasArray.length > 0 ? tarjetasArray : defaultCards;

const ProcessedTarjetas = rawData.slice(0, 3).map((card) => ({
    title: card.titulo,
    desc: typeof card.descripcion === 'string'
        ? card.descripcion
        : stringifyRichText(card.descripcion),
    img: getStrapiUrl(card.imagen),
    alt: card.titulo || "Toca Social",
    link: card.link || "#"
}));

---

<section class="trigger-anim-9 w-full bg-[var(--surface-brand-primary)] py-10 lg:py-16 relative">

    <div class="anim-fade max-w-[1400px] mx-auto px-4 sm:px-6 h-full">

        {sectionTitle && (
            <h2 class="font-(family-name:--font-titling-gothic-fb-extended-bold) text-[var(--accent-feedback-strong)] text-center text-2xl md:text-2xl font-bold uppercase tracking-tighter mb-8 lg:mb-12 leading-none">
                {sectionTitle}
            </h2>
        )}

        <div id="cards-container" class="lg:grid lg:grid-cols-3 lg:gap-8 h-full">

            {ProcessedTarjetas.map((item, index) => (
                <div
                    class={`carousel-item flex flex-col h-full group
                    ${index === 0 ? 'flex' : 'hidden'} lg:flex
                    transition-all duration-300 ease-out
                    cursor-pointer`}
                    data-index={index}
                >
                    <a href={item.link}>
                        <div class="w-full aspect-square relative overflow-hidden mb-6 border-2 border-transparent">
                        <Image
                            src={item.img || "https://placehold.co/600x600/2d3748/ffffff?text=Image"}
                            alt={item.alt}
                            class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
                            width={600}
                            height={600}
                            inferSize={true}
                        />
                    </div>

                    <div class="flex flex-col grow px-1">
                        <div class="flex justify-between items-start gap-2 mb-3">
                            <h3 class="font-(family-name:--font-titling-gothic-fb-extended-bold) font-bold text-[var(--brand-interactive-base)] text-base lg:text-base uppercase leading-none tracking-tighter">
                                {item.title}
                            </h3>

                            <div class="flex gap-4 lg:hidden shrink-0">
                                <button class="prev-btn text-[var(--brand-interactive-base)] hover:text-[var(--accent-feedback-strong)] transition-colors focus:outline-none">
                                    <i class="fa-solid fa-caret-left text-3xl"></i>
                                </button>
                                <button class="next-btn text-[var(--brand-interactive-base)] hover:text-[var(--accent-feedback-strong)] transition-colors focus:outline-none">
                                    <i class="fa-solid fa-caret-right text-3xl"></i>
                                </button>
                            </div>
                        </div>

                        <div class="font-(family-name:--font-sharp-sans-medium) text-[var(--accent-feedback-strong)] text-base leading-relaxed w-full strapi-rich-text mb-6">
                            <Fragment set:html={item.desc} />
                        </div>

                        <a
                            href={item.link}
                            class="font-(family-name:--font-sharp-sans-medium) mt-auto text-[var(--surface-brand-secondary)] hover:text-[var(--accent-feedback-strong)] font-bold text-base transition-colors inline-block"
                        >
                            Leer más...
                        </a>
                    </div>
                    </a>
                    
                </div>
            ))}

        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('DOMContentLoaded', initAll);

    function initAll() {
        initCarousel();
        initObserver();
    }

    // Animación de entrada (Fade In Up)
    function initObserver() {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-9');
        targets.forEach(target => observer.observe(target));
    }

    // Funcionalidad del Carrusel Móvil
    function initCarousel() {
        const items = document.querySelectorAll('.carousel-item');
        const prevBtns = document.querySelectorAll('.prev-btn');
        const nextBtns = document.querySelectorAll('.next-btn');
        let currentIndex = 0;
        const totalItems = items.length;

        if(totalItems === 0) return;

        function showItem(index) {
            items.forEach((item, i) => {
                item.classList.remove('flex');
                item.classList.add('hidden');

                if (i === index) {
                    item.classList.remove('hidden');
                    item.classList.add('flex');
                }
            });
        }

        function nextSlide() {
            currentIndex = (currentIndex + 1) % totalItems;
            showItem(currentIndex);
        }

        function prevSlide() {
            currentIndex = (currentIndex - 1 + totalItems) % totalItems;
            showItem(currentIndex);
        }

        nextBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            if(btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                nextSlide();
            });
        });

        prevBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            if(btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                prevSlide();
            });
        });
    }
</script>

<style>
    .strapi-rich-text :global(p) {
        margin-bottom: 0;
        color: inherit;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .anim-fade {
        opacity: 0;
    }

    :global(.trigger-anim-9.is-visible) .anim-fade {
        animation: fadeInUp 2s ease-out forwards;
    }
</style>