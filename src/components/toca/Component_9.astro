---
// src/components/toca/Component_9.astro
import { getStrapiUrl } from '../../lib/strapi.js';

// --- INTERFACES ---
interface SlideData {
    id: number;
    titulo: string;
    imagen: any;
}

interface Props {
    carrusel_imagen: SlideData[];
}

const { carrusel_imagen = [] } = Astro.props;

const defaultSlides = [
    {
        titulo: "FUN NIGHTS OUT",
        imagen: { url: "https://placehold.co/1920x1080/050220/5dfbc4?text=Fun+Nights" }
    },
    {
        titulo: "WITH FRIENDS",
        imagen: { url: "https://placehold.co/1920x1080/1a0b40/5dfbc4?text=With+Friends" }
    }
];

const rawData = carrusel_imagen.length > 0 ? carrusel_imagen : defaultSlides;

// --- PROCESAMIENTO ---
const ProcessedSlides = rawData.map((item) => {
    let imgRaw = item.imagen;
    if (Array.isArray(imgRaw) && imgRaw.length > 0) imgRaw = imgRaw[0];

    const finalUrl = getStrapiUrl(imgRaw) || "";

    return {
        id: item.id,
        title: item.titulo || "",
        img: finalUrl,
        alt: item.titulo || "Slider Image"
    };
}).filter(slide => slide.img !== "");

const componentId = `slider-${Math.random().toString(36).substring(2, 9)}`;
---

<section
    class="w-full bg-[var(--surface-brand-primary)] py-6 px-4 md:px-10 relative group"
    data-id={componentId}
    data-slides={JSON.stringify(ProcessedSlides)}
>
    <div class="max-w-[1400px] mx-auto">

        <div class="flex flex-col md:flex-row justify-between items-end mb-4 gap-4 min-h-[3rem]">

            <h2
                id={`title-${componentId}`}
                class="text-white font-bold uppercase text-3xl md:text-5xl tracking-widest leading-none transition-opacity duration-300 w-full md:w-auto text-left"
            >
                {ProcessedSlides[0]?.title}
            </h2>

            <div class="flex gap-4 shrink-0">
                <button id={`prev-${componentId}`} class="prev-btn text-[var(--brand-interactive-base)] hover:text-[var(--accent-feedback-strong)] transition-colors focus:outline-none p-1">
                    <i class="fa-solid fa-caret-left text-4xl leading-none"></i>
                </button>

                <button id={`next-${componentId}`} class="next-btn text-[var(--brand-interactive-base)] hover:text-[var(--accent-feedback-strong)] transition-colors focus:outline-none p-1">
                    <i class="fa-solid fa-caret-right text-4xl leading-none"></i>
                </button>
            </div>
        </div>

        <div class="relative w-full aspect-[2/1] md:aspect-[21/8] overflow-hidden bg-black">

            <div
                id={`track-${componentId}`}
                class="flex h-full transition-transform duration-500 ease-out will-change-transform"
            >
                {ProcessedSlides.map((slide) => (
                    <div class="w-full h-full flex-shrink-0 relative">
                        <img
                            src={slide.img}
                            alt={slide.alt}
                            class="w-full h-full object-cover"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#050220]/50 to-transparent pointer-events-none"></div>
                    </div>
                ))}
            </div>

            <div class="absolute bottom-6 left-0 w-full flex justify-center gap-3 z-20">
                {ProcessedSlides.map((_, index) => (
                    <button
                        data-index={index}
                        class={`dot-btn w-3 h-3 rounded-full transition-all duration-300 border border-transparent ${index === 0 ? 'bg-[#5DFBC4] scale-125' : 'bg-gray-600 hover:bg-gray-400'}`}
                    ></button>
                ))}
            </div>

        </div>
    </div>

</section>

<script define:vars={{ componentId }}>
    function initSlider() {
        const section = document.querySelector(`section[data-id="${componentId}"]`);
        if (!section) return;

        // Elementos DOM
        const track = document.getElementById(`track-${componentId}`);
        const titleEl = document.getElementById(`title-${componentId}`);
        const prevBtn = document.getElementById(`prev-${componentId}`);
        const nextBtn = document.getElementById(`next-${componentId}`);
        const dots = section.querySelectorAll('.dot-btn');

        let slidesData = [];
        try {
            slidesData = JSON.parse(section.dataset.slides);
        } catch (error) {
            console.error("Error al leer datos del slider:", error);
            return;
        }

        let currentIndex = 0;
        const totalItems = slidesData.length;

        if (totalItems === 0) return;

        function showSlide(index) {
            if (track) {
                track.style.transform = `translateX(-${index * 100}%)`;
            }

            if (titleEl) {
                titleEl.style.opacity = '0';
                setTimeout(() => {
                    titleEl.textContent = slidesData[index].title;
                    titleEl.style.opacity = '1';
                }, 200);
            }

            dots.forEach((dot, i) => {
                if (i === index) {
                    dot.classList.remove('bg-gray-600', 'hover:bg-gray-400');
                    dot.classList.add('bg-[#5DFBC4]', 'scale-125');
                } else {
                    dot.classList.add('bg-gray-600', 'hover:bg-gray-400');
                    dot.classList.remove('bg-[#5DFBC4]', 'scale-125');
                }
            });
        }

        function nextSlide() {
            currentIndex = (currentIndex + 1) % totalItems;
            showSlide(currentIndex);
        }

        function prevSlide() {
            currentIndex = (currentIndex - 1 + totalItems) % totalItems;
            showSlide(currentIndex);
        }

        if (nextBtn) {
            nextBtn.onclick = (e) => {
                e.preventDefault();
                nextSlide();
            };
        }

        if (prevBtn) {
            prevBtn.onclick = (e) => {
                e.preventDefault();
                prevSlide();
            };
        }

        dots.forEach((dot, i) => {
            dot.onclick = (e) => {
                e.preventDefault();
                currentIndex = i;
                showSlide(currentIndex);
            };
        });
    }

    initSlider();
    document.addEventListener('astro:after-swap', initSlider);
</script>