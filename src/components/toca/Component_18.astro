---
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";
import "swiper/css";
import "swiper/css/navigation";

// Fallback data
const fallbackItems = [
    {
        titulo: "1. BOOK YOUR BOX",
        descripcion: "Book birthday parties for up to 24 guests online. Pick your date and time, then add packages. Dates available up to three months ahead.",
        imagen: { data: { attributes: { url: "https://placehold.co/600x600" } } },
        Boton: [{
            id: 1,
            texto: "BOOK NOW",
            url: "#",
            tipo: "version_1" // Assuming white/light button
        }]
    },
    {
        titulo: "2. ADD YOUR PACKAGE",
        descripcion: "Add the Ultimate Birthday Package as part of your booking journey – includes a meal, drink, dessert, and medal for all players.",
        imagen: { data: { attributes: { url: "https://placehold.co/600x600" } } },
        Boton: [{
             id: 2,
             texto: "KIDS MENU",
             url: "#",
             tipo: "version_1"
         }]
    },
    {
        titulo: "3. PERSONAL TOUCHES",
        descripcion: "You are welcome to bring your own cake & balloons. An adult is required to be present to run the self-managed party. For other questions, please consult our FAQs below.",
        imagen: { data: { attributes: { url: "https://placehold.co/600x600" } } },
        Boton: []
    }
];

interface Props {
    items: any[];
}

const { items = [] } = Astro.props;
const dataToShow = items.length > 0 ? items : fallbackItems;
---

<section class="w-full bg-[var(--surface-brand-primary)] py-12 lg:py-20 overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 md:px-8">
        
        <!-- Swiper Container -->
        <div class="swiper swiper-component-18 relative">
            <div class="swiper-wrapper lg:grid lg:grid-cols-3 lg:gap-8">
                {dataToShow.map((item, index) => {
                     const imageUrl = getStrapiUrl(item.imagen);
                     const descripcionHtml = stringifyRichText(item.descripcion);
                     const botones = item.Boton ? (Array.isArray(item.Boton) ? item.Boton : [item.Boton]) : [];

                     // Logic for different title colors based on index (simulating the screenshot)
                     // 1: White, 2: Cyan-ish, 3: Pink-ish (Fallback to default if variables not present)
                     let titleColorClass = "text-white";
                     if (index % 3 === 1) titleColorClass = "text-[var(--brand-interactive-base)]"; // Green/Cyan
                     if (index % 3 === 2) titleColorClass = "text-[var(--accent-feedback-strong)]"; // Pink/Red fallback

                     return (
                        <div class="swiper-slide h-auto lg:h-full flex flex-col">
                            <!-- Helper container for alignment -->
                            <div class="flex flex-col h-full w-full justify-between">
                                
                                <div class="flex flex-col">
                                    <!-- Image (Top) -->
                                    <div class="w-full aspect-square relative rounded-xl overflow-hidden mb-6 lg:mb-8 shrink-0">
                                        <Image 
                                            src={imageUrl || "https://placehold.co/600x600"} 
                                            alt={item.titulo} 
                                            inferSize={true}
                                            class="w-full h-full object-cover"
                                        />
                                    </div>

                                    <!-- Content (Title & Desc) -->
                                    <div class="text-center mb-6 lg:mb-8 flex-grow-0">
                                        <h3 class={`text-2xl lg:text-3xl font-bold uppercase mb-4 font-(family-name:--font-titling-gothic-fb-extended-bold) leading-tight flex items-center justify-center js-c18-title ${titleColorClass}`}>
                                            {item.titulo}
                                        </h3>
                                        <div class="text-white text-sm lg:text-base font-(family-name:--font-sharp-sans-medium) leading-relaxed opacity-90 flex items-start justify-center js-c18-desc">
                                             <Fragment set:html={descripcionHtml} />
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Button -->
                                <div class="mt-auto w-full flex justify-center">
                                    <Button
                                        botones={botones}
                                        clase="block w-full text-center font-bold uppercase py-3 text-lg lg:text-xl font-(family-name:--font-titling-gothic-fb-extended-bold) hover:opacity-90 transition-opacity"
                                    />
                                </div>

                            </div>
                        </div>
                     )
                })}
            </div>

            <!-- Mobile Custom Navigation Arrows -->
            <div class="flex lg:hidden justify-end items-center gap-4 mt-8">
                <button class="swiper-button-prev-c18 text-white hover:text-[var(--brand-interactive-base)] transition-colors">
                     <!-- Triangle Left -->
                     <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M14 7l-5 5 5 5V7z"/></svg>
                </button>
                <button class="swiper-button-next-c18 text-white hover:text-[var(--brand-interactive-base)] transition-colors">
                    <!-- Triangle Right -->
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor"><path d="M10 17l5-5-5-5v10z"/></svg>
                </button>
            </div>

        </div>

    </div>
</section>

<script>
    import Swiper from "swiper";
    import { Navigation } from "swiper/modules";

    document.addEventListener("astro:page-load", () => {
        initSwiper();
        initEqualHeights();
    });

    // Fallback for non-view-transitions
    if (!document.startViewTransition) {
        initSwiper();
        initEqualHeights();
        document.addEventListener("DOMContentLoaded", () => {
            initSwiper();
            initEqualHeights();
        });
    }

    // Recalculate on resize
    window.addEventListener('resize', () => {
        initEqualHeights();
    });

    function initSwiper() {
        const existingSwiper = document.querySelector('.swiper-component-18')?.swiper;
        if (existingSwiper) existingSwiper.destroy();

        const swiperEl = document.querySelector(".swiper-component-18");
        if (!swiperEl) return;

        new Swiper(swiperEl, {
            modules: [Navigation],
            slidesPerView: 1,
            spaceBetween: 20,
            loop: true,
            navigation: {
                nextEl: ".swiper-button-next-c18",
                prevEl: ".swiper-button-prev-c18",
            },
            breakpoints: {
                1024: {
                    enabled: false,
                    slidesPerView: 3,
                    spaceBetween: 32 // lg:gap-8 is 2rem = 32px
                }
            }
        });
    }

    function initEqualHeights() {
        const isDesktop = window.matchMedia('(min-width: 1024px)').matches;
        
        const titles = document.querySelectorAll('.js-c18-title');
        const descs = document.querySelectorAll('.js-c18-desc');

        // Reset heights first
        titles.forEach(el => (el as HTMLElement).style.height = 'auto');
        descs.forEach(el => (el as HTMLElement).style.height = 'auto');

        if (!isDesktop) return; // Only apply on desktop

        equalize(titles);
        equalize(descs);
    }

    function equalize(elements: NodeListOf<Element>) {
        let maxH = 0;
        elements.forEach(el => {
            const h = (el as HTMLElement).offsetHeight;
            if (h > maxH) maxH = h;
        });
        elements.forEach(el => (el as HTMLElement).style.height = `${maxH}px`);
    }
</script>

<style>
    /* 
       When Swiper is disabled (Desktop), we need to ensure the wrapper 
       behaves like a normal Grid container. 
       Swiper adds 'display: flex' to wrapper by default.
    */
    @media (min-width: 1024px) {
        .swiper-wrapper {
            display: grid !important; 
            /* grid-template-columns: repeat(3, 1fr);  <-- handled by Tailwind classes lg:grid lg:grid-cols-3 */
            transform: none !important; /* Remove swiper translate */
            width: 100% !important;
        }
        .swiper-slide {
            width: auto !important;
            margin-right: 0 !important;
        }
    }
</style>
