---
import { getStrapiUrl } from "../../../lib/strapi.js";

// Caja de tecnologia (steps-toca.tecnologia-toca / step.item-tecnologia).
// El icono se sube desde Strapi como media (SVG/imagen) y se encaja dentro de
// un contenedor fijo de 44x44 con object-fit: contain para no deformarse ni
// alterar el tamaño de la card. Si no tiene icono cargado en Strapi, muestra
// un SVG lineal por defecto en el color de la variante.
interface Props {
    icono?: any;
    imagen?: any;
    titulo?: string;
    descripcion?: string;
    variante?: string;
}

const { icono = null, imagen = null, titulo = "", descripcion = "", variante = "mint" } =
    Astro.props;

const colorVariante =
    variante === "rosa" ? "var(--surface-brand-secondary)" : "var(--brand-interactive-base)";

const mediaObj = icono ?? imagen;
const rawUrl =
    typeof mediaObj === "string"
        ? mediaObj
        : mediaObj?.data?.attributes?.url || mediaObj?.url || mediaObj?.src || null;
const iconoSrc = rawUrl?.startsWith("data:")
    ? rawUrl
    : getStrapiUrl(mediaObj) || mediaObj?.src || null;
const iconoAlt = mediaObj?.alternativeText || mediaObj?.data?.attributes?.alternativeText || titulo;

const tituloClave = titulo.toLowerCase();
const tipoDefault = tituloClave.includes("pantalla") || tituloClave.includes("marcador")
    ? "pantalla"
    : tituloClave.includes("nivel") || tituloClave.includes("hándicap") || tituloClave.includes("handicap")
      ? "niveles"
      : tituloClave.includes("restaurante") || tituloClave.includes("comida")
        ? "restaurante"
        : "maquina";
---

<div class="item-tecnologia" style={`--color-variante: ${colorVariante};`}>
    <div class="item-tecnologia-icono">
        {
            iconoSrc ? (
                <img
                    class="item-tecnologia-imagen"
                    src={iconoSrc}
                    alt={iconoAlt}
                    width="44"
                    height="44"
                    loading="lazy"
                />
            ) : (
                <svg
                    class="item-tecnologia-svg"
                    viewBox="0 0 40 40"
                    fill="none"
                    stroke="var(--color-variante)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                >
                    {tipoDefault === "maquina" && (
                        <Fragment>
                            <rect x="7" y="5" width="26" height="10" rx="2" />
                            <path d="M14 15v4h12v-4" />
                            <circle cx="20" cy="27" r="7" />
                            <path d="M20 23.2l3.3 2.4-1.3 3.9h-4l-1.3-3.9z" />
                            <path d="M20 23.2v-3.4" />
                            <path d="M23.3 25.6l3.2-1.1" />
                            <path d="M16.7 25.6l-3.2-1.1" />
                        </Fragment>
                    )}
                    {tipoDefault === "pantalla" && (
                        <Fragment>
                            <rect x="5" y="8" width="30" height="19" rx="2" />
                            <path d="M20 27v6" />
                            <path d="M15 33h10" />
                            <path d="M9 23l6-7 4 5 3-3 9 7" />
                        </Fragment>
                    )}
                    {tipoDefault === "niveles" && (
                        <Fragment>
                            <rect x="7" y="22" width="7" height="11" rx="1" />
                            <rect x="17" y="15" width="7" height="18" rx="1" />
                            <rect x="27" y="8" width="7" height="25" rx="1" />
                        </Fragment>
                    )}
                    {tipoDefault === "restaurante" && (
                        <Fragment>
                            <path d="M4 21h13a6.5 6.5 0 0 1-13 0z" />
                            <path d="M8 25h5" />
                            <path d="M26 8h10l-5 8z" />
                            <path d="M31 16v14" />
                            <path d="M26 30h10" />
                            <path d="M34 9l4-3" />
                        </Fragment>
                    )}
                </svg>
            )
        }
    </div>

    {titulo && <h3 class="item-tecnologia-titulo">{titulo}</h3>}
    {descripcion && <p class="item-tecnologia-descripcion">{descripcion}</p>}
</div>

<style>
    .item-tecnologia {
        display: flex;
        flex-direction: column;
        border: 2px solid var(--color-variante, var(--brand-interactive-base));
        padding: 1.75rem 1.5rem;
    }

    .item-tecnologia-icono {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        width: 44px;
        height: 44px;
        min-width: 44px;
        min-height: 44px;
        max-width: 44px;
        max-height: 44px;
        flex: 0 0 44px;
        overflow: hidden;
    }

    .item-tecnologia-svg,
    .item-tecnologia-imagen {
        display: block;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        object-position: left center;
    }

    .item-tecnologia-titulo {
        display: block;
        margin: 1.15rem 0 0;
        font-family: var(--font-sharp-sans-bold);
        font-weight: 700;
        font-size: 1.05rem;
        line-height: 1.2;
        text-transform: uppercase;
        color: var(--neutral-text-inverted);
    }

    .item-tecnologia-descripcion {
        margin: 0.65rem 0 0;
        font-family: var(--font-sharp-sans-medium);
        font-size: 0.9rem;
        line-height: 1.45;
        color: var(--accent-highlight-primary);
    }
</style>
