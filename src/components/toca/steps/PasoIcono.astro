---
import { getStrapiUrl } from "../../../lib/strapi.js";

// Paso con icono SVG subido desde Strapi (steps-toca.pasos-experiencia-toca / step.paso-icono).
// Si el editor aun no sube el archivo en Strapi, muestra un SVG lineal por defecto
// para que el componente siempre se vea completo.
interface Props {
    numero?: string;
    titulo?: string;
    icono?: any;
    imagen?: any;
    descripcion?: string;
}

const { numero = "", titulo = "", icono = null, imagen = null, descripcion = "" } = Astro.props;

const mediaObj = icono ?? imagen;
const rawUrl =
    typeof mediaObj === "string"
        ? mediaObj
        : mediaObj?.data?.attributes?.url || mediaObj?.url || mediaObj?.src || null;
const iconoSrc = rawUrl?.startsWith("data:")
    ? rawUrl
    : getStrapiUrl(mediaObj) || mediaObj?.src || null;
const iconoAlt = mediaObj?.alternativeText || mediaObj?.data?.attributes?.alternativeText || titulo;

const textoClave = `${numero} ${titulo}`.toLowerCase();
const tipoDefault = textoClave.includes("check") || numero === "02"
    ? "checkin"
    : textoClave.includes("juego") || textoClave.includes("nivel") || numero === "03"
      ? "juego"
      : textoClave.includes("patea") || textoClave.includes("anota") || numero === "04"
        ? "balon"
        : textoClave.includes("come") || textoClave.includes("celebra") || numero === "05"
          ? "comida"
          : "reserva";
---

<div class="paso-icono">
    <h3 class="paso-icono-titulo">{numero ? `${numero} · ` : ""}{titulo}</h3>

    <div class="paso-icono-caja">
        {
            iconoSrc ? (
                <img class="paso-icono-imagen" src={iconoSrc} alt={iconoAlt} loading="lazy" />
            ) : (
                <svg
                    class="paso-icono-svg"
                    viewBox="0 0 64 64"
                    fill="none"
                    stroke="var(--surface-brand-primary)"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    focusable="false"
                >
                    {tipoDefault === "reserva" && (
                        <Fragment>
                            <rect x="11" y="9" width="42" height="27" rx="3" />
                            <line x1="18" y1="18" x2="38" y2="18" />
                            <line x1="18" y1="24" x2="32" y2="24" />
                            <path d="M29 44v-11a3 3 0 0 1 6 0v8" />
                            <path d="M35 38a3 3 0 0 1 6 0v6c0 5-3 9-8 9h-4c-4 0-7-3-8-7l-2-6a2.5 2.5 0 0 1 4.5-2l1.5 3" />
                        </Fragment>
                    )}
                    {tipoDefault === "checkin" && (
                        <Fragment>
                            <rect x="18" y="8" width="28" height="48" rx="3" />
                            <circle cx="32" cy="25" r="6" />
                            <path d="M22 44c0-6 4.5-9 10-9s10 3 10 9" />
                        </Fragment>
                    )}
                    {tipoDefault === "juego" && (
                        <Fragment>
                            <rect x="9" y="9" width="21" height="21" rx="2" />
                            <rect x="34" y="9" width="21" height="21" rx="2" />
                            <rect x="9" y="34" width="21" height="21" rx="2" />
                            <rect x="34" y="34" width="21" height="21" rx="2" />
                            <circle cx="19.5" cy="19.5" r="5" />
                            <path d="M44.5 14.5 51 25h-13z" />
                            <path d="M44.5 51c-5-4-6-8-3-9.5 1.7-.8 3 .5 3 2 0-1.5 1.3-2.8 3-2 3 1.5 2 5.5-3 9.5z" />
                        </Fragment>
                    )}
                    {tipoDefault === "balon" && (
                        <Fragment>
                            <circle cx="36" cy="34" r="15" />
                            <path d="M36 27l6.5 4-2.5 7h-8l-2.5-7z" />
                            <line x1="14" y1="18" x2="21" y2="22" />
                            <line x1="10" y1="26" x2="18" y2="28" />
                            <line x1="20" y1="13" x2="25" y2="19" />
                        </Fragment>
                    )}
                    {tipoDefault === "comida" && (
                        <Fragment>
                            <path d="M8 38h24" />
                            <path d="M10 38a10 10 0 0 0 20 0" />
                            <circle cx="16" cy="33" r="4" />
                            <circle cx="24" cy="33" r="4" />
                            <path d="M36 20h18l-9 11z" />
                            <line x1="45" y1="31" x2="45" y2="48" />
                            <line x1="39" y1="48" x2="51" y2="48" />
                            <circle cx="53" cy="19" r="3.5" />
                        </Fragment>
                    )}
                </svg>
            )
        }
    </div>

    {descripcion && <p class="paso-icono-descripcion">{descripcion}</p>}
</div>

<style>
    .paso-icono {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .paso-icono-titulo {
        display: block;
        margin: 0;
        font-family: var(--font-sharp-sans-bold);
        font-weight: 700;
        font-size: 0.95rem;
        line-height: 1.2;
        text-transform: uppercase;
        color: var(--surface-brand-primary);
        min-height: 2.4em;
    }

    .paso-icono-caja {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 170px;
        aspect-ratio: 1 / 1;
        border: 2px solid var(--surface-brand-primary);
        margin: 0.85rem 0;
        padding: 1.25rem;
        box-sizing: border-box;
    }

    .paso-icono-svg,
    .paso-icono-imagen {
        display: block;
        width: 100%;
        height: 100%;
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .paso-icono-descripcion {
        margin: 0;
        font-family: var(--font-sharp-sans-medium);
        font-size: 0.88rem;
        line-height: 1.4;
        color: var(--surface-brand-primary);
    }
</style>
