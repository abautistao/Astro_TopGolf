---
// src/components/toca/Component_3.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';

interface CardProps {
    titulo: string;
    descripcion: string;
    imagen: any;
}

interface Props {
    card_1: CardProps;
    card_2: CardProps;
    card_3: CardProps;
}

const {
    card_1 = {
        titulo: "FUN GAMES",
        descripcion: "Designed for both football lovers and haters alike, whether you can kick a ball or not.",
        imagen: null
    },
    card_2 = {
        titulo: "BANGING MENU",
        descripcion: "A modern Americana-inspired menu that will leave you wanting more.",
        imagen: null
    },
    card_3 = {
        titulo: "EVENT SPACES",
        descripcion: "TOCA Social caters for events of all shape and sizes, from corporate nights to hen dos.",
        imagen: null
    }
} = Astro.props;

const cards = [
    {
        title: card_1.titulo,
        desc: stringifyRichText(card_1.descripcion),
        img: getStrapiUrl(card_1.imagen),
        alt: "Fun Games"
    },
    {
        title: card_2.titulo,
        desc: stringifyRichText(card_2.descripcion),
        img: getStrapiUrl(card_2.imagen),
        alt: "Banging Menu"
    },
    {
        title: card_3.titulo,
        desc: stringifyRichText(card_3.descripcion),
        img: getStrapiUrl(card_3.imagen),
        alt: "Event Spaces"
    }
];
---

<section class="w-full bg-[var(--surface-brand-primary)] py-12 lg:py-20 overflow-hidden relative">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 h-full">

        <div id="cards-container" class="lg:grid lg:grid-cols-3 lg:gap-8 h-full">

            {cards.map((item, index) => (
                <div
                    class={`carousel-item flex-col h-full group
                    ${index === 0 ? 'flex' : 'hidden'} lg:flex`}
                    data-index={index}
                >
                    <div class="mb-6">
                        <div class="flex justify-between items-start gap-4 mb-3">
                            <h3 class="flex-1 min-w-0 w-min font-bold text-[var(--accent-feedback-strong)] text-5xl sm:text-6xl lg:text-xl uppercase leading-[0.9] tracking-tighter title-extended break-words">
                                {item.title}
                            </h3>
                            <div class="flex gap-4 lg:hidden shrink-0 pt-2">
                                <button class="prev-btn text-[var(--brand-interactive-base)] hover:text-[var(--accent-feedback-strong)] transition-colors focus:outline-none p-1">
                                    <i class="fa-solid fa-caret-left text-4xl leading-none"></i>
                                </button>

                                <button class="next-btn text-[var(--brand-interactive-base)] hover:text-[var(--accent-feedback-strong)] transition-colors focus:outline-none p-1">
                                    <i class="fa-solid fa-caret-right text-4xl leading-none"></i>
                                </button>
                            </div>
                        </div>
                        <div class="text-[var(--brand-interactive-base)] text-base lg:text-base font-bold leading-tight w-full strapi-rich-text">
                            <Fragment set:html={item.desc} />
                        </div>

                    </div>

                    <div class="w-full aspect-[430/560] lg:aspect-square relative overflow-hidden shadow-lg border-2 border-transparent mt-auto">
                        <Image
                            src={item.img || "https://placehold.co/600x600/2d3748/ffffff?text=Image"}
                            alt={item.alt}
                            class="w-full h-full object-cover object-center"
                            width={600}
                            height={600}
                        />
                    </div>
                </div>
            ))}

        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', () => {
        initCarousel();
    });

    document.addEventListener('DOMContentLoaded', () => {
        initCarousel();
    });

    function initCarousel() {
        const items = document.querySelectorAll('.carousel-item');
        const prevBtns = document.querySelectorAll('.prev-btn');
        const nextBtns = document.querySelectorAll('.next-btn');
        let currentIndex = 0;
        const totalItems = items.length;

        if(totalItems === 0) return;

        function showItem(index) {
            items.forEach((item, i) => {
                item.classList.remove('flex');
                item.classList.add('hidden');

                if (i === index) {
                    item.classList.remove('hidden');
                    item.classList.add('flex');
                }
            });
        }

        function nextSlide() {
            currentIndex = (currentIndex + 1) % totalItems;
            showItem(currentIndex);
        }

        function prevSlide() {
            currentIndex = (currentIndex - 1 + totalItems) % totalItems;
            showItem(currentIndex);
        }

        nextBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                nextSlide();
            });
        });

        prevBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                prevSlide();
            });
        });
    }
</script>

<style>
    .strapi-rich-text :global(p) {
        margin-bottom: 0;
        color: inherit;
    }

    .title-extended {
        transform: scaleX(1.05);
        transform-origin: left;
    }
</style>