---
// Componente de resumen reactivo a través de eventos de SessionStorage
---
<div class="bg-neutral-900/60 border border-neutral-900 rounded-2xl p-6 space-y-6 backdrop-blur-sm">
  <h3 class="text-sm font-bold tracking-wider uppercase text-neutral-400 border-b border-neutral-800/60 pb-3">
    Tu Reserva
  </h3>

  <div class="space-y-3 text-sm">
    <div class="flex justify-between">
      <span class="text-neutral-400">Box de Juego Privado</span>
      <span class="font-bold text-white" id="summary-box-price">$400.00</span>
    </div>
    <div class="flex justify-between text-xs text-neutral-500">
      <span id="summary-players-val">2 Jugadores</span>
      <span>60 mins de sesión</span>
    </div>
    
    <div id="summary-addons-container" class="border-t border-neutral-800/40 pt-3 hidden space-y-2">
      <span class="text-xs text-lime-400 font-semibold block">Extras Añadidos:</span>
      <div id="summary-addons-list" class="text-xs text-neutral-400 space-y-1"></div>
    </div>
  </div>

  <div class="border-t border-neutral-800 pt-4 flex items-baseline justify-between">
    <span class="text-xs font-bold uppercase text-neutral-400">Total</span>
    <div class="text-right">
      <span class="text-2xl font-black text-lime-400 tracking-tight" id="summary-total-pay">$400.00</span>
    </div>
  </div>
</div>