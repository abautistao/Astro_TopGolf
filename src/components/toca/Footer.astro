---
// src/components/toca/Footer.astro
import { getStrapiUrl, getLocalizedUrl } from "../../lib/strapi";
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

const { data, locale = "en" } = Astro.props;

// --- 1. DATOS Y UTILIDADES ---
const strapiData = data || {};

const formatIconHtml = (input: string) => {
    if (!input) return "";
    if (input.trim().startsWith("<")) {
        return input;
    }
    return `<i class="${input}"></i>`;
};

// --- 2. MAPEO DE CAMPOS ---

const title = strapiData.titulo || "";
const locationsTitle = strapiData.columna_central_titulo || "";
const newsletterTitle = strapiData.newsletter_titulo || "";
const newsletterDescription = strapiData.newsletter_descripcion || "";

// Redes Sociales
const rawSocials = strapiData.redes_sociales || [];
const socials = rawSocials.map((social: any) => ({
    name: social.name,
    url: social.url || "#",
    iconHtml: formatIconHtml(social.icon),
    iconImage: social.icon_img
}));

// Columna Central
const rawLinksBlock = strapiData.links && strapiData.links.length > 0 ? strapiData.links[0] : null;
const rawItems = strapiData.ubicaciones || rawLinksBlock?.dropdown_items || [];

const middleColumnItems = rawItems.map((item: any) => ({
    name: item.titulo || item.name || "",
    url: getLocalizedUrl(item.url || "#", locale),
    status: item.subtitulo || item.status || "",
}));

// --- BOTÓN NEWSLETTER (Ajustado a tu objeto de datos) ---
// Leemos 'newsletter_boton' directamente
const rawButton = strapiData.newsletter_boton;

// Fallback: Si rawButton es null, usamos valores por defecto. Si url es null, usamos "#"
const buttonData = rawButton || { texto: "SIGN UP", url: "#", tipo: "version_2", id: "default-btn" };

const newsletterButton: Boton[] = [{
    id: buttonData.id || "btn-news",
    texto: buttonData.texto || "SIGN UP",
    url: buttonData.url || "#", // Protegemos el null que viene en tu data
    tipo: buttonData.tipo || "version_2",
}];

// Iconos Extra
const rawExtraLinks = strapiData.enlaces_iconos || [];
const extraIconLinks = rawExtraLinks.map((link: any) => ({
    text: link.name || link.texto || "",
    url: getLocalizedUrl(link.url || "#", locale),
    iconHtml: formatIconHtml(link.icon),
}));

// Barra Inferior
const rawBottomLinks = strapiData.barra_inferior || [];

const linksLeft = rawBottomLinks.filter((l: any) => {
    const pos = l.Posicion?.toLowerCase() || "";
    return pos === "izquierda" || pos === "left" || !pos;
});

const linksRight = rawBottomLinks.filter((l: any) => {
    const pos = l.Posicion?.toLowerCase() || "";
    return pos === "derecha" || pos === "right";
});

const allLinksMobile = [...linksLeft, ...linksRight];
---

<footer class="trigger-anim-footer w-full text-[var(--surface-brand-primary)] mt-auto flex flex-col">
    <div class="font-(family-name:--font-titling-gothic-fb-extended-bold) footer-part-1 bg-[var(--surface-brand-secondary)] py-6 lg:py-8 px-4 sm:px-6 lg:px-12 h-auto lg:min-h-[268px] flex flex-col justify-center">
        <div class="max-w-[1920px] mx-auto w-full flex flex-col lg:grid lg:grid-cols-3 gap-10 lg:gap-12 items-start lg:items-center">

            <div class="hidden lg:flex flex-col justify-between h-full w-full lg:order-1 self-stretch">
                <div class="flex-grow flex items-center">
                    {title && (
                        <h2 class="font-bold uppercase text-4xl md:text-4xl  break-words">
                            {title}
                        </h2>
                    )}
                </div>

                <div class="flex items-center gap-3 mt-4">
                    {socials.map((social: any) => (
                        <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-(--surface-brand-primary)! hover:scale-110 transition-transform hover:no-underline! block">
                            {social.iconImage?.data ? (
                                <img src={getStrapiUrl(social.iconImage.data.attributes.url)} alt={social.name} class="w-6 h-6 md:w-8 md:h-8 object-contain fill-current" />
                            ) : (
                                <span class="text-2xl md:text-2xl flex items-center justify-center" set:html={social.iconHtml} />
                            )}
                        </a>
                    ))}
                </div>
            </div>

            <div class="flex flex-col w-full order-1 lg:order-2 self-start lg:self-center">
                {locationsTitle && (
                    <h3 class="font-bold uppercase text-4xl md:text-2xl  mb-4 text-center lg:text-left w-full">
                        {locationsTitle}
                    </h3>
                )}

                <ul class="flex flex-col w-full space-y-3">
                    {middleColumnItems.map((item: any) => (
                        <li>
                            <a href={item.url} class="text-(--surface-brand-primary)! group flex items-end justify-between pb-1 border-b border-black hover:border-b-[3px] transition-all duration-200 hover:no-underline!" >
                                <div class="flex flex-col text-left">
                                    <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base ">
                                        {item.name}
                                    </span>
                                    {item.status && (
                                        <span class="font-(family-name:--font-sharp-sans-medium) text-base font-bold">
                                            {item.status}
                                        </span>
                                    )}
                                    <span class="mt-5 font-(family-name:--font-sharp-sans-medium) font-bold text-base">Nuestros horarios:</span>
                                    <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base">Lunes - Jueves 1pm a 11pm</span>
                                    <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base">Viernes 1pm - 12am</span>
                                    <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base">Sábados 10am - 12am</span>
                                    <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base">Domingos 12pm - 10pm</span>
                                </div>
                                <i class="fa-solid fa-play text-2xl mb-1 opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 ease-out" />
                            </a>
                        </li>
                    ))}

                    <li>
                        <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base">Correo: contacto@tocasocial.com.mx</span>
                    </li>
                    <li>
                        <span class="font-(family-name:--font-sharp-sans-medium) font-bold text-base">Teléfono: 81 4445 3100</span>
                    </li>
                </ul>
            </div>

            <div class="flex flex-col w-full order-2 lg:order-3 text-center lg:text-left self-start lg:self-center h-full justify-between">
                {newsletterTitle && (
                    <h3 class="font-black uppercase text-base md:text-base  mb-4 mt-4 lg:mt-0">
                        {newsletterTitle}
                    </h3>
                )}


                {newsletterDescription && (
                    <p class="font-(family-name:--font-sharp-sans-medium) text-sm md:text-sm font-medium mb-6  opacity-90 mx-auto lg:mx-0 max-w-sm lg:max-w-none">
                        {newsletterDescription}
                    </p>
                )}

                <div class="font-(family-name:--font-sharp-sans-bold) flex flex-wrap items-center justify-center lg:justify-start gap-6 mt-auto">
                    {extraIconLinks.map((link: any) => (
                        <a href={link.url} class="text-(--surface-brand-primary)! text-base flex items-center gap-2 group hover:no-underline!">
                            <span class="text-base text-[var(--surface-brand-primary)] flex items-center" set:html={link.iconHtml}></span>
                            <span class="font-bold text-base  underline decoration-solid decoration-black">
                                {link.text}
                            </span>
                        </a>
                    ))}
                </div>
            </div>
        </div>
    </div>

    <div class="font-(family-name:--font-sharp-sans-bold) footer-part-2 bg-[var(--brand-interactive-base)] py-4 lg:py-1 px-4 sm:px-6 lg:px-12 border-4 border-black h-auto min-h-[115px] lg:min-h-[47px] flex items-center">
        <div class="max-w-[1920px] mx-auto w-full flex flex-col justify-center items-center gap-4 text-sm font-bold">

            <div class="flex lg:hidden items-center gap-6">
                {socials.map((social: any) => (
                    <a href={social.url} target="_blank" rel="noopener noreferrer" class="text-(--surface-brand-primary)! hover:scale-110 transition-transform block">
                        {social.iconImage?.data ? (
                            <img src={getStrapiUrl(social.iconImage.data.attributes.url)} alt={social.name} class="w-6 h-6 object-contain fill-current" />
                        ) : (
                            <span class="text-2xl flex items-center justify-center" set:html={social.iconHtml} />
                        )}
                    </a>
                ))}
            </div>

            <div class="hidden lg:flex w-full flex-row justify-between items-center h-full">
                <div class="font-(family-name:--font-sharp-sans-medium) font-medium flex flex-wrap justify-start gap-6 underline decoration-2 underline-offset-3">
                    {linksLeft.map((link: any) => (
                        <a class="text-(--surface-brand-primary)!" href={getLocalizedUrl(link.URL, locale)}>{link.Texto}</a>
                    ))}
                </div>
                <div class="font-(family-name:--font-sharp-sans-medium) font-medium flex flex-wrap justify-end gap-6 underline decoration-1 underline-offset-3">
                    {linksRight.map((link: any) => (
                        <a class="text-(--surface-brand-primary)!" href={getLocalizedUrl(link.URL, locale)}>{link.Texto}</a>
                    ))}
                </div>
            </div>

            <div class="flex lg:hidden flex-wrap justify-center text-center gap-x-6 gap-y-2 underline decoration-2 underline-offset-3 px-2">
                {allLinksMobile.map((link: any) => (
                    <a href={getLocalizedUrl(link.URL, locale)} class="text-(--surface-brand-primary)! whitespace-nowrap text-xs">
                        {link.Texto}
                    </a>
                ))}
            </div>
        </div>
    </div>

    <div id="wa-contact" class="rounded-full fixed right-[5%] bottom-[8%] w-14 h-14 bg-green-500 flex justify-center items-center text-white! text-3xl! z-50">
        <a target="_blank" class="text-white!" href="https://api.whatsapp.com/send?phone=5218118209536">
            <i class="fa-brands fa-whatsapp"></i>
        </a>
    </div>
</footer>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const observerOptions = { root: null, rootMargin: "0px", threshold: 0.1 };
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("is-visible");
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);
        const targets = document.querySelectorAll(".trigger-anim-footer");
        targets.forEach((target) => observer.observe(target));
    });
</script>

<style>
    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .footer-part-1, .footer-part-2 { opacity: 0; }
    :global(.trigger-anim-footer.is-visible) .footer-part-1 { animation: fadeInUp 0.8s ease-out forwards; }
    :global(.trigger-anim-footer.is-visible) .footer-part-2 { animation: fadeInUp 0.8s ease-out forwards; animation-delay: 0.2s; }
</style>