---
import TituloSeccion from "./cards/TituloSeccion.astro";
import CardExperiencia from "./cards/Experiencia.astro";
import { stringifyRichText } from "../../lib/strapi";

interface Props {
    titulo_seccion?: string;
    subtitulo?: string;
    tituloHtmlTag?: string | null;
    subtituloHtmlTag?: string | null;
    color_fondo_override?: string | null;
    cards?: any[];
    description: any[]
}

const {
    titulo_seccion = "",
    subtitulo = "",
    tituloHtmlTag = null,
    subtituloHtmlTag = null,
    color_fondo_override = null,
    cards = [],
    description
} = Astro.props;
---

<section class="experiencias py-12" style={color_fondo_override ? `background: ${color_fondo_override}` : undefined}>
    <div class="container mx-auto px-4 md:px-0">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end w-full">
            <div class="titulo-sesion col-span-3 text-(--surface-brand-primary)">
                {subtitulo && <subtituloHtmlTag class="font-(family-name:--font-sharp-sans-bold) block text-md">{subtitulo}</subtituloHtmlTag>}
                {
                    titulo_seccion && (
                        <tituloHtmlTag class="font-(family-name:--font-titling-gothic-fb-extended-bold) text-4xl">
                            
                            <span class="titulo-sesion-linea titulo-sesion-linea--solida">{titulo_seccion}</span>
                            
                        </tituloHtmlTag>
                    )
                }
            </div>

            {description && (
                <div set:html={stringifyRichText(description)} class="font-(family-name:--font-sharp-sans-bold) col-span-1 text-(--surface-brand-primary)"></div>
            )}
        </div>
        

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mt-10">
            {
                Array.isArray(cards) &&
                    cards.map((card: any, i: number) => <CardExperiencia {...card} indice={i + 1} />)
            }
        </div>
    </div>
</section>

<style>
    .experiencias {
        /* Fondo mint por defecto (la ficha de esta seccion va en navy sobre mint). */
        background: var(--brand-interactive-base);
        /* Esta seccion es clara: el titulo compartido necesita texto navy.
           Los valores por defecto viven en TituloSeccion.astro; aqui se
           sobreescriben solo para esta seccion. */
        --titulo-color: var(--surface-brand-primary);
        --titulo-color-contorno: transparent;
        --subtitulo-color: var(--surface-brand-primary);
        --enlace-color: var(--surface-brand-primary);
        padding: 3rem 1rem 4rem;
    }

    .contenedor {
        max-width: 1440px;
        margin: 0 auto;
    }

</style>
