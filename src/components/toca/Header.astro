---
// src/components/toca/Header.astro
import { getHeaderData, getStrapiUrl, getLocalizedUrl, stringifyRichText } from "../../lib/strapi";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";
import defaultLogoImg from "../../assets/TOCA_Social_One_Color.png";
import { Image } from "astro:assets";

interface Promo {
    id: number
    titulo: string
    descripcion: object
}

const { data, locale = "en" } = Astro.props;
const headerData = data || (await getHeaderData());

const strapiLogo = getStrapiUrl(headerData?.logo);
const logoUrl = strapiLogo || defaultLogoImg.src;
const logoMobileUrl = getStrapiUrl(headerData?.logo_mobile) || logoUrl;
const textoHorario = headerData?.texto_horario || "";
const textoTel = headerData?.texto_telefono || "";
// --- Usamos links_multiples ---

// --- Menú Derecho (Links normales) ---
const links = headerData?.links || [];

const social = headerData?.social || [];

// --- Botones (Book Now) desde Strapi ---
const ctaButtonRaw = headerData?.boton;
let buttons: Boton[] = [];

if (ctaButtonRaw) {
    const ctaButtonLocalized = {
        ...ctaButtonRaw,
        url: getLocalizedUrl(ctaButtonRaw.url, locale)
    };
    buttons = [ctaButtonLocalized];
}

const currentPath = (Astro.url.pathname || "/").replace(/\/$/, "") || "/";
const normalizeUrl = (u: string) => (u || "").replace(/\/$/, "") || "/";
const isLinkActive = (url?: string) => {
    if (!url) return false;
    return normalizeUrl(getLocalizedUrl(url, locale)) === currentPath;
};
const isLinkActiveOrChild = (link: any) => {
    if (isLinkActive(link.url)) return true;
    if (Array.isArray(link.dropdown_items) && link.dropdown_items.length > 0) {
        return link.dropdown_items.some((sub: any) => isLinkActive(sub.url));
    }
    return false;
};
---
<header class="w-full relative z-50 bg-(--surface-brand-primary) font-(family-name:--font-titling-gothic-fb-extended-bold)">
    <div class="header-top py-4 hidden md:flex bg-black">
        <div class="container mx-auto px-4 md:px-0">
            <div class="flex justify-between w-full font-bold ">
                <!-- Horario / Text -->
                 <div class="header-time flex gap-6">
                     <div class="flex-grow flex items-center justify-center">
                         <div set:html={stringifyRichText(textoTel)} class="text-white text-xs md:text-[9px] font-bold tracking-wide uppercase"></div>
                     </div>
                     <div class="flex-grow flex items-center justify-center">
                         <div set:html={stringifyRichText(textoHorario)} class="text-white text-xs md:text-[9px] font-bold tracking-wide uppercase"></div>
                     </div>
                 </div>

                <div class="flex items-center gap-5 text-white!">
                        {social.map((item: any) => (
                            <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-white! hover:opacity-80! transition-opacity">
                                    <i class={`${item.icono_clase} text-[17px]`}></i>
                            </a>
                        ))}
                </div>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <div class="header-main">
        <div class="container mx-auto px-4 md:px-0">
            <div class="flex! items-center! justify-between">
                <div class="py-4">
                    <!-- Logo -->
                    <a href="/">
                        <!-- Desktop Logo -->
                        {logoUrl && (
                            <Image
                                src={logoUrl}
                                alt="Acuario"
                                width="120"
                                height="80"
                                class="hidden! md:block! h-15! object-contain"
                            />
                        )}
                        <!-- Mobile Logo -->
                        {logoMobileUrl && (
                            <Image
                                src={logoMobileUrl}
                                alt="Acuario Mobile"
                                width="120"
                                height="80"
                                class="block! md:hidden! h-15 object-contain py-1"
                            />
                        )}
                    </a>
                </div>

                <!-- Desktop Links -->
                <nav class="hidden! md:flex! items-center! justify-center! gap-6! h-full! grow!">
                    {links.map((link: any) => (
                        <div class="relative group h-full py-4 flex items-center">
                            <a
                                href={link.url ? getLocalizedUrl(link.url, locale) : '#'}
                                class={`flex! items-center! gap-1.5! font-(family-name:--font-titling-gothic-fb-extended-bold) text-[11px]! font-medium! tracking-wide! uppercase! transition-colors! hover:no-underline!  ${
                                    isLinkActiveOrChild(link)
                                        ? "text-(--brand-interactive-base)!"
                                        : "text-white!"
                                }`}
                                aria-current={isLinkActive(link.url) ? "page" : undefined}
                            >
                                {link.texto}
                                {link.dropdown_items && link.dropdown_items.length > 0 && (
                                    <i class={`fa-solid fa-chevron-down text-[10px] transition-transform duration-300 group-hover:rotate-180 -mt-0.5 ${isLinkActiveOrChild(link) ? "text-[var(--color-white)]" : ""}`}></i>
                                )}
                            </a>
                            
                            <!-- Dropdown -->
                            {link.dropdown_items && link.dropdown_items.length > 0 && (
                                <div class="absolute! top-full! left-0! opacity-0! invisible! group-hover:opacity-100! group-hover:visible! transition-all duration-300 w-max min-w-[240px] bg-(--surface-brand-primary)! border-t-2! border-(--brand-interactive-base) shadow-2xl z-50!">
                                    <ul class="flex! flex-col!">
                                        {link.dropdown_items.map((sublink: any) => (
                                            <li>
                                                <a
                                                    href={getLocalizedUrl(sublink.url, locale)}
                                                    class={`block! px-8! py-4! font-[family-name:var(--font-principal)]! font-bold! text-[11px]! transition-colors hover:no-underline! ${
                                                        isLinkActive(sublink.url)
                                                            ? "bg-(--neutral-background-strong)! text-(--brand-interactive-base)!"
                                                            : "text-(--accent-feedback-strong)! hover:bg-(--neutral-background-strong)! hover:text-(--brand-interactive-base)!"
                                                    }`}
                                                    aria-current={isLinkActive(sublink.url) ? "page" : undefined}
                                                >
                                                    {sublink.titulo}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </div>
                    ))}
                </nav>
                
                {ctaButtonRaw && (
                    <div class="relative animate-fade-in-up delay-300 hidden md:block">
                        <Button botones={buttons} />
                    </div>
                )}
                <!-- Mobile Info & Hamburger -->
                <div class="flex! md:hidden! items-center! gap-15!">
                    <span class="text-white! text-[10px]! sm:text-xs! font-[family-name:var(--font-principal)] font-bold! tracking-wide uppercase! text-right! max-w-[150px]! leading-tight">
                        
                    </span>
                    <button aria-label="Abrir menú de navegación" id="mobile-menu-toggle" class="text-white! text-3xl! focus:outline-none ml-1! w-8! h-8! flex! items-center! justify-center!">
                        <span id="menu-icon"><i aria-hidden="true" class="fa-solid fa-bars"></i></span>
                        <span id="close-icon" class="hidden!"><i aria-hidden="true" class="fa-solid fa-xmark"></i></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Overlay Menu -->
<div id="mobile-menu" class="hidden! md:hidden! fixed! inset-0! top-[95px]! bg-(--surface-brand-primary)! font-(family-name:--font-titling-gothic-fb-extended-bold)! z-40! overflow-y-auto! flex-col! pb-20! border-t-4! border-[var(--brand-interactive-base)]!">
    <nav class="flex flex-col">
        {links.map((link: any, index: number) => (
            <div class="mobile-menu-group border-b! border-gray-200!">
                <div class="mobile-menu-header flex! items-center! justify-between! px-6! py-4!  text-white!">
                    <a href={link.url ? getLocalizedUrl(link.url, locale) : '#'} class={`font-[family-name:var(--font-principal)] text-[15px]! uppercase! font-bold! grow! ${isLinkActiveOrChild(link) ? "text-[var(--brand-interactive-base)]!" : "text-(--accent-feedback-strong)!"}`} aria-current={isLinkActive(link.url) ? "page" : undefined}>
                        {link.texto}
                    </a>
                    {link.dropdown_items && link.dropdown_items.length > 0 && (
                        <button class="p-2! mobile-submenu-toggle focus:outline-none! text-inherit!" data-target={`submenu-${index}`}>
                            <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
                        </button>
                    )}
                </div>
                {link.dropdown_items && link.dropdown_items.length > 0 && (
                    <div id={`submenu-${index}`} class="hidden! flex-col! bg-(--surface-brand-primary)!">
                        {link.dropdown_items.map((sublink: any) => (
                            <a href={getLocalizedUrl(sublink.url, locale)} class={`block! px-8! py-3.5! font-[family-name:var(--font-principal)]! font-bold! text-[12px]! transition-colors border-t! border-(--accent-feedback-strong)! ${isLinkActive(sublink.url) ? " text-[var(--brand-interactive-base)]" : "text-[var(--accent-feedback-strong)] hover:bg-[var(--neutral-background-strong)] hover:text-[var(--brand-interactive-base)]"}`} aria-current={isLinkActive(sublink.url) ? "page" : undefined}>
                                {sublink.titulo}
                            </a>
                        ))}
                    </div>
                )}
            </div>
        ))}
        {buttons.length > 0 && (
            <div class="p-6! mt-4!">
                <a href={buttons[0].url} class="block! w-full! text-center! bg-(--brand-interactive-base) text-(--surface-brand-primary) font-[family-name:var(--font-principal)]! font-bold! text-lg! py-4! rounded-md! uppercase! shadow-sm">
                    {buttons[0].texto}
                </a>
            </div>
        )}
    </nav>
</div>

<script>
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    toggle?.addEventListener("click", () => {
        const isHidden = menu?.classList.contains("hidden!");
        if (isHidden) {
            menu?.classList.remove("hidden!");
            menu?.classList.add("flex!");
            menuIcon?.classList.add("hidden!");
            closeIcon?.classList.remove("hidden!");
            document.body.style.overflow = "hidden!";
        } else {
            menu?.classList.add("hidden!");
            menu?.classList.remove("flex!");
            menuIcon?.classList.remove("hidden!");
            closeIcon?.classList.add("hidden!");
            document.body.style.overflow = "";
        }
    });

    // Mobile submenu toggles
    const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    submenuToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const targetId = btn.getAttribute('data-target');
            if (targetId) {
                const submenu = document.getElementById(targetId);
                const icon = btn.querySelector('i');
                const header = btn.closest('.mobile-menu-header');
                
                if (submenu?.classList.contains('hidden!')) {
                    submenu.classList.remove('hidden!');
                    submenu.classList.add('flex!');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                    
                    // Apply expanded styles to header wrapper
                    header?.classList.remove('bg-white!', 'text-[var(--surface-brand-primary)]!');
                    header?.classList.add('bg-[var(--surface-brand-primary)]!', 'text-[var(--brand-interactive-base)]!');
                } else {
                    submenu?.classList.add('hidden!');
                    submenu?.classList.remove('flex!');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                    
                    // Revert styles on header wrapper
                    
                    header?.classList.remove('bg-[var(--surface-brand-primary)]!', 'text-[var(--brand-interactive-base)]!');
                }
            }
        });
    });
</script>

<style>
    .header-time :global(p > strong) {
        color: var(--brand-interactive-base) !important;
    }
</style>
