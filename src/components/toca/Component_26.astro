---
// src/components/toca/Component_26.astro
import { stringifyRichText } from "../../lib/strapi.js";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    subtitulo?: string;
    subtituloHtmlTag?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'span' | 'p';
    titulo?: string;
    tituloHtmlTag?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6' | 'span' | 'p';
    descripcion?: any;
    boton_primario?: Boton | null;
    boton_secundario?: Boton | null;
}

const {
    subtitulo = "IT'S GAME TIME",
    subtituloHtmlTag = "span",
    titulo = "VISIT TOCA SOCIAL",
    tituloHtmlTag = "h2",
    descripcion = null,
    boton_primario = null,
    boton_secundario = null
} = Astro.props;

const subtituloMostrar = subtitulo || "";
const tituloMostrar = titulo || "";

// Convert Strapi blocks to HTML string
const descripcionHtml = descripcion ? stringifyRichText(descripcion) : "";

// Fallback dynamic text in case backend is empty
const defaultDescriptionHtml = `
<p>Whether it's birthdays, work socials, date nights or matchday plans, TOCA Social is where food, drinks and interactive football come together.</p>
<p>Book a game box or plan your next group event at our venues in London and Birmingham.</p>
`;

const descriptionToRender = descripcionHtml || defaultDescriptionHtml;

const SubtitleTag = subtituloHtmlTag || 'span';
const TitleTag = tituloHtmlTag || 'h2';

// Default buttons if not provided
const defaultBotonPrimario: Boton = {
    id: 1,
    texto: "BOOK NOW",
    url: "#",
    tipo: "version_3" // Mint green
};

const defaultBotonSecundario: Boton = {
    id: 2,
    texto: "LARGE BOOKINGS",
    url: "#",
    tipo: "version_1" // Pink
};

const finalBotonPrimario = boton_primario ? { ...boton_primario, tipo: boton_primario.tipo || "version_3" } : defaultBotonPrimario;
const finalBotonSecundario = boton_secundario ? { ...boton_secundario, tipo: boton_secundario.tipo || "version_1" } : defaultBotonSecundario;

const buttonsToRender: Boton[] = [];
if (finalBotonPrimario) buttonsToRender.push(finalBotonPrimario);
if (finalBotonSecundario) buttonsToRender.push(finalBotonSecundario);
---

<section class="w-full bg-[var(--surface-brand-primary)] py-16 px-4 sm:px-6 md:px-8 flex items-center justify-center overflow-hidden">
    <div class="w-full max-w-[1100px] border-[4px] md:border-[6px] border-[var(--brand-interactive-base)] bg-[var(--surface-brand-primary)] p-8 sm:p-12 md:py-16 md:px-20 text-center flex flex-col items-center justify-center">
        
        {subtituloMostrar && (
            <SubtitleTag class="block font-(family-name:--font-titling-gothic-fb-extended-bold) text-[.7rem] md:text-[.875rem] font-medium text-[var(--accent-feedback-strong)] uppercase tracking-wider">
                {subtituloMostrar}
            </SubtitleTag>
        )}

        {tituloMostrar && (
            <TitleTag class="block font-(family-name:--font-titling-gothic-fb-extended-bold) text-[1.5rem] md:text-[2.5rem] font-bold text-[var(--accent-feedback-strong)] leading-[1.1] uppercase mb-8">
                {tituloMostrar}
            </TitleTag>
        )}

        {descriptionToRender && (
            <div class="font-(family-name:--font-sharp-sans-medium) text-[14px] font-normal text-[var(--accent-feedback-strong)] leading-relaxed mb-10 max-w-3xl mx-auto strapi-rich-text [&_p]:font-(family-name:--font-sharp-sans-medium)">
                <Fragment set:html={descriptionToRender} />
            </div>
        )}

        {buttonsToRender.length > 0 && (
            <div class="w-full flex justify-center">
                <Button 
                    botones={buttonsToRender} 
                    clase="flex flex-col sm:flex-row gap-4 sm:gap-6 justify-center w-full sm:w-auto"
                />
            </div>
        )}
        
    </div>
</section>
