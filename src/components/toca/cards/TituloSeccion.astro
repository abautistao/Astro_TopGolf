---
interface Props {
    titulo?: string;
    subtitulo?: string;
    texto_enlace?: string;
    url_enlace?: string;
    tituloTag?: string | null;
    subtituloTag?: string | null;
}

const {
    titulo = "",
    subtitulo = "",
    texto_enlace = "",
    url_enlace = "",
    tituloTag = null,
    subtituloTag = null
} = Astro.props;

// El editor elige en el CMS la etiqueta HTML del titulo y del subtitulo. Los
// registros ya publicados mandan `null` en los campos nuevos (no `undefined`),
// asi que el default del destructuring no se aplica: normalizamos contra una
// lista blanca y caemos en las etiquetas por defecto (h2 y p) cuando el valor
// no llega o no es valido.
const TAGS_HTML = ["h1", "h2", "h3", "h4", "h5", "h6", "span", "p"] as const;

type TagHtml = (typeof TAGS_HTML)[number];

const resolverTag = (valor: string | null | undefined, porDefecto: TagHtml): TagHtml => {
    const normalizado = (valor ?? "").trim().toLowerCase();
    return (TAGS_HTML as readonly string[]).includes(normalizado)
        ? (normalizado as TagHtml)
        : porDefecto;
};

const TituloTag = resolverTag(tituloTag, "h2");
const SubtituloTag = resolverTag(subtituloTag, "p");
---

<div class="titulo-sesion">
    {
        titulo && (
            <TituloTag class="titulo-sesion-titulo">
                <span class="titulo-sesion-linea titulo-sesion-linea--contorno">{titulo}</span>
                <span class="titulo-sesion-linea titulo-sesion-linea--solida">{titulo}</span>
                <span class="titulo-sesion-linea titulo-sesion-linea--contorno">{titulo}</span>
            </TituloTag>
        )
    }
    {subtitulo && <SubtituloTag class="titulo-sesion-subtitulo">{subtitulo}</SubtituloTag>}
    {
        texto_enlace && (
            <a href={url_enlace || "#"} class="titulo-sesion-enlace">
                {texto_enlace}
            </a>
        )
    }
</div>

<style>
    .titulo-sesion {
        text-align: center;
        /* Como item flex con align-items:flex-start toma su ancho maximo y puede
            desbordar el contenedor: lo acotamos para que el titulo envuelva. */
        max-width: 100%;
        min-width: 0;
    }

    .titulo-sesion-titulo {
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        line-height: 0.95;
        text-transform: uppercase;
        letter-spacing: 0.01em;
        /* Movil: la ficha usa Anton 50px. Con la fuente condensada entra de sobra;
           sin ella (fallback ancha) el clamp evita que el titulo desborde. */
        font-size: clamp(1.5rem, 7.5vw, 3.125rem);
        overflow-wrap: break-word;
        /* La etiqueta la elige el editor (h1..h6, span o p): display y margenes
           quedan fijados aqui para que el titulo se vea igual con cualquiera. */
        display: block;
        margin: 0;
    }

    .titulo-sesion-linea {
        display: block;
    }

    .titulo-sesion-linea--contorno {
        color: transparent;
        -webkit-text-stroke: 1px var(--surface-brand-secondary);
    }

    .titulo-sesion-linea--solida {
        color: var(--neutral-text-inverted);
    }

    .titulo-sesion-subtitulo {
        font-family: var(--font-sharp-sans-bold);
        color: var(--brand-interactive-base);
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.03em;
        /* display, margenes, peso e interlineado quedan fijados aqui para que
           el subtitulo se vea igual con cualquiera de las etiquetas. */
        display: block;
        margin: 14px 0 0;
        font-weight: inherit;
        line-height: inherit;
    }

    .titulo-sesion-enlace {
        display: inline-block;
        font-family: var(--font-titling-gothic-fb-extended-bold);
        color: var(--neutral-text-inverted);
        text-decoration: underline;
        text-transform: uppercase;
        margin-top: 1rem;
        font-size: 0.95rem;
    }

    /* La ficha usa Anton 50px en movil; Marketing pide 50px tambien en desktop.
       El subtitulo si escala como en la ficha: Archivo 800, 11px en movil y 16px en desktop. */
    @media (min-width: 1024px) {
        .titulo-sesion-titulo {
            font-size: 3.125rem;
        }

        .titulo-sesion-subtitulo {
            font-size: 16px;
            letter-spacing: 0.04em;
            margin: 22px 0 0;
        }
    }
</style>
