---
import { getStrapiUrl } from "../../../lib/strapi.js";
import { Image } from "astro:assets";

interface Props {
    titulo?: string;
    descriptor?: string;
    imagen?: any;
    descripcion?: string;
    bullets?: { id?: number; texto?: string }[];
    variante?: "mint" | "rosa";
}

const {
    titulo = "",
    descriptor = "",
    imagen = null,
    descripcion = "",
    bullets = [],
    variante = "mint"
} = Astro.props;

const imgSrc = getStrapiUrl(imagen);
// La foto puede venir de Strapi (URL remota) o ser un asset local (solo para el dummy).
const esAssetLocal = Boolean(imagen?.src);
const esRosa = variante === "rosa";
const colorVariante = esRosa ? "var(--surface-brand-secondary)" : "var(--brand-interactive-base)";
---

<article class="card-juego" style={`--color-variante: ${colorVariante};`}>
    <header class="cabecera">
        <span class="titulo">{titulo}</span>
        {descriptor && <span class="descriptor">{descriptor}</span>}
    </header>

    <div class="foto">
        {esAssetLocal ? (
                <Image src={imagen} alt={titulo} class="w-full! h-full! object-cover!" />
            ) : imgSrc ? (
                <Image src={imgSrc} alt={titulo} width={800} height={520} class="w-full! h-full! object-cover!" />
            ) : (
                <span class="placeholder">CAPTURA DEL JUEGO · {titulo}</span>
            )
        }
    </div>

    {descripcion && <p class="descripcion">{descripcion}</p>}

    {
        Array.isArray(bullets) && bullets.length > 0 && (
            <ul class="lista">
                {bullets.map((item) => (
                    <li>
                        <span class="vineta" aria-hidden="true" />
                        <span>{item.texto}</span>
                    </li>
                ))}
            </ul>
        )
    }
</article>

<style>
    .card-juego {
        container-type: inline-size;
        display: flex;
        flex-direction: column;
        background: var(--surface-brand-primary);
        border: 2px solid var(--color-variante, var(--brand-interactive-base));
        padding: 0.5rem;
    }

    .cabecera {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: stretch;
                gap: 0.5rem;
        margin-bottom: 0.75rem;
        margin: calc(-1 * 0.5rem) calc(-1 * 0.5rem) 0.75rem;}

    .titulo {min-width: 0;
        flex: 1 1 auto;
        background: var(--color-variante, var(--brand-interactive-base));
        color: var(--surface-brand-primary);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        text-transform: uppercase;
        font-size: clamp(0.8rem, 5.5cqw, 1.35rem);
        line-height: 1;
        padding: 0.75rem;
        overflow-wrap: break-word;
    }

    .descriptor {min-width: 0;
        min-width: 0;
        background: var(--surface-brand-primary);
        color: var(--neutral-text-inverted);
        font-family: var(--font-sharp-sans-bold);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        font-size: clamp(0.72rem, 0.9vw, 0.82rem);
        line-height: 1.15;
        padding: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow-wrap: break-word;
        white-space: nowrap;}

    .foto {
        position: relative;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        aspect-ratio: 16 / 9;
        background: var(--custom-color-01);
        overflow: hidden;
        
    }

    /* El placeholder de la ficha es un recuadro punteado con el texto arriba. */
    .placeholder {
        flex: 1 1 auto;
        /* El recuadro punteado va inset; la foto real ocupa todo el area. */
        margin: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 2px dashed var(--accent-highlight-primary);
        color: var(--accent-highlight-primary);
        font-family: var(--font-sharp-sans-medium);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        padding: 1rem;
    }

    .descripcion {
        text-transform: none;
        margin: 1rem 0 0;
        font-family: var(--font-sharp-sans-medium);
        color: var(--brand-interactive-base);
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .lista {
        list-style: none;
        padding: 0;
        margin: 0.85rem 0 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .lista li {
        display: flex;
        align-items: flex-start;
        gap: 0.6rem;
        color: var(--neutral-text-inverted);
        font-family: var(--font-sharp-sans-medium);
        text-transform: none;
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .vineta {
        flex: 0 0 auto;
        width: 0.5rem;
        height: 0.5rem;
        margin-top: 0.3rem;
        background: var(--surface-brand-secondary);
    }
</style>
