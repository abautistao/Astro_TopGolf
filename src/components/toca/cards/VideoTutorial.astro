---
import { getStrapiUrl } from "../../../lib/strapi.js";
import { Image } from "astro:assets";

interface Props {
    titulo?: string;
    video?: any;
    texto?: string;
}

const {
    titulo = "",
    video = null,
    texto = ""
} = Astro.props;

const mediaSrc = getStrapiUrl(video);
const mime = video?.data?.attributes?.mime || video?.mime || "";
const extension = (mediaSrc || "").split("?")[0].split(".").pop()?.toLowerCase() || "";
const esVideo = mime.startsWith("video/") || ["mp4", "webm", "mov", "m4v", "ogv"].includes(extension);
---

<article class="card-video">
    {titulo && <h3 class="titulo">{titulo}</h3>}

    <div class="miniatura">
        {
            mediaSrc && esVideo && (
                <video class="video" src={mediaSrc} controls muted playsinline preload="metadata" />
            )
        }
        {
            mediaSrc && !esVideo && (
                <Image src={mediaSrc} alt={titulo} width={800} height={450} class="w-full h-full object-cover!" />
            )
        }
        {!mediaSrc && <span class="placeholder">VIDEO TUTORIAL</span>}

        <span class="capa" aria-hidden="true">
            <i class="fa-solid fa-play play"></i>
        </span>
        <span class="etiqueta">VIDEO TUTORIAL</span>
    </div>

    {texto && <p class="texto">{texto}</p>}
</article>

<style>
    .card-video {
        display: flex;
        flex-direction: column;
        background: var(--surface-brand-primary);
        border: 2px dashed var(--brand-interactive-base);
        padding: 1rem;
    }

    .titulo {
        margin: 0 0 0.85rem;
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        color: var(--neutral-text-inverted);
        text-transform: uppercase;
        font-size: 2rem;
        line-height: 1;
        overflow-wrap: anywhere;
    }

    .miniatura {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 16 / 9;
        background: var(--custom-color-01);
        overflow: hidden;
    }

    .video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .placeholder {
        font-family: var(--font-sharp-sans-medium);
        color: var(--accent-highlight-primary);
        font-size: 0.8rem;
        text-align: center;
        padding: 1rem;
        letter-spacing: 0.08em;
    }

    .capa {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
    }

    .play {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 999px;
        background: var(--brand-interactive-base);
        color: var(--surface-brand-primary);
        font-size: 1.35rem;
        line-height: 1;
    }

    .etiqueta {
        position: absolute;
        left: 0.75rem;
        bottom: 0.75rem;
        background: var(--surface-brand-secondary);
        color: var(--surface-brand-primary);
        font-family: var(--font-sharp-sans-bold);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 0.75rem;
        line-height: 1;
        padding: 0.4rem 0.6rem;
    }

    .texto {
        margin: 0.9rem 0 0;
        font-family: var(--font-sharp-sans-medium);
        color: var(--neutral-text-inverted);
        font-size: 0.9rem;
        line-height: 1.4;
    }
</style>
