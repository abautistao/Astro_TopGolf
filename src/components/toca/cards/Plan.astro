---
import { getStrapiUrl } from "../../../lib/strapi.js";
import { Image } from "astro:assets";

interface Props {
    titulo?: string;
    precio?: string;
    badge?: string;
    imagen?: any;
    linea?: string;
    features?: { id?: number; texto?: string }[];
    texto_boton?: string;
    url_boton?: string;
    texto_enlace?: string;
    url_enlace?: string;
}

const {
    titulo = "",
    precio = "",
    badge = "",
    imagen = null,
    linea = "",
    features = [],
    texto_boton = "",
    url_boton = "",
    texto_enlace = "",
    url_enlace = ""
} = Astro.props;

const imgSrc = getStrapiUrl(imagen);
// La foto puede venir de Strapi (URL remota) o ser un asset local (solo para el dummy).
const esAssetLocal = Boolean(imagen?.src);
---

<article class="plan-card">
    <header class="plan-cabecera">
        <span class="plan-titulo">{titulo}</span>
        <span class="plan-precio">{precio}</span>
    </header>

    {badge && <span class="plan-badge">{badge}</span>}

    <div class="plan-foto">
        {esAssetLocal ? (
                <Image src={imagen} alt={titulo} class="w-full! h-full! object-cover!" />
            ) : imgSrc ? (
                <Image src={imgSrc} alt={titulo} width={800} height={520} class="w-full! h-full! object-cover!" />
            ) : (
                <span class="plan-placeholder">FOTO · {titulo}</span>
            )
        }
    </div>

    <div class="plan-cuerpo">
        {linea && <p class="plan-linea">{linea}</p>}

        {
            Array.isArray(features) && features.length > 0 && (
                <ul class="plan-lista">
                    {features.map((item) => (
                        <li class="plan-item">
                            <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                            <span>{item.texto}</span>
                        </li>
                    ))}
                </ul>
            )
        }

        {texto_boton && <a href={url_boton || "#"} class="plan-boton">{texto_boton}</a>}

        {texto_enlace && <a href={url_enlace || "#"} class="plan-enlace">{texto_enlace}</a>}
    </div>
</article>

<style>
    .plan-card {
        position: relative;
        display: flex;
        flex-direction: column;
        background: var(--surface-brand-primary);
        border: 2px solid var(--brand-interactive-base);
        /* Sin padding: la banda del encabezado va a sangre contra el borde,
           como en la ficha. El padding vive en el cuerpo. */
        padding: 0;
        /* Permite que el titulo se ajuste al ancho de la card (container query). */
        container-type: inline-size;
    }

    .plan-cabecera {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: stretch;
        gap: 0;
        margin-bottom: 0;
    }

    .plan-titulo {
        min-width: 0;
        background: var(--brand-interactive-base);
        color: var(--surface-brand-primary);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        text-transform: uppercase;
        /* 5.5cqw: el tamano sigue al ancho de la card, asi el titulo no parte
           a media palabra en cards estrechas (2 columnas en tablet). */
        font-size: clamp(0.8rem, 5.5cqw, 1.35rem);
        line-height: 1;
        padding: 0.65rem 0.55rem;
        overflow-wrap: break-word;
    }

    .plan-precio {
        background: var(--surface-brand-secondary);
        color: var(--surface-brand-primary);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        font-weight: 700;
        text-transform: uppercase;
        font-size: clamp(0.75rem, 4.6cqw, 1.15rem);
        line-height: 1;
        padding: 0.65rem 0.55rem;
        display: flex;
        align-items: center;
        white-space: nowrap;
    }

    .plan-badge {
        position: absolute;
        top: -0.85rem;
        right: 2.5rem;
        z-index: 2;
        transform: rotate(-8deg);
        background: var(--brand-interactive-base);
        color: var(--surface-brand-primary);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        text-transform: uppercase;
        font-size: 0.85rem;
        padding: 0.25rem 0.5rem;
    }

    .plan-foto {
        position: relative;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
        aspect-ratio: 4 / 3;
        background: var(--custom-color-01);
        overflow: hidden;
        padding: 1.25rem;
    }

    /* El placeholder de la ficha es un recuadro punteado con el texto arriba. */
    .plan-placeholder {
        flex: 1 1 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        border: 2px dashed var(--accent-highlight-primary);
        color: var(--accent-highlight-primary);
        font-family: var(--font-sharp-sans-medium);
        text-transform: uppercase;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        padding: 1rem;
    }

    .plan-cuerpo {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        padding: 0.9rem 0.75rem 1rem;
    }

    .plan-linea {
        font-family: var(--font-sharp-sans-bold);
        color: var(--surface-brand-secondary);
        text-transform: uppercase;
        font-size: 0.85rem;
        line-height: 1.25;
        margin: 0;
    }

    .plan-lista {
        list-style: none;
        padding: 0;
        margin: 1rem 0 1.25rem;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        flex: 1 1 auto;
    }

    .plan-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        color: var(--neutral-text-inverted);
        font-family: var(--font-sharp-sans-medium);
        text-transform: uppercase;
        font-size: 0.85rem;
        line-height: 1.3;
    }

    .plan-item i {
        color: var(--brand-interactive-base);
        font-size: 1rem;
        line-height: 1.1;
    }

    .plan-boton {
        display: block;
        text-align: center;
        background: var(--surface-brand-secondary);
        color: var(--surface-brand-primary);
        font-family: var(--font-titling-gothic-fb-extended-bold);
        text-transform: uppercase;
        /* Fluido con el ancho de la card: 'COTIZA CON UN ASESOR' no debe partirse.
           El factor esta calibrado para la fuente de respaldo (1.2em por caracter);
           con la condensada del diseno se puede subir hasta el tope de 1.5rem. */
        font-size: clamp(0.72rem, 3.6cqw, 1.5rem);
        padding: 0.85rem 0.5rem;
        box-shadow: 4px 4px 0 0 var(--brand-interactive-base);
        transition: transform 0.2s ease;
    }

    .plan-boton:hover {
        transform: translate(-2px, -2px);
    }

    .plan-enlace {
        display: inline-block;
        align-self: center;
        margin-top: 1rem;
        font-family: var(--font-sharp-sans-medium);
        color: var(--accent-highlight-primary);
        text-decoration: underline;
        font-size: 0.8rem;
    }
</style>
