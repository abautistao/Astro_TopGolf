---
import { stringifyRichText } from "../../lib/strapi";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    titulo: string;
    descripcion: string;
    Boton: Boton | null;
}

const {
    titulo = "FOOD & DRINK MENU",
    descripcion = "Our menu has something for every moment – from shareable bites perfect for inside the box while you play, to hearty mains to enjoy before or after the action. Great food, great vibes, game on! It’s a little bit of everything!",
    Boton = null,
} = Astro.props;

// Fallback button if none provided from Strapi
const boton_data: Boton[] = Boton
    ? [Boton]
    : [
        {
            id: 1,
            texto: "FOOD + DRINK MENU",
            url: "#",
            tipo: "version_3", // Use a valid type from Button component
        },
    ];

const descripcionHtml = stringifyRichText(descripcion);
---

<section class="w-full bg-[var(--surface-brand-primary)] py-12 lg:py-15 px-4">
    <div class="max-w-4xl mx-auto flex flex-col items-center text-center">
        <!-- Title -->
        <h2
            class="text-white text-4xl lg:text-7xl font-bold uppercase mb-6 font-(family-name:--font-titling-gothic-fb-extended-bold) leading-none tracking-wide"
        >
            {titulo}
        </h2>

        <!-- Description -->
        <div
            class="text-[var(--accent-feedback-strong)] text-base lg:text-xl font-(family-name:--font-sharp-sans-medium) leading-relaxed max-w-3xl mb-10 opacity-90 strapi-rich-text"
        >
            <Fragment set:html={descripcionHtml} />
        </div>

        <!-- CTA Button -->
        <div class="w-full flex justify-center">
            <Button
                botones={boton_data}
                clase="inline-block  text-black font-bold uppercase py-4 px-10 text-lg lg:text-2xl hover:scale-105 transition-transform font-(family-name:--font-titling-gothic-fb-extended-bold) tracking-wider w-full md:w-auto"
            />
        </div>
    </div>
</section>

<style>
    /* Ensure rich text links inherit color or have specific style if needed */
    .strapi-rich-text a {
        color: var(--brand-interactive-base);
        text-decoration: underline;
    }
</style>
