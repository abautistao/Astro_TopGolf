---
import { stringifyRichText } from "../../lib/strapi";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    titulo: string;
    descripcion: string;
    Boton: Boton | null;
}

const {
    titulo = "FOOD & DRINK MENU",
    descripcion = "Our menu has something for every moment – from shareable bites perfect for inside the box while you play, to hearty mains to enjoy before or after the action. Great food, great vibes, game on! It’s a little bit of everything!",
    Boton = null,
} = Astro.props;

// Fallback button if none provided from Strapi
const boton_data: Boton[] = Boton
    ? [Boton]
    : [
        {
            id: 1,
            texto: "FOOD + DRINK MENU",
            url: "#",
            tipo: "version_3", // Use a valid type from Button component
        },
    ];

const descripcionHtml = stringifyRichText(descripcion);
---

<section class="trigger-anim-menu w-full bg-[var(--surface-brand-primary)] py-12 lg:py-15 px-4">

    <div class="anim-fade max-w-4xl mx-auto flex flex-col items-center text-center">
        <h2
            class="text-[var(--accent-feedback-strong)] text-4xl lg:text-3xl font-bold uppercase mb-6 font-(family-name:--font-titling-gothic-fb-extended-bold) leading-none tracking-wide"
        >
            {titulo}
        </h2>

        <div
            class="text-[var(--accent-feedback-strong)] text-base lg:text-xl font-(family-name:--font-sharp-sans-medium) leading-relaxed max-w-3xl mb-10 opacity-90 strapi-rich-text"
        >
            <Fragment set:html={descripcionHtml} />
        </div>

        <div class="w-full flex justify-center">
            <Button
                botones={boton_data}
                clase="inline-block  text-black font-bold uppercase py-4 px-10 text-lg lg:text-2xl hover:scale-105 transition-transform font-(family-name:--font-titling-gothic-fb-extended-bold) tracking-wider w-full md:w-auto"
            />
        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', initObserver);
    document.addEventListener('DOMContentLoaded', initObserver);

    function initObserver() {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.2 // Se activa cuando el 20% es visible
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-menu');
        targets.forEach(target => observer.observe(target));
    }
</script>

<style>
    /* Ensure rich text links inherit color or have specific style if needed */
    .strapi-rich-text a {
        color: var(--brand-interactive-base);
        text-decoration: underline;
    }

    /* --- CAMBIO 4: ESTILOS DE ANIMACIÓN --- */
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .anim-fade {
        opacity: 0; /* Oculto por defecto */
    }

    /* Se anima solo cuando el padre tiene .is-visible */
    :global(.trigger-anim-menu.is-visible) .anim-fade {
        animation: fadeInUp 3s ease-out forwards;
    }
</style>