---
// src/components/toca/Component_6.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';

interface CardData {
    id: number;
    titulo: string;
    descripcion: any;
    bullets: any;
    imagen: any;
    imagen_decoracion: any;
}

interface Props {
    titulo_seccion?: string;
    cards?: CardData[];
}

const {
    titulo_seccion = "OUR GAMES",
    cards = []
} = Astro.props;

const defaultGames = [
    {
        titulo: "ATOM SPLITTER",
        descripcion: "Splitting the atom has never been so easy...",
        bullets: "<ul><li>Hit the atoms.</li></ul>",
        imagen: null,
        imagen_decoracion: null
    }
];

const dataToRender = cards && cards.length > 0 ? cards : defaultGames;
---

<section class="trigger-anim-games w-full bg-[var(--surface-brand-primary)] py-6 lg:py-4 overflow-hidden relative text-[var(--accent-feedback-strong)]">
    <div class="anim-fade max-w-[1280px] mx-auto px-6 sm:px-12 relative z-10">

        <h2 class="w-fit mx-auto font-(family-name:--font-titling-gothic-fb-extended-bold) font-bold text-2xl lg:text-[40px] uppercase leading-[1] tracking-normal text-center mb-2 lg:mb-8 text-[var(--accent-feedback-strong)]">
            {titulo_seccion}
        </h2>

        <div class="flex lg:hidden justify-between items-center mb-6 w-full border-b border-[var(--accent-feedback-strong)]/10 pb-2">
            <div class="flex gap-2 pagination-dots mobile-dots">
                {dataToRender.map((_, index) => (
                    <div class={`w-3 h-3 rounded-full transition-colors duration-300 ${index === 0 ? 'bg-[var(--brand-interactive-base)]' : 'bg-[var(--surface-brand-primary)]'}`}></div>
                ))}
            </div>
            <div class="flex gap-8 items-center">
                <button class="prev-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors focus:outline-none active:scale-90">
                    <i class="fa-solid fa-play fa-rotate-180 text-2xl"></i>
                </button>
                <button class="next-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors focus:outline-none active:scale-90">
                    <i class="fa-solid fa-play text-2xl"></i>
                </button>
            </div>
        </div>

        <div id="games-slider" class="flex w-full overflow-x-auto overflow-y-hidden scroll-smooth snap-x snap-mandatory pb-8 lg:pb-16 no-scrollbar">
            {dataToRender.map((juego: any, index: number) => {

                const imgUrl = getStrapiUrl(juego.imagen);
                const decoUrl = getStrapiUrl(juego.imagen_decoracion);

                const descHtml = typeof juego.descripcion === 'string'
                    ? `<p>${juego.descripcion}</p>`
                    : stringifyRichText(juego.descripcion);

                const bulletsHtml = typeof juego.bullets === 'string'
                    ? juego.bullets
                    : stringifyRichText(juego.bullets);

                return (
                    <div class="w-full min-w-full shrink-0 snap-center relative flex justify-center" data-index={index}>
                        <div class="w-full grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-y-2 lg:gap-x-16 items-start">

                            <div class="order-1 relative group flex flex-col">
                                <h3 class="font-(family-name:--font-titling-gothic-fb-extended-bold) font-bold text-2xl lg:text-4xl mb-2 uppercase text-[var(--accent-feedback-strong)] leading-none  text-left w-min lg:w-auto lg:whitespace-nowrap">
                                    {juego.titulo}
                                </h3>

                                <div class="w-full aspect-[16/9] lg:aspect-[21/9] relative z-10 bg-[var(--surface-brand-primary)]">
                                    <Image
                                        src={imgUrl || "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo"}
                                        alt={juego.titulo}
                                        class="w-full h-full object-cover"
                                        width={1000}
                                        height={600}
                                    />
                                </div>

                                {decoUrl && (
                                    <div class="hidden lg:block absolute lg:-bottom-12 lg:-right-25 z-30 pointer-events-none lg:w-[160px] lg:h-[160px]">
                                        <Image
                                            src={decoUrl}
                                            alt="Decoration"
                                            width={160}
                                            height={160}
                                            class="w-full h-full object-contain animate-pulse-slow mix-blend-screen"
                                        />
                                    </div>
                                )}
                            </div>

                            <div class="order-2 flex flex-col relative mt-4 lg:mt-8 lg:pl-4">
                                <div class="font-(family-name:--font-titling-gothic-fb-extended-bold) text-lg lg:text-xl font-bold mb-4 leading-tight rich-text-content text-[var(--surface-brand-secondary)] lg:text-[var(--brand-interactive-base)] lg:uppercase">
                                    <Fragment set:html={descHtml} />
                                </div>

                                <div class="font-(family-name:--font-sharp-sans-medium) font-medium text-sm strapi-bullets text-[var(--accent-feedback-strong)]">
                                    <Fragment set:html={bulletsHtml} />
                                </div>
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>

        <div class="hidden lg:flex justify-between items-end mt-2 lg:-mt-16 relative z-20 px-1">
            <div class="flex gap-3 pagination-dots desktop-dots items-center h-12">
                {dataToRender.map((_, index) => (
                    <button
                        class={`dot-trigger w-2 h-2 rounded-full transition-all duration-300 border border-transparent focus:outline-none ${index === 0 ? 'bg-[var(--brand-interactive-base)] scale-125' : 'bg-gray-600 hover:bg-gray-400'}`}
                        data-target={index}
                        aria-label={`Go to slide ${index + 1}`}
                    >
                    </button>
                ))}
            </div>

            <div class="flex gap-8 items-center">
                <button class="prev-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors">
                    <i class="fa-solid fa-play fa-rotate-180 text-3xl"></i>
                </button>
                <button class="next-slide text-[var(--brand-interactive-base)] hover:text-[var(--brand-interactive-base)] transition-colors">
                    <i class="fa-solid fa-play text-3xl"></i>
                </button>
            </div>
        </div>

    </div>
</section>

<script>
    // El SCRIPT sigue exactamente igual
    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('DOMContentLoaded', initAll);

    function initAll() {
        initGameSlider();
        initObserver();
    }

    function initObserver() {
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.1
        };

        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        const targets = document.querySelectorAll('.trigger-anim-games');
        targets.forEach(target => observer.observe(target));
    }

    function initGameSlider() {
        const slider = document.getElementById('games-slider');
        if (!slider || slider.children.length === 0) return;

        const prevBtns = document.querySelectorAll('.prev-slide');
        const nextBtns = document.querySelectorAll('.next-slide');
        const dotTriggers = document.querySelectorAll('.dot-trigger');

        let currentIndex = 0;
        const totalSlides = slider.children.length;

        const updateDotsState = (index: number) => {
            const mobileContainer = document.querySelector('.mobile-dots');
            if (mobileContainer) {
                Array.from(mobileContainer.children).forEach((dot, i) => {
                    dot.className = `w-3 h-3 rounded-full transition-colors duration-300 ${i === index ? 'bg-[var(--brand-interactive-base)]' : 'bg-gray-600'}`;
                });
            }

            const desktopContainer = document.querySelector('.desktop-dots');
            if (desktopContainer) {
                Array.from(desktopContainer.children).forEach((btn, i) => {
                    const baseClasses = "dot-trigger w-3 h-3 rounded-full transition-all duration-300 border border-transparent focus:outline-none";
                    if (i === index) {
                        btn.className = `${baseClasses} bg-[var(--brand-interactive-base)] scale-125`;
                    } else {
                        btn.className = `${baseClasses} bg-gray-600 hover:bg-gray-400`;
                    }
                });
            }
        };

        const scrollToIndex = (index: number) => {
            if (index < 0) index = totalSlides - 1;
            if (index >= totalSlides) index = 0;

            currentIndex = index;
            const slideWidth = slider.clientWidth;

            slider.scrollTo({
                left: slideWidth * index,
                behavior: 'smooth'
            });
            updateDotsState(index);
        };

        prevBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            if(btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', () => scrollToIndex(currentIndex - 1));
        });

        nextBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            if(btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', () => scrollToIndex(currentIndex + 1));
        });

        dotTriggers.forEach((trigger) => {
             trigger.addEventListener('click', (e) => {
                const button = (e.target as HTMLElement).closest('button');
                if(!button) return;
                const targetIndex = parseInt(button.dataset.target || '0');
                scrollToIndex(targetIndex);
             });
        });

        let isScrolling: ReturnType<typeof setTimeout>;
        slider.addEventListener('scroll', () => {
            window.clearTimeout(isScrolling);
            isScrolling = setTimeout(() => {
                const slideWidth = slider.clientWidth;
                const newIndex = Math.round(slider.scrollLeft / slideWidth);

                if (newIndex !== currentIndex && newIndex >= 0 && newIndex < totalSlides) {
                    currentIndex = newIndex;
                    updateDotsState(currentIndex);
                }
            }, 100);
        });
    }
</script>

<style>
    /* ESTILOS BASE DEL SLIDER (SIN CAMBIOS) */
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

    .rich-text-content :global(p) { margin-bottom: 0.5rem; }
    .rich-text-content :global(strong) { color: inherit; font-weight: 900; }

    .strapi-bullets :global(ul) {
        list-style: none;
        padding-left: 0;
        margin-top: 0.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .strapi-bullets :global(li) {
        position: relative;
        padding-left: 1.25rem;
        color: white;
        font-size: text-sm;
        font-weight: 500;
        line-height: 1.375;
        letter-spacing: 0.025em;
    }

    .strapi-bullets :global(li::before) {
        content: '';
        position: absolute;
        left: 0;
        top: 0.5em;
        width: 0.375rem;
        height: 0.375rem;
        background-color: white;
        border-radius: 9999px;
    }

    /* --- CAMBIO EN LA VELOCIDAD DE ANIMACIÓN --- */

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .anim-fade {
        opacity: 0;
    }

    /* Aumentamos el tiempo a 3s para que sea mucho más lento */
    :global(.trigger-anim-games.is-visible) .anim-fade {
        animation: fadeInUp 3s ease-out forwards;
    }
</style>