---
// src/components/toca/OurGames.astro
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import { Image } from 'astro:assets';
import defaultAtomImage from '../../assets/path_atom.png';

interface GameProps {
    titulo: string;
    descripcion: string | any;
    bullets: string[];
    imagen: any;
}

interface Props {
    titulo_seccion?: string;
    imagen_decoracion?: any;
    juegos?: GameProps[];
}

const {
    titulo_seccion = "OUR GAMES",
    imagen_decoracion,
    juegos = [
        {
            titulo: "ATOM SPLITTER",
            descripcion: "Splitting the atom has never been so easy... In this game, the smaller atoms are worth more, so get splitting!",
            bullets: ["Hit the atoms to split them apart.", "Smaller atoms are worth more points.", "Supercharged atoms cause a chain reaction."],
            imagen: null
        },
        {
            titulo: "MR. GOALIE",
            descripcion: "Test your precision against the ultimate robo-keeper.",
            bullets: ["Aim for corners.", "Speed matters."],
            imagen: null
        }
    ]
} = Astro.props;

const strapiAtomUrl = getStrapiUrl(imagen_decoracion);
const finalDecoration = strapiAtomUrl || defaultAtomImage;
---

<section class="w-full bg-[#0a0a20] py-6 lg:py-6 overflow-hidden relative text-white">

    <div class="max-w-[1280px] mx-auto px-6 sm:px-12 relative z-10">

        <h2 class="text-center font-black text-4xl lg:text-7xl uppercase tracking-tighter title-condensed mb-2 lg:mb-8 text-white">
            {titulo_seccion}
        </h2>

        <div class="flex lg:hidden justify-between items-center mb-6 w-full border-b border-white/10 pb-2">
            <div class="flex gap-2 pagination-dots mobile-dots">
                {juegos.map((_, index) => (
                    <div class={`w-3 h-3 rounded-full transition-colors duration-300 ${index === 0 ? 'bg-[#66ffcc]' : 'bg-gray-600'}`}></div>
                ))}
            </div>
            <div class="flex gap-8 items-center">
                <button class="prev-slide text-[#66ffcc] hover:text-white transition-colors focus:outline-none active:scale-90">
                    <i class="fa-solid fa-play fa-rotate-180 text-2xl"></i>
                </button>
                <button class="next-slide text-[#66ffcc] hover:text-white transition-colors focus:outline-none active:scale-90">
                    <i class="fa-solid fa-play text-2xl"></i>
                </button>
            </div>
        </div>

        {/* SLIDER */}
        <div id="games-slider" class="flex w-full overflow-x-auto overflow-y-hidden scroll-smooth snap-x snap-mandatory pb-8 lg:pb-16 no-scrollbar">
            {juegos.map((juego, index) => {
                const imgUrl = getStrapiUrl(juego.imagen);
                const descHtml = typeof juego.descripcion === 'string'
                    ? `<p>${juego.descripcion}</p>`
                    : stringifyRichText(juego.descripcion);

                return (
                    <div class="w-full min-w-full shrink-0 snap-center relative flex justify-center" data-index={index}>
                        <div class="w-full grid grid-cols-1 lg:grid-cols-[1.6fr_1fr] gap-y-2 lg:gap-x-16 items-start">

                            <div class="order-1 relative group flex flex-col">
                                <h3 class="font-black text-4xl lg:text-5xl mb-2 uppercase wide-title text-white leading-[0.9] tracking-tighter text-left w-min lg:w-auto lg:whitespace-nowrap">
                                    {juego.titulo}
                                </h3>

                                <div class="w-full aspect-[16/9] lg:aspect-[21/9] relative z-10 bg-[#000015]">
                                    <Image
                                        src={imgUrl || "https://placehold.co/1200x800/0a0a2a/66ffcc?text=GAME+SCREEN"}
                                        alt={juego.titulo}
                                        class="w-full h-full object-cover"
                                        width={1000}
                                        height={600}
                                    />
                                </div>
                                <div class="hidden lg:block absolute lg:-bottom-12 lg:-right-20 z-30 pointer-events-none lg:w-[160px] lg:h-[160px]">
                                    <Image
                                        src={finalDecoration}
                                        alt=""
                                        width={160}
                                        height={160}
                                        class="w-full h-full object-contain animate-pulse-slow mix-blend-screen"
                                    />
                                </div>
                            </div>

                            <div class="order-2 flex flex-col relative mt-4 lg:mt-8 lg:pl-4">

                                <div class="text-[1.1rem] lg:text-xl font-bold mb-4 leading-tight rich-text-content text-[#d8b4fe]">
                                    <Fragment set:html={descHtml} />
                                </div>

                                {juego.bullets && juego.bullets.length > 0 && (
                                    <ul class="space-y-2">
                                        {juego.bullets.map((bullet) => (
                                            <li class="flex items-start text-white text-[0.95rem] lg:text-[0.95rem] font-medium tracking-wide leading-snug">
                                                <span class="mr-3 mt-[0.45em] w-1.5 h-1.5 rounded-full shrink-0 bg-white"></span>
                                                {bullet}
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>
        <div class="hidden lg:flex justify-between items-end mt-2 lg:-mt-16 relative z-20 px-1">
            <div class="flex gap-3 pagination-dots desktop-dots items-center h-12">
                {juegos.map((_, index) => (
                    <button class="dot-trigger p-2 focus:outline-none group" data-target={index} aria-label={`Go to slide ${index + 1}`}>
                        <div class={`w-2.5 h-2.5 rounded-full transition-all duration-300 group-hover:scale-125 ${index === 0 ? 'bg-[#66ffcc] scale-110' : 'bg-gray-700'}`}></div>
                    </button>
                ))}
            </div>

            <div class="flex gap-8 items-center">
                <button class="prev-slide text-[#66ffcc] hover:text-white transition-colors">
                    <i class="fa-solid fa-play fa-rotate-180 text-3xl"></i>
                </button>
                <button class="next-slide text-[#66ffcc] hover:text-white transition-colors">
                    <i class="fa-solid fa-play text-3xl"></i>
                </button>
            </div>
        </div>

    </div>
</section>

<script>
    document.addEventListener('astro:page-load', initGameSlider);
    document.addEventListener('DOMContentLoaded', initGameSlider);

    function initGameSlider() {
        const slider = document.getElementById('games-slider');
        if (!slider || slider.children.length === 0) return;

        const prevBtns = document.querySelectorAll('.prev-slide');
        const nextBtns = document.querySelectorAll('.next-slide');
        const dotTriggers = document.querySelectorAll('.dot-trigger');

        let currentIndex = 0;
        const totalSlides = slider.children.length;

        const updateDotsState = (index: number) => {
            // Update Mobile Dots
            const mobileContainer = document.querySelector('.mobile-dots');
            if (mobileContainer) {
                Array.from(mobileContainer.children).forEach((dot, i) => {
                    dot.className = `w-3 h-3 rounded-full transition-colors duration-300 ${i === index ? 'bg-[#66ffcc]' : 'bg-gray-600'}`;
                });
            }

            // Update Desktop Dots
            const desktopContainer = document.querySelector('.desktop-dots');
            if (desktopContainer) {
                Array.from(desktopContainer.children).forEach((btn, i) => {
                    const dotDiv = btn.firstElementChild;
                    if (dotDiv) {
                        dotDiv.className = `w-2.5 h-2.5 rounded-full transition-all duration-300 group-hover:scale-125 ${i === index ? 'bg-[#66ffcc] scale-110' : 'bg-gray-700'}`;
                    }
                });
            }
        };

        const scrollToIndex = (index: number) => {
            if (index < 0) index = totalSlides - 1;
            if (index >= totalSlides) index = 0;

            currentIndex = index;
            const slideWidth = slider.clientWidth;

            slider.scrollTo({
                left: slideWidth * index,
                behavior: 'smooth'
            });
            updateDotsState(index);
        };

        prevBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            btn.parentNode?.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', () => scrollToIndex(currentIndex - 1));
        });

        nextBtns.forEach(btn => {
            const newBtn = btn.cloneNode(true);
            btn.parentNode?.replaceChild(newBtn, btn);
            newBtn.addEventListener('click', () => scrollToIndex(currentIndex + 1));
        });

        dotTriggers.forEach((trigger) => {
             trigger.addEventListener('click', (e) => {
                const button = (e.target as HTMLElement).closest('button');
                if(!button) return;
                const targetIndex = parseInt(button.dataset.target || '0');
                scrollToIndex(targetIndex);
             });
        });

        let isScrolling: ReturnType<typeof setTimeout>;
        slider.addEventListener('scroll', () => {
            window.clearTimeout(isScrolling);
            isScrolling = setTimeout(() => {
                const slideWidth = slider.clientWidth;
                const newIndex = Math.round(slider.scrollLeft / slideWidth);

                if (newIndex !== currentIndex && newIndex >= 0 && newIndex < totalSlides) {
                    currentIndex = newIndex;
                    updateDotsState(currentIndex);
                }
            }, 100);
        });
    }
</script>

<style>
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
    .title-condensed {
        transform: scaleY(1.2);
    }
    .wide-title {
        letter-spacing: -0.02em;
    }
    .rich-text-content :global(p) {
        margin-bottom: 0.5rem;
    }
    .rich-text-content :global(strong) {
        color: inherit;
        font-weight: 900;
    }
</style>