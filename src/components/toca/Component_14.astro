---
import { stringifyRichText } from "../../lib/strapi";
import Icono from "../shared/Icono.astro";

interface Props {
  subtitulo: string;
  titulo: string;
  categorias_faq: any[]; // Array of categories, each with a list of preguntas
}

const {
  subtitulo = "TOCA SOCIAL FAQS",
  titulo = "THE IMPORTANT THINGS",
  categorias_faq = [],
} = Astro.props;

// Data structure expected from Strapi:
// categories_faq: [
//   {
//     label: "BOX BOOKING",
//     faqs: [
//       { pregunta: "How long will my game be?", respuesta: "..." },
//       ...
//     ]
//   },
//   ...
// ]

// Fallback data for preview
const fallbackData = [
    {
        label: "BOX BOOKING",
        faqs: [
            { pregunta: "How long will my game be?", respuesta: "Your game will last approximately 60 minutes." },
            { pregunta: "How do I make a booking?", respuesta: "You can book online or call our reservation team." },
            { pregunta: "Is the price per hour?", respuesta: "Yes, the price is calculated per hour per box." },
            { pregunta: "What are the prices to play?", respuesta: "Prices vary depending on the day and time." },
        ]
    },
    {
        label: "FOOD & DRINK",
        faqs: [
            { pregunta: "Can I pre-order food?", respuesta: "Yes, you can pre-order food packages." },
            { pregunta: "Do you have vegan options?", respuesta: "Yes, we have a variety of vegan options." },
        ]
    },
    {
        label: "EVENTS",
        faqs: [
            { pregunta: "Do you host private events?", respuesta: "Absolutely! We specialize in private events." },
        ]
    },
    {
        label: "VENUE",
        faqs: [
            { pregunta: "Is there parking?", respuesta: "There is public parking nearby." },
        ]
    }
];

const categories = categorias_faq?.length > 0 ? categorias_faq : fallbackData;
---

<section class="w-full bg-[var(--surface-brand-primary)] py-12 lg:py-20" x-data="{ activeTab: 0 }">
    <div class="max-w-[1000px] mx-auto px-4">
        
        <!-- Header -->
        <div class="text-center mb-12">
            <h3 class="text-white text-sm lg:text-base font-bold tracking-[0.2em] font-(family-name:--font-sharp-sans-medium) mb-2 uppercase">
                {subtitulo}
            </h3>
            <h2 class="text-white text-4xl lg:text-7xl font-bold uppercase font-(family-name:--font-titling-gothic-fb-extended-bold) leading-[0.9]">
                {titulo}
            </h2>
        </div>

        <!-- Custom Tabs Navigation -->
        <div class="flex flex-wrap border border-[var(--brand-interactive-base)] mb-12">
            {categories.map((cat: any, index: number) => (
                <button
                    class="flex-1 py-4 px-2 text-center text-lg lg:text-xl font-bold uppercase transition-colors duration-300 font-(family-name:--font-titling-gothic-fb-extended-bold) border-r border-[var(--brand-interactive-base)] last:border-r-0 hover:bg-[var(--brand-interactive-base)] hover:text-[var(--surface-brand-primary)]"
                    :class={`activeTab === ${index} ? 'bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)]' : 'text-white bg-transparent'`}
                    @click={`activeTab = ${index}`}
                >
                    {cat.label}
                </button>
            ))}
        </div>

        <!-- Tab Content -->
        <div>
            {categories.map((cat: any, index: number) => (
                <div x-show={`activeTab === ${index}`} style="display: none;">
                    
                    <div class="flex flex-col border-t border-[var(--neutral-stroke-weak)]">
                        {cat.faqs.map((faq: any) => (
                            <div x-data="{ expanded: false }" class="border-b border-[var(--neutral-stroke-weak)]">
                                <button 
                                    @click="expanded = !expanded" 
                                    class="w-full py-6 flex items-center justify-between text-left group"
                                >
                                    <span 
                                        class="text-[var(--brand-interactive-base)] font-bold text-lg lg:text-xl font-(family-name:--font-sharp-sans-medium) transition-colors group-hover:text-white"
                                        :class="expanded ? 'text-white' : 'text-[var(--brand-interactive-base)]'"
                                    >
                                        {faq.pregunta}
                                    </span>
                                    <span 
                                        class="text-[var(--brand-interactive-base)] transition-transform duration-300 transform"
                                        :class="expanded ? 'rotate-180 text-white' : ''"
                                    >
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                    </span>
                                </button>
                                
                                <div 
                                    x-show="expanded" 
                                    x-collapse
                                    class="pb-6 text-white text-base lg:text-lg opacity-90 font-(family-name:--font-sharp-sans-medium) leading-relaxed strapi-rich-text"
                                >
                                    {faq.respuesta ? <Fragment set:html={stringifyRichText(faq.respuesta)} /> : <p>{faq.respuesta}</p>}
                                </div>
                            </div>
                        ))}
                    </div>

                </div>
            ))}
        </div>

    </div>
</section>

<style>
    /* Styling for the borders to match the cyan/mint color */
    .border-\[var\(--brand-interactive-base\)\] {
        border-color: var(--brand-interactive-base);
    }
    
    .border-\[var\(--neutral-stroke-weak\)\] {
        border-color: rgba(255, 255, 255, 0.2);
    }

    div[x-show="true"] {
        display: block !important;
    }
</style>
