---
import TituloSeccion from "./cards/TituloSeccion.astro";
import CardFormato from "./cards/Formato.astro";

interface Props {
    titulo_seccion?: string;
    subtitulo?: string;
    tituloHtmlTag?: string | null;
    subtituloHtmlTag?: string | null;
    color_fondo_override?: string | null;
    cards?: any[];
}

const {
    titulo_seccion = "",
    subtitulo = "",
    tituloHtmlTag = null,
    subtituloHtmlTag = null,
    color_fondo_override = null,
    cards = []
} = Astro.props;
---

<section class="formatos" style={color_fondo_override ? `background: ${color_fondo_override}` : undefined}>
    <div class="contenedor">
        <TituloSeccion
            titulo={titulo_seccion}
            subtitulo={subtitulo}
            tituloTag={tituloHtmlTag}
            subtituloTag={subtituloHtmlTag}
        />

        <div class="grid">
            {Array.isArray(cards) && cards.map((card) => <CardFormato {...card} />)}
        </div>
    </div>
</section>

<style>
    /* Las clases propias del <style> scoped NO llevan el sufijo "!" (Astro
       las compila como .clase[data-astro-cid-...] y el token "clase!" no
       casaría). El sufijo "!" es sólo para las utilidades de Tailwind, que
       deben ganar a Bootstrap. */
    .formatos {
        background: var(--neutral-background-strong);
        padding: 3rem 1rem 4rem;
    }

    .contenedor {
        max-width: 1440px;
        margin: 0 auto;
    }

    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.5rem;
        margin-top: 3rem;
    }

    @media (min-width: 768px) {
        .grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (min-width: 1280px) {
        .grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>
