                    baseClasses +=
                        "text-black font-bold cursor-pointer hover:bg-gray-100";
                }

                dayDiv.className = baseClasses;
                dayDiv.textContent = i;

                if (!isPast) {
                    dayDiv.addEventListener("click", () => {
                        // Deselect all
                        const allDays =
