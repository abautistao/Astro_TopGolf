        renderCalendar();

        const btnExtraConfirm = document.getElementById("b7-btn-extra-confirm");
        if (btnExtraConfirm) {
            btnExtraConfirm.addEventListener("click", () => {
                goToStep(3);
            });
        }

        async function renderUpgrades(upsellCategories) {
            const container = document.getElementById(
                "step2-upgrades-container",
            );
            if (!container) return;

            // PREGUNTA PARA EL CLIENTE (A resolver mañana):
            // TODO: Consultar cómo se deben enviar las mejoras en el Payload de PUT /book.
            // Posibles campos: client_upgrades, upgrades, client_requests...

            if (!upsellCategories || upsellCategories.length === 0) {
                container.innerHTML =
                    '<div class="col-span-full p-8 text-center text-gray-500 font-bold border-2 border-dashed border-gray-300 bg-gray-50/50">No hay extras disponibles.</div>';
                return;
            }

            container.innerHTML =
                '<div class="col-span-full p-8 text-center"><i class="fa-solid fa-spinner fa-spin text-4xl mb-4 text-[var(--brand-interactive-base)]"></i></div>';

            try {
                let allUpgrades = [];
                const mainSec = document.getElementById("b7-main-section");
                const srToken = mainSec ? mainSec.dataset.token : "";

                // Fetch each category
                for (const catId of upsellCategories) {
                    const res = await fetch(
                        `https://api.sevenrooms.com/2_4/upgrade_categories/${catId}/upgrades`,
                        {
                            headers: { Authorization: srToken },
                        },
                    );
                    const json = await res.json();
                    if (json.data && json.data.upgrades) {
                        allUpgrades.push(...json.data.upgrades);
                    }
                }

                if (allUpgrades.length === 0) {
                    container.innerHTML =
                        '<div class="col-span-full p-8 text-center text-gray-500 font-bold border-2 border-dashed border-gray-300 bg-gray-50/50">No se encontraron extras.</div>';
                    return;
                }

                window._selectedUpgrades = [];
                (window as any)._allUpgrades = allUpgrades;

                container.innerHTML = allUpgrades
                    .map((u, idx) => {
                        const priceStr = u.price > 0 ? `${u.price}` : "Gratis";
                        return `
                    <div class="upgrade-card w-full flex flex-col group border border-gray-300 cursor-pointer hover:border-black transition-colors" data-id="${u.id}">
                        <div class="bg-[var(--surface-brand-primary)] text-white p-3 flex justify-between items-center h-[60px]">
                            <span class="font-[family-name:var(--font-principal)] text-[16px] font-bold uppercase tracking-wide leading-tight">${u.name}</span>
                            <div class="checkbox-ui w-6 h-6 border-2 border-white flex items-center justify-center transition-colors">
                                <i class="fa-solid fa-check text-white opacity-0 transition-opacity"></i>
                            </div>
                        </div>
                        <div class="p-4 bg-white text-black flex items-start flex-1 border-x border-gray-300">
                            <div class="font-[family-name:var(--font-secundaria)] text-[12px] text-gray-800 line-clamp-4">
                                ${u.description || ""}
                            </div>
                        </div>
                        <div class="p-4 bg-white flex justify-between items-center border border-gray-300 border-t-0 group-hover:bg-gray-50 transition-colors">
                            <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold tracking-tight">${priceStr}</span>
                            <div class="flex items-center gap-2">
                                <button type="button" class="qty-minus bg-gray-200 text-black w-8 h-8 flex items-center justify-center font-bold border border-gray-300 hover:bg-gray-300 transition-colors">-</button>
                                <span class="qty-val font-bold text-lg w-4 text-center">1</span>
                                <button type="button" class="qty-plus bg-[var(--brand-interactive-base)] text-black w-8 h-8 flex items-center justify-center font-bold border border-black hover:opacity-80 transition-opacity">+</button>
                            </div>
                        </div>
                    </div>`;
                    })
                    .join("");

                // Function to update overview upgrades
                function updateOverviewUpgrades() {
                    const overviewList = document.getElementById(
                        "overview-upgrades-list",
                    );
                    if (!overviewList) return;

                    const selectedCards = container.querySelectorAll(
                        ".upgrade-card.border-black",
                    );
                    if (selectedCards.length === 0) {
                        overviewList.innerHTML = `<span class="text-sm italic text-gray-500">Ningún extra seleccionado</span>`;
                        return;
                    }

                    let html = "";
                    selectedCards.forEach((c) => {
                        const name = c.querySelector("span").textContent;
                        const qty = c.querySelector(".qty-val").textContent;
                        html += `<div class="flex justify-between text-sm"><span>${qty}x ${name}</span></div>`;
                    });
                    overviewList.innerHTML = html;

                    if ((window as any)._updateOverviewTotal) {
                        (window as any)._updateOverviewTotal();
                    }
                }

                // Add toggle logic
                const cards = container.querySelectorAll(".upgrade-card");
                cards.forEach((card) => {
                    card.addEventListener("click", (e) => {
                        // Prevent toggling if clicked on +/- buttons
                        if (
                            (e.target as HTMLElement).closest(".qty-minus") ||
                            (e.target as HTMLElement).closest(".qty-plus")
                        ) {
                            return;
                        }

                        const isSelected =
                            card.classList.contains("border-black") &&
                            card.classList.contains("border-2");
                        const checkIcon = card.querySelector(".fa-check");
                        const checkUi = card.querySelector(".checkbox-ui");

                        if (isSelected) {
                            card.classList.remove("border-black", "border-2");
                            card.classList.add("border-gray-300", "border");
                            checkIcon.classList.add("opacity-0");
                            checkUi.classList.remove(
                                "bg-[var(--brand-interactive-base)]",
                                "border-[var(--brand-interactive-base)]",
                            );
                        } else {
                            card.classList.remove("border-gray-300", "border");
                            card.classList.add("border-black", "border-2");
                            checkIcon.classList.remove("opacity-0");
                            checkUi.classList.add(
                                "bg-[var(--brand-interactive-base)]",
                                "border-[var(--brand-interactive-base)]",
                            );
                        }
                        updateOverviewUpgrades();
                    });

                    // Quantity logic
                    const qtyMinus = card.querySelector(".qty-minus");
                    const qtyPlus = card.querySelector(".qty-plus");
                    const qtyVal = card.querySelector(".qty-val");

                    if (qtyMinus && qtyPlus && qtyVal) {
                        qtyMinus.addEventListener("click", (e) => {
                            let val = parseInt(qtyVal.textContent || "1", 10);
                            if (val > 1) {
                                qtyVal.textContent = (val - 1).toString();
                                updateOverviewUpgrades();
                            }
                        });
                        qtyPlus.addEventListener("click", (e) => {
                            let val = parseInt(qtyVal.textContent || "1", 10);
                            qtyVal.textContent = (val + 1).toString();
                            updateOverviewUpgrades();
                        });
                    }
                });
            } catch (e) {
                console.error(e);
                container.innerHTML =
                    '<div class="col-span-full p-8 text-center text-red-500 font-bold">Error cargando mejoras.</div>';
            }
        }

        // Booking Submission Logic
        const submitBtn = document.getElementById("b7-btn-submit");
        if (submitBtn) {
            submitBtn.addEventListener("click", async () => {
                // Collect Form Data
                const locationSelect = document.getElementById(
                    "location-select",
                ) as HTMLSelectElement;
                const venue_id = locationSelect ? locationSelect.value : "";

                const playersEl = document.getElementById("overview-players");
                const party_size = parseInt(playersEl?.textContent || "0", 10);

                // Date and Time (we need to parse it from the active slot and selected day)
                const activeSlot = document.querySelector(
                    ".time-slot-btn.active-slot",
                );
                let time = "00:00";
                if (activeSlot) {
                    const timeEl = activeSlot.querySelector(".tracking-tight");
                    const ampmEl = timeEl?.nextElementSibling;
                    if (timeEl && ampmEl) {
                        time = `${timeEl.textContent} ${ampmEl.textContent}`;
                    }
                }

                // Get selected date from calendar
                const activeDay = document.querySelector(
                    ".calendar-day.active-date",
                );
                const monthYearText =
                    document.getElementById("b7-calendar-month-year")
                        ?.textContent || "";
                const fallbackToday = new Date();
                let date = `${fallbackToday.getFullYear()}-${String(fallbackToday.getMonth() + 1).padStart(2, "0")}-${String(fallbackToday.getDate()).padStart(2, "0")}`;
                if (activeDay && monthYearText) {
                    const day = String(activeDay.textContent).padStart(2, "0");
                    const [monthName, year] = monthYearText.split(" ");
                    const monthNames = [
                        "JANUARY",
                        "FEBRUARY",
                        "MARCH",
                        "APRIL",
                        "MAY",
                        "JUNE",
                        "JULY",
                        "AUGUST",
                        "SEPTEMBER",
                        "OCTOBER",
                        "NOVEMBER",
                        "DECEMBER",
                    ];
                    const monthIdx = monthNames.indexOf(monthName) + 1;
                    const monthStr = String(monthIdx).padStart(2, "0");
                    date = `${year}-${monthStr}-${day}`;
                }

                // Personal Info
                const fname =
                    (document.getElementById("b7-fname") as HTMLInputElement)
                        ?.value || "";
                const lname =
                    (document.getElementById("b7-lname") as HTMLInputElement)
                        ?.value || "";
                const email =
                    (document.getElementById("b7-email") as HTMLInputElement)
                        ?.value || "";
                const phoneInput =
                    (document.getElementById("b7-phone") as HTMLInputElement)
                        ?.value || "";
                const phonePrefix =
                    (
                        document.getElementById(
                            "b7-phone-prefix",
                        ) as HTMLSelectElement
                    )?.value || "+52";
                const phone = phoneInput ? `${phonePrefix}${phoneInput}` : "";

                const diet =
                    (document.getElementById("b7-diet") as HTMLSelectElement)
                        ?.value || "";
                const dobDay =
                    (document.getElementById("b7-dob-day") as HTMLSelectElement)
                        ?.value || "";
                const dobMonth =
                    (
                        document.getElementById(
                            "b7-dob-month",
                        ) as HTMLSelectElement
                    )?.value || "";
                const dobYear =
                    (
                        document.getElementById(
                            "b7-dob-year",
                        ) as HTMLSelectElement
                    )?.value || "";
                const dob =
                    dobDay && dobMonth && dobYear
                        ? `${dobYear}-${dobMonth}-${dobDay}`
                        : "";

                const rawNotes =
                    (document.getElementById("b7-notes") as HTMLInputElement)
                        ?.value || "";
                const occasion =
                    (
                        document.getElementById(
                            "b7-occasion",
                        ) as HTMLSelectElement
                    )?.value || "";

                let combinedNotes = rawNotes || "Reservado vía Web";
                if (diet) combinedNotes += ` | Dieta: ${diet}`;
                if (occasion) combinedNotes += ` | Ocasión: ${occasion}`;
                if (dob) combinedNotes += ` | Cumpleaños: ${dob}`;

                if (!fname || !lname || !phoneInput) {
                    alert(
                        "Por favor, completa los campos requeridos (Nombre, Apellido, Teléfono).",
                    );
                    return;
                }

                const selectedSlot = (window as any)._selectedSlot;
                const access_persistent_id = selectedSlot
                    ? selectedSlot.access_persistent_id
                    : "";

                let costPerPerson = selectedSlot ? selectedSlot.cost || 0 : 0;
                const allUpgrades = (window as any)._allUpgrades || [];
                const client_upgrades = [];
                const selectedCards = document.querySelectorAll(
                    ".upgrade-card.border-black",
                );

                selectedCards.forEach((card) => {
                    const id = card.getAttribute("data-id");
                    const qtyEl = card.querySelector(".qty-val");
                    const quantity = parseInt(qtyEl?.textContent || "1", 10);
                    const upgrade = allUpgrades.find((u: any) => u.id === id);
                    if (upgrade) {
                        client_upgrades.push({
                            id: id,
                            price: upgrade.price || 0,
                            quantity: quantity,
                        });
                    }
                });

                const payment_subtotal = costPerPerson * party_size * 100;

                submitBtn.setAttribute("disabled", "true");
                const originalText = submitBtn.innerHTML;
                submitBtn.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> PROCESANDO...';
                submitBtn.classList.add("opacity-50", "pointer-events-none");

                try {
                    const response = await fetch("/api/book", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            venue_id,
                            date,
                            time,
                            party_size,
                            first_name: fname,
                            last_name: lname,
                            email,
                            phone,
                            notes: combinedNotes,
                            access_persistent_id,
                            payment_subtotal,
                            client_upgrades: client_upgrades,
                        }),
                    });

                    const result = await response.json();

                    if (response.ok && result.success) {
                        goToStep(4); // Show confirmation step
                    } else {
                        alert(
                            "Error al procesar la reserva: " +
                                (result.error || "Intenta nuevamente.") +
                                (result.sent_payload
                                    ? "\n\nPayload Enviado:\n" +
                                      decodeURIComponent(result.sent_payload)
                                    : ""),
                        );
                        console.error("Booking Error:", result);
                    }
                } catch (error) {
                    console.error("Network error", error);
                    alert("Error de red al procesar la reserva.");
                } finally {
                    submitBtn.removeAttribute("disabled");
                    submitBtn.innerHTML = originalText;
                    submitBtn.classList.remove(
                        "opacity-50",
                        "pointer-events-none",
                    );
                }
            });
        }
    };

    // Run on initial load and after Astro View Transitions
    initBooking();
    document.addEventListener("astro:page-load", initBooking);
</script>