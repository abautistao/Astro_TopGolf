---
// src/components/toca/BookingSeven2.astro
const token = import.meta.env.PUBLIC_SEVENROOMS_TOKEN;
let venues = [];
let apiError = null;
try {
    console.log("\n--- [DEBUG SERVER-SIDE] GET /venues Request starting ---");
    const res = await fetch("https://api.sevenrooms.com/2_4/venues", {
        headers: {
            Authorization: token,
        },
    });
    const json = await res.json();
    console.log(
        `--- [DEBUG SERVER-SIDE] GET /venues Response Status: ${res.status} ---`,
    );
    console.log("Response Body:", JSON.stringify(json, null, 2));

    if (json.data && json.data.results) {
        venues = json.data.results;

        // Debug GET /venues/{venue_id} for the first venue in the list
        if (venues.length > 0) {
            const firstVenueId = venues[0].id;
            console.log(
                `\n--- [DEBUG SERVER-SIDE] GET /venues/${firstVenueId} Request starting ---`,
            );
            const venueDetailRes = await fetch(
                `https://api.sevenrooms.com/2_4/venues/${firstVenueId}`,
                {
                    headers: { Authorization: token },
                },
            );
            const venueDetailJson = await venueDetailRes.json();
            console.log(
                `--- [DEBUG SERVER-SIDE] GET /venues/${firstVenueId} Response Status: ${venueDetailRes.status} ---`,
            );
            console.log(
                "Response Body:",
                JSON.stringify(venueDetailJson, null, 2),
            );
        }
    } else {
        apiError = json.msg || "Unknown error from API";
        console.error("SevenRooms API Error:", json);
    }
} catch (e) {
    console.error("Error fetching venues", e);
    apiError = e.message;
}
