                const today = new Date();
                const isToday =
                    currentDate.getMonth() === today.getMonth() &&
                    currentDate.getFullYear() === today.getFullYear() &&
                    i === today.getDate();
                const isPast =
                    currentDate.getFullYear() < today.getFullYear() ||
                    (currentDate.getFullYear() === today.getFullYear() &&
                        currentDate.getMonth() < today.getMonth()) ||
                    (currentDate.getFullYear() === today.getFullYear() &&
                        currentDate.getMonth() === today.getMonth() &&
                        i < today.getDate());

                let baseClasses =
                    "calendar-day py-2 transition-all select-none ";

