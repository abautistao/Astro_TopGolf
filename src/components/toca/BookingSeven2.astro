---
// src/components/toca/BookingSeven2.astro
---

<section class="min-h-screen bg-[var(--surface-brand-primary)] text-white w-full overflow-hidden font-[family-name:var(--font-secundaria)]">
    {/* TOP STEPPER */}
    <div class="w-full max-w-7xl mx-auto px-4 py-6 flex items-center justify-between border-b border-white/10">
        <button id="b7-btn-back" class="flex items-center gap-2 text-[var(--brand-interactive-base)] hover:text-white uppercase font-[family-name:var(--font-principal)] font-bold text-xl transition-colors opacity-50 pointer-events-none">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="3" d="M15 19l-7-7 7-7" />
            </svg>
            BACK
        </button>
        <div class="hidden md:flex flex-1 justify-center items-center gap-8 px-8">
            {/* Steps line */}
            <div class="flex items-center w-full max-w-2xl justify-between relative">
                <div class="absolute left-0 right-0 top-6 h-0.5 bg-white/20 -z-10"></div>
                {/* Step 1: Details */}
                <div id="step1-wrap" class="flex flex-col items-center gap-2">
                    <div id="step1-icon" class="w-12 h-12 rounded-full border-2 border-[var(--brand-interactive-base)] bg-[var(--surface-brand-primary)] flex items-center justify-center text-[var(--brand-interactive-base)] z-10 transition-colors">
                        <i class="fa-solid fa-user-group text-xl"></i>
                    </div>
                    <span id="step1-text" class="text-[var(--brand-interactive-base)] text-xs font-[family-name:var(--font-principal)] font-bold transition-colors">Details</span>
                </div>
                {/* Step 2: Extra Time */}
                <div id="step2-wrap" class="flex flex-col items-center gap-2 opacity-50 transition-opacity">
                    <div id="step2-icon" class="w-12 h-12 rounded-full border-2 border-white/50 bg-[var(--surface-brand-primary)] flex items-center justify-center text-white z-10 transition-colors">
                        <i class="fa-regular fa-clock text-xl"></i>
                    </div>
                    <span id="step2-text" class="text-white/50 text-xs font-[family-name:var(--font-principal)] transition-colors">Extra Time</span>
                </div>
                {/* Step 3: Packages */}
                <div id="step3-wrap" class="flex flex-col items-center gap-2 opacity-50 transition-opacity">
                    <div id="step3-icon" class="w-12 h-12 rounded-full border-2 border-white/50 bg-[var(--surface-brand-primary)] flex items-center justify-center text-white z-10 transition-colors">
                        <div class="flex gap-1"><i class="fa-solid fa-wine-bottle text-lg"></i><i class="fa-solid fa-wine-bottle text-lg"></i></div>
                    </div>
                    <span id="step3-text" class="text-white/50 text-xs font-[family-name:var(--font-principal)] transition-colors">Packages</span>
                </div>
                {/* Step 4: Payment */}
                <div id="step4-wrap" class="flex flex-col items-center gap-2 opacity-50 transition-opacity">
                    <div id="step4-icon" class="w-12 h-12 rounded-full border-2 border-white/50 bg-[var(--surface-brand-primary)] flex items-center justify-center text-white z-10 transition-colors">
                        <i class="fa-regular fa-credit-card text-xl"></i>
                    </div>
                    <span id="step4-text" class="text-white/50 text-xs font-[family-name:var(--font-principal)] transition-colors">Payment</span>
                </div>
                {/* Step 5: Confirmation */}
                <div id="step5-wrap" class="flex flex-col items-center gap-2 opacity-50 transition-opacity">
                    <div id="step5-icon" class="w-12 h-12 rounded-full border-2 border-white/50 bg-[var(--surface-brand-primary)] flex items-center justify-center text-white z-10 transition-colors">
                        <i class="fa-solid fa-medal text-xl"></i>
                    </div>
                    <span id="step5-text" class="text-white/50 text-xs font-[family-name:var(--font-principal)] transition-colors">Confirmation</span>
                </div>
            </div>
        </div>
    </div>

    {/* MAIN CONTENT GRID */}
    <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
        
        {/* RIGHT COLUMN (OVERVIEW) - Stacks on top on mobile */}
        <div class="lg:col-span-4 lg:col-start-9 flex flex-col gap-6 order-1 lg:order-2">
            
            {/* OVERVIEW PANEL STEP 1 */}
            <div id="overview-step-1" class="flex flex-col gap-6">
                <div class="bg-white text-black neo-shadow border-2 border-black w-full relative">
                    <div class="bg-[var(--brand-interactive-base)] py-2 px-4 border-b-2 border-black">
                        <h3 class="font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase tracking-wide">Overview</h3>
                    </div>
                    <div class="p-6 flex flex-col gap-4 relative">
                        <div class="flex flex-col sm:flex-row lg:flex-col justify-between sm:gap-8 lg:gap-4">
                            <div class="flex flex-col gap-4 flex-1">
                                <div class="flex items-center gap-4">
                                    <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-solid fa-location-dot"></i></span>
                                    <span class="font-bold text-lg">-</span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-solid fa-users"></i></span>
                                    <span class="font-bold text-lg" id="overview-players">-</span>
                                </div>
                            </div>
                            <div class="flex flex-col gap-4 flex-1 mt-4 sm:mt-0 lg:mt-0">
                                <div class="flex items-center gap-4">
                                    <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-solid fa-calendar-days"></i></span>
                                    <span class="font-bold text-lg">--/--/--</span>
                                </div>
                                <div class="flex items-center gap-4">
                                    <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-solid fa-clock"></i></span>
                                    <span class="font-bold text-lg">--:--</span>
                                </div>
                            </div>
                        </div>
                        <div class="flex justify-between items-center mt-6 border-t-2 border-dashed border-gray-300 pt-6">
                            <span class="font-[family-name:var(--font-principal)] text-[32px] font-bold uppercase">Total</span>
                            <span class="font-[family-name:var(--font-principal)] text-[32px] font-bold">$ --.--</span>
                        </div>
                    </div>
                </div>

                {/* EVENT BOOKINGS PANEL */}
                <div class="bg-[var(--brand-interactive-base)] text-black neo-shadow border-2 border-black w-full">
                    <div class="bg-[var(--brand-interactive-base)] py-2 px-4 border-b-2 border-black">
                        <h3 class="font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase tracking-wide">Event Bookings</h3>
                    </div>
                    <div class="p-6 flex flex-col gap-4">
                        <p class="font-[family-name:var(--font-secundaria)] text-[16px] font-medium leading-relaxed">
                            Want to elevate your experience or plan something bigger? Contact our dedicated sales team to discuss the needs of your event!
                        </p>
                        <a href="#" class="inline-block mt-2 bg-[var(--surface-brand-secondary)] text-black font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase px-6 py-2 border-2 border-black neo-shadow self-start hover:translate-x-1 hover:translate-y-1 hover:shadow-none transition-all">
                            Inquire Now
                        </a>
                    </div>
                </div>
            </div>
            
            {/* OVERVIEW PANEL STEP 2 */}
            <div id="overview-step-2" class="hidden flex-col gap-6">
                <div class="bg-white text-black w-full relative">
                    <div class="bg-[var(--brand-interactive-base)] py-2 px-4 border-b-2 border-transparent">
                        <h3 class="font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase tracking-wide">OVERVIEW</h3>
                    </div>
                    <div class="p-6 flex flex-col gap-4 relative">
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center gap-4">
                                <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-solid fa-location-dot"></i></span>
                                <span class="font-[family-name:var(--font-principal)] font-bold text-sm">Grandscape, Dallas</span>
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-solid fa-users"></i></span>
                                <span class="font-[family-name:var(--font-principal)] font-bold text-sm" id="overview-step2-players">2</span>
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-regular fa-calendar-days"></i></span>
                                <span class="font-[family-name:var(--font-principal)] font-bold text-sm">05/28/2026</span>
                            </div>
                            <div class="flex items-center gap-4">
                                <span class="text-[var(--surface-brand-secondary)] w-6 text-center text-xl"><i class="fa-regular fa-clock"></i></span>
                                <span class="font-[family-name:var(--font-principal)] font-bold text-sm">6:45 PM</span>
                            </div>
                            <div class="ml-10 text-[11px] font-[family-name:var(--font-secundaria)] text-gray-500 mt-1" id="overview-step2-duration">Duration: 75 minutes</div>
                            <div class="ml-10 text-[11px] font-[family-name:var(--font-secundaria)] italic text-gray-400" id="overview-step2-extra-text">Including 30 minutes extra time</div>
                        </div>
                        
                        <div class="bg-[var(--surface-brand-primary)] text-white p-4 flex flex-col gap-4 mt-2">
                            <div class="font-[family-name:var(--font-secundaria)] text-[11px] font-bold border-b border-white/20 pb-2">
                                1 x Game Box
                            </div>
                            <div class="flex justify-between items-center font-[family-name:var(--font-secundaria)] text-[11px]">
                                <span id="overview-step2-desc">2 Ages 18-21 - $16 per person</span>
                                <span class="font-bold" id="overview-step2-price">$32.00</span>
                            </div>
                            
                            <div id="overview-extra-row" class="flex flex-col gap-3 pt-3 border-t border-white/20">
                                <span class="font-bold font-[family-name:var(--font-secundaria)] text-[11px]">Extra time</span>
                                <div class="flex justify-between items-center font-[family-name:var(--font-secundaria)] text-[11px]">
                                    <div class="flex items-center gap-2 text-[var(--surface-brand-secondary)]">
                                        <i class="fa-regular fa-clock text-base"></i>
                                        <span class="text-white font-medium">30 minutes more of playing</span>
                                    </div>
                                    <span class="font-bold">$30.00</span>
                                </div>
                            </div>
                            <div id="overview-packages-list" class="flex flex-col gap-3 pt-3 border-t border-white/20 empty:hidden"></div>
                        </div>
                        
                        <div class="flex justify-between items-center mt-2">
                            <span class="font-[family-name:var(--font-principal)] text-[36px] font-bold uppercase tracking-tight">TOTAL</span>
                            <span class="font-[family-name:var(--font-principal)] text-[36px] font-bold tracking-tight" id="overview-step2-total">$67.12</span>
                        </div>
                    </div>
                    <div id="overview-step2-tax" class="bg-[var(--brand-interactive-base)] text-black p-3 text-[12px] font-bold uppercase w-full">
                        *TAX OF $5.12 ADDED (8.25%)
                    </div>
                </div>
            </div>

        </div>

        {/* LEFT COLUMN */}
        <div class="lg:col-span-8 lg:col-start-1 lg:row-start-1 flex flex-col gap-8 order-2 lg:order-1">
            
            <div id="step-1-details" class="flex flex-col gap-8">
                {/* SELECT LOCATION */}
            <div class="bg-white w-full border-2 border-black flex flex-col">
                <div class="bg-[var(--surface-brand-secondary)] py-2 px-4 border-b-2 border-black">
                    <h2 class="text-black font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase">Select Location</h2>
                </div>
                <div class="p-6 md:p-8 bg-white text-black">
                    <button id="location-btn" class="bg-white text-black font-[family-name:var(--font-principal)] text-[24px] md:text-[32px] font-bold uppercase px-8 py-4 border-2 border-black neo-shadow hover:bg-gray-50 transition-colors tracking-tight text-center lg:text-left inline-block">
                        Grandscape, Dallas
                    </button>
                </div>
            </div>

            {/* HOW MANY PLAYERS? */}
            <div class="bg-white w-full border-2 border-black flex flex-col">
                <div class="bg-[var(--surface-brand-secondary)] py-2 px-4 border-b-2 border-black">
                    <h2 class="text-black font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase">How Many Players?</h2>
                </div>
                <div class="p-6 md:p-8 bg-white text-black flex flex-col gap-6">
                    <p class="font-[family-name:var(--font-secundaria)] text-[16px] font-medium">
                        TOCA Social is great for groups of all sizes, but we find it most fun with 4 or more.
                    </p>
                    <div class="flex flex-col sm:flex-row flex-wrap gap-8 justify-start">
                        
                        {/* Group 1 */}
                        <div class="flex flex-col gap-2">
                            <span class="font-[family-name:var(--font-principal)] text-[16px] font-medium uppercase tracking-wide">21's and over</span>
                            <div class="flex items-center gap-2">
                                <button type="button" class="player-btn minus-btn bg-[var(--surface-brand-secondary)] w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-bold text-2xl hover:translate-y-px hover:translate-x-px hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all select-none">-</button>
                                <div class="player-count bg-white w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-[family-name:var(--font-principal)] font-bold text-2xl select-none">0</div>
                                <button type="button" class="player-btn plus-btn bg-[var(--surface-brand-secondary)] w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-bold text-2xl hover:translate-y-px hover:translate-x-px hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all select-none">+</button>
                            </div>
                        </div>

                        {/* Group 2 */}
                        <div class="flex flex-col gap-2">
                            <span class="font-[family-name:var(--font-principal)] text-[16px] font-medium uppercase tracking-wide">Age 18 - 20</span>
                            <div class="flex items-center gap-2">
                                <button type="button" class="player-btn minus-btn bg-[var(--brand-interactive-base)] w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-bold text-2xl hover:translate-y-px hover:translate-x-px hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all select-none">-</button>
                                <div class="player-count bg-white w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-[family-name:var(--font-principal)] font-bold text-2xl select-none">0</div>
                                <button type="button" class="player-btn plus-btn bg-[var(--brand-interactive-base)] w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-bold text-2xl hover:translate-y-px hover:translate-x-px hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all select-none">+</button>
                            </div>
                        </div>

                        {/* Group 3 */}
                        <div class="flex flex-col gap-2">
                            <span class="font-[family-name:var(--font-principal)] text-[16px] font-medium uppercase tracking-wide">UNDER 18's</span>
                            <div class="flex items-center gap-2">
                                <button type="button" class="player-btn minus-btn bg-[#B975FF] w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-bold text-2xl hover:translate-y-px hover:translate-x-px hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all select-none">-</button>
                                <div class="player-count bg-white w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-[family-name:var(--font-principal)] font-bold text-2xl select-none">0</div>
                                <button type="button" class="player-btn plus-btn bg-[#B975FF] w-12 h-12 border-2 border-black neo-shadow flex items-center justify-center font-bold text-2xl hover:translate-y-px hover:translate-x-px hover:shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] transition-all select-none">+</button>
                            </div>
                        </div>

                    </div>
                    
                    <div class="border-2 border-black p-4 mt-2 max-w-lg">
                        <div class="flex items-start gap-3 text-black/80 font-[family-name:var(--font-secundaria)]">
                            <div class="w-5 h-5 rounded-full bg-[var(--surface-brand-primary)] text-white flex items-center justify-center text-[10px] font-bold shrink-0 mt-0.5">
                                <i class="fa-solid fa-info"></i>
                            </div>
                            <p class="text-[14px] leading-relaxed italic">
                                Players under 21 years of age must always be supervised by at least one adult (no payment required for non playing adults)
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {/* SELECT DATE AND TIME */}
            <div class="bg-white w-full border-2 border-black flex flex-col mb-12">
                <div class="bg-[var(--surface-brand-secondary)] py-2 px-4 border-b-2 border-black">
                    <h2 class="text-black font-[family-name:var(--font-principal)] text-[20px] font-bold uppercase">Select Date and Time</h2>
                </div>
                <div class="p-6 md:p-8 bg-white text-black flex flex-col lg:flex-row gap-6">
                    {/* Calendar Outline */}
                    <div class="border-2 border-black w-full lg:w-[55%] shrink-0 h-fit">
                        <div class="bg-[var(--surface-brand-primary)] text-white p-3 flex justify-between items-center relative border-b-2 border-black">
                            <button id="b7-prev-month" class="w-8 h-8 flex items-center justify-center text-[var(--brand-interactive-base)] hover:text-white transition-colors">
                                <i class="fa-solid fa-play fa-rotate-180 text-sm"></i>
                            </button>
                            <span id="b7-calendar-month-year" class="font-[family-name:var(--font-principal)] text-[22px] font-bold uppercase tracking-widest">MAY 2026</span>
                            <button id="b7-next-month" class="w-8 h-8 flex items-center justify-center text-[var(--brand-interactive-base)] hover:text-white transition-colors">
                                <i class="fa-solid fa-play text-sm"></i>
                            </button>
                        </div>
                        <div id="b7-calendar-days-grid" class="p-4 grid grid-cols-7 gap-y-4 gap-x-2 text-center font-[family-name:var(--font-principal)] text-[14px] font-bold uppercase">
                            {/* Injected by JS */}
                        </div>
                    </div>
                    
                    {/* Placeholder before selection */}
                    <div id="time-slots-placeholder" class="w-full lg:w-[45%] flex flex-col justify-center items-center text-center p-8 border-2 border-dashed border-gray-300 bg-gray-50/50 min-h-[300px]">
                        <i class="fa-regular fa-calendar-check text-4xl text-gray-300 mb-4"></i>
                        <p class="font-[family-name:var(--font-secundaria)] text-gray-500 font-medium">Please select a date to view available times.</p>
                    </div>

                    {/* Time Slots */}
                    <div id="time-slots-container" class="hidden w-full lg:w-[45%] flex-col gap-3 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar">
                        
                        {/* Slot 1 */}
                        <button type="button" class="time-slot-btn bg-white text-black py-3 px-4 border-2 border-black transition-all w-full text-left shadow-[2px_2px_0px_0px_rgba(0,0,0,0.2)] hover:bg-gray-50 hover:translate-x-px hover:translate-y-px hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,0.2)] relative flex flex-row items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-3 h-3 rounded-full bg-gray-300 slot-dot transition-colors"></div>
                                <div class="flex items-baseline gap-1">
                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold tracking-tight">11:00</span>
                                    <span class="font-[family-name:var(--font-principal)] text-[16px] font-bold">AM</span>
                                </div>
                                <div class="flex flex-col ml-3">
                                    <span class="slot-subtext font-[family-name:var(--font-secundaria)] text-[11px] text-black/60 leading-tight transition-colors">45 minutes</span>
                                    <span class="slot-subtext font-[family-name:var(--font-secundaria)] text-[11px] text-black/60 leading-tight transition-colors">1 x Game Box</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="flex items-baseline">
                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold">$16</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-[12px] ml-1">p.p</span>
                                </div>
                                <i class="slot-info fa-solid fa-circle-info text-black text-lg transition-colors"></i>
                            </div>
                        </button>

                        {/* Slot 2 */}
                        <button type="button" class="time-slot-btn bg-white text-black py-3 px-4 border-2 border-black transition-all w-full text-left shadow-[2px_2px_0px_0px_rgba(0,0,0,0.2)] hover:bg-gray-50 hover:translate-x-px hover:translate-y-px hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,0.2)] relative flex flex-row items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-3 h-3 rounded-full bg-gray-300 slot-dot transition-colors"></div>
                                <div class="flex items-baseline gap-1">
                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold tracking-tight">11:15</span>
                                    <span class="font-[family-name:var(--font-principal)] text-[16px] font-bold">AM</span>
                                </div>
                                <div class="flex flex-col ml-3">
                                    <span class="slot-subtext font-[family-name:var(--font-secundaria)] text-[11px] text-black/60 leading-tight transition-colors">45 minutes</span>
                                    <span class="slot-subtext font-[family-name:var(--font-secundaria)] text-[11px] text-black/60 leading-tight transition-colors">1 x Game Box</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="flex items-baseline">
                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold">$16</span>
                                    <span class="font-[family-name:var(--font-secundaria)] text-[12px] ml-1">p.p</span>
                                </div>
                                <i class="slot-info fa-solid fa-circle-info text-black text-lg transition-colors"></i>
                            </div>
                        </button>

                        {/* Slot 3 */}
                        <button type="button" class="time-slot-btn bg-white text-black py-3 px-4 border-2 border-black transition-all w-full text-left shadow-[2px_2px_0px_0px_rgba(0,0,0,0.2)] hover:bg-gray-50 hover:translate-x-px hover:translate-y-px hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,0.2)] relative flex flex-row items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-3 h-3 rounded-full bg-gray-300 slot-dot transition-colors"></div>
                                <div class="flex items-baseline gap-1">
                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold tracking-tight">11:30</span>
                                    <span class="font-[family-name:var(--font-principal)] text-[16px] font-bold">AM</span>
                                </div>
                                <div class="flex flex-col ml-3">
                                    <span class="slot-subtext font-[family-name:var(--font-secundaria)] text-[11px] text-black/60 leading-tight transition-colors">45 minutes</span>
