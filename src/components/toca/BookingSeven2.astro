<script>
    // Astro scripts run as deferred modules, so DOM is already available
    const initBooking = () => {
        // Find a specific wrapper for this component to know if we are on the page
        const bookingWrapper = document.getElementById("step-1-details");
        if (!bookingWrapper) return; // Not on this page, exit

        let currentStep = 1;
        const totalSteps = 4;

        const goToStep = (stepIndex) => {
            if (stepIndex < 1 || stepIndex > totalSteps) return;

            // Hide all steps
            for (let i = 1; i <= totalSteps; i++) {
                const stepSuffix =
                    i === 1
                        ? "-details"
                        : i === 2
                          ? "-extra"
                          : i === 3
                            ? "-payment"
                            : "-confirmation";
                const s = document.getElementById(`step-${i}${stepSuffix}`);
                if (s) {
                    s.classList.add("hidden");
                    s.classList.remove("flex");
                }
            }

            // Show current step
            const currentSuffix =
                stepIndex === 1
                    ? "-details"
                    : stepIndex === 2
                      ? "-extra"
                      : stepIndex === 3
                        ? "-payment"
                        : "-confirmation";
            const target = document.getElementById(
                `step-${stepIndex}${currentSuffix}`,
            );
            if (target) {
                target.classList.remove("hidden");
                target.classList.add("flex");
            }

            // Update Overview
            const overview1 = document.getElementById("overview-step-1");
            const overview2 = document.getElementById("overview-step-2");
            if (stepIndex === 1) {
                if (overview2) {
                    overview2.classList.add("hidden");
                    overview2.classList.remove("flex");
                }
                if (overview1) {
                    overview1.classList.remove("hidden");
                    overview1.classList.add("flex");
                }
            } else {
                if (overview1) {
                    overview1.classList.add("hidden");
                    overview1.classList.remove("flex");
                }
                if (overview2) {
                    overview2.classList.remove("hidden");
                    overview2.classList.add("flex");
                }
            }

            // Update Stepper
            for (let i = 1; i <= totalSteps; i++) {
                const wrap = document.getElementById(`step${i}-wrap`);
                const icon = document.getElementById(`step${i}-icon`);
                const text = document.getElementById(`step${i}-text`);
                if (!wrap || !icon || !text) continue;

                // Reset classes (Inactive)
                wrap.classList.add("opacity-50");
                icon.className =
                    "w-12 h-12 rounded-full border border-white/20 bg-white/5 backdrop-blur-sm flex items-center justify-center text-white z-10 transition-all duration-300 transform scale-100";
                text.className =
                    "text-white/50 text-xs font-[family-name:var(--font-principal)] font-medium transition-all duration-300 tracking-wide mt-1";

                if (i < stepIndex) {
                    // Completed step
                    wrap.classList.remove("opacity-50");
                    icon.className =
                        "w-12 h-12 rounded-full border-2 border-[var(--brand-interactive-base)] bg-[var(--brand-interactive-base)] flex items-center justify-center text-black z-10 transition-all duration-300 transform scale-100";
                    text.className =
                        "text-[var(--brand-interactive-base)] text-xs font-[family-name:var(--font-principal)] font-bold transition-all duration-300 tracking-wide mt-1";
                } else if (i === stepIndex) {
                    // Current step
                    wrap.classList.remove("opacity-50");
                    icon.className =
                        "w-12 h-12 rounded-full border-2 border-[var(--brand-interactive-base)] bg-[var(--brand-interactive-base)] flex items-center justify-center text-black shadow-[0_0_15px_var(--brand-interactive-base)] z-10 transition-all duration-300 transform scale-110";
                    text.className =
                        "text-[var(--brand-interactive-base)] text-xs font-[family-name:var(--font-principal)] font-bold transition-all duration-300 tracking-wide mt-1";
                }
            }

            // Update back button
            const btnBack = document.getElementById("b7-btn-back");
