                            <label class="text-[14px] font-medium">País</label>
                            <div class="relative">
                                <select class="w-full appearance-none border border-gray-400 p-2 pr-8 focus:outline-none focus:border-[var(--surface-brand-primary)] bg-white rounded-none">
                                    <option>México</option>
                                    <option>Estados Unidos</option>
                                </select>
                                <i class="fa-solid fa-chevron-down absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 text-xs pointer-events-none"></i>
                            </div>
                        </div>

                        <div class="flex flex-col gap-3 mt-4 text-[13px] text-gray-700">
                            <p>Al suministrar tus datos de tarjeta, le permites a Toca Social Grandscape efectuar futuros cargos en tu tarjeta conforme a las condiciones estipuladas.</p>
                            
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="w-4 h-4 rounded-sm border-gray-400 accent-[var(--surface-brand-primary)]" />
                                <span class="underline">Cancellation Policy*</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="w-4 h-4 rounded-sm border-gray-400 accent-[var(--surface-brand-primary)]" />
                                <span>I agree to the <span class="underline">venue's required policy*</span></span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="w-4 h-4 rounded-sm border-gray-400 accent-[var(--surface-brand-primary)]" />
                                <span>I certify I am above the age of 18*</span>
                            </label>
                        </div>
                        
                    </div>
                </div>
            </div>
            
        </div>

    </div>
</section>

<style>
    .neo-shadow {
        box-shadow: 4px 4px 0px 0px rgba(0,0,0,1);
    }
    #location-btn.active-location {
        background-color: var(--surface-brand-primary) !important;
        color: white !important;
        text-shadow: -1px 0px 0px var(--brand-interactive-base), 1.5px 0px 0px var(--surface-brand-secondary);
    }
    
    .time-slot-btn.active-slot {
        background-color: var(--surface-brand-primary) !important;
        color: white !important;
        border-color: transparent !important;
    }
    .time-slot-btn.active-slot .slot-dot {
        background-color: rgba(255,255,255,0.5) !important;
    }
    .time-slot-btn.active-slot .slot-subtext {
        color: rgba(255,255,255,0.8) !important;
    }
    .time-slot-btn.active-slot .slot-info {
        color: rgba(255,255,255,0.8) !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(0,0,0,0.05);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: var(--surface-brand-secondary);
        border-radius: 10px;
    }
</style>

<script>
    // Astro scripts run as deferred modules, so DOM is already available
    const initBooking = () => {
        // Find a specific wrapper for this component to know if we are on the page
        const bookingWrapper = document.getElementById('step-1-details');
        if (!bookingWrapper) return; // Not on this page, exit

        let currentStep = 1;
        const totalSteps = 4;
        
        const goToStep = (stepIndex) => {
            if (stepIndex < 1 || stepIndex > totalSteps) return;
            
            // Hide all steps
            for(let i=1; i<=totalSteps; i++) {
                const s = document.getElementById(`step-${i}${i===1?'-details':i===2?'-extra':i===3?'-packages':'-payment'}`);
                if(s) {
                    s.classList.add('hidden');
                    s.classList.remove('flex');
                }
            }
            
            // Show current step
            const target = document.getElementById(`step-${stepIndex}${stepIndex===1?'-details':stepIndex===2?'-extra':stepIndex===3?'-packages':'-payment'}`);
            if (target) {
                target.classList.remove('hidden');
                target.classList.add('flex');
            }
            
            // Update Overview
            const overview1 = document.getElementById('overview-step-1');
            const overview2 = document.getElementById('overview-step-2');
            if (stepIndex === 1) {
                if(overview2) { overview2.classList.add('hidden'); overview2.classList.remove('flex'); }
                if(overview1) { overview1.classList.remove('hidden'); overview1.classList.add('flex'); }
            } else {
                if(overview1) { overview1.classList.add('hidden'); overview1.classList.remove('flex'); }
                if(overview2) { overview2.classList.remove('hidden'); overview2.classList.add('flex'); }
            }
            
            // Update Stepper
            for (let i = 1; i <= 5; i++) {
                const wrap = document.getElementById(`step${i}-wrap`);
                const icon = document.getElementById(`step${i}-icon`);
                const text = document.getElementById(`step${i}-text`);
                if (!wrap || !icon || !text) continue;
                
                // Reset classes
                wrap.classList.add('opacity-50');
                icon.classList.remove('border-[var(--brand-interactive-base)]', 'text-[var(--brand-interactive-base)]', 'bg-[var(--brand-interactive-base)]', 'text-[var(--surface-brand-primary)]');
                icon.classList.add('border-white/50', 'text-white', 'bg-[var(--surface-brand-primary)]');
                text.classList.remove('text-[var(--brand-interactive-base)]', 'font-bold');
                text.classList.add('text-white/50');
                
                if (i < stepIndex) {
                    // Completed step
                    wrap.classList.remove('opacity-50');
                    icon.classList.remove('border-white/50', 'text-white', 'bg-[var(--surface-brand-primary)]');
                    icon.classList.add('bg-[var(--brand-interactive-base)]', 'text-[var(--surface-brand-primary)]');
                    text.classList.remove('text-white/50');
                    text.classList.add('text-[var(--brand-interactive-base)]', 'font-bold');
                } else if (i === stepIndex) {
                    // Current step
                    wrap.classList.remove('opacity-50');
                    icon.classList.remove('border-white/50', 'text-white');
                    icon.classList.add('border-[var(--brand-interactive-base)]', 'text-[var(--brand-interactive-base)]');
                    text.classList.remove('text-white/50');
                    text.classList.add('text-[var(--brand-interactive-base)]', 'font-bold');
                }
            }

            // Update back button
            const btnBack = document.getElementById('b7-btn-back');
            if (btnBack) {
                if (stepIndex > 1) {
                    btnBack.classList.remove('opacity-50', 'pointer-events-none', 'text-white/50');
                    btnBack.classList.add('text-[var(--brand-interactive-base)]');
                } else {
                    btnBack.classList.add('opacity-50', 'pointer-events-none');
                    btnBack.classList.remove('text-[var(--brand-interactive-base)]');
                }
            }
            
            currentStep = stepIndex;
        };

        const btnBack = document.getElementById('b7-btn-back');
        if (btnBack) {
            btnBack.addEventListener('click', () => {
                if (currentStep > 1) {
                    goToStep(currentStep - 1);
                }
            });
        }

        const calendarGrid = document.getElementById('b7-calendar-days-grid');
        if (!calendarGrid) return;
        
        if (calendarGrid.dataset.initialized) {
            return;
        }
        calendarGrid.dataset.initialized = 'true';

        const minusBtns = document.querySelectorAll('.minus-btn');
        const plusBtns = document.querySelectorAll('.plus-btn');
        const overviewPlayers = document.getElementById('overview-players');
        const locationBtn = document.getElementById('location-btn');

        if (locationBtn) {
            locationBtn.addEventListener('click', () => {
                locationBtn.classList.toggle('active-location');
            });
        }

        function updateTotalPlayers() {
            let total = 0;
            document.querySelectorAll('.player-count').forEach(el => {
                total += parseInt(el.textContent || '0', 10);
            });
            if (overviewPlayers) {
                overviewPlayers.textContent = total > 0 ? total.toString() : '-';
            }
        }

        minusBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const countEl = (e.target as HTMLElement).nextElementSibling;
                if (countEl) {
                    let val = parseInt(countEl.textContent || '0', 10);
                    if (val > 0) {
                        val--;
                        countEl.textContent = val.toString();
                        updateTotalPlayers();
                    }
                }
            });
        });

        plusBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const countEl = (e.target as HTMLElement).previousElementSibling;
                if (countEl) {
                    let val = parseInt(countEl.textContent || '0', 10);
                    val++;
                    countEl.textContent = val.toString();
                    updateTotalPlayers();
                }
            });
        });

        const timeSlots = document.querySelectorAll('.time-slot-btn');
        const step1Details = document.getElementById('step-1-details');
        const step2Extra = document.getElementById('step-2-extra');
        const overviewStep1 = document.getElementById('overview-step-1');
        const overviewStep2 = document.getElementById('overview-step-2');

        timeSlots.forEach(slot => {
            slot.addEventListener('click', () => {
                timeSlots.forEach(s => s.classList.remove('active-slot'));
                slot.classList.add('active-slot');
                
                // Switch to Extra Time step after a brief delay
                setTimeout(() => {
                    goToStep(2);
                }, 400); // 400ms delay to feel the click
            });
        });

        // JS Generated Calendar
        const monthNames = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"];
        let currentDate = new Date(2026, 4, 1); // Start at May 2026 (Month is 0-indexed)

        const calendarMonthYear = document.getElementById('b7-calendar-month-year');
        const timeSlotsContainer = document.getElementById('time-slots-container');
        const timeSlotsPlaceholder = document.getElementById('time-slots-placeholder');

        function renderCalendar() {
            console.log("renderCalendar called. Month year element:", !!calendarMonthYear, "Grid element:", !!calendarGrid);
            if (!calendarMonthYear || !calendarGrid) return;
            
            calendarMonthYear.textContent = `${monthNames[currentDate.getMonth()]} ${currentDate.getFullYear()}`;
            calendarGrid.innerHTML = '';
            
            // Header row
            const daysOfWeek = ['SU', 'MO', 'TU', 'WE', 'TH', 'FR', 'SA'];
            daysOfWeek.forEach(d => {
                const div = document.createElement('div');
                div.className = 'text-black';
                div.textContent = d;
                calendarGrid.appendChild(div);
            });
            
            const firstDayIndex = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1).getDay();
            const lastDay = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0).getDate();
            console.log("Calendar bounds: firstDayIndex =", firstDayIndex, "lastDay =", lastDay);
            
            for (let i = 0; i < firstDayIndex; i++) {
                const emptyDiv = document.createElement('div');
                emptyDiv.className = 'text-gray-300 py-2';
                calendarGrid.appendChild(emptyDiv);
            }
            
            for (let i = 1; i <= lastDay; i++) {
                const dayDiv = document.createElement('div');
                // Fake today is May 27, 2026
                const isToday = (currentDate.getMonth() === 4 && currentDate.getFullYear() === 2026 && i === 27);
                const isPast = (currentDate.getFullYear() < 2026) || 
                               (currentDate.getFullYear() === 2026 && currentDate.getMonth() < 4) ||
                               (currentDate.getFullYear() === 2026 && currentDate.getMonth() === 4 && i < 27);
                
                let baseClasses = 'calendar-day py-2 transition-all select-none ';
                
                if (isPast) {
                    baseClasses += 'text-gray-300 font-medium';
                } else if (isToday) {
                    baseClasses += 'current-date bg-[var(--surface-brand-secondary)] border-2 border-black text-black cursor-pointer shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] font-bold scale-110 relative z-10';
                } else {
                    baseClasses += 'text-black font-bold cursor-pointer hover:bg-gray-100';
                }
                
                dayDiv.className = baseClasses;
                dayDiv.textContent = i;
                
                if (!isPast) {
                    dayDiv.addEventListener('click', () => {
                        // Deselect all
                        const allDays = calendarGrid.querySelectorAll('.calendar-day');
                        allDays.forEach(d => {
                            d.classList.remove('shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]', 'scale-110', 'relative', 'z-10');
                            if (!d.classList.contains('current-date')) {
                                d.classList.remove('bg-[var(--surface-brand-secondary)]', 'border-2', 'border-black');
                                d.classList.add('hover:bg-gray-100', 'font-bold');
                            }
                        });
                        
                        // Select clicked
                        dayDiv.classList.add('bg-[var(--surface-brand-secondary)]', 'border-2', 'border-black', 'shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]', 'scale-110', 'relative', 'z-10');
                        dayDiv.classList.remove('hover:bg-gray-100');
                        
                        // Show time slots
                        if (timeSlotsPlaceholder) timeSlotsPlaceholder.classList.add('hidden');
                        if (timeSlotsContainer) {
                            timeSlotsContainer.classList.remove('hidden');
                            timeSlotsContainer.classList.add('flex');
                        }
                    });
                }
                
                calendarGrid.appendChild(dayDiv);
            }
        }
        
        // Month Navigation
        const prevMonthBtn = document.getElementById('b7-prev-month');
        const nextMonthBtn = document.getElementById('b7-next-month');
        
        if (prevMonthBtn) {
            prevMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar();
            });
        }
        if (nextMonthBtn) {
            nextMonthBtn.addEventListener('click', () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar();
            });
        }
        
        // Initial Render
        renderCalendar();

        const btnConfirmExtra = document.getElementById('b7-btn-nothanks');
        if (btnConfirmExtra) {
            btnConfirmExtra.addEventListener('click', () => {
                goToStep(3);
            });
        }

        const btnPackagesConfirm = document.getElementById('b7-btn-packages-confirm');
        if (btnPackagesConfirm) {
            btnPackagesConfirm.addEventListener('click', () => {
                goToStep(4);
            });
        }

        let extraAdded = false;

        const updateTotals = () => {
            const basePrice = 32.00;
            const extraPrice = extraAdded ? 30.00 : 0.00;
            
            let packagesTotal = 0.00;
            const packagesListEl = document.getElementById('overview-packages-list');
            if (packagesListEl) {
                packagesListEl.innerHTML = '';
            }
            
            const pkgContainers = document.querySelectorAll('[data-pkg-name]');
            pkgContainers.forEach(container => {
                const qtyEl = container.querySelector('.pkg-qty');
                if (qtyEl) {
                    const qty = parseInt(qtyEl.textContent || '0', 10);
                    if (qty > 0) {
                        const name = container.getAttribute('data-pkg-name');
                        const price = parseFloat(container.getAttribute('data-pkg-price') || '0');
                        packagesTotal += (qty * price);
                        
                        if (packagesListEl) {
                            const row = document.createElement('div');
                            row.className = "flex justify-between items-center font-[family-name:var(--font-secundaria)] text-[11px]";
                            row.innerHTML = `
                                <div class="flex items-center gap-2 text-[var(--surface-brand-secondary)]">
                                    <i class="fa-solid fa-wine-bottle text-base"></i>
                                    <span class="text-white font-medium">${qty} x ${name}</span>
                                </div>
                                <span class="font-bold">$${(qty * price).toFixed(2)}</span>
                            `;
                            packagesListEl.appendChild(row);
                        }
                    }
                }
            });
            
            const subtotal = basePrice + extraPrice + packagesTotal;
            const tax = subtotal * 0.0825;
            const total = subtotal + tax;
            
            const overviewTotalEl = document.getElementById('overview-step2-total');
            const overviewTaxEl = document.getElementById('overview-step2-tax');
            
            if (overviewTotalEl) overviewTotalEl.textContent = '$' + total.toFixed(2);
            if (overviewTaxEl) overviewTaxEl.textContent = `*TAX OF $${tax.toFixed(2)} ADDED (8.25%)`;
        };

        // Toggle Extra Time
        const btnAddExtra = document.getElementById('btn-add-extra');
        const overviewDuration = document.getElementById('overview-step2-duration');
        const overviewExtraText = document.getElementById('overview-step2-extra-text');
        const overviewExtraRow = document.getElementById('overview-extra-row');
        
        if (btnAddExtra) {
            btnAddExtra.addEventListener('click', () => {
                extraAdded = !extraAdded;
                if (extraAdded) {
                    btnAddExtra.innerHTML = '<i class="fa-solid fa-check"></i>';
                    btnAddExtra.classList.add('bg-white', 'text-[var(--surface-brand-primary)]');
                    btnAddExtra.classList.remove('bg-[var(--surface-brand-secondary)]');
                    
                    if (overviewDuration) overviewDuration.textContent = 'Duration: 75 minutes';
                    if (overviewExtraText) overviewExtraText.classList.remove('hidden');
                    if (overviewExtraRow) {
                        overviewExtraRow.classList.remove('hidden');
                        overviewExtraRow.classList.add('flex');
                    }
                } else {
                    btnAddExtra.textContent = '+';
                    btnAddExtra.classList.remove('bg-white', 'text-[var(--surface-brand-primary)]');
                    btnAddExtra.classList.add('bg-[var(--surface-brand-secondary)]');
                    
                    if (overviewDuration) overviewDuration.textContent = 'Duration: 45 minutes';
                    if (overviewExtraText) overviewExtraText.classList.add('hidden');
                    if (overviewExtraRow) {
                        overviewExtraRow.classList.add('hidden');
                        overviewExtraRow.classList.remove('flex');
                    }
                }
                updateTotals();
            });
        }

        // Package minus/plus buttons
        document.querySelectorAll('.pkg-minus-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const qtyEl = btn.nextElementSibling;
                if (qtyEl) {
                    let val = parseInt(qtyEl.textContent || '0', 10);
                    if (val > 0) {
                        val--;
                        qtyEl.textContent = val.toString();
                        updateTotals();
                    }
                }
            });
        });
        document.querySelectorAll('.pkg-plus-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const qtyEl = btn.previousElementSibling;
                if (qtyEl) {
                    let val = parseInt(qtyEl.textContent || '0', 10);
                    val++;
                    qtyEl.textContent = val.toString();
                    updateTotals();
                }
            });
        });
    };
    
    // Run on initial load and after Astro View Transitions
    initBooking();
    document.addEventListener('astro:page-load', initBooking);
</script>
