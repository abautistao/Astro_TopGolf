                                d.classList.remove(
                                    "bg-[var(--surface-brand-secondary)]",
                                    "border-2",
                                    "border-black",
                                );
                                d.classList.add(
                                    "hover:bg-gray-100",
                                    "font-bold",
                                );
                            }
                        });

                        // Select clicked
                        dayDiv.classList.add(
                            "active-date",
                            "bg-[var(--surface-brand-secondary)]",
                            "border-2",
                            "border-black",
                            "shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]",
                            "scale-110",
                            "relative",
                            "z-10",
                        );
                        dayDiv.classList.remove("hover:bg-gray-100");

                        // Update overview date
                        const mStr = String(
                            currentDate.getMonth() + 1,
                        ).padStart(2, "0");
                        const dStr = String(i).padStart(2, "0");
                        const yStr = currentDate.getFullYear();
                        const selectedDate = `${yStr}-${mStr}-${dStr}`;

                        const overviewDate =
                            document.getElementById("overview-date");
                        if (overviewDate)
                            overviewDate.textContent = selectedDate;
                        const overviewStep2Date = document.getElementById(
                            "overview-step2-date",
                        );
                        if (overviewStep2Date)
                            overviewStep2Date.textContent = selectedDate;

                        // Show time slots loading state
                        if (timeSlotsPlaceholder)
                            timeSlotsPlaceholder.classList.add("hidden");
                        if (timeSlotsContainer) {
                            timeSlotsContainer.classList.remove("hidden");
                            timeSlotsContainer.classList.add("flex");
                            timeSlotsContainer.innerHTML =
                                '<div class="p-8 text-center w-full"><i class="fa-solid fa-spinner fa-spin text-4xl mb-4 text-[var(--brand-interactive-base)]"></i><p class="font-bold text-gray-500">Cargando disponibilidad...</p></div>';

                            // Fetch from SevenRooms
                            const mainSec =
                                document.getElementById("b7-main-section");
                            const srToken = mainSec
                                ? mainSec.dataset.token
                                : "";
                            const locationSelect = document.getElementById(
                                "location-select",
                            ) as HTMLSelectElement;
                            const venueId = locationSelect
                                ? locationSelect.value
                                : "";

                            const overviewPlayers =
                                document.getElementById("overview-players");
                            let totalPlayers = parseInt(
                                overviewPlayers?.textContent || "0",
                                10,
                            );

                            if (!venueId) {
                                timeSlotsContainer.innerHTML =
                                    '<div class="p-8 text-center text-red-500 font-bold w-full">Por favor selecciona una ubicación primero.</div>';
                                return;
                            }
                            if (totalPlayers <= 0) {
                                timeSlotsContainer.innerHTML =
                                    '<div class="p-8 text-center text-red-500 font-bold w-full">Por favor selecciona el número de jugadores primero.</div>';
                                return;
                            }

                            const mStr = String(
                                currentDate.getMonth() + 1,
                            ).padStart(2, "0");
                            const dStr = String(i).padStart(2, "0");
                            const yStr = currentDate.getFullYear();
                            const dateStr = `${yStr}-${mStr}-${dStr}`;

                            let startTime = "00:00";
                            const now = new Date();
                            // If the selected date is today, use current time as start_time
                            if (
                                now.getFullYear() === yStr &&
                                now.getMonth() === currentDate.getMonth() &&
                                now.getDate() === i
                            ) {
                                const hours = String(now.getHours()).padStart(
                                    2,
                                    "0",
                                );
                                const minutes = String(
                                    now.getMinutes(),
                                ).padStart(2, "0");
                                startTime = `${hours}:${minutes}`;
                            }

                            const url = `https://api.sevenrooms.com/2_4/venues/${venueId}/availability?date=${dateStr}&start_time=${startTime}&end_time=23:59&party_size=${totalPlayers}`;
                            console.log(
                                "\n--- [DEBUG CLIENT-SIDE] GET /venues/{venue_id}/availability Request starting ---",
                            );
                            console.log("URL:", url);
                            console.log(
                                "Authorization Token:",
                                srToken.substring(0, 10) + "...",
                            );

                            // Fetch and log Venue Group Availability if venue_group_id is available
                            if (locationSelect) {
                                const selectedOption =
                                    locationSelect.options[
                                        locationSelect.selectedIndex
                                    ];
                                const venueGroupId =
                                    selectedOption.getAttribute(
                                        "data-venue-group-id",
                                    );
                                if (venueGroupId) {
                                    const groupUrl = `https://api.sevenrooms.com/2_4/venue_groups/${venueGroupId}/availability?date=${dateStr}&start_time=${startTime}&end_time=23:59&party_size=${totalPlayers}`;
                                    console.log(
                                        "--- [DEBUG CLIENT-SIDE] GET /venue_groups/{venue_group_id}/availability Request starting ---",
                                    );
                                    console.log("Group URL:", groupUrl);
                                    fetch(groupUrl, {
                                        headers: { Authorization: srToken },
                                    })
                                        .then((gRes) => {
                                            console.log(
                                                `--- [DEBUG CLIENT-SIDE] GET /venue_groups/{venue_group_id}/availability Response Status: ${gRes.status} ---`,
                                            );
                                            return gRes.json();
                                        })
                                        .then((gJson) => {
                                            console.log(
                                                "Group Response Body:",
                                                gJson,
                                            );
                                        })
                                        .catch((gErr) =>
                                            console.error(
                                                "Error debugging Venue Group Availability:",
                                                gErr,
                                            ),
                                        );
                                }
                            }

                            fetch(url, {
                                headers: { Authorization: srToken },
                            })
                                .then((res) => {
                                    console.log(
                                        `--- [DEBUG CLIENT-SIDE] GET /venues/{venue_id}/availability Response Status: ${res.status} ---`,
                                    );
                                    return res.json();
                                })
                                .then((json) => {
                                    console.log("Response Body:", json);
                                    if (json.data && json.data.availability) {
                                        let allTimes = [];
                                        json.data.availability.forEach(
                                            (shift: any) => {
                                                if (shift.times) {
                                                    const bookableTimes =
                                                        shift.times.filter(
                                                            (t: any) =>
                                                                t.type ===
                                                                "book",
                                                        );
                                                    bookableTimes.forEach(
                                                        (t: any) =>
                                                            (t.shiftUpsells =
                                                                (t.upsell_categories && t.upsell_categories.length > 0) ? t.upsell_categories : (shift.upsell_categories || [])),
                                                    );
                                                    allTimes.push(
                                                        ...bookableTimes,
                                                    );
                                                }
                                            },
                                        );

                                        if (allTimes.length === 0) {
                                            timeSlotsContainer.innerHTML =
                                                '<div class="p-8 text-center text-gray-500 font-bold w-full">No hay disponibilidad para esta fecha.</div>';
                                            return;
                                        }

                                        // Render time slots
                                        (window as any)._lastTimes = allTimes;
                                        timeSlotsContainer.innerHTML = allTimes
                                            .map((t: any, idx: number) => {
                                                const timeParts =
                                                    t.time.split(" ");
                                                const timeVal = timeParts[0];
                                                const timeAmPm =
                                                    timeParts[1] || "";
                                                const cost = t.cost
                                                    ? `$${t.cost}`
                                                    : "Gratis";
                                                const duration = t.duration
                                                    ? `${t.duration} minutos`
                                                    : " ";

                                                return `
                                        <button type="button" data-index="${idx}" class="time-slot-btn bg-white text-black py-3 px-4 border-2 border-black transition-all w-full text-left shadow-[2px_2px_0px_0px_rgba(0,0,0,0.2)] hover:bg-gray-50 hover:translate-x-px hover:translate-y-px hover:shadow-[1px_1px_0px_0px_rgba(0,0,0,0.2)] relative flex flex-row items-center justify-between">
                                            <div class="flex items-center gap-3">
                                                <div class="w-3 h-3 rounded-full bg-gray-300 slot-dot transition-colors"></div>
                                                <div class="flex items-baseline gap-1">
                                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold tracking-tight">${timeVal}</span>
                                                    <span class="font-[family-name:var(--font-principal)] text-[16px] font-bold">${timeAmPm}</span>
                                                </div>
                                                <div class="flex flex-col ml-3">
                                                    <span class="slot-subtext font-[family-name:var(--font-secundaria)] text-[11px] text-black/60 leading-tight transition-colors">${duration}</span>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <div class="flex items-baseline">
                                                    <span class="font-[family-name:var(--font-principal)] text-[24px] font-bold">${cost}</span>
                                                    <span class="font-[family-name:var(--font-secundaria)] text-[12px] ml-1">p.p</span>
                                                </div
                                            </div>
                                        </button>
                                        `;
                                            })
                                            .join("");

                                        // Rebind click events
                                        const newlyRenderedSlots =
                                            timeSlotsContainer.querySelectorAll(
                                                ".time-slot-btn",
                                            );
                                        newlyRenderedSlots.forEach((slot) => {
                                            slot.addEventListener(
                                                "click",
                                                () => {
                                                    newlyRenderedSlots.forEach(
                                                        (s) =>
                                                            s.classList.remove(
                                                                "active-slot",
                                                            ),
                                                    );
                                                    slot.classList.add(
                                                        "active-slot",
                                                    );

                                                    const idx = parseInt(
                                                        slot.getAttribute(
                                                            "data-index",
                                                        ) || "0",
                                                        10,
                                                    );
                                                    const selectedTime = (
                                                        window as any
                                                    )._lastTimes[idx];
                                                    (
                                                        window as any
                                                    )._selectedSlot =
                                                        selectedTime;

                                                    // Update overview time
                                                    const timeStr =
                                                        selectedTime.time; // e.g. "12:00 PM"
                                                    const overviewTime =
                                                        document.getElementById(
                                                            "overview-time",
                                                        );
                                                    if (overviewTime)
                                                        overviewTime.textContent =
                                                            timeStr;
                                                    const overviewStep2Time =
                                                        document.getElementById(
                                                            "overview-step2-time",
                                                        );
                                                    if (overviewStep2Time)
                                                        overviewStep2Time.textContent =
                                                            timeStr;

                                                    // Update duration dynamically
                                                    const overviewStep2Duration =
                                                        document.getElementById(
                                                            "overview-step2-duration",
                                                        );
                                                    if (overviewStep2Duration) {
                                                        const dur =
                                                            selectedTime.duration
                                                                ? `${selectedTime.duration} minutos`
                                                                : "1 x Caja de Juego";
                                                        overviewStep2Duration.textContent = `Duración: ${dur}`;
                                                    }

                                                    // Hide extra text since it's hardcoded and not provided by API
                                                    const overviewStep2ExtraText =
                                                        document.getElementById(
                                                            "overview-step2-extra-text",
                                                        );
                                                    if (overviewStep2ExtraText)
                                                        overviewStep2ExtraText.style.display =
                                                            "none";

                                                    // Update overview total (base cost + upgrades)
                                                    if (
                                                        (window as any)
                                                            ._updateOverviewTotal
                                                    ) {
                                                        (
                                                            window as any
                                                        )._updateOverviewTotal();
                                                    }

                                                    renderUpgrades(
                                                        selectedTime.shiftUpsells ||
                                                            [],
                                                    );
                                                    setTimeout(() => {
                                                        goToStep(2);
                                                    }, 400);
                                                },
                                            );
                                        });
                                    } else {
                                        timeSlotsContainer.innerHTML = `<div class="p-8 text-center text-red-500 font-bold w-full">Error: ${json.msg || "No se encontró disponibilidad."}</div>`;
                                    }
                                })
                                .catch((err) => {
                                    console.error(
                                        "Availability fetch error:",
                                        err,
                                    );
                                    timeSlotsContainer.innerHTML =
                                        '<div class="p-8 text-center text-red-500 font-bold w-full">Error de red</div>';
                                });
                        }
                    });
                }

                calendarGrid.appendChild(dayDiv);
            }
        }

        // Month Navigation
        const prevMonthBtn = document.getElementById("b7-prev-month");
        const nextMonthBtn = document.getElementById("b7-next-month");

        if (prevMonthBtn) {
            prevMonthBtn.addEventListener("click", () => {
                currentDate.setMonth(currentDate.getMonth() - 1);
                renderCalendar();
            });
        }
        if (nextMonthBtn) {
            nextMonthBtn.addEventListener("click", () => {
                currentDate.setMonth(currentDate.getMonth() + 1);
                renderCalendar();
            });
