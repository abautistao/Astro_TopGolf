        if (calendarGrid.dataset.initialized) {
            return;
        }
        calendarGrid.dataset.initialized = "true";

        const minusBtns = document.querySelectorAll(".minus-btn");
        const plusBtns = document.querySelectorAll(".plus-btn");
        const overviewPlayers = document.getElementById("overview-players");
        const locationSelect = document.getElementById(
            "location-select",
        ) as HTMLSelectElement;
        const overviewLocation = document.getElementById("overview-location");
        const overviewStep2Location = document.getElementById(
            "overview-step2-location",
        );

        // Function to calculate and update global totals
        (window as any)._updateOverviewTotal = function () {
            let totalBaseCost = 0;
            const overviewPlayersEl =
                document.getElementById("overview-players");
            const pSize = parseInt(overviewPlayersEl?.textContent || "0", 10);

            if ((window as any)._selectedSlot) {
                const costPerPerson = (window as any)._selectedSlot.cost || 0;
                totalBaseCost = costPerPerson * pSize;
            }

            let upgradesTotalCost = 0;
            const allUpgrades = (window as any)._allUpgrades || [];
            const container = document.getElementById(
                "step2-upgrades-container",
            );
            if (container) {
                const selectedCards = container.querySelectorAll(
                    ".upgrade-card.border-black",
                );
                selectedCards.forEach((c) => {
                    const qtyEl = c.querySelector(".qty-val");
                    const qty = parseInt(qtyEl?.textContent || "1", 10);
                    const id = c.getAttribute("data-id");
                    const upgrade = allUpgrades.find((u: any) => u.id === id);
                    if (upgrade) {
                        upgradesTotalCost += (upgrade.price || 0) * qty;
                    }
                });
            }

            const finalTotal = totalBaseCost + upgradesTotalCost;
            const overviewTotal = document.getElementById("overview-total");
            if (overviewTotal)
                overviewTotal.textContent = `$${finalTotal.toFixed(2)}`;
            const overviewStep2Total = document.getElementById(
                "overview-step2-total",
            );
            if (overviewStep2Total)
                overviewStep2Total.textContent = `$${finalTotal.toFixed(2)}`;
        };

        if (locationSelect) {
            locationSelect.addEventListener("change", (e) => {
                const target = e.target as HTMLSelectElement;
                const selectedOption = target.options[target.selectedIndex];
                const venueName =
                    selectedOption.getAttribute("data-name") || target.value;
                console.log("Selected venue:", venueName); // debugging
                if (overviewLocation) overviewLocation.textContent = venueName;
                if (overviewStep2Location)
                    overviewStep2Location.textContent = venueName;
            });
            // Initial call if already selected
            if (locationSelect.value) {
                const selectedOption =
                    locationSelect.options[locationSelect.selectedIndex];
                const venueName =
                    selectedOption.getAttribute("data-name") ||
                    locationSelect.value;
                if (overviewLocation) overviewLocation.textContent = venueName;
                if (overviewStep2Location)
                    overviewStep2Location.textContent = venueName;
            }
        }

        function updateTotalPlayers() {
            let total = 0;
            document.querySelectorAll(".player-count").forEach((el) => {
                total += parseInt(el.textContent || "0", 10);
            });
            if (overviewPlayers) {
                overviewPlayers.textContent =
                    total > 0 ? total.toString() : "-";
            }
            const overviewStep2Players = document.getElementById(
                "overview-step2-players",
            );
            if (overviewStep2Players) {
                overviewStep2Players.textContent =
                    total > 0 ? total.toString() : "-";
            }
            if ((window as any)._updateOverviewTotal) {
                (window as any)._updateOverviewTotal();
            }

            // Toggle calendar disabled state
            const calendarContainer = document.getElementById(
                "b7-calendar-container",
            );
            const calendarOverlay = document.getElementById(
                "b7-calendar-overlay",
            );
            if (calendarContainer && calendarOverlay) {
                if (total > 0) {
                    calendarContainer.classList.remove(
                        "opacity-50",
                        "pointer-events-none",
                    );
                    calendarOverlay.classList.add("hidden");
                } else {
                    calendarContainer.classList.add(
                        "opacity-50",
                        "pointer-events-none",
                    );
                    calendarOverlay.classList.remove("hidden");
                }
            }
        }

        minusBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const countEl = (e.target as HTMLElement).nextElementSibling;
                if (countEl) {
                    let val = parseInt(countEl.textContent || "0", 10);
                    if (val > 0) {
                        val--;
                        countEl.textContent = val.toString();
                        updateTotalPlayers();
                    }
                }
            });
        });

        plusBtns.forEach((btn) => {
            btn.addEventListener("click", (e) => {
                const countEl = (e.target as HTMLElement)
                    .previousElementSibling;
                if (countEl) {
                    let val = parseInt(countEl.textContent || "0", 10);
                    val++;
                    countEl.textContent = val.toString();
                    updateTotalPlayers();
                }
            });
        });

        const timeSlots = document.querySelectorAll(".time-slot-btn");
        const step1Details = document.getElementById("step-1-details");
        const step2Extra = document.getElementById("step-2-extra");
        const overviewStep1 = document.getElementById("overview-step-1");
        const overviewStep2 = document.getElementById("overview-step-2");

        timeSlots.forEach((slot) => {
            slot.addEventListener("click", () => {
                timeSlots.forEach((s) => s.classList.remove("active-slot"));
