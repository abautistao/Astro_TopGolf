---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    titulo: string;
    descripcion: string;
    imagen: any;
    precio_titulo: string;
    precio_subtitulo: string;
    precio_descripcion: string;
    Boton: Boton | null;
}

const {
    titulo,
    descripcion,
    imagen,
    precio_titulo = "PRICING",
    precio_subtitulo = "FROM £12.50 PER PERSON",
    precio_descripcion = "For the most up-to-date pricing, including variations by venue or time, please check the Book Now section.",
    Boton = null,
} = Astro.props;
console.log(Boton);
const boton_pricing: Boton[] = Boton
    ? [Boton]
    : [
          {
              id: 1,
              texto: "BOOK NOW",
              url: "#",
              tipo: "version_1",
          },
      ];

const tituloMostrar = titulo || "BOOT ROOM";
const descripcionHtml = stringifyRichText(
    descripcion ||
        "Whether you turn up in flipflops, high heels or barefoot (!?), we've got you covered with our boots! Don't worry, they are far nicer than the smelly old pair from the bowling alley.",
);
const strapiImageUrl = getStrapiUrl(imagen);

const altText = imagen?.data?.attributes?.alternativeText || tituloMostrar;
---

<section class="w-full bg-[var(--surface-brand-primary)] py-8 lg:py-16">
    <div
        class="w-full max-w-[1440px] mx-auto px-4 md:px-8 flex flex-col gap-12 lg:gap-0"
    >
        <!-- Row 1: Image + Text -->
        <div
            class="w-full grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center"
        >
            <!-- Image (Col 1) -->
            <div
                class="relative w-full h-[400px] lg:h-[600px] order-2 lg:order-1 rounded-xl overflow-hidden shadow-2xl"
            >
                <Image
                    src={strapiImageUrl ||
                        "https://placehold.co/800x1000?text=Boot+Room"}
                    alt={altText}
                    inferSize={true}
                    class="w-full h-full object-cover"
                />
            </div>

            <!-- Text (Col 2) -->
            <div class="flex flex-col justify-center order-1 lg:order-2">
                <h2
                    class="text-[var(--accent-feedback-strong)] text-4xl lg:text-7xl font-bold uppercase mb-6 font-(family-name:--font-titling-gothic-fb-extended-bold) leading-[0.9]"
                >
                    {tituloMostrar}
                </h2>
                <div
                    class="text-[var(--accent-feedback-strong)] text-base lg:text-lg leading-relaxed font-(family-name:--font-sharp-sans-medium) strapi-rich-text opacity-90"
                >
                    <Fragment set:html={descripcionHtml} />
                </div>
            </div>
        </div>

        <!-- Row 2: Pricing Card -->
        <!-- Desktop: Overlapping upwards into the image area using negative margin -->
        <div
            class="w-full flex justify-center lg:justify-center lg:-mt-10 relative z-10 pointer-events-none"
        >
            <div
                class="w-full lg:max-w-2xl pointer-events-auto border-2 border-[var(--brand-interactive-base)] bg-[var(--surface-brand-primary)]"
            >
                <!-- Header -->
                <div
                    class="bg-[var(--brand-interactive-base)] py-2 text-center"
                >
                    <span
                        class="font-(family-name:--font-titling-gothic-fb-extended-bold) text-black text-2xl lg:text-3xl uppercase tracking-wider"
                    >
                        {precio_titulo}
                    </span>
                </div>

                <!-- Body -->
                <div
                    class="p-6 md:p-10 flex flex-col items-center text-center gap-6"
                >
                    <!-- Subtitle (Price) -->
                    <h3
                        class="text-[var(--accent-feedback-strong)] text-4xl lg:text-6xl uppercase font-(family-name:--font-titling-gothic-fb-extended-bold) leading-none"
                    >
                        {precio_subtitulo}
                    </h3>

                    <!-- Description -->
                    <p
                        class="text-[var(--brand-interactive-base)] text-sm md:text-base font-(family-name:--font-sharp-sans-medium) max-w-md"
                    >
                        {precio_descripcion}
                    </p>

                    <!-- CTA Button -->

                    <Button
                        botones={boton_pricing}
                        clase="inline-block text-black font-bold uppercase py-3 px-8 text-xl hover:scale-105 transition-transform font-(family-name:--font-titling-gothic-fb-extended-bold)"
                    />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Rich text styling overrides */
    div :global(strong) {
        color: white;
        font-weight: 700;
    }
</style>
