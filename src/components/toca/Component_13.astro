---
// src/components/toca/Component_13.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi";
import SplitSection from "./elements/SplitSection.astro";
import Component_4 from "./Component_4.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    titulo: string;
    descripcion: any;
    imagen: any;
    precio_titulo?: string;
    precio_subtitulo?: string;
    precio_descripcion?: any;
    Boton: Boton | null;
    animacion?: boolean; // Nuevo prop
}

const {
    titulo,
    descripcion,
    imagen,
    precio_titulo = "PRICING",
    precio_subtitulo = "FROM £12.50 PER PERSON",
    precio_descripcion,
    Boton = null,
    animacion = false,
} = Astro.props;

// 1. Data SplitSection
const tituloMostrar = titulo || "BOOT ROOM";
const strapiImageUrl = getStrapiUrl(imagen);
const altText = imagen?.data?.attributes?.alternativeText || tituloMostrar;
const descripcionHtml = stringifyRichText(
    descripcion || "Whether you turn up in flipflops, high heels or barefoot (!?), we've got you covered with our boots! Don't worry, they are far nicer than the smelly old pair from the bowling alley."
);

// 2. Data Component_4
const defaultPricingDesc = [
    {
        type: "paragraph",
        children: [
        {
            type: "text",
            text: "For the most up-to-date pricing, including variations by venue or time, please check the Book Now section.",
        },
        ],
    },
];
const descripcionPricing = precio_descripcion || defaultPricingDesc;

const botonPricing = Boton
    ? Boton
    : {
        id: 1,
        texto: "BOOK NOW",
        url: "#",
        tipo: "version_1",
    };
const svgPositionClass = '-left-12 -top-12';
---

<div class="flex flex-col w-full bg-[var(--surface-brand-primary)]">

    <div class="relative z-0">
        <SplitSection
            titulo={tituloMostrar}
            htmlContent={descripcionHtml}
            imgUrl={strapiImageUrl}
            imgAlt={altText}
            botonData={null}
            tipo="version_2"
        >
            {/* SLOT DEL SVG ANIMADO (ARE YOU GAME?) */}
            {animacion && (
                <div slot="image-overlay" class={`absolute z-0 pointer-events-none ${svgPositionClass}`}>
                    <div class="svg-decoration">
                        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
                            <path id="textCirclePath" d="M 100, 100 m -75, 0 a 75,75 0 1,1 150,0 a 75,75 0 1,1 -150,0" fill="none"/>
                            <text class="svg-text-style">
                                <textPath xlink:href="#textCirclePath" startOffset="0%">
                                ARE YOU GAME? &nbsp; ARE YOU GAME? &nbsp; ARE YOU GAME? &nbsp;
                                </textPath>
                            </text>
                        </svg>
                    </div>
                </div>
            )}
        </SplitSection>
    </div>

    <div class="relative z-10 w-full pointer-events-none pb-16 pt-8">
        <div class="pointer-events-auto">
        <Component_4
            titulo_header={precio_titulo}
            precio={precio_subtitulo}
            descripcion={descripcionPricing}
            button={botonPricing}
            titulo_seccion=""
            claseSection="py-0"
        />
        </div>
    </div>

</div>

<style>
    /* ESTILOS SVG (Copiados de Component_8) */
    .svg-decoration {
        width: 180px;
        height: 180px;
        animation: rotate-left 20s linear infinite;
    }

    .svg-text-style {
        fill: white;
        font-family: 'Titling Gothic FB Extended', sans-serif;
        font-weight: 800;
        text-transform: uppercase;
        font-size: 13.5px;
        letter-spacing: 2px;
    }

    @keyframes rotate-left {
        from { transform: rotate(0deg); }
        to { transform: rotate(-360deg); }
    }
</style>