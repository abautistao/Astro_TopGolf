---
// src/components/dolphinaris/Component_13_Dolphinaris.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

interface Props {
    titulo?: string;
    descripcion?: string; // Rich Text for the right side
    info_extra?: string; // Rich Text for the left side below gallery (Duration, etc.)
    galeria?: any;
    fondoImagen?: any;
    codigoColorFondo?: string;
    tabs?: any;
}

const {
    titulo,
    descripcion,
    info_extra,
    galeria,
    fondoImagen,
    codigoColorFondo = "var(--neutral-text-inverted, #FFFFFF)",
    tabs,
} = Astro.props;

// Process Gallery Images (Normalize for Strapi 4 and Strapi 5)
const rawImages = galeria?.data || (Array.isArray(galeria) ? galeria : []);
const images = rawImages.map((img: any) => ({
    url: getStrapiUrl(img),
    alt: img?.attributes?.alternativeText || img?.alternativeText || "",
}));

// Background Logic
const bgUrl = fondoImagen ? getStrapiUrl(fondoImagen) : null;
const finalColor = codigoColorFondo || "var(--neutral-text-inverted, #FFFFFF)";
const styleAttribute = bgUrl
    ? `background-image: url('${bgUrl}'); background-size: cover; background-position: center;`
    : `background-color: ${finalColor};`;
---

<section class="w-full py-12! md:py-24! relative" style={styleAttribute}>
    <div class="max-w-360! mx-auto! px-6! md:px-12!">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-start">
            <!-- Left Column: Gallery & Info -->
            <div class="w-full flex flex-col gap-6">
                <!-- Gallery Container -->
                <div class="gallery-container w-full">
                    <!-- Main Display -->
                    <div class="w-full aspect-4/3 rounded-lg overflow-hidden bg-gray-200 relative mb-4! shadow-md">
                        {
                            images.length > 0 ? (
                                images.map((img, index) => {
                                    return (
                                        <img
                                            src={img.url}
                                            alt={img.alt}
                                            class={`absolute inset-0 w-full h-full object-cover transition-opacity duration-500 gallery-main-img ${index === 0 ? "opacity-100 z-10" : "opacity-0 z-0"}`}
                                            data-index={index}
                                        />
                                    );
                                })
                            ) : (
                                <div class="absolute inset-0 flex items-center justify-center text-gray-400">Sin imágenes</div>
                            )
                        }
                    </div>

                    <!-- Thumbnails -->
                    {
                        images.length > 1 && (
                            <div class="grid grid-cols-4 gap-2 md:gap-4">
                                {images.map((img, index) => {
                                    return (
                                        <button
                                            class={`relative aspect-[4/3] overflow-hidden rounded cursor-pointer transition-all hover:opacity-100 gallery-thumb ${index === 0 ? "ring-2 ring-[var(--surface-brand-primary)] opacity-100" : "opacity-60 hover:opacity-80"}`}
                                            data-target={index}
                                            aria-label={`Show image ${index + 1}`}
                                        >
                                            <img
                                                src={img.url}
                                                alt=""
                                                class="w-full h-full object-cover"
                                            />
                                        </button>
                                    );
                                })}
                            </div>
                        )
                    }
                </div>

                <!-- Info Extra (Duration, Level, etc.) -->
                {
                    info_extra && (
                        <div class="text-(--surface-brand-primary) font-roboto! text-[16px]! leading-relaxed rich-text-content opacity-90">
                            <Fragment
                                set:html={stringifyRichText(info_extra)}
                            />
                        </div>
                    )
                }
            </div>

            <!-- Right Column: Content -->
            <div class="w-full flex flex-col">
                {
                    titulo && (
                        <h2 class="font-montserrat! text-[32px]! font-bold! text-(--surface-brand-primary) mb-8! tracking-wide">
                            {titulo}
                        </h2>
                    )
                }

                <div class="font-roboto! text-[16px]! font-normal! text-(--surface-brand-primary) leading-relaxed space-y-4 rich-text-content">
                    {
                        descripcion ? (
                            <Fragment
                                set:html={stringifyRichText(descripcion)}
                            />
                        ) : null
                    }
                </div>

                {
                    tabs && tabs.length > 0 && (
                        <div class="mt-8 tabs-container">
                            {/* Headers */}
                            <div class="flex flex-wrap gap-2 mb-0 border-b border-gray-200">
                                {tabs.map((tab: any, index: number) => (
                                    <button 
                                        class={`tab-btn px-6 py-3 font-montserrat! text-[16px]! font-medium! transition-colors rounded-t-lg
                                        ${index === 0 ? 'bg-[var(--surface-brand-primary)] text-[var(--neutral-text-inverted)]' : 'bg-transparent text-[var(--brand-interactive-base)] hover:bg-[var(--neutral-background-subtle)]'}`}
                                        data-tab={index}
                                    >
                                        {tab.titulo}
                                    </button>
                                ))}
                            </div>
                            
                            {/* Content */}
                            <div class="bg-[var(--neutral-background-subtle)] p-6 rounded-b-lg rounded-tr-lg w-full">
                                {tabs.map((tab: any, index: number) => {
                                    const tabImgUrl = tab.imagen ? getStrapiUrl(tab.imagen) : null;
                                    return (
                                        <div class={`tab-pane space-y-4 ${index === 0 ? 'block' : 'hidden'}`} data-pane={index}>
                                            {tabImgUrl && (
                                                <img src={tabImgUrl} alt={tab.titulo} class="w-auto h-auto mx-auto max-h-24 object-contain mb-6" />
                                            )}
                                            {tab.contenido && (
                                                <div class="font-roboto! text-[16px]! font-normal! text-(--surface-brand-primary) leading-relaxed rich-text-content">
                                                    <Fragment set:html={stringifyRichText(tab.contenido)} />
                                                </div>
                                            )}
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    )
                }
            </div>
        </div>
    </div>
</section>

<style>
    /* Styling for Rich Text internally if needed */
    .rich-text-content :global(p) {
        margin-bottom: 1em;
    }
    .rich-text-content :global(ul) {
        list-style-type: disc;
        padding-left: 1.5em;
        margin-bottom: 1em;
    }
    .rich-text-content :global(strong) {
        font-weight: 700;
        color: var(--surface-brand-primary);
    }
    .rich-text-content :global(a) {
        color: var(--accent-highlight-primary);
        text-decoration: underline;
    }
</style>

<script>
    // Gallery Logic
    function initGalleryDolphinaris() {
        const galleries = document.querySelectorAll(".gallery-container");

        galleries.forEach((gallery) => {
            const mainImages = gallery.querySelectorAll(".gallery-main-img");
            const thumbs = gallery.querySelectorAll(".gallery-thumb");

            thumbs.forEach((thumb) => {
                thumb.addEventListener("click", () => {
                    const targetIndex = thumb.getAttribute("data-target");

                    // Update Main Images
                    mainImages.forEach((img) => {
                        if (img.getAttribute("data-index") === targetIndex) {
                            img.classList.remove("opacity-0", "z-0");
                            img.classList.add("opacity-100", "z-10");
                        } else {
                            img.classList.remove("opacity-100", "z-10");
                            img.classList.add("opacity-0", "z-0");
                        }
                    });

                    // Update Thumbs active state
                    thumbs.forEach((t) => {
                        if (t === thumb) {
                            t.classList.remove("opacity-60");
                            t.classList.add(
                                "ring-2",
                                "ring-[var(--surface-brand-primary)]",
                                "opacity-100",
                            );
                        } else {
                            t.classList.remove(
                                "ring-2",
                                "ring-[var(--surface-brand-primary)]",
                                "opacity-100",
                            );
                            t.classList.add("opacity-60");
                        }
                    });
                });
            });
        });
    }

    // Initialize
    initGalleryDolphinaris();
    document.addEventListener("astro:page-load", initGalleryDolphinaris);

    // Tabs Logic
    function initTabsDolphinaris() {
        const tabContainers = document.querySelectorAll(".tabs-container");

        tabContainers.forEach((container) => {
            const btns = container.querySelectorAll(".tab-btn");
            const panes = container.querySelectorAll(".tab-pane");

            btns.forEach((btn) => {
                btn.addEventListener("click", () => {
                    const targetIndex = btn.getAttribute("data-tab");

                    // Update buttons
                    btns.forEach((b) => {
                        if (b === btn) {
                            b.classList.remove("bg-transparent", "text-[var(--brand-interactive-base)]", "hover:bg-[var(--neutral-background-subtle)]");
                            b.classList.add("bg-[var(--surface-brand-primary)]", "text-[var(--neutral-text-inverted)]");
                        } else {
                            b.classList.remove("bg-[var(--surface-brand-primary)]", "text-[var(--neutral-text-inverted)]");
                            b.classList.add("bg-transparent", "text-[var(--brand-interactive-base)]", "hover:bg-[var(--neutral-background-subtle)]");
                        }
                    });

                    // Update panes
                    panes.forEach((pane) => {
                        if (pane.getAttribute("data-pane") === targetIndex) {
                            pane.classList.remove("hidden");
                            pane.classList.add("block");
                        } else {
                            pane.classList.remove("block");
                            pane.classList.add("hidden");
                        }
                    });
                });
            });
        });
    }

    initTabsDolphinaris();
    document.addEventListener("astro:page-load", initTabsDolphinaris);
</script>
