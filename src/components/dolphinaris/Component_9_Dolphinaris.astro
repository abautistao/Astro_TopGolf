---
// src/components/dolphinaris/Component_9_Dolphinaris.astro
import { stringifyRichText } from "../../lib/strapi.js";

interface Props {
    titulo?: string;
    contenido?: any;
}

const {
    titulo = "Gourmet Experiences",
    contenido,
} = Astro.props;

const contenidoHtml = contenido ? stringifyRichText(contenido) : "";
---

<section class="w-full py-14 pb-0 bg-[var(--neutral-background-subtle)]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

        <!-- TÍTULO -->
        {titulo && (
            <h2 class="font-montserrat font-bold text-[32px] md:text-[40px] text-[var(--surface-brand-primary)] mb-4 leading-tight">
                {titulo}
            </h2>
        )}

        <!-- LÍNEA SEPARADORA -->
        <div class="w-24 h-0.5 bg-[var(--surface-brand-secondary)] mx-auto mb-8"></div>

        <!-- RICH TEXT -->
        {contenidoHtml && (
            <div class="rich-text-dolphinaris font-roboto text-[16px] font-normal leading-relaxed text-[var(--surface-brand-primary)]/70 max-w-2xl mx-auto">
                <Fragment set:html={contenidoHtml} />
            </div>
        )}
    </div>
</section>

<style>
    /* Estilos para el rich text de Strapi */
    .rich-text-dolphinaris :global(p) {
        margin-bottom: 1em;
    }
    .rich-text-dolphinaris :global(p:last-child) {
        margin-bottom: 0;
    }
    .rich-text-dolphinaris :global(strong) {
        font-weight: 700;
        color: var(--surface-brand-primary);
    }
    .rich-text-dolphinaris :global(em) {
        font-style: italic;
    }
    .rich-text-dolphinaris :global(u) {
        text-decoration: underline;
        text-decoration-color: var(--surface-brand-secondary);
    }
    .rich-text-dolphinaris :global(a) {
        color: var(--surface-brand-secondary);
        text-decoration: underline;
        transition: color 0.2s;
    }
    .rich-text-dolphinaris :global(a:hover) {
        color: var(--accent-highlight-primary);
    }
    .rich-text-dolphinaris :global(h1),
    .rich-text-dolphinaris :global(h2),
    .rich-text-dolphinaris :global(h3),
    .rich-text-dolphinaris :global(h4),
    .rich-text-dolphinaris :global(h5),
    .rich-text-dolphinaris :global(h6) {
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        color: var(--surface-brand-primary);
        margin-bottom: 0.5em;
        margin-top: 1em;
    }
    .rich-text-dolphinaris :global(ul) {
        list-style: disc;
        margin-left: 1.5rem;
        margin-bottom: 1em;
        text-align: left;
    }
    .rich-text-dolphinaris :global(ol) {
        list-style: decimal;
        margin-left: 1.5rem;
        margin-bottom: 1em;
        text-align: left;
    }
    .rich-text-dolphinaris :global(li) {
        margin-bottom: 0.4em;
    }
    .rich-text-dolphinaris :global(blockquote) {
        border-left: 3px solid var(--surface-brand-secondary);
        padding-left: 1rem;
        margin: 1rem 0;
        color: var(--surface-brand-primary);
        font-style: italic;
        opacity: 0.8;
    }
    .rich-text-dolphinaris :global(hr) {
        border: none;
        border-top: 1px solid var(--surface-brand-secondary);
        margin: 1.5rem auto;
        width: 4rem;
    }
    .rich-text-dolphinaris :global(code) {
        background: rgba(30, 140, 166, 0.1);
        padding: 0.1rem 0.4rem;
        border-radius: 4px;
        font-size: 0.9em;
        font-family: monospace;
    }
</style>
