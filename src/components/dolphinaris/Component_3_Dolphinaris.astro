---
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface CardDolphinaris {
    id: number;
    titulo: string;
    imagen: any;
    duracion?: string;
    intensidad?: string;
    edadMinima?: string;
    beneficios: any; 
    precioOferta: string;
    precioRegular: string;
    LabelPrecioOferta: string;
    LabelPrecioRegular: string;
    boton?: Boton | Boton[] | null;
}

interface Props {
    tituloExperiencias?: string;
    experiencias?: CardDolphinaris[];
}

const {
    tituloExperiencias,
    experiencias = [
        {
            id: 1,
            titulo: "DOLPHIN FRIENDLY ENCOUNTER",
            imagen: "https://placehold.co/800x400/002A4E/ffffff?text=Dolphin+Encounter",
            duracion: "40 minutes",
            intensidad: "Easy",
            edadMinima: "Minimum age: 3 years (minors with adult)",
            beneficios: [
                {
                    type: "list",
                    format: "unordered",
                    children: [
                        { type: "list-item", children: [{ type: "text", text: "Dolphin encounter" }] },
                        { type: "list-item", children: [{ type: "text", text: "Domestic open bar" }] },
                        { type: "list-item", children: [{ type: "text", text: "Food buffet" }] },
                        { type: "list-item", children: [{ type: "text", text: "Basic digital photos" }] },
                        { type: "list-item", children: [{ type: "text", text: "Facilities access" }] },
                    ],
                },
            ],
            precioOferta: "$99 USD",
            precioRegular: "$149 USD",
            LabelPrecioOferta: "ONLINE PRICE",
            LabelPrecioRegular: "REGULAR PRICE",
            boton: {
                id: 1,
                texto: "BOOK NOW",
                url: "#",
                tipo: "version_6", // Use Outline Dark Blue version
            },
        }
    ],
} = Astro.props;
---

<section class="w-full py-12 md:py-20 px-6 overflow-hidden bg-[var(--neutral-background-subtle)]">
    <div class="max-w-[1440px] mx-auto">
        { tituloExperiencias && (
            <div class="flex flex-col items-center justify-center mb-12">
                <h2 class="text-[32px] md:text-[36px] font-bold font-montserrat text-[var(--surface-brand-primary)] text-center capitalize mb-4">
                    {tituloExperiencias}
                </h2>
                <div class="w-[80px] h-0.5 bg-[var(--surface-brand-secondary)] hidden md:block"></div>
            </div>
        )}

        <div class="flex flex-wrap justify-center items-stretch gap-8 md:gap-10 max-w-7xl mx-auto">
            {
                Array.isArray(experiencias) && experiencias.map((exp) => (
                    <div class="flex flex-col bg-white overflow-hidden shadow-xl border border-gray-100 group transition-all duration-300 hover:shadow-2xl hover:-translate-y-2 w-full max-w-[420px]">
                        
                        <!-- IMAGEN Y TÍTULO -->
                        <div class="relative h-64 overflow-hidden">
                            <Image
                                src={getStrapiUrl(exp.imagen) || "https://placehold.co/800x400/002A4E/4BA3B5?text=Dolphinaris"}
                                alt={exp.titulo}
                                width={800}
                                height={400}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                            <!-- OVERLAY DEGRADADO OSCURO HACIA ABAJO -->
                            <div class="absolute inset-0 bg-gradient-to-t from-[var(--surface-brand-primary)]/90 via-[#002A4E]/30 to-transparent pointer-events-none z-10"></div>
                            
                            <!-- TÍTULO SOBRE LA IMAGEN -->
                            <div class="absolute bottom-4 left-4 right-4 z-20">
                                <h3 class="text-white font-montserrat text-xl leading-tight font-bold uppercase tracking-wide">
                                    {exp.titulo}
                                </h3>
                            </div>
                        </div>

                        <!-- CONTENIDO CARTA -->
                        <div class="p-6 flex flex-col flex-grow text-[var(--surface-brand-primary)]">
                            
                            <!-- META INFO: Duracion, Intensidad, Edad -->
                            <div class="grid grid-cols-2 gap-4 mb-6 font-roboto text-base font-normal text-[#6B8096]">
                                {exp.duracion && (
                                    <div class="flex items-center gap-2">
                                        <i class="fa-regular fa-clock text-[var(--accent-highlight-primary)]"></i>
                                        <span>{exp.duracion}</span>
                                    </div>
                                )}
                                {exp.intensidad && (
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-heart-pulse text-[var(--accent-highlight-primary)]"></i>
                                        <span>{exp.intensidad}</span>
                                    </div>
                                )}
                                {exp.edadMinima && (
                                    <div class="flex items-center gap-2 col-span-2">
                                        <i class="fa-regular fa-user text-[var(--accent-highlight-primary)]"></i>
                                        <span>{exp.edadMinima}</span>
                                    </div>
                                )}
                            </div>

                            <!-- INCLUDES Y RICHTEXT -->
                            <div class="mb-6 flex-grow">
                                <h4 class="font-montserrat font-bold text-[12px] mb-3 uppercase tracking-wider text-[var(--surface-brand-primary)]">
                                    INCLUDES:
                                </h4>
                                
                                <div class="benefits-rich-text text-base text-[#6B8096] font-roboto font-normal leading-relaxed">
                                    <Fragment set:html={stringifyRichText(exp.beneficios)} />
                                </div>
                            </div>

                            <!-- PRECIOS -->
                            <div class="flex items-center justify-between border-t border-gray-100 pt-6 mb-6">
                                <div class="text-center w-1/2 pr-4 border-r border-[#E5E7EB] flex flex-col justify-center items-center">
                                    <p class="text-[10px] uppercase tracking-widest text-[#6B8096] font-bold mb-1 font-montserrat">
                                        {exp.LabelPrecioRegular}
                                    </p>
                                    <p class="text-[20px] font-bold text-[var(--surface-brand-primary)] line-through decoration-[var(--surface-brand-primary)]/50 font-montserrat opacity-90">
                                        {exp.precioRegular}
                                    </p>
                                </div>
                                
                                <div class="text-center w-1/2 pl-4 flex flex-col justify-center items-center">
                                    <p class="text-[10px] uppercase tracking-widest text-[var(--surface-brand-secondary)] font-bold mb-1 font-montserrat">
                                        {exp.LabelPrecioOferta}
                                    </p>
                                    <p class="text-[24px] font-extrabold text-[var(--surface-brand-secondary)] font-montserrat leading-none mt-1">
                                        {exp.precioOferta}
                                    </p>
                                </div>
                            </div>

                            <!-- BOTON -->
                            {exp.boton && (
                                <div class="mt-auto">
                                    <Button
                                        botones={Array.isArray(exp.boton) ? exp.boton : [exp.boton]}
                                        clase="w-full justify-center [&>a]:w-full"
                                    />
                                </div>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    /* Redefinición de los bullet points para convertirlos en checkmarks cyans */
    .benefits-rich-text :global(ul) {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .benefits-rich-text :global(li) {
        position: relative;
        padding-left: 1.75rem;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: flex-start;
    }

    .benefits-rich-text :global(li::before) {
        content: "\f00c"; /* Unicode FontAwesome Checkmark */
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        position: absolute;
        left: 0;
        top: 0.2rem;
        font-size: 0.9rem;
        color: var(--accent-highlight-primary); 
    }
</style>
