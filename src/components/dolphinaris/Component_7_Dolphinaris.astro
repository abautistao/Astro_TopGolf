---
// src/components/dolphinaris/Component_7_Dolphinaris.astro
import { Image } from "astro:assets";
import { getStrapiUrl } from "../../lib/strapi.js";

interface Props {
    tituloSeccion?: string;
    nombreLugar?: string;
    pais?: string;
    imagen?: any;
    descripcion?: string;
    direccion?: string;
    horario?: string;
    comoLlegar?: string;
    textoBoton?: string;
    urlBoton?: string;
}

const {
    tituloSeccion = "Locations",
    nombreLugar = "Cozumel",
    pais = "México",
    imagen,
    descripcion = "Located in the heart of the Mexican paradise, Dolphinaris Cozumel is situated on the Island of Cozumel, within the second largest coral reef in the world.",
    direccion = "Carretera Costera Sur Km 4, San Miguel de Cozumel, Q.R., Mexico",
    horario = "Monday to Sunday 9:00 AM – 5:00 PM",
    comoLlegar = "Ferry from Playa del Carmen (45 min), direct flight to Cozumel, or cruise (stop at Cozumel port)",
    textoBoton = "Ver en Mapa",
    urlBoton = "#",
} = Astro.props;

const imgSrc =
    getStrapiUrl(imagen) ||
    "https://placehold.co/800x800/002A4E/4BA3B5?text=Dolphinaris";
---

<section class="w-full py-16 md:py-24 bg-[var(--neutral-background-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- ENCABEZADO -->
        {tituloSeccion && (
            <div class="text-center mb-12 md:mb-16">
                <h2 class="font-montserrat font-bold text-[32px] md:text-[40px] text-[var(--surface-brand-primary)] mb-4">
                    {tituloSeccion}
                </h2>
                <div class="w-24 h-0.5 bg-[var(--surface-brand-secondary)] mx-auto"></div>
            </div>
        )}

        <!-- CARD PRINCIPAL -->
        <div class="bg-white shadow-2xl overflow-hidden flex flex-col lg:flex-row">

            <!-- LADO IZQUIERDO: Imagen -->
            <div class="lg:w-1/2 relative h-72 lg:h-auto min-h-[320px]">
                <Image
                    src={imgSrc}
                    alt={nombreLugar}
                    width={800}
                    height={800}
                    class="absolute inset-0 w-full h-full object-cover"
                />
                <!-- Overlay gradiente -->
                <div class="absolute inset-0 bg-gradient-to-r from-[var(--surface-brand-primary)]/80 to-transparent pointer-events-none"></div>

                <!-- Nombre del lugar -->
                <div class="absolute bottom-8 left-8 z-10">
                    <h3 class="font-montserrat font-bold text-[32px] text-white leading-tight mb-2">
                        {nombreLugar}
                    </h3>
                    <div class="flex items-center gap-2 text-[var(--surface-brand-secondary)]">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                            <circle cx="12" cy="10" r="3"></circle>
                        </svg>
                        <span class="font-montserrat font-bold text-[14px] tracking-widest uppercase">
                            {pais}
                        </span>
                    </div>
                </div>
            </div>

            <!-- LADO DERECHO: Información -->
            <div class="lg:w-1/2 p-8 md:p-12 flex flex-col justify-center">
                {descripcion && (
                    <p class="font-roboto text-[16px] font-normal text-[var(--surface-brand-primary)]/60 leading-relaxed mb-8">
                        {descripcion}
                    </p>
                )}

                <div class="space-y-6">
                    <!-- Dirección -->
                    {direccion && (
                        <div class="flex items-start gap-4">
                            <div class="bg-[var(--neutral-background-subtle)] p-3 rounded-full text-[var(--surface-brand-secondary)] shrink-0 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-montserrat font-bold text-[16px] text-[var(--surface-brand-primary)] mb-1">
                                    Dirección
                                </h4>
                                <p class="font-roboto text-[15px] font-normal text-[var(--surface-brand-primary)]/60">
                                    {direccion}
                                </p>
                            </div>
                        </div>
                    )}

                    <!-- Horario -->
                    {horario && (
                        <div class="flex items-start gap-4">
                            <div class="bg-[var(--neutral-background-subtle)] p-3 rounded-full text-[var(--surface-brand-secondary)] shrink-0 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-montserrat font-bold text-[16px] text-[var(--surface-brand-primary)] mb-1">
                                    Horario
                                </h4>
                                <p class="font-roboto text-[15px] font-normal text-[var(--surface-brand-primary)]/60">
                                    {horario}
                                </p>
                            </div>
                        </div>
                    )}

                    <!-- Cómo llegar -->
                    {comoLlegar && (
                        <div class="flex items-start gap-4">
                            <div class="bg-[var(--neutral-background-subtle)] p-3 rounded-full text-[var(--surface-brand-secondary)] shrink-0 flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="3 11 22 2 13 21 11 13 3 11"></polygon>
                                </svg>
                            </div>
                            <div>
                                <h4 class="font-montserrat font-bold text-[16px] text-[var(--surface-brand-primary)] mb-1">
                                    Cómo llegar
                                </h4>
                                <p class="font-roboto text-[15px] font-normal text-[var(--surface-brand-primary)]/60">
                                    {comoLlegar}
                                </p>
                            </div>
                        </div>
                    )}
                </div>

                <!-- CTA -->
                {textoBoton && urlBoton && (
                    <div class="mt-10">
                        <a
                            href={urlBoton}
                            target={urlBoton.startsWith('http') ? '_blank' : '_self'}
                            rel={urlBoton.startsWith('http') ? 'noopener noreferrer' : undefined}
                            class="inline-block px-8 py-4 bg-[var(--surface-brand-primary)] text-white font-montserrat font-bold text-[15px] tracking-widest uppercase transition-colors duration-300 hover:bg-[var(--surface-brand-secondary)]"
                        >
                            {textoBoton}
                        </a>
                    </div>
                )}
            </div>
        </div>
    </div>
</section>
