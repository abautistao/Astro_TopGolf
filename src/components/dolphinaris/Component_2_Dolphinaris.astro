---
import { stringifyRichText, getStrapiUrl } from "../../lib/strapi.js";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
  titulo: string;
  descripcion: any;
  boton: Boton | Boton[] | null;
  carrusel: any;
}

const { titulo, descripcion, boton = null, carrusel } = Astro.props;
const descripcionHtml = descripcion ? stringifyRichText(descripcion) : "";
const buttons = Array.isArray(boton) ? boton : (boton ? [boton] : []);
const media = Array.isArray(carrusel) ? carrusel : (Array.isArray(carrusel?.data) ? carrusel.data : (carrusel?.data ? [carrusel.data] : []));

// Fallback images if no backend data
const placeholderImages = [
  "https://placehold.co/800x600/002A4E/4BA3B5?text=Dolphinaris+Image+1",
  "https://placehold.co/800x600/002A4E/1E8CA6?text=Dolphinaris+Image+2",
  "https://placehold.co/800x600/1E8CA6/ffffff?text=Dolphinaris+Image+3"
];

const sliderImages = media.length > 0 
  ? media.map((img: any) => getStrapiUrl(img)) 
  : placeholderImages;
---

<section class="relative bg-[var(--surface-brand-primary)] text-[var(--neutral-text-inverted)] overflow-hidden w-full">
  <!-- Fondo con división diagonal -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    <div class="absolute top-0 right-0 w-[55%] h-full bg-[#001f3a] transform skew-x-[-12deg] translate-x-[15%] origin-top hidden md:block"></div>
    <div class="absolute bottom-0 left-0 w-full h-[40%] bg-[#001f3a] transform skew-y-[-5deg] translate-y-[20%] origin-left md:hidden"></div>
  </div>

  <div class="relative z-10 w-full flex flex-col md:flex-row items-stretch">
    <!-- Contenido de Texto -->
    <div class="w-full md:w-1/2 p-8 md:p-14 lg:p-24 flex flex-col justify-center order-1 text-left relative z-10 md:mr-[-5%] ml-auto max-w-[720px]">
      {titulo && (
        <>
          <h2 class="font-montserrat text-[32px] font-bold mb-4 text-white leading-tight">
            {titulo}
          </h2>
          <div class="w-16 h-0.5 bg-[var(--surface-brand-secondary)] mb-8"></div>
        </>
      )}
      
      {descripcionHtml && (
        <div class="font-roboto text-[16px] font-normal leading-relaxed text-gray-300 md:text-gray-200 mb-8 space-y-[1em] opacity-90">
          <Fragment set:html={descripcionHtml} />
        </div>
      )}

      {buttons.length > 0 && (
        <div class="mt-2">
          <Button botones={buttons} />
        </div>
      )}
    </div>

    <!-- Carrusel de Imágenes -->
    <div class="w-full md:w-1/2 relative order-2 md:py-12 md:pr-12 lg:pr-24 flex items-center justify-start">
      <div class="carousel-container relative overflow-hidden group w-full h-[350px] sm:h-[450px] md:h-[80%] md:aspect-[4/3] md:shadow-2xl z-0">
        <div class="carousel-track flex h-full w-full transition-transform duration-700 ease-in-out">
          {sliderImages.map((src: string, index: number) => (
            <div class="carousel-slide flex-shrink-0 w-full h-full relative">
              <Image 
                src={src} 
                alt={`${titulo || 'Dolphinaris'} carousel image ${index + 1}`} 
                width={800} 
                height={600} 
                class="w-full h-full object-cover absolute inset-0"
              />
              <div class="absolute inset-0 bg-black/20 mix-blend-multiply"></div>
            </div>
          ))}
        </div>

        {/* Controles del Carrusel (Prev/Next) */}
        {sliderImages.length > 1 && (
          <>
            <button class="prev-btn absolute left-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/40 hover:bg-black/80 text-white flex justify-center items-center opacity-0 group-hover:opacity-100 transition-all duration-300">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
            <button class="next-btn absolute right-4 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-black/40 hover:bg-black/80 text-white flex justify-center items-center opacity-0 group-hover:opacity-100 transition-all duration-300">
              <i class="fa-solid fa-chevron-right"></i>
            </button>
           
            {/* Indicadores */}
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center justify-center gap-2 z-10">
              {sliderImages.map((_: any, idx: number) => (
                <button 
                    class={`indicator transition-all duration-300 rounded-full hover:bg-white ${idx === 0 ? 'w-4 h-1.5 bg-white' : 'w-1.5 h-1.5 bg-white/50'}`} 
                    data-index={idx} 
                    aria-label={`Go to slide ${idx + 1}`}
                ></button>
              ))}
            </div>
          </>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  /* Personalización de los rich texts para asegurar estilo */
  :global(.space-y-\[1em\] > p) {
    margin-bottom: 1em;
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const carousels = document.querySelectorAll(".carousel-container");
   
    carousels.forEach(carousel => {
      const track = carousel.querySelector(".carousel-track") as HTMLElement;
      const slides = carousel.querySelectorAll(".carousel-slide");
      const nextBtn = carousel.querySelector(".next-btn");
      const prevBtn = carousel.querySelector(".prev-btn");
      const indicators = carousel.querySelectorAll(".indicator");
     
      let currentIndex = 0;
      let intervalId: any;
     
      const totalSlides = slides.length;
      if (totalSlides <= 1) return;

      const updateCarousel = (index: number) => {
        track.style.transform = `translateX(-${index * 100}%)`;
        indicators.forEach((ind: any, i: number) => {
          if (i === index) {
            ind.classList.add('w-4', 'h-1.5', 'bg-white');
            ind.classList.remove('w-1.5', 'bg-white/50');
          } else {
            ind.classList.add('w-1.5', 'bg-white/50');
            ind.classList.remove('w-4', 'h-1.5', 'bg-white');
          }
        });
      };

      const nextSlide = () => {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateCarousel(currentIndex);
      };

      const prevSlide = () => {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateCarousel(currentIndex);
      };

      if (nextBtn) nextBtn.addEventListener("click", () => {
        nextSlide();
        resetAutoPlay();
      });
     
      if (prevBtn) prevBtn.addEventListener("click", () => {
        prevSlide();
        resetAutoPlay();
      });

      indicators.forEach((indicator: any) => {
        indicator.addEventListener("click", (e: any) => {
          const index = parseInt(e.target.dataset.index);
          currentIndex = index;
          updateCarousel(currentIndex);
          resetAutoPlay();
        });
      });

      const startAutoPlay = () => {
        intervalId = setInterval(nextSlide, 6000); 
      };

      const pauseAutoPlay = () => {
        clearInterval(intervalId);
      };

      const resetAutoPlay = () => {
        pauseAutoPlay();
        startAutoPlay();
      };

      startAutoPlay();

      // Swipe functionality for mobile
      let startX = 0;
      let currentX = 0;
      let isDragging = false;

      carousel.addEventListener('touchstart', (e: any) => {
        startX = e.touches[0].clientX;
        isDragging = true;
        pauseAutoPlay();
        track.style.transition = 'none';
      }, {passive: true});

      carousel.addEventListener('touchmove', (e: any) => {
        if (!isDragging) return;
        currentX = e.touches[0].clientX;
        const diffX = currentX - startX;
        track.style.transform = `translateX(calc(-${currentIndex * 100}% + ${diffX}px))`;
      }, {passive: true});

      carousel.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        track.style.transition = 'transform 0.7s ease-in-out';
        const diffX = currentX - startX;
        
        if (Math.abs(diffX) > 50) {
          if (diffX > 0) {
            prevSlide();
          } else {
            nextSlide();
          }
        } else {
          updateCarousel(currentIndex);
        }
        resetAutoPlay();
      });
    });
  });
</script>
