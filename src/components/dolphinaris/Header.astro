---
import {
    getHeaderData,
    getStrapiUrl,
    getLocalizedUrl,
} from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    data?: any;
    locale?: string;
}

const { data, locale = "en" } = Astro.props;
const headerData = data || (await getHeaderData());

const logoUrl = getStrapiUrl(headerData?.logo);

const links = headerData?.links || [];

const ctaButtonRaw = headerData?.Boton || {
    id: 999,
    texto: "RESERVAR",
    url: "/reservar",
};
let buttons: Boton[] = [];

if (ctaButtonRaw) {
    const ctaButtonLocalized = {
        ...ctaButtonRaw,
        url: getLocalizedUrl(ctaButtonRaw.url, locale)
    };
    buttons = [ctaButtonLocalized];
}
---

<header
    class="w-full absolute top-0 left-0 z-50 transition-all duration-500 ease-in-out"
    id="dolphinaris-header"
>
    <div
        class="max-w-[1440px] mx-auto px-6 h-20 md:h-28 flex items-center justify-between transition-all duration-500 relative z-50"
    >
        <!-- Logo -->
        <a href="/" class="flex-shrink-0">
            {
                logoUrl && (
                    <Image
                        src={logoUrl}
                        alt="Dolphinaris"
                        width={250}
                        height={100}
                        class="h-16 md:h-20 w-auto object-contain"
                    />
                )
            }
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center space-x-10">
            {
                links.map((link: any) => (
                    <div class="relative group py-8">
                        <a
                            href={link.url ? getLocalizedUrl(link.url, locale) : '#'}
                            class="flex items-center gap-2 text-white font-medium text-xs tracking-[0.2em] hover:text-[var(--brand-interactive-base)] transition-colors uppercase font-[family-name:var(--font-dolphinaris-body)]"
                        >
                            {link.texto}
                            {link.dropdown_items && link.dropdown_items.length > 0 && (
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform duration-300 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            )}
                        </a>
                        
                        {/* Submenu Dropdown */}
                        {link.dropdown_items && link.dropdown_items.length > 0 && (
                            <div class="absolute top-full left-0 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 w-max min-w-[280px] bg-[var(--surface-brand-primary)] border-t-[4px] border-[var(--brand-interactive-base)] shadow-2xl z-50">
                                <ul class="flex flex-col py-3">
                                    {link.dropdown_items.map((sublink: any) => (
                                        <li>
                                            <a
                                                href={getLocalizedUrl(sublink.url, locale)}
                                                class="block px-6 py-4 text-[var(--neutral-text-inverted)] font-roboto text-[16px] font-normal hover:bg-[var(--accent-highlight-primary)] hover:text-white transition-colors"
                                            >
                                                {sublink.titulo}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                ))
            }
        </nav>

        <!-- CTA Button & Mobile Toggle -->
        <div class="flex items-center gap-4">
            <!-- Language Switcher (Desktop) -->
            {
                (() => {
                    const isMultiLanguage =
                        import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
                    if (!isMultiLanguage) return null;

                    return (
                        <div class="hidden lg:flex items-center">
                            {(() => {
                                const isEn = locale === "en";
                                const targetLang = isEn ? "es" : "en";
                                const flagUrl = isEn
                                    ? "https://flagcdn.com/w40/mx.png"
                                    : "https://flagcdn.com/w40/us.png";

                                const currentPath = Astro.url.pathname;
                                const targetPath =
                                    currentPath.replace(
                                        `/${locale}`,
                                        `/${targetLang}`,
                                    ) || `/${targetLang}`;

                                return (
                                    <a
                                        href={targetPath}
                                        class="flex items-center gap-2 text-[var(--neutral-text-inverted)] hover:opacity-80 transition-opacity"
                                    >
                                        <span class="text-xs font-bold tracking-widest">
                                            {isEn ? "ES" : "EN"}
                                        </span>
                                        <img
                                            src={flagUrl}
                                            alt={isEn ? "Español" : "English"}
                                            class="w-6 h-auto rounded-sm border border-white/20"
                                        />
                                    </a>
                                );
                            })()}
                        </div>
                    );
                })()
            }

            {buttons.length > 0 && <Button botones={buttons} clase="hidden lg:block" />}

            <button
                id="mobile-menu-toggle"
                class="lg:hidden text-[var(--neutral-text-inverted)] p-2 focus:outline-none flex items-center justify-center w-10 h-10"
            >
                <i id="menu-icon" class="fa-solid fa-bars text-3xl"></i>
                <i id="close-icon" class="fa-solid fa-xmark text-3xl" style="display: none;"></i>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<div
    id="mobile-menu"
    class="hidden lg:hidden fixed inset-0 bg-[var(--surface-brand-primary)] z-40 pt-28 px-8 overflow-y-auto"
>
    <nav class="flex flex-col space-y-6 pb-10">
        {
            links.map((link: any, index: number) => (
                <div class="border-b border-white/20 pb-6">
                    <div class="flex items-center justify-between">
                        <a
                            href={link.url ? getLocalizedUrl(link.url, locale) : '#'}
                            class="text-white font-bold text-3xl tracking-widest uppercase font-[family-name:var(--font-dolphinaris-title)]"
                        >
                            {link.texto}
                        </a>
                        {link.dropdown_items && link.dropdown_items.length > 0 && (
                            <button
                                class="text-[var(--neutral-text-inverted)] p-2 mobile-submenu-toggle focus:outline-none"
                                data-target={`submenu-${index}`}
                            >
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 transition-transform duration-300" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                                </svg>
                            </button>
                        )}
                    </div>
                    
                    {link.dropdown_items && link.dropdown_items.length > 0 && (
                        <div id={`submenu-${index}`} class="hidden flex-col pl-6 pt-6 space-y-5">
                            {link.dropdown_items.map((sublink: any) => (
                                <a
                                    href={getLocalizedUrl(sublink.url, locale)}
                                    class="text-[var(--neutral-text-inverted)] opacity-90 font-roboto text-[16px] font-normal hover:text-[var(--accent-highlight-primary)] transition-colors"
                                >
                                    {sublink.titulo}
                                </a>
                            ))}
                        </div>
                    )}
                </div>
            ))
        }
        <div class="pt-6 flex flex-col gap-6">
            {buttons.length > 0 && <Button botones={buttons} clase="w-full py-4 text-center text-xl" />}
            
            <!-- Mobile Language Switcher -->
            {
                (() => {
                    const isMultiLanguage =
                        import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
                    if (!isMultiLanguage) return null;

                    const isEn = locale === "en";
                    const targetLang = isEn ? "es" : "en";
                    const flagUrl = isEn
                        ? "https://flagcdn.com/w40/mx.png"
                        : "https://flagcdn.com/w40/us.png";

                    const currentPath = Astro.url.pathname;
                    const targetPath =
                        currentPath.replace(`/${locale}`, `/${targetLang}`) ||
                        `/${targetLang}`;

                    return (
                        <a
                            href={targetPath}
                            class="flex items-center justify-center gap-3 text-white border border-white/20 py-3 rounded-md hover:bg-white/10 transition-colors"
                        >
                            <span class="text-lg font-bold tracking-widest">
                                {isEn ? "ESPAÑOL" : "ENGLISH"}
                            </span>
                            <img
                                src={flagUrl}
                                alt={isEn ? "Español" : "English"}
                                class="w-8 h-auto rounded-sm"
                            />
                        </a>
                    );
                })()
            }
        </div>
    </nav>
</div>

<style>
    #dolphinaris-header {
        background-color: var(--surface-brand-primary);
    }

    @media (min-width: 1024px) {
        #dolphinaris-header {
            background-color: transparent;
            background-image: linear-gradient(
                to bottom,
                var(--surface-brand-primary),
                transparent
            );
        }
    }

    .header-scrolled {
        background-color: var(--surface-brand-primary) !important;
        background-image: none !important;
        position: fixed !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        animation: slideInDown 0.5s ease;
    }

    .is-menu-open {
        background-color: var(--surface-brand-primary) !important;
        background-image: none !important;
    }

    .header-scrolled > div {
        height: 80px !important;
    }

    @keyframes slideInDown {
        from {
            transform: translateY(-100%);
        }
        to {
            transform: translateY(0);
        }
    }
</style>

<script>
    const header = document.getElementById("dolphinaris-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    window.addEventListener("scroll", () => {
        if (window.scrollY > 50) {
            header?.classList.add("header-scrolled");
        } else {
            header?.classList.remove("header-scrolled");
        }
    });

    toggle?.addEventListener("click", () => {
        const isHidden = menu?.classList.contains("hidden");
        if (isHidden) {
            menu?.classList.remove("hidden");
            header?.classList.add("is-menu-open");
            if (menuIcon) menuIcon.style.display = "none";
            if (closeIcon) closeIcon.style.display = "block";
            document.body.style.overflow = "hidden";
        } else {
            menu?.classList.add("hidden");
            header?.classList.remove("is-menu-open");
            if (menuIcon) menuIcon.style.display = "block";
            if (closeIcon) closeIcon.style.display = "none";
            document.body.style.overflow = "";
        }
    });

    // Mobile submenu toggles
    const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    submenuToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const targetId = btn.getAttribute('data-target');
            if (targetId) {
                const submenu = document.getElementById(targetId);
                const icon = btn.querySelector('svg');
                if (submenu?.classList.contains('hidden')) {
                    submenu.classList.remove('hidden');
                    submenu.classList.add('flex');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                } else {
                    submenu?.classList.add('hidden');
                    submenu?.classList.remove('flex');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
            }
        });
    });
</script>
