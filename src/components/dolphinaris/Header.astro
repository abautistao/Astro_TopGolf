---
// src/components/blu/Header.astro
import {
    getHeaderData,
    getStrapiUrl,
    formatUrl,
    getLocalizedUrl,
} from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    data?: any;
    locale?: string;
}

const { data, locale = "en" } = Astro.props;
const headerData = data || (await getHeaderData());

const logoUrl = getStrapiUrl(headerData?.logo) || "/assets/blu-logo-white.png";

const links = headerData?.links || [
    { texto: "HOME", url: "/" },
    { texto: "PRODUCTOS", url: "/productos" },
    { texto: "GALERÍA", url: "/galeria" },
    { texto: "CONTACTO", url: "/contacto" },
];

const ctaButtonRaw = headerData?.Boton || {
    id: 999,
    texto: "RESERVAR",
    url: "/reservar",
};

// Ensure the CTA button URL is localized
const ctaButtonLocalized = {
    ...ctaButtonRaw,
    url: getLocalizedUrl(ctaButtonRaw.url, locale)
};

const buttons: Boton[] = [ctaButtonLocalized];
---

<header
    class="w-full absolute top-0 left-0 z-50 transition-all duration-500 ease-in-out"
    id="blu-header"
>
    <div
        class="max-w-360 mx-auto px-6 h-20 md:h-28 flex items-center justify-between transition-all duration-500 relative z-50"
    >
        <!-- Logo -->
        <a href="/" class="shrink-0">
            {
                logoUrl && (
                    <Image
                        src={logoUrl}
                        alt="Blu Ocean Club"
                        width={250}
                        height={100}
                        class="h-16 md:h-20 w-auto object-contain"
                    />
                )
            }
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden! md:flex! items-center space-x-12">
            {
                links.map((link: any) => (
                    <a
                        href={getLocalizedUrl(link.url, locale)}
                        class="text-white font-medium text-xs tracking-[0.2em] hover:text-[var(--neutral-background-subtle)] transition-colors uppercase font-[family-name:var(--font-dolphinaris-body)]"
                    >
                        {link.texto}
                    </a>
                ))
            }
        </nav>

        <!-- CTA Button & Mobile Toggle -->
        <div class="flex items-center gap-4">
            <!-- Language Switcher (Desktop) -->
            {
                (() => {
                    const isMultiLanguage =
                        import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
                    if (!isMultiLanguage) return null;

                    return (
                        <div class="hidden md:flex items-center">
                            {(() => {
                                const isEn = locale === "en";
                                const targetLang = isEn ? "es" : "en";
                                const flagUrl = isEn
                                    ? "https://flagcdn.com/w40/mx.png" // Show Mexico flag to switch to Spanish
                                    : "https://flagcdn.com/w40/us.png"; // Show USA flag to switch to English

                                // Simple URL replacement logic (robust enough for mostly static paths)
                                const currentPath = Astro.url.pathname;
                                const targetPath =
                                    currentPath.replace(
                                        `/${locale}`,
                                        `/${targetLang}`,
                                    ) || `/${targetLang}`;

                                return (
                                    <a
                                        href={targetPath}
                                        class="flex items-center gap-2 text-white hover:opacity-80 transition-opacity"
                                    >
                                        <span class="text-xs font-bold tracking-widest">
                                            {isEn ? "ES" : "EN"}
                                        </span>
                                        <img
                                            src={flagUrl}
                                            alt={isEn ? "Español" : "English"}
                                            class="w-6 h-auto rounded-sm border border-white/20"
                                        />
                                    </a>
                                );
                            })()}
                        </div>
                    );
                })()
            }

            <Button botones={buttons} clase="hidden md:block" />

            <button
                id="mobile-menu-toggle"
                class="md:hidden text-white p-2 focus:outline-none"
            >
                <i id="menu-icon" class="fa-solid fa-bars text-2xl"></i>
                <i id="close-icon" class="fa-solid fa-xmark text-2xl hidden!"
                ></i>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<div
    id="mobile-menu"
    class="hidden md:hidden fixed inset-0 bg-[var(--surface-brand-primary)] z-40 pt-28! px-10! flex flex-col"
>
    <nav class="flex! flex-col! space-y-8">
        {
            links.map((link: any) => (
                <a
                    href={getLocalizedUrl(link.url, locale)}
                    class="text-white font-bold text-lg md:text-3xl tracking-widest border-b border-white/5 pb-6! uppercase font-[family-name:var(--font-dolphinaris-title)]"
                >
                    {link.texto}
                </a>
            ))
        }
        <div class="flex flex-col gap-3">
            <Button botones={buttons} clase="w-full py-5! text-center text-xl" />

            <!-- Mobile Language Switcher -->
            {
                (() => {
                    const isMultiLanguage =
                        import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
                    if (!isMultiLanguage) return null;

                    const isEn = locale === "en";
                    const targetLang = isEn ? "es" : "en";
                    const flagUrl = isEn
                        ? "https://flagcdn.com/w40/mx.png"
                        : "https://flagcdn.com/w40/us.png";

                    const currentPath = Astro.url.pathname;
                    const targetPath =
                        currentPath.replace(`/${locale}`, `/${targetLang}`) ||
                        `/${targetLang}`;

                    return (
                        <a
                            href={targetPath}
                            class="flex items-center justify-center gap-3 text-white border border-white/20 py-3 rounded-md hover:bg-white/10 transition-colors"
                        >
                            <span class="text-md font-bold tracking-widest">
                                {isEn ? "ESPAÑOL" : "ENGLISH"}
                            </span>
                            <img
                                src={flagUrl}
                                alt={isEn ? "Español" : "English"}
                                class="w-8 h-auto rounded-sm"
                            />
                        </a>
                    );
                })()
            }
        </div>
    </nav>
</div>

<style>
    /* Default Mobile Background: Solid Blue */
    #blu-header {
        background-color: var(--surface-brand-primary);
    }

    /* Desktop Background: Vertical Gradient */
    @media (min-width: 768px) {
        #blu-header {
            background-color: transparent;
            background-image: linear-gradient(
                to bottom,
                var(--surface-brand-primary),
                transparent
            );
        }
    }

    /* Transición suave para el encabezado al hacer scroll */
    .header-scrolled {
        background-color: var(--surface-brand-primary) !important;
        background-image: none !important; /* Kill gradient */
        position: fixed !important;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        animation: slideInDown 0.5s ease;
    }

    /* Estado cuando el menú móvil está abierto: Fondo sólido forzado */
    .is-menu-open {
        background-color: var(--surface-brand-primary) !important;
        background-image: none !important;
    }

    .header-scrolled > div {
        height: 70px !important;
    }

    .header-scrolled > div {
        padding-top: 50px !important;
        padding-bottom: 50px !important;
    }

    @keyframes slideInDown {
        from {
            transform: translateY(-100%);
        }
        to {
            transform: translateY(0);
        }
    }
</style>

<script>
    const header = document.getElementById("blu-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    // Manejador de scroll para el header
    window.addEventListener("scroll", () => {
        // En mobile el fondo ya es sólido, pero aplicamos fixed y min-height igual
        if (window.scrollY > 50) {
            header?.classList.add("header-scrolled");
        } else {
            header?.classList.remove("header-scrolled");
        }
    });

    // Toggle del menú móvil
    toggle?.addEventListener("click", () => {
        const isHidden = menu?.classList.contains("hidden");
        if (isHidden) {
            menu?.classList.remove("hidden");
            header?.classList.add("is-menu-open"); // Force solid background
            menuIcon?.classList.add("hidden!");
            closeIcon?.classList.remove("hidden!");
            document.body.style.overflow = "hidden";
        } else {
            menu?.classList.add("hidden");
            header?.classList.remove("is-menu-open"); // Remove solid background force
            menuIcon?.classList.remove("hidden!");
            closeIcon?.classList.add("hidden!");
            document.body.style.overflow = "";
        }
    });
</script>
