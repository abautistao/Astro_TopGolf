---
// src/components/blu/Component_1_Blu.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    subtitulo?: string;
    titulo: string;
    descripcion: string;
    imagen: any;
    boton: Boton | Boton[] | null;
}

const { subtitulo, titulo, descripcion, imagen, boton = null } = Astro.props;

const strapiImageUrl =
    getStrapiUrl(imagen) ||
    "https://placehold.co/1920x1080/1a202c/ffffff?text=Video+Placeholder";
const descripcionHtml = descripcion ? stringifyRichText(descripcion) : "";

const buttons: Boton[] = Array.isArray(boton) ? boton : (boton ? [boton] : []);

// Check if we have any content to show
const hasContent = titulo || subtitulo || descripcion;

const isVideo = (url: string | undefined | null) => {
    if (!url) return false;
    const cleanUrl = url.split("?")[0].toLowerCase();
    return (
        cleanUrl.endsWith(".mp4") ||
        cleanUrl.endsWith(".webm") ||
        cleanUrl.endsWith(".ogg") ||
        cleanUrl.endsWith(".mov")
    );
};

const showVideo = isVideo(strapiImageUrl);
---

<section
    class="relative z-10 w-screen relative left-1/2 -ml-[50vw] h-[550px] md:h-screen md:min-h-[600px] flex items-end md:items-center justify-center overflow-hidden"
>
    <!-- Background Image or Video -->
    <div class="absolute inset-0 z-0">
        {
            showVideo ? (
                <video
                    src={strapiImageUrl}
                    autoplay
                    loop
                    muted
                    playsinline
                    class="w-full h-full object-cover"
                />
            ) : (
                <Image
                    src={strapiImageUrl}
                    alt={titulo || "Blu Ocean Club"}
                    width={1920}
                    height={1080}
                    class="w-full h-full object-cover"
                />
            )
        }
        <!-- Overlay (Mobile: Gradient from bottom, Desktop: Full dark overlay) -->
        {
            hasContent && (
                <>
                    <div class="absolute inset-0 bg-black/20 hidden md:block" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent md:hidden" />
                </>
            )
        }
    </div>

    <!-- Content -->
    {
        hasContent && (
            <div class="relative z-10 w-full max-w-[1440px] px-6 pb-16 md:pb-0 text-left md:text-center text-white md:mt-[-50px]">
                {/* Mobile Layout: Bottom Left. Desktop Layout: Center Center */}
                {subtitulo && (
                    <span class="block text-[20px] font-medium tracking-[0.1em] md:tracking-[0.2em] uppercase text-[var(--accent-highlight-primary)] font-[family-name:var(--font-dolphinaris-title)] mb-2 md:mb-4">
                        {subtitulo}
                    </span>
                )}
                {titulo && (
                    <h1 class="text-[32px] md:text-5xl lg:text-[60px] font-bold font-[family-name:var(--font-dolphinaris-title)] leading-tight mb-4 md:mb-8">
                        {titulo}
                    </h1>
                )}
                {descripcionHtml && (
                    <div class="text-[16px] font-normal md:text-[20px] opacity-90 font-[family-name:var(--font-dolphinaris-body)] max-w-3xl md:mx-auto">
                        <Fragment set:html={descripcionHtml} />
                    </div>
                )}
                {buttons.length > 0 && (
                    <div class="relative z-10 mt-6 md:mt-8 animate-fade-in-up delay-300 flex justify-center gap-4 flex-wrap">
                        <Button botones={buttons} />
                    </div>
                )}
            </div>
        )
    }

    <!-- Scroll Down Icon (Hidden on Mobile) -->
    <div
        class="hidden md:block absolute bottom-10 left-1/2 -translate-x-1/2 text-white animate-bounce opacity-50"
    >
        <i class="fa-solid fa-chevron-down text-xl"></i>
    </div>
</section>

<style>
    @keyframes fade-in-up {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .animate-fade-in-up {
        animation: fade-in-up 0.8s ease-out forwards;
    }

    .delay-100 {
        animation-delay: 0.1s;
    }
    .delay-200 {
        animation-delay: 0.2s;
    }
    .delay-300 {
        animation-delay: 0.3s;
    }
</style>
