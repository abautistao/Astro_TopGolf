---
// src/components/dolphinaris/BookingHome_Dolphinaris.astro

const { lang } = Astro.params;
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const currentLang = lang || defaultLocale;
const isEn = currentLang === 'en';

const t = {
    experience: isEn ? "EXPERIENCE" : "EXPERIENCIA",
    placeholder_experience: isEn ? "Select..." : "Selecciona...",
    date: isEn ? "DATE" : "FECHA",
    guests: isEn ? "GUESTS" : "INVITADOS",
    bookNow: isEn ? "BOOK NOW" : "RESERVAR AHORA",
};
---

<section class="w-full relative z-30 font-montserrat bg-(--surface-brand-primary) py-8 md:py-0 md:bg-transparent md:h-0 md:pointer-events-none">
    <div class="w-full px-4 md:max-w-5xl md:mx-auto z-50 pointer-events-auto relative md:absolute md:top-0 md:left-1/2 md:-translate-x-1/2 md:-translate-y-1/2">
        <!-- Container (Solid on Mobile, Glass on Desktop) -->
        <div class="w-full md:bg-white/10 md:backdrop-blur-md md:border md:border-white/20 md:p-6 md:shadow-2xl md:rounded-sm">
            <form method="get" action="booking" class="grid grid-cols-2 md:flex md:flex-row gap-4 lg:gap-6 items-end booking-home-form">
                
                <!-- Experience Dropdown -->
                <div class="col-span-2 md:col-span-none md:w-1/4 text-left w-full">
                    <label class="block text-white text-[12px] font-bold tracking-wider uppercase mb-2">
                        {t.experience}
                    </label>
                    <div class="relative">
                        <select name="producto_id" class="w-full h-12.5 bg-white/90 text-(--surface-brand-primary) px-3 outline-none focus:ring-2 focus:ring-(--accent-highlight-primary) appearance-none cursor-pointer text-[15px] font-roboto">
                            <option value="">{t.placeholder_experience}</option>
                            <option value="1">Dolphin Encounter</option>
                            <option value="2">Dolphin Swim Program</option>
                            <option value="3">Trainer for a Day</option>
                        </select>
                        <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-(--surface-brand-primary) text-sm pointer-events-none"></i>
                    </div>
                </div>
                
                <!-- Date Picker -->
                <div class="col-span-1 md:col-span-none md:w-1/4 text-left w-full">
                    <label class="block text-white text-[12px] font-bold tracking-wider uppercase mb-2">
                        {t.date}
                    </label>
                    <div class="relative">
                        <input 
                            name="reservacion_fecha"
                            type="text"
                            class="flatpickr-input-booking w-full h-12.5 bg-white/90 text-(--surface-brand-primary) px-3 outline-none focus:ring-2 focus:ring-(--accent-highlight-primary) text-[15px] cursor-pointer font-roboto"
                            placeholder="dd/mm/aaaa"
                        />
                        <i class="fa-regular fa-calendar absolute right-4 top-1/2 -translate-y-1/2 text-(--surface-brand-primary) pointer-events-none"></i>
                    </div>
                </div>
                
                <!-- Guests Counter -->
                <div class="col-span-1 md:col-span-none md:w-1/4 text-left w-full">
                    <label class="block text-white text-[12px] font-bold tracking-wider uppercase mb-2">
                        {t.guests}
                    </label>
                    <div class="flex h-12.5 bg-white/90 text-(--surface-brand-primary) item-center justify-between">
                        <button type="button" class="btn-minus px-4 h-full flex items-center justify-center hover:bg-gray-200 transition-colors cursor-pointer text-lg leading-none">-</button>
                        <input 
                            name="pax_min"
                            type="number" 
                            min="1" 
                            max="20"
                            value="2" 
                            class="guests-input w-full h-full text-center bg-transparent outline-none font-roboto text-[15px] pointer-events-none" 
                            readonly
                        />
                        <button type="button" class="btn-plus px-4 h-full flex items-center justify-center hover:bg-gray-200 transition-colors cursor-pointer text-lg leading-none">+</button>
                    </div>
                </div>
                
                <!-- Book Now Button -->
                <div class="col-span-2 md:col-span-none md:w-auto grow w-full mt-2 md:mt-0">
                    <button 
                        type="submit" 
                        class="w-full bg-(--accent-highlight-secondary) text-white font-bold tracking-wider text-[15px] uppercase py-2 px-3 hover:bg-(--accent-highlight-primary) transition-colors min-h-12.5 text-center leading-tight shadow-md"
                    >
                        {t.bookNow.replace(' ', '\n')}
                    </button>
                </div>
                
            </form>
        </div>
    </div>
</section>

<input id="currentLangBookingHome" type="hidden" name="lang" value={currentLang}>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script>
    import flatpickr from "flatpickr";
    import { english } from "flatpickr/dist/l10n/default.js"; 
    import { Spanish } from "flatpickr/dist/l10n/es.js";

    function initBookingLogic() {
        // Date Picker
        const inputs = document.querySelectorAll('.flatpickr-input-booking');
        const langInput = document.querySelector('#currentLangBookingHome') as HTMLInputElement;
        const locale: any = {
            'en': english,
            'es': Spanish,
        };

        inputs.forEach((input) => {
            flatpickr(input as HTMLInputElement, {
                locale: langInput ? locale[langInput.value] : english,
                dateFormat: "Y-m-d", 
                altInput: true,
                altFormat: "d/m/Y",
                minDate: "today",
                defaultDate: 'today',
            });
        });

        // Guest Counter
        const forms = document.querySelectorAll('.booking-home-form');
        forms.forEach(form => {
            // Prevent multiple bindings
            if(form.getAttribute('data-bound')) return;
            form.setAttribute('data-bound', 'true');

            const btnMinus = form.querySelector('.btn-minus') as HTMLButtonElement;
            const btnPlus = form.querySelector('.btn-plus') as HTMLButtonElement;
            const input = form.querySelector('.guests-input') as HTMLInputElement;

            if (btnMinus && btnPlus && input) {
                btnMinus.addEventListener('click', () => {
                    let val = parseInt(input.value || "1");
                    if (val > 1) {
                        input.value = (val - 1).toString();
                        input.setAttribute('value', input.value);
                    }
                });

                btnPlus.addEventListener('click', () => {
                    let val = parseInt(input.value || "1");
                    if (val < 20) {
                        input.value = (val + 1).toString();
                        input.setAttribute('value', input.value);
                    }
                });
            }
        });
    }

    // Attempt immediately and attach to view transitions
    initBookingLogic();
    document.addEventListener("astro:page-load", initBookingLogic);
</script>
