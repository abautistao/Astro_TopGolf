---
// src/components/dolphinaris/BookingHome_Dolphinaris.astro

const { lang } = Astro.params;
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const currentLang = lang || defaultLocale;
const isEn = currentLang === 'en';

const t = {
    experience: isEn ? "EXPERIENCE" : "EXPERIENCIA",
    placeholder_experience: isEn ? "Select..." : "Selecciona...",
    date: isEn ? "DATE" : "FECHA",
    guests: isEn ? "GUESTS" : "INVITADOS",
    bookNow: isEn ? "BOOK NOW" : "RESERVAR AHORA",
};
---

<section class="w-full relative z-30 px-4 font-montserrat">
    <div class="w-full max-w-5xl mx-auto -mt-16 md:-mt-24 relative z-20">
        <!-- Floating Container -->
        <div class="bg-white/10 backdrop-blur-md border border-white/20 p-6 shadow-2xl rounded-sm">
            <form method="get" action="booking" class="flex flex-col md:flex-row gap-4 lg:gap-6 items-end booking-home-form">
                
                <!-- Experience Dropdown -->
                <div class="w-full md:w-1/3 text-left">
                    <label class="block text-white text-[12px] font-bold tracking-wider uppercase mb-2">
                        {t.experience}
                    </label>
                    <div class="relative">
                        <select name="producto_id" class="w-full bg-white/90 text-[var(--surface-brand-primary)] p-3 outline-none focus:ring-2 focus:ring-[var(--accent-highlight-primary)] appearance-none cursor-pointer text-[15px] font-roboto">
                            <option value="">{t.placeholder_experience}</option>
                            <option value="1">Dolphin Encounter</option>
                            <option value="2">Dolphin Swim Program</option>
                            <option value="3">Trainer for a Day</option>
                        </select>
                        <i class="fa-solid fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-[var(--surface-brand-primary)] text-sm pointer-events-none"></i>
                    </div>
                </div>
                
                <!-- Date Picker -->
                <div class="w-full md:w-1/4 text-left">
                    <label class="block text-white text-[12px] font-bold tracking-wider uppercase mb-2">
                        {t.date}
                    </label>
                    <div class="relative">
                        <input 
                            name="reservacion_fecha"
                            type="text"
                            class="flatpickr-input-booking w-full bg-white/90 text-[var(--surface-brand-primary)] p-3 outline-none focus:ring-2 focus:ring-[var(--accent-highlight-primary)] text-[15px] cursor-pointer font-roboto"
                            placeholder="dd/mm/aaaa"
                        />
                        <i class="fa-regular fa-calendar absolute right-4 top-1/2 -translate-y-1/2 text-[var(--surface-brand-primary)] pointer-events-none"></i>
                    </div>
                </div>
                
                <!-- Guests Counter -->
                <div class="w-full md:w-1/4 text-left">
                    <label class="block text-white text-[12px] font-bold tracking-wider uppercase mb-2">
                        {t.guests}
                    </label>
                    <div class="flex bg-white/90 text-[var(--surface-brand-primary)] item-center justify-between">
                        <button type="button" class="btn-minus px-4 py-3 hover:bg-gray-200 transition-colors cursor-pointer text-lg leading-none">-</button>
                        <input 
                            name="pax_min"
                            type="number" 
                            min="1" 
                            max="20"
                            value="2" 
                            class="guests-input w-full text-center bg-transparent outline-none font-roboto text-[15px] pointer-events-none" 
                            readonly
                        />
                        <button type="button" class="btn-plus px-4 py-3 hover:bg-gray-200 transition-colors cursor-pointer text-lg leading-none">+</button>
                    </div>
                </div>
                
                <!-- Book Now Button -->
                <div class="w-full md:w-auto flex-grow">
                    <button 
                        type="submit" 
                        class="w-full bg-[var(--accent-highlight-secondary)] text-white font-bold tracking-wider text-[15px] uppercase p-3 hover:bg-[var(--accent-highlight-primary)] transition-colors h-[48px]"
                    >
                        {t.bookNow}
                    </button>
                </div>
                
            </form>
        </div>
    </div>
</section>

<input id="currentLangBookingHome" type="hidden" name="lang" value={currentLang}>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script>
    import flatpickr from "flatpickr";
    import { english } from "flatpickr/dist/l10n/default.js"; 
    import { Spanish } from "flatpickr/dist/l10n/es.js";

    function initBookingLogic() {
        // Date Picker
        const inputs = document.querySelectorAll('.flatpickr-input-booking');
        const langInput = document.querySelector('#currentLangBookingHome') as HTMLInputElement;
        const locale: any = {
            'en': english,
            'es': Spanish,
        };

        inputs.forEach((input) => {
            flatpickr(input as HTMLInputElement, {
                locale: langInput ? locale[langInput.value] : english,
                dateFormat: "Y-m-d", 
                altInput: true,
                altFormat: "d/m/Y",
                minDate: "today",
                defaultDate: 'today',
            });
        });

        // Guest Counter
        const forms = document.querySelectorAll('.booking-home-form');
        forms.forEach(form => {
            // Prevent multiple bindings
            if(form.getAttribute('data-bound')) return;
            form.setAttribute('data-bound', 'true');

            const btnMinus = form.querySelector('.btn-minus') as HTMLButtonElement;
            const btnPlus = form.querySelector('.btn-plus') as HTMLButtonElement;
            const input = form.querySelector('.guests-input') as HTMLInputElement;

            if (btnMinus && btnPlus && input) {
                btnMinus.addEventListener('click', () => {
                    let val = parseInt(input.value || "1");
                    if (val > 1) {
                        input.value = (val - 1).toString();
                        input.setAttribute('value', input.value);
                    }
                });

                btnPlus.addEventListener('click', () => {
                    let val = parseInt(input.value || "1");
                    if (val < 20) {
                        input.value = (val + 1).toString();
                        input.setAttribute('value', input.value);
                    }
                });
            }
        });
    }

    // Attempt immediately and attach to view transitions
    initBookingLogic();
    document.addEventListener("astro:page-load", initBookingLogic);
</script>
