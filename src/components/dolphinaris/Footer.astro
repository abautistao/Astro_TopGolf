---
// src/components/dolphinaris/Footer.astro
import {
    getFooterData,
    getStrapiUrl,
    getLocalizedUrl,
    formatUrl,
} from "../../lib/strapi";
import { Image } from "astro:assets";

import localLogo from "../../assets/dolphinaris/logo.png"; // Placeholder if doesn't exist, we will use a fallback

interface Props {
    data?: any;
    locale?: string;
}

const { data, locale = "en" } = Astro.props;
const footerData = data || (await getFooterData(locale));

// Column 1
const logoUrl = getStrapiUrl(footerData?.logo) || null;
const descripcion_logo = footerData?.descripcion_logo || "Unforgettable experiences in the Mexican Caribbean.";
const socialIcons = footerData?.social || [
    { url: "#", icon: "<i class=\"fa-brands fa-facebook-f\"></i>" },
    { url: "#", icon: "<i class=\"fa-brands fa-instagram\"></i>" },
    { url: "#", icon: "<i class=\"fa-brands fa-tiktok\"></i>" },
    { url: "#", icon: "<i class=\"fa-brands fa-youtube\"></i>" }
];

// Column 2
const titulo_experiencias = footerData?.columna_experiencias_titulo || "EXPERIENCES";
const links_experiencias = footerData?.links_experiencias || [
    { texto: "Dolphin Friendly Encounter", url: "#" },
    { texto: "Dolphin Swim", url: "#" },
    { texto: "Tabasco Chef Maestro - Mexican Cuisine", url: "#" },
    { texto: "Ultimate Mexology For A Day", url: "#" }
];

// Column 3
const titulo_legal = footerData?.columna_legal_titulo || "LEGAL";
const links_legal = footerData?.links_legal || [
    { texto: "About Us", url: "/about" },
    { texto: "Foundation", url: "#" },
    { texto: "Contact", url: "/contact" },
    { texto: "FAQs", url: "/faqs" },
    { texto: "Affiliates", url: "#" },
    { texto: "Privacy Notice", url: "/privacy-notice" },
    { texto: "Terms and Conditions", url: "/terms" }
];

// Column 4
const titulo_contacto = footerData?.columna_contacto_titulo || "CONTACT";
const contacto_direccion = footerData?.contacto_direccion || "Carretera Costera Sur Km 4, San Miguel de Cozumel, Q.R., Mexico";
const contacto_telefono = footerData?.contacto_telefono || "+52 558 900 9996";
const contacto_email = footerData?.contacto_email || "info@dolphinaris.com";

const year = new Date().getFullYear();

const { lang } = Astro.params;
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const currentLang = lang || defaultLocale;
const isEn = currentLang === 'en';

const t = {
    privacy: isEn ? "Privacy notice" : "Aviso de privacidad",
    terms: isEn ? "Terms and conditions" : "Términos y condiciones",
    rights: isEn ? "all rights reserved" : "Todos los derechos reservados",
    link_privacy: isEn ? "/en/privacy-notice" : "/es/aviso-de-privacidad",
    link_terms: isEn ? "/en/terms-and-conditions" : "/es/terminos-y-condiciones",
};
---

<footer
    class="w-full font-(--font-dolphinaris-body) bg-(--neutral-background-strong) pt-16 pb-8 px-6 md:px-12 text-white overflow-hidden relative"
>
    <!-- Background vector logic if needed, though for now removed to match clean dark blue of Dolphinaris -->

    <div class="max-w-360 mx-auto grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 relative z-10">
        
        {/* Column 1: Logo & Description */}
        <div class="flex flex-col items-start gap-6">
            {logoUrl ? (
                <Image
                    src={logoUrl}
                    alt="Dolphinaris"
                    width={200}
                    height={50}
                    class="h-16 md:h-20 w-auto object-contain mb-2"
                />
            ) : (
                <h3 class="text-[32px] font-(--font-dolphinaris-title) tracking-wide uppercase mb-2">DOLPHINARIS</h3>
            )}
            
            <p class="text-[16px] opacity-90 leading-relaxed max-w-sm">
                {descripcion_logo}
            </p>
            
            <div class="flex gap-4 items-center mt-2">
                {socialIcons.map((icon: any) => (
                    <a
                        href={formatUrl(icon.url)}
                        class="text-white hover:text-(--accent-highlight-secondary) transition-colors text-lg"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <span class="flex items-center justify-center hover:scale-110 transition-transform" set:html={icon.icon} />
                    </a>
                ))}
            </div>
        </div>

        {/* Column 2: Experiences */}
        <div class="flex flex-col gap-6">
            <h4 class="text-[20px] tracking-[0.15em] text-(--accent-highlight-secondary) font-(--font-dolphinaris-title) uppercase">
                {titulo_experiencias}
            </h4>
            <ul class="flex flex-col gap-4">
                {links_experiencias.map((link: any) => (
                    <li>
                        <a
                            href={getLocalizedUrl(link.url, locale)}
                            class="text-[16px] opacity-90 hover:opacity-100 hover:text-(--accent-highlight-primary) transition-colors text-white!"
                        >
                            {link.texto}
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        {/* Column 3: Legal */}
        <div class="flex flex-col gap-6">
            <h4 class="text-[20px] tracking-[0.15em] text-(--accent-highlight-secondary) font-(--font-dolphinaris-title) uppercase">
                {titulo_legal}
            </h4>
            <ul class="flex flex-col gap-4">
                {links_legal.map((link: any) => (
                    <li>
                        <a
                            href={getLocalizedUrl(link.url, locale)}
                            class="text-[16px] opacity-90 hover:opacity-100 hover:text-(--accent-highlight-primary) transition-colors text-white!"
                        >
                            {link.texto}
                        </a>
                    </li>
                ))}
            </ul>
        </div>

        {/* Column 4: Contact */}
        <div class="flex flex-col gap-6">
            <h4 class="text-[20px] tracking-[0.15em] text-(--accent-highlight-secondary) font-(--font-dolphinaris-title) uppercase">
                {titulo_contacto}
            </h4>
            <div class="flex flex-col gap-5 text-[16px] opacity-90">
                {contacto_direccion && (
                    <div class="flex items-start gap-3">
                        <i class="fa-solid fa-location-dot mt-1 text-(--accent-highlight-secondary)"></i>
                        <p class="leading-relaxed">{contacto_direccion}</p>
                    </div>
                )}
                {contacto_telefono && (
                    <div class="flex items-center gap-3">
                        <i class="fa-solid fa-phone text-(--accent-highlight-secondary)"></i>
                        <a
                            href={`tel:${contacto_telefono.replace(/[^0-9+]/g, "")}`}
                            class="hover:text-(--accent-highlight-primary) transition-colors text-white!"
                        >
                            {contacto_telefono}
                        </a>
                    </div>
                )}
                {contacto_email && (
                    <div class="flex items-center gap-3">
                        <i class="fa-regular fa-envelope text-(--accent-highlight-secondary)"></i>
                        <a
                            href={`mailto:${contacto_email}`}
                            class="hover:text-(--accent-highlight-primary) transition-colors text-white!"
                        >
                            {contacto_email}
                        </a>
                    </div>
                )}
            </div>
        </div>

    </div>

    {/* Bottom Bar: Copyright and Extra Legal Links */}
    <div
        class="max-w-360 mx-auto mt-16 pt-8 border-t border-white/20 flex flex-col space-y-4 md:space-y-0 md:flex-row justify-between items-center text-[14px] opacity-70 relative z-10"
    >
        <p>© {year} Dolphinaris. {t.rights}</p>
        <div class="flex gap-6">
            <a href={t.link_privacy} class="text-white! hover:text-(--accent-highlight-primary) transition-colors">{t.privacy}</a>
            <a href={t.link_terms} class="text-white! hover:text-(--accent-highlight-primary) transition-colors">{t.terms}</a>
        </div>
    </div>
</footer>
