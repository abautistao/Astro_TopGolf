---
// src/components/Component_26.astro

// 2. Define la URL de la imagen de respaldo
const placeholderImageUrl = "https://placehold.co/370x205/4a5568/ffffff?text=cards";

// 3. Define el contenido de cada tarjeta en un arreglo
const cardsData = [
    {
        imageUrl: "",
        title: 'Es golf no es golf es topgolf',
        description: 'Nuestras tarjetas de regalo son válidas para cualquier cosa en el lugar: equipo, juegos, comida e incluso lecciones.',
    },
    {
        imageUrl: "", // <-- IMAGEN QUITADA PARA MOSTRAR EL PLACEHOLDER
        title: 'Es golf no es golf es topgolf',
        description: 'Nuestras tarjetas de regalo son válidas para cualquier cosa en el lugar: equipo, juegos, comida e incluso lecciones.',
    },
    {
        imageUrl: "",
        title: 'Ven y disfruta con amigos o con familia, tú eliges.',
        description: 'Nuestras tarjetas de regalo son válidas para cualquier cosa en el lugar: equipo, juegos, comida e incluso lecciones.',
    },
];
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">

            {cardsData.map(card => (
                <div class="bg-[var(--neutral-background-subtle)] p-6 flex flex-col text-left">
                    <img
                        src={card.imageUrl?.src || placeholderImageUrl}
                        alt={card.title}
                        class="w-full h-48 object-cover rounded-t-lg shadow-md"
                        loading="lazy"
                        decoding="async"
                        width="370"
                        height="205"
                    />
                    <h3 class="text-xl font-bold text-[var(--neutral-background-strong)] mt-6">
                        {card.title}
                    </h3>
                    <p class="text-[var(--neutral-background-strong)] mt-2 flex-grow">
                        {card.description}
                    </p>
                </div>
            ))}

        </div>
    </div>
</section>