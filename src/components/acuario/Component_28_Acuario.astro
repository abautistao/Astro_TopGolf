---
import { getStrapiUrl } from "../../lib/strapi.js";

export interface Props {
    tipo_media?: "imagen" | "youtube";
    imagen?: any;
    youtube_url?: string;
    relacion_aspecto?: "16_9" | "4_3" | "1_1" | "21_9" | "3_4" | "libre";
    color_fondo?: string;
}

const {
    tipo_media = "imagen",
    imagen,
    youtube_url,
    relacion_aspecto = "16_9",
    color_fondo,
} = Astro.props;

// Cascade: editor override (hex from the color picker) wins, otherwise the
// theme CSS variable defined by setup-site.
const finalBg = color_fondo || "var(--surface-brand-primary)";

// Map schema enum values to Tailwind aspect ratio utilities.
const aspectClassMap: Record<string, string> = {
    "16_9": "aspect-video",
    "4_3": "aspect-[4/3]",
    "1_1": "aspect-square",
    "21_9": "aspect-[21/9]",
    "3_4": "aspect-[3/4]",
    "9_16": "aspect-[9/16]",
    "libre": "",
};
const rawAspect = aspectClassMap[relacion_aspecto] ?? "aspect-video";
const isLibre = relacion_aspecto === "libre";
// libre means "auto": images size themselves, but a cross-origin YouTube
// iframe cannot report its content size, so infer it from the URL instead.
// Shorts are always vertical; any other video defaults to 16:9.
const isShortsUrl = /youtube\.com\/shorts\//.test(youtube_url ?? "");
const libreAspect = tipo_media === "youtube" ? (isShortsUrl ? "aspect-[9/16]" : "aspect-video") : "";
const wrapperAspect = isLibre ? libreAspect : rawAspect;
// Portrait boxes would be gigantic at full width, so cap them and center.
const wrapperWidth = wrapperAspect === "aspect-[9/16]" || wrapperAspect === "aspect-[4/3]" ? "max-w-md mx-auto" : "";

// YouTube URL parser supporting watch, share, embed, and shorts forms.
// Pattern B from componente-9-acuario.
const getYoutubeId = (url: string) => {
    if (!url) return null;
    const patterns = [
        /youtube\.com\/watch\?v=([a-zA-Z0-9_-]+)/,
        /youtu\.be\/([a-zA-Z0-9_-]+)/,
        /youtube\.com\/embed\/([a-zA-Z0-9_-]+)/,
        /youtube\.com\/shorts\/([a-zA-Z0-9_-]+)/,
    ];
    for (const p of patterns) {
        const m = url.match(p);
        if (m) return m[1];
    }
    return null;
};

// Resolve media URL with null guard; Strapi media may come wrapped in { data: { attributes: { url } } }.
const mediaUrl = getStrapiUrl(imagen);
const youtubeId = tipo_media === "youtube" ? getYoutubeId(youtube_url ?? "") : null;
---

<section
    class="w-full py-12 md:py-20"
    style={`background-color: ${finalBg};`}
>
    <div class="container mx-auto px-4 md:px-6 max-w-7xl">
        <div class:list={[
            "c28-marco w-full relative overflow-hidden rounded-[24px] bg-transparent",
            wrapperAspect,
            wrapperWidth,
        ]}>
            {tipo_media === "youtube" && youtubeId ? (
                <iframe
                    src={`https://www.youtube.com/embed/${youtubeId}`}
                    title="YouTube video"
                    class="absolute inset-0 w-full h-full"
                    frameborder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                />
            ) : tipo_media === "imagen" && mediaUrl ? (
                isLibre ? (
                    <img
                        src={mediaUrl}
                        alt=""
                        class="block w-full h-auto object-contain"
                    />
                ) : (
                    <img
                        src={mediaUrl}
                        alt=""
                        class="w-full h-full object-cover"
                    />
                )
            ) : null}
        </div>
    </div>
</section>

<script>
    import { initMotion, revealSection, zoomImage } from "../../scripts/motion";

    /*
     * Bloque de media motion (T8).
     *
     * Este bloque tiene dos variantes y ninguna de las dos necesita un `<script>`
     * propio de lógica: sólo renderiza un `<img>` o un `<iframe>` de YouTube
     * dentro de un marco que recorta.
     *
     * El ancla es `.c28-marco`, la clase que lleva el `<div>` contenedor — el
     * que tiene `overflow-hidden` — y NO el `<img>` ni el `<iframe>`. El marco es
     * un envoltorio NO interactivo: no es un control, no recibe foco y no
     * guarda ningún valor, así que revelarlo no puede dejar nada invisible
     * detrás de una Tecla.
     *
     * POR QUÉ el marco sí se revela con opacidad (a diferencia del `<form>` del
     * componente-16): el `<iframe>` de YouTube SÍ es focusable —el teclado puede
     * entrar en él—, pero el helper tiene la red de seguridad para eso
     * (`bindFocusRescue`): en cuanto algo dentro de un contenedor con
     * `opacity: 0` en línea recibe el foco, el contenedor se limpia y el control
     * queda visible justo cuando el usuario lo necesita. Ese mecanismo es
     * justamente lo que permite este reveal, y lo que hace IMPOSIBLE revelar
     * el `<iframe>` en sí mismo (el helper limpia a los ANCESTROS del elemento
     * enfocado, no al elemento enfocado: un `<iframe>` con opacidad 0 propia se
     * quedaría invisible y focusable para siempre).
     *
     * POR QUÉ no hay CSS de estado inicial para el marco: `revealSection` y
     * `zoomImage` construyen tweens `gsap.from()`, que leen el valor ACTUAL del
     * elemento como destino al crearse. Una regla de stylesheet que preocultara
     * el marco bajo `[data-motion="ready"]` sería leída como ese destino, el
     * tween animaría `opacity: 0 → 0` y el bloque se quedaría invisible para
     * siempre. El estado inicial escondido viene del tween, que es lo que
     * mantiene honesta la regla de "sin JS, sin atributo de disponibilidad, sin
     * contenido oculto".
     */
    function setupMediaMotion() {
        document.querySelectorAll<HTMLElement>('.c28-marco').forEach((marco) => {
            // El marco entra con un reveal corto: sube y aparece. Es un tween de
            // una sola pasada (`once: true`), así que una vez que el bloque
            // quedó atrás no se vuelve a tocar.
            revealSection(marco, {
                y: 30,
                duration: 0.85,
                ease: 'power3.out',
            });

            // El zoom pertenece SÓLO a la variante de imagen. `zoomImage` es un
            // tween con `scrub` sobre la escala de la imagen, y la imagen
            // vive dentro del marco con `overflow-hidden`, así que el recorte
            // recorta el sobredimensionado en vez de dejarlo asomar: no hace
            // falta ningún `scale` de holgura en el stylesheet.
            //
            // El `<iframe>` de YouTube queda fuera a propósito: meter motion
            // dentro del reproductor es imposible (es un documento ajeno) y
            // transformarlo movería el player bajo el cursor.
            const imagen = marco.querySelector('img');
            if (imagen) {
                zoomImage(imagen, {
                    from: 1.07,
                    to: 1,
                    duration: 1.1,
                });
            }
        });
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que un
    // trigger registrado antes de `initMotion()` no haría nada.
    initMotion();
    setupMediaMotion();

    // Decision 7, replicado del helper: en una navegación del lado del cliente
    // el helper desmonta sus triggers y vuelve a armar motion, así que los
    // triggers tienen que registrarse otra vez. `Layout.astro` no registra
    // ClientRouter hoy, así que esto nunca se dispara; existe para que el
    // bloque no se quede estático si algún día se activa el modo SPA. La
    // guarda del primer evento replica la del helper: Astro también dispara
    // `astro:page-load` en la carga inicial, y volver a registrar ahí dejaría
    // dos ScrollTrigger sobre los mismos elementos.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupMediaMotion();
    });
</script>