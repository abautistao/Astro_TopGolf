---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    subtitulo?: string;
    descripcion?: any;
    color_fondo?: string;
    imagen_fondo?: any;
    color_titulo?: string;
    color_texto?: string;
    tarjetas?: any[];
}

const {
    titulo,
    htmlTag = "h2",
    subtitulo,
    descripcion,
    color_fondo,
    imagen_fondo,
    color_titulo,
    color_texto,
    tarjetas = [],
} = Astro.props;

const TitleTag = htmlTag;
---

<section
    class="w-full py-12 md:py-20 relative overflow-hidden"
    style={{
        backgroundColor: color_fondo || "transparent",
        backgroundImage: imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none",
        backgroundSize: "cover",
        backgroundPosition: "center",
    }}
>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl relative z-10">
        {(titulo || subtitulo || descripcion) && (
            <div class="text-center mb-10 md:mb-16">
                {titulo && (
                    <TitleTag
                        class="font-[family-name:var(--font-principal)] text-[32px] md:text-[42px] font-bold uppercase mb-2"
                        style={color_titulo ? { color: color_titulo } : { color: "var(--surface-brand-primary)" }}
                    >
                        {titulo}
                    </TitleTag>
                )}

                {subtitulo && (
                    <span
                        class="block font-[family-name:var(--font-principal)] text-[18px] md:text-[22px] font-medium uppercase tracking-wide"
                        style={color_texto ? { color: color_texto } : { color: "var(--surface-brand-primary)" }}
                    >
                        {subtitulo}
                    </span>
                )}

                {descripcion && (
                    <div
                        class="mt-6 mx-auto max-w-3xl font-[family-name:var(--font-secundaria)] text-[16px] md:text-[18px] font-normal leading-relaxed text-center [&>p]:mb-2 [&_strong]:font-bold [&_u]:underline [&_em]:italic"
                        style={color_texto ? { color: color_texto } : undefined}
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>
        )}

        {tarjetas && tarjetas.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10 lg:gap-12 justify-items-center">
                {tarjetas.map((tarjeta) => {
                    const CardTag = (tarjeta.htmlTag || "h3") as "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
                    return (
                        <div class="flex flex-col items-center text-center w-full max-w-[320px] group">
                            {tarjeta.imagen && (
                                <img
                                    src={getStrapiUrl(tarjeta.imagen)}
                                    alt={tarjeta.titulo || "Tarjeta"}
                                    class="w-full max-w-[220px] h-auto"
                                    loading="lazy"
                                />
                            )}

                            {tarjeta.titulo && (
                                <CardTag
                                    class="mt-5 font-[family-name:var(--font-principal)] text-[20px] md:text-[22px] font-bold uppercase leading-tight"
                                    style={color_titulo ? { color: color_titulo } : { color: "var(--neutral-text-inverted, #ffffff)" }}
                                >
                                    {tarjeta.titulo}
                                </CardTag>
                            )}

                            {tarjeta.subtitulo && (
                                <span
                                    class="mt-1 font-[family-name:var(--font-secundaria)] text-[14px] md:text-[16px] font-normal leading-snug"
                                    style={color_texto ? { color: color_texto } : { color: "var(--neutral-text-inverted, #ffffff)" }}
                                >
                                    {tarjeta.subtitulo}
                                </span>
                            )}
                        </div>
                    );
                })}
            </div>
        )}
    </div>
</section>