---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo?: string;
    subtitulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    color_fondo?: string;
    imagen_fondo?: any;
    galeria?: { data: any[] } | any[];
}

const {
    titulo,
    subtitulo,
    htmlTag = "h2",
    descripcion,
    color_fondo,
    imagen_fondo,
    galeria,
} = Astro.props;

const TitleTag = htmlTag;
const finalBgColor = color_fondo || "var(--surface-brand-primary)";
const bgImageStyle = imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none";

// Procesar galería
// Strapi entrega la galería como `{ data: [...] }` o como arreglo plano según
// la forma del response; el `Array.isArray` sólo desambigua el tipo para que
// el compilador pueda leer `.data` sin cambiar el comportamiento (si el
// response trae la estructura sin `data`, se usa una lista vacía en lugar de
// reventar la build).
const mediaFiles: any[] = Array.isArray(galeria) ? galeria : (galeria?.data ?? []);
---

<section 
    class="w-full py-16 md:py-24 relative overflow-hidden c13-section" 
    style={{
        backgroundColor: finalBgColor,
        backgroundImage: bgImageStyle,
        backgroundSize: "cover",
        backgroundPosition: "center",
    }}
>
    <div class="container mx-auto px-6 md:px-12 relative z-10 max-w-[1440px]">
        
        {/* Cabecera: Título, Subtítulo y Descripción */}
        <div class="text-center max-w-4xl mx-auto mb-12 md:mb-16 px-6 md:px-12">
            {titulo && (
                <TitleTag class="c13-title font-[family-name:var(--font-principal)] text-[32px] md:text-[40px] font-bold uppercase text-white mb-2">
                    {titulo}
                </TitleTag>
            )}
            {subtitulo && (
                <p class="c13-subtitle font-[family-name:var(--font-principal)] text-[20px] md:text-[24px] uppercase text-[var(--accent-highlight-primary)] mb-6">
                    {subtitulo}
                </p>
            )}
            {descripcion && (
                <div 
                    class="c13-text font-[family-name:var(--font-secundaria)] text-[16px] md:text-[18px] text-white leading-relaxed opacity-90 [&>p]:mb-4"
                    set:html={stringifyRichText(descripcion)}
                />
            )}
        </div>

        {/* Carrusel de Imágenes */}
        {mediaFiles.length > 0 && (
            <div class="c13-carousel relative w-full px-0 md:px-10">
                <div class="componente-13-swiper w-full overflow-hidden pb-12" data-total={mediaFiles.length}>
                    <div class="swiper-wrapper flex items-stretch">
                        {mediaFiles.map((mediaFile: any) => {
                            const url = getStrapiUrl(mediaFile);
                            const isVideo = mediaFile?.attributes?.mime?.startsWith('video/') || mediaFile?.mime?.startsWith('video/');
                            
                            return (
                                <div class="swiper-slide h-auto">
                                    <div class="w-full h-[300px] md:h-[400px] rounded-[24px] overflow-hidden shadow-lg relative group">
                                        {isVideo ? (
                                            <video 
                                                src={url} 
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
                                                autoplay 
                                                loop 
                                                muted 
                                                playsinline
                                            ></video>
                                        ) : (
                                            <img 
                                                src={url} 
                                                alt={mediaFile?.attributes?.alternativeText || "Galería Acuario"} 
                                                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                                            />
                                        )}
                                        {/* Overlay para contraste si es necesario */}
                                        <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>

                {/* Controles de Navegación y Paginación */}
                <div class="absolute bottom-0 left-0 right-0 flex justify-center items-center gap-6 z-20">
                    <button class="comp13-btn-prev text-white hover:text-[var(--accent-highlight-primary)] transition-colors duration-300 focus:outline-none flex items-center justify-center cursor-pointer">
                        <i class="fa-solid fa-angle-left text-2xl md:text-3xl"></i>
                    </button>
                    
                    <div class="comp13-pagination flex items-center justify-center gap-2"></div>
                    
                    <button class="comp13-btn-next text-white hover:text-[var(--accent-highlight-primary)] transition-colors duration-300 focus:outline-none flex items-center justify-center cursor-pointer">
                        <i class="fa-solid fa-angle-right text-2xl md:text-3xl"></i>
                    </button>
                </div>
            </div>
        )}
    </div>
</section>

<style>
    .componente-13-swiper .swiper-slide {
        transition: transform 0.4s ease, opacity 0.4s ease;
    }
    
    /* Estilos de la Paginación */
    :global(.comp13-pagination .swiper-pagination-bullet) {
        background: #ffffff;
        opacity: 0.5;
        width: 10px;
        height: 10px;
        transition: all 0.3s ease;
        border-radius: 50%;
        cursor: pointer;
    }
    :global(.comp13-pagination .swiper-pagination-bullet-active) {
        background: var(--accent-highlight-primary);
        opacity: 1;
        transform: scale(1.3);
    }
    
    /* Evitar selección de texto en botones */
    .comp13-btn-prev, .comp13-btn-next {
        user-select: none;
    }
    .comp13-btn-prev.swiper-button-disabled, .comp13-btn-next.swiper-button-disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, Autoplay } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';
    import { initMotion, revealSection, parallaxLayer, ambientBubbles } from "../../scripts/motion";

    function initComp13Swiper() {
        const sliders = document.querySelectorAll('.componente-13-swiper');
        
        sliders.forEach((sliderElement) => {
            const container = sliderElement.closest('.relative.w-full');
            const prevBtn = container?.querySelector('.comp13-btn-prev') as HTMLElement;
            const nextBtn = container?.querySelector('.comp13-btn-next') as HTMLElement;
            const paginationEl = container?.querySelector('.comp13-pagination') as HTMLElement;
            
            const totalSlides = parseInt(sliderElement.getAttribute('data-total') || '0', 10);
            // Solo auto-play y loop si hay más de 3 imágenes
            const shouldAutoplay = totalSlides > 3;

            new Swiper(sliderElement as HTMLElement, {
                modules: [Navigation, Pagination, Autoplay],
                loop: shouldAutoplay,
                autoplay: shouldAutoplay ? {
                    delay: 3500,
                    disableOnInteraction: false,
                } : false,
                slidesPerView: 1, // Móvil: 1 imagen
                spaceBetween: 16,
                pagination: {
                    el: paginationEl,
                    clickable: true,
                },
                navigation: {
                    nextEl: nextBtn,
                    prevEl: prevBtn,
                },
                breakpoints: {
                    // Tablets (SM/MD)
                    768: {
                        slidesPerView: 2,
                        spaceBetween: 20,
                    },
                    // Desktop (LG)
                    1024: {
                        slidesPerView: 3, // Desktop: 3 imágenes
                        spaceBetween: 24,
                    }
                }
            });
        });
    }

    // Inicializar al cargar el DOM y en ViewTransitions
    document.addEventListener('DOMContentLoaded', initComp13Swiper);
    document.addEventListener('astro:page-load', initComp13Swiper);

    /*
     * Motion del bloque (T5) — cabecera de texto + carrusel de galería.
     *
     * Por qué NO se revela ninguna diapositiva: Swiper es dueño del transform de
     * sus diapositivas, y una diapositiva en opacidad 0 se quedaría invisible
     * hasta que el usuario la alcanzara con el dedo, sin que el ScrollTrigger
     * volviera a evaluarla (la posición de un trigger no sigue el transform
     * interno de Swiper). El carrusel entra como una sola pieza: se revela el
     * contenedor que lo abraza (carrusel + controles), no cada imagen.
     *
     * Por qué el fondo no lleva parallax: la imagen de fondo del bloque es el
     * `background-image` CSS del propio `<section>`, y el helper sólo puede
     * desplazar un ELEMENTO. Convertir ese fondo en una capa `<img>` sería un
     * cambio de maquetación, y esta unidad es sólo motion. Lo que sí se
     * desplaza es el carrusel, que es lo que da la profundidad contra ese
     * fondo fijo: es la misma lectura visual (contenido que flota sobre una
     * foto quieta) sin tocar el DOM.
     *
     * Por qué no hay CSS de estado inicial: `revealSection` se apoya en
     * `gsap.from()`, que lee el valor ACTUAL del elemento como destino del tween
     * en el momento de crearlo. Una regla de hoja de estilos que pre-ocultara
     * el elemento bajo el guard `[data-motion="ready"]` sería leída como ese
     * destino y el tween animaría `opacity: 0 → 0`, dejando el bloque invisible
     * para siempre. El estado inicial lo pone el tween, que es lo que mantiene
     * la decisión 3: sin JS, con movimiento reducido o si el helper no
     * inicializa, no se escribe ningún estilo inline y el contenido se ve tal
     * cual.
     */
    function setupComponente13Motion() {
        // Cada consulta se resuelve desde la raíz `.c13-section` de ESTE bloque.
        document.querySelectorAll('.c13-section').forEach((section) => {
            // Título. Si el editor eligió `h1` como etiqueta, NO se revela: un
            // h1 puede ser el elemento LCP y la decisión 4 exige que el texto
            // sobre el pliegue esté en el primer fotograma pintado.
            const title = section.querySelector('.c13-title');
            if (title && title.tagName !== 'H1') {
                revealSection(title, {
                    y: 28,
                    duration: 0.7,
                    ease: 'power3.out',
                });
            }

            const subtitle = section.querySelector('.c13-subtitle');
            if (subtitle) {
                revealSection(subtitle, {
                    y: 18,
                    duration: 0.6,
                    ease: 'power2.out',
                    delay: 0.08,
                });
            }

            // Texto descriptivo. Si el editor metió un enlace dentro del texto
            // enriquecido, el contenedor se deja intacto (S13: nunca se revela
            // como bloque un elemento que contiene un control enfocable).
            const text = section.querySelector('.c13-text');
            if (text && !text.querySelector('a')) {
                revealSection(text, {
                    y: 22,
                    duration: 0.7,
                    ease: 'power2.out',
                    delay: 0.16,
                });
            }

            // Burbujas ambiente: el bloque tiene imagen de fondo y recorta con
            // `overflow-hidden`, así que las burbujas quedan dentro. El helper
            // las crea con `pointer-events: none` y `aria-hidden`, no capturan
            // el clic y el contenido va en un contenedor con `z-10`, así que
            // quedan por detrás del texto.
            ambientBubbles(section, {
                count: 7,
                maxOnMobile: 4,
            });

            // El contenedor del carrusel (carrusel + controles) entra como una
            // sola pieza. La entrada es una ESCALA y no un `y` a propósito: el
            // carrusel es el que lleva el parallax (que escribe `yPercent`), y
            // así los dos movimientos usan canales distintos del mismo
            // transform de GSAP (`scale` de un lado, `yPercent` del otro) y no
            // se pisan. La escala no altera el ancho de maquetación, así que
            // Swiper sigue midiendo las diapositivas igual.
            const carousel = section.querySelector('.c13-carousel');
            if (carousel) {
                revealSection(carousel, {
                    y: 0,
                    scale: 0.95,
                    duration: 0.9,
                    ease: 'power3.out',
                });
            }

            // Parallax contra la imagen de fondo. El carrusel no contiene
            // ningún control enfocable (los videos van sin `controls`), así que
            // el helper lo acepta sin `allowInteractive`; y los botones de
            // navegación son HERMANOS del contenedor del carrusel, no
            // ancestros, así que ningún control enfocable queda bajo un
            // transform con scrub.
            const swiper = section.querySelector('.componente-13-swiper');
            if (swiper) {
                parallaxLayer(swiper, {
                    distance: 3,
                    trigger: section,
                });
            }

            // Deliberadamente NO hay `hoverDepth` en este bloque: la imagen de
            // cada diapositiva ocupa la tarjeta completa y tanto el carrusel
            // como la propia tarjeta recortan con `overflow-hidden`, así que
            // cualquier ascenso o escala de la tarjeta quedaría cortado. El
            // gesto de hover que el bloque ya tiene (el `group-hover:scale-105`
            // de la imagen) sí sobrevive, porque GSAP nunca toca la imagen.
        });
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que
    // ningún trigger puede registrarse antes de esta llamada.
    initMotion();
    setupComponente13Motion();

    // Decisión 7, reflejada desde el helper: en una navegación del lado del
    // cliente el helper desmonta sus triggers y vuelve a armar el motion, así
    // que los triggers tienen que registrarse otra vez. `Layout.astro` no
    // registra ningún ClientRouter hoy, así que esto nunca se dispara; existe
    // para que el bloque no se quede estático si algún día se activa el modo
    // SPA.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupComponente13Motion();
    });
</script>
