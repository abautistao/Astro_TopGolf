---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    variante?: "Preguntas Frecuentes" | "Restricciones";
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    color_fondo?: string;
    imagen_fondo?: any;
    acordeones?: any[];
}

const {
    variante = "Preguntas Frecuentes",
    titulo,
    htmlTag = "h2",
    color_fondo,
    imagen_fondo,
    acordeones = [],
} = Astro.props;

const TitleTag = htmlTag;

// Configuración visual según la variante elegida
const isFAQ = variante === "Preguntas Frecuentes";

const defaultBgColor = isFAQ ? "var(--surface-brand-primary)" : "var(--neutral-background-subtle)";
const finalBgColor = color_fondo || defaultBgColor;
const bgImageStyle = imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none";

// Estilos dinámicos para los ítems
const itemContainerClass = isFAQ 
    ? "border-b border-white py-4" 
    : "border-2 border-[var(--surface-brand-primary)] mb-2";

const headerClass = isFAQ 
    ? "w-full flex justify-start items-center gap-4 text-left cursor-pointer focus:outline-none" 
    : "w-full flex justify-between items-center bg-[var(--surface-brand-secondary)]/10 p-4 text-left cursor-pointer focus:outline-none";

const iconClass = isFAQ 
    ? "text-[var(--brand-interactive-base)] text-xl shrink-0 transition-transform duration-300" 
    : "text-[var(--surface-brand-primary)] text-xl shrink-0 transition-transform duration-300 order-last";

const titleTextClass = isFAQ 
    ? "text-white font-[family-name:var(--font-principal)] font-bold text-[18px] md:text-[20px]" 
    : "text-[var(--surface-brand-primary)] font-[family-name:var(--font-principal)] font-bold text-[18px] md:text-[20px]";

const bodyContainerClass = isFAQ 
    ? "overflow-hidden transition-all duration-300 max-h-0" 
    : "overflow-hidden transition-all duration-300 max-h-0 bg-[var(--surface-brand-primary)]";

const bodyContentClass = isFAQ 
    ? "pt-4 pb-2 text-white font-[family-name:var(--font-secundaria)] text-[16px] leading-relaxed [&>p]:mb-2 [&_strong]:font-bold [&_u]:underline [&_em]:italic" 
    : "p-4 text-white font-[family-name:var(--font-secundaria)] text-[16px] leading-relaxed [&>p]:mb-2 [&_strong]:font-bold [&_u]:underline [&_em]:italic [&_ul]:list-disc [&_ul]:pl-5 [&_li]:mb-1";

// Generar un ID único para este componente para aislar la interactividad
const componentId = `accordion-${Math.random().toString(36).substring(2, 9)}`;
---

<section 
    class="w-full py-16 md:py-24 relative overflow-hidden" 
    style={{
        backgroundColor: finalBgColor,
        backgroundImage: bgImageStyle,
        backgroundSize: "cover",
        backgroundPosition: "center",
    }}
>
    <div class={`container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 ${isFAQ ? 'max-w-4xl' : 'max-w-5xl'}`}>
        
        {/* Título Principal */}
        {titulo && (
            <div class="text-center mb-10 md:mb-16">
                <TitleTag class={`font-[family-name:var(--font-principal)] text-[24px] md:text-[40px] font-black uppercase ${isFAQ ? 'text-white' : 'text-[var(--surface-brand-primary)]'}`}>
                    {titulo}
                </TitleTag>
            </div>
        )}

        {/* Contenedor de Acordeones */}
        <div class="flex flex-col w-full" id={componentId}>
            {acordeones.map((item, index) => (
                <div class={`accordion-item ${itemContainerClass}`}>
                    <button class={`accordion-header ${headerClass}`} aria-expanded="false" aria-controls={`content-${componentId}-${index}`}>
                        {/* Icono izquierdo (o derecho en variante 2) */}
                        <div class={`accordion-icon ${iconClass}`}>
                            {item.icono ? (
                                <i class={item.icono}></i>
                            ) : (
                                <i class={`fa-solid ${isFAQ ? 'fa-circle-plus' : 'fa-plus'}`}></i>
                            )}
                        </div>
                        
                        {/* Título del Acordeón */}
                        <span class={`accordion-title ${titleTextClass} flex items-center gap-2`}>
                            {!isFAQ && item.icono && <i class={`${item.icono} text-xl shrink-0`}></i>} 
                            {item.titulo}
                        </span>
                    </button>
                    
                    {/* Contenido Desplegable */}
                    <div id={`content-${componentId}-${index}`} class={`accordion-body ${bodyContainerClass}`}>
                        <div 
                            class={`accordion-content-inner ${bodyContentClass}`}
                            set:html={stringifyRichText(item.contenido)}
                        />
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
function initAccordions() {
    const accordionHeaders = document.querySelectorAll('.accordion-header');

    // Abrir el primer acordeón por defecto
    if (accordionHeaders.length > 0) {
        const firstHeader = accordionHeaders[0];
        const firstItem = firstHeader.closest('.accordion-item');
        const firstBody = firstItem?.querySelector('.accordion-body');
        const firstIcon = firstItem?.querySelector('.accordion-icon');

        firstHeader.setAttribute('aria-expanded', 'true');
        if (firstBody) firstBody.style.maxHeight = firstBody.scrollHeight + 'px';
        if (firstIcon) {
            if (firstIcon.querySelector('.fa-circle-plus')) {
                firstIcon.innerHTML = firstIcon.innerHTML.replace('fa-circle-plus', 'fa-circle-minus');
            } else if (firstIcon.querySelector('.fa-plus')) {
                firstIcon.innerHTML = firstIcon.innerHTML.replace('fa-plus', 'fa-minus');
            }
            firstIcon.style.transform = 'rotate(180deg)';
        }
    }

    accordionHeaders.forEach(header => {
            // Remove previous event listeners to avoid duplicates if re-init occurs
            const newHeader = header.cloneNode(true);
            header.parentNode?.replaceChild(newHeader, header);
            
            newHeader.addEventListener('click', (e) => {
                const btn = e.currentTarget as HTMLElement;
                const item = btn.closest('.accordion-item');
                const body = item?.querySelector('.accordion-body') as HTMLElement;
                const icon = btn.querySelector('.accordion-icon') as HTMLElement;
                
                // Toggle state
                const isExpanded = btn.getAttribute('aria-expanded') === 'true';
                
                // Close all other accordions (Optional, adjust if you want multiple open)
                const allItems = btn.closest('.flex-col')?.querySelectorAll('.accordion-item');
                allItems?.forEach(otherItem => {
                    if (otherItem !== item) {
                        const otherBtn = otherItem.querySelector('.accordion-header');
                        const otherBody = otherItem.querySelector('.accordion-body') as HTMLElement;
                        const otherIcon = otherItem.querySelector('.accordion-icon') as HTMLElement;
                        
                        otherBtn?.setAttribute('aria-expanded', 'false');
                        if (otherBody) otherBody.style.maxHeight = '0px';
                        if (otherIcon) {
                            // Rotate back icon
                            if(otherIcon.querySelector('.fa-circle-minus')) {
                                otherIcon.innerHTML = otherIcon.innerHTML.replace('fa-circle-minus', 'fa-circle-plus');
                            } else if (otherIcon.querySelector('.fa-minus')) {
                                otherIcon.innerHTML = otherIcon.innerHTML.replace('fa-minus', 'fa-plus');
                            }
                            otherIcon.style.transform = 'rotate(0deg)';
                        }
                    }
                });

                // Open/Close current
                if (isExpanded) {
                    btn.setAttribute('aria-expanded', 'false');
                    if (body) body.style.maxHeight = '0px';
                    if (icon) {
                        if(icon.querySelector('.fa-circle-minus')) icon.innerHTML = icon.innerHTML.replace('fa-circle-minus', 'fa-circle-plus');
                        else if (icon.querySelector('.fa-minus')) icon.innerHTML = icon.innerHTML.replace('fa-minus', 'fa-plus');
                        icon.style.transform = 'rotate(0deg)';
                    }
                } else {
                    btn.setAttribute('aria-expanded', 'true');
                    if (body) body.style.maxHeight = body.scrollHeight + 'px';
                    if (icon) {
                        if(icon.querySelector('.fa-circle-plus')) icon.innerHTML = icon.innerHTML.replace('fa-circle-plus', 'fa-circle-minus');
                        else if (icon.querySelector('.fa-plus')) icon.innerHTML = icon.innerHTML.replace('fa-plus', 'fa-minus');
                        icon.style.transform = 'rotate(180deg)'; // Slight rotate for smooth transition
                    }
                }
            });
        });
    }

    // Initialize on DOM load and on Astro page changes
    document.addEventListener('DOMContentLoaded', initAccordions);
    // Para entornos con ViewTransitions (Astro SPA mode)
    document.addEventListener('astro:page-load', initAccordions);
</script>
