---
// Bloque de vinculación con la NEM para el tema Acuario (componente-35-acuario).
// Replica `landing-sealand/visitas-escolares/index.html:116-148` (#nem).
//
// La sección del origen es clara (`.section` a secas), con tarjetas de campo
// blancas y un módulo de fases en degradado azul marino. Ninguno de esos colores
// se copia: las tarjetas se derivan de las variables de superficie y el módulo de
// fases se construye con color-mix() sobre variables de tema.
//
// A diferencia de componente-34, NINGÚN repeatable de este bloque lleva media:
// `campos`, `fases`, `fases[].aprendizajes` y `fases[].productos` son sólo texto,
// y las dos descargas son campos planos top-level (los cubre `populate=*` de la
// consulta base). Por eso este bloque no necesita entrada en el deep-populate
// de strapi.js.
import { stringifyRichText, getStrapiUrl } from "../../lib/strapi.js";

export interface Props {
    eyebrow?: string;
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    campos?: any[];
    fases?: any[];
    descarga_vinculacion?: any;
    descarga_vinculacion_texto?: string;
    descarga_proyecto?: any;
    descarga_proyecto_texto?: string;
}

const {
    eyebrow,
    titulo,
    htmlTag = "h2",
    descripcion,
    campos = [],
    fases = [],
    descarga_vinculacion,
    descarga_vinculacion_texto,
    descarga_proyecto,
    descarga_proyecto_texto,
} = Astro.props;

const TitleTag = htmlTag as any;

// Prefijo para los ids de la lista de pestañas. Se deriva del título del bloque
// para que dos instancias de componente-35 en la misma página no compartan ids
// (los ids se necesitan para aria-controls / aria-labelledby).
const idBase = `c35-${(titulo || "nem").toString().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "nem"}`;

// Descargas: patrón de Component_20_Acuario.astro (media + <a download> nativo).
// Si el editor no subió el archivo, el botón no se renderiza en lugar de
// quedar como un ancla muerta.
const descargas = [
    { archivo: descarga_vinculacion, texto: descarga_vinculacion_texto },
    { archivo: descarga_proyecto, texto: descarga_proyecto_texto },
]
    .map((d) => ({ ...d, url: getStrapiUrl(d.archivo) }))
    .filter((d) => Boolean(d.url));

const listaCampos = campos.filter((c) => c?.numero || c?.titulo || c?.descripcion);
const listaFases = fases.filter((f) => f?.fase || f?.nivel || f?.titulo || f?.descripcion);

// Los repeatables de texto llegan como `any` desde Strapi; este helper los
// normaliza a arreglo y descarta los ítems sin texto, para que una fase con la
// lista vacía no deje un encabezado de sección sin contenido debajo.
const textos = (arr: any): any[] => (Array.isArray(arr) ? arr.filter((i: any) => i?.texto) : []);
---

<section class="c35-section w-full py-[68px] lg:py-[82px] xl:py-[104px]">
    <div class="container mx-auto px-4 md:px-6 max-w-7xl">
        {/* Encabezado de dos columnas, igual que .section-heading del origen. */}
        {(eyebrow || titulo || descripcion) && (
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.72fr] gap-[18px] lg:gap-[70px] items-end mb-[36px] lg:mb-[56px]">
                <div>
                    {eyebrow && (
                        <p class="font-[family-name:var(--font-secundaria)] text-[12px] font-bold uppercase tracking-[0.17em] text-[var(--accent-highlight-primary)] mb-4">
                            {eyebrow}
                        </p>
                    )}

                    {titulo && (
                        <TitleTag class="c35-title font-[family-name:var(--font-principal)] font-bold">
                            {titulo}
                        </TitleTag>
                    )}
                </div>

                {descripcion && (
                    <div
                        class="c35-muted font-[family-name:var(--font-secundaria)] font-normal text-[17px] mb-1 [&>p]:mb-0"
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>
        )}

        {/* Rejilla de campos de formación: 4 columnas, 2 en tablet, 1 en móvil. */}
        {listaCampos.length > 0 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-[26px]">
                {listaCampos.map((c) => (
                    <article class="c35-card p-7 rounded-[22px] min-h-[230px]">
                        {c.numero && (
                            <span class="c35-card-numero font-[family-name:var(--font-principal)] font-bold">{c.numero}</span>
                        )}

                        {c.titulo && (
                            <h3 class="c35-card-titulo font-[family-name:var(--font-principal)] font-bold text-[20px] mt-7 mb-3">
                                {c.titulo}
                            </h3>
                        )}

                        {c.descripcion && (
                            <p class="c35-muted font-[family-name:var(--font-secundaria)] text-[14px] leading-relaxed mb-0">{c.descripcion}</p>
                        )}
                    </article>
                ))}
            </div>
        )}

        {/* Módulo de fases y descargas. Alpine resuelve el estado `activa` con un
           índice; cada panel se renderiza en el servidor y sólo se muestra el
           activo. Se usa `x-data` en todo el archivo, sin scripts ad hoc,
           siguiendo el precedente de Component_17_Acuario.astro.

           Las descargas viven DENTRO del módulo, como en el origen
           (index.html:142-145): la segunda es un botón de sólo filete con texto
           claro y necesita el degradado oscuro para tener contraste. Si el
           editor no subió archivos, no se renderiza ningún botón. */}
        {(listaFases.length > 0 || descargas.length > 0) && (
            <div class="c35-module rounded-[24px] lg:rounded-[32px] p-[26px] lg:p-[42px]" x-data="{ activa: 0 }">
                {listaFases.length > 0 && (
                    <div class="c35-tabs flex flex-wrap gap-2 mb-[30px]" role="tablist" aria-label="Fases educativas">
                        {listaFases.map((f, i) => (
                            <button
                                type="button"
                                role="tab"
                                id={`${idBase}-tab-${i}`}
                                class="c35-tab rounded-full px-4 py-[10px] font-[family-name:var(--font-principal)] font-bold text-[16px] cursor-pointer transition-colors"
                                x-on:click={`activa = ${i}`}
                                x-bind:class={`activa === ${i} ? 'c35-tab-active' : ''`}
                                x-bind:aria-selected={`activa === ${i} ? 'true' : 'false'`}
                                aria-selected={i === 0 ? "true" : "false"}
                                aria-controls={`${idBase}-panel-${i}`}
                            >
                                {f.fase ? `Fase ${f.fase}` : `Fase ${i + 1}`}
                            </button>
                        ))}
                    </div>
                )}

                {listaFases.map((f, i) => {
                    const aprendizajes = textos(f.aprendizajes);
                    const productos = textos(f.productos);
                    return (
                        <div
                            id={`${idBase}-panel-${i}`}
                            class="c35-phase grid grid-cols-1 lg:grid-cols-[0.72fr_1.28fr] gap-[42px] min-h-[220px] py-6 pb-8 outline-none"
                            role="tabpanel"
                            aria-labelledby={`${idBase}-tab-${i}`}
                            tabindex="0"
                            aria-live="polite"
                            x-show={`activa === ${i}`}
                            x-cloak={i === 0 ? undefined : true}
                        >
                            <div>
                                {f.nivel && (
                                    <span class="c35-nivel font-[family-name:var(--font-principal)] text-[13px] font-bold uppercase tracking-[0.12em]">{f.nivel}</span>
                                )}

                                {f.titulo && (
                                    <h3 class="c35-phase-title font-[family-name:var(--font-principal)] font-bold text-[34px] my-[10px]">{f.titulo}</h3>
                                )}

                                {f.descripcion && (
                                    <p class="c35-phase-muted font-[family-name:var(--font-secundaria)] text-[16px] mb-0">{f.descripcion}</p>
                                )}
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-[26px]">
                                {aprendizajes.length > 0 && (
                                    <div class="c35-detail border-l pl-[22px]">
                                        <h4 class="c35-detail-titulo font-[family-name:var(--font-secundaria)] text-[14px] font-bold mb-[10px]">
                                            Aprendizajes y propósitos
                                        </h4>
                                        {/* Un solo aprendizaje se renderiza como
                                            párrafo (así lo hace el origen); con
                                            varios, lista con viñetas. */}
                                        {aprendizajes.length === 1 ? (
                                            <p class="c35-detail-texto font-[family-name:var(--font-secundaria)] text-[15px] mb-0">{aprendizajes[0].texto}</p>
                                        ) : (
                                            <ul class="c35-detail-texto list-disc pl-5 m-0">
                                                {aprendizajes.map((a) => (
                                                    <li class="my-[6px]">{a.texto}</li>
                                                ))}
                                            </ul>
                                        )}
                                    </div>
                                )}

                                {productos.length > 0 && (
                                    <div class="c35-detail border-l pl-[22px]">
                                        <h4 class="c35-detail-titulo font-[family-name:var(--font-secundaria)] text-[14px] font-bold mb-[10px]">
                                            Productos sugeridos
                                        </h4>
                                        {productos.length === 1 ? (
                                            <p class="c35-detail-texto font-[family-name:var(--font-secundaria)] text-[15px] mb-0">{productos[0].texto}</p>
                                        ) : (
                                            <ul class="c35-detail-texto list-disc pl-5 m-0">
                                                {productos.map((p) => (
                                                    <li class="my-[6px]">{p.texto}</li>
                                                ))}
                                            </ul>
                                        )}
                                    </div>
                                )}
                            </div>
                        </div>
                    );
                })}

                {descargas.length > 0 && (
                    <div class="c35-downloads flex flex-col sm:flex-row flex-wrap gap-3">
                        {descargas.map((d, i) => (
                            <a
                                href={d.url}
                                download={d.archivo?.name || undefined}
                                class="c35-download inline-flex justify-center items-center min-h-[52px] py-[13px] px-[22px] rounded-full border font-[family-name:var(--font-principal)] font-bold text-[14px] transition-transform hover:-translate-y-0.5"
                            >
                                {d.texto || `Descargar documento ${i + 1}`}
                            </a>
                        ))}
                    </div>
                )}
            </div>
        )}
    </div>
</section>

<style>
    /* La sección del origen es clara; --neutral-background-subtle es la variable
       del tema para fondos claros, así que la franja no depende de un blanco
       fijo. El texto principal cae a --surface-brand-primary implícitamente vía
       Layout.astro; el secundario se atenúa con color-mix(). */
    .c35-section {
        background-color: var(--neutral-background-subtle);
        color: var(--surface-brand-primary);
    }

    .c35-muted {
        color: color-mix(in srgb, var(--surface-brand-primary) 70%, transparent);
    }

    /* Escala no-role del origen: h2 es `clamp(34px, 4.2vw, 58px)` y en móvil
        baja a 36px. Se conserva el clamp; la familia sale de --font-principal. */
    .c35-title {
        font-size: clamp(34px, 4.2vw, 58px);
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    /* Tarjeta blanca con filete (--line en el origen): se sube hacia el blanco
       del tema mezclando texto invertido con el fondo claro de sección, y el
       borde es la marca de primario diluida. */
    .c35-card {
        background-color: color-mix(in srgb, var(--neutral-text-inverted) 70%, var(--neutral-background-subtle));
        border: 1px solid color-mix(in srgb, var(--surface-brand-primary) 12%, transparent);
    }

    .c35-card-numero {
        color: var(--accent-highlight-primary);
    }

    /* Degradado del módulo de fases (135deg de navy a navy-2 en el origen),
        reconstruido con las variables de superficie del tema. */
    .c35-module {
        background-image: linear-gradient(
            135deg,
            var(--surface-brand-primary),
            color-mix(in srgb, var(--surface-brand-secondary) 60%, var(--surface-brand-primary))
        );
        color: var(--neutral-text-inverted);
        box-shadow: 0 24px 70px color-mix(in srgb, var(--surface-brand-primary) 20%, transparent);
    }

    /* Pestaña en reposo: sólo filete translúcido. La activa invierte a fondo
        claro con texto de marca, igual que `.phase-tab.active` del origen. */
    .c35-tab {
        background-color: transparent;
        border: 1px solid color-mix(in srgb, var(--neutral-text-inverted) 20%, transparent);
        color: color-mix(in srgb, var(--neutral-text-inverted) 72%, transparent);
    }

    .c35-tab-active {
        background-color: var(--neutral-text-inverted);
        border-color: var(--neutral-text-inverted);
        color: var(--surface-brand-primary);
    }

    .c35-nivel {
        color: var(--accent-highlight-tertiary);
    }

    .c35-phase-muted {
        color: color-mix(in srgb, var(--neutral-text-inverted) 70%, transparent);
    }

    .c35-detail {
        border-left-color: color-mix(in srgb, var(--neutral-text-inverted) 18%, transparent);
    }

    .c35-detail-titulo {
        color: var(--accent-highlight-secondary);
    }

    .c35-detail-texto {
        color: color-mix(in srgb, var(--neutral-text-inverted) 80%, transparent);
    }

    /* Botones de descarga: la primera es sólida (`.button-light`) y la segunda
        sólo con filete (`.button-outline-light`). La differentiation viene de un
        modificador aplicado por nth-child, no de un color hardcodeado. */
    .c35-download {
        background-color: var(--neutral-text-inverted);
        border-color: var(--neutral-text-inverted);
        color: var(--surface-brand-primary);
    }

    .c35-downloads .c35-download:nth-child(n + 2) {
        background-color: transparent;
        border-color: color-mix(in srgb, var(--neutral-text-inverted) 42%, transparent);
        color: var(--neutral-text-inverted);
    }

    /* Sin Alpine los paneles arrancan visibles (no queremos un bloque vacío si
        el JS no carga); con Alpine, x-cloak los esconde hasta que la pestaña
        activa esté definida. El primer panel nunca lleva x-cloak. */
    [x-cloak] {
        display: none !important;
    }

    /* --- Motion layer (T4). Decision 3 + the Astro scoping trap. ---
       *
       * WHY `:global()`: Astro puts its scope attribute on every compound, so a
       * plain `[data-motion="ready"] .c35-download` compiles to
       * `[data-astro-cid-x][data-motion=ready] .c35-download[data-astro-cid-x]`
       * and demands that ONE element carry both attributes — but `data-motion`
       * is written on <html>, which never gets a cid. It compiles and never
       * matches. `:global()` leaves the guard unscoped while `.c35-download`
       * stays scoped to this component.
       *
       * WHAT this is for: the downloads carry Tailwind's `transition-transform`,
       * and a CSS transition applies to the inline `transform` GSAP writes on
       * every frame of the reveal just as readily as to the Tailwind one. The
       * browser then interpolates between GSAP's per-frame writes, so the whole
       * reveal eases ~150-200ms behind its own tween: the double-easing artifact
       * `Component_34` already identified and solved for `.c34-figure-img`.
       *
       * WHY this drops only `transform` from the list and does NOT repeat
       * `transition: none` the way `.c34-figure-img` does — because these
       * buttons have a Tailwind hover lift that `.c34-figure-img` does not
       * (there, the zoom is a GSAP tween and the stylesheet transition is dead
       * weight under motion). Verified against the installed Tailwind v4.2.1
       * compiler, which emits:
       *   .transition-transform { transition-property: transform, translate, scale, rotate; }
       *   .-translate-y-0.5       { --tw-translate-y: …; translate: var(--tw-translate-x) var(--tw-translate-y); }
       * Two facts follow. (1) The hover lift lives on the STANDALONE `translate`
       * property, not on `transform`, so it composes with GSAP's inline
       * transform instead of competing for it — the lift survives either way.
       * (2) `transition-property` lists `translate` too, so `transition: none`
       * would also delete the lift's easing and turn a 150ms hover into an
       * instant snap. Listing Tailwind's own set minus `transform` removes the
       * double-eased channel and leaves the hover exactly as it was, duration
       * and timing-function included, because this rule overrides one longhand
       * and inherits the rest of the shorthand from `.transition-transform`.
       *
       * WHY under the guard: with JS off, reduced motion on, or before the
       * helper initializes, `data-motion` is never written, no inline transform
       * exists to double-ease, and the buttons render and hover exactly as the
       * pre-motion build did. */
    :global([data-motion="ready"]) .c35-download {
        transition-property: translate, scale, rotate;
    }
</style>

<script>
    import { initMotion, revealSection, revealStagger } from "../../scripts/motion";

    /*
     * NEM block motion (T4) — decision 5 bites harder here than anywhere else on
     * the page: `.c35-module` contains the phase tablist, the panels Alpine
     * swaps and the two download buttons, so this block IS the interactive
     * zone. There is no `parallaxLayer` anywhere in this script, on purpose.
     * Every reveal below is a `gsap.from()` behind a `once: true` ScrollTrigger,
     * so the block is entered once and then left alone: no transform is ever
     * rewritten while the reader is pointing at a tab or clicking a download.
     *
     * WHY there is no hidden-state CSS for any of these elements:
     * `revealSection` / `revealStagger` are built on `gsap.from()`, which reads
     * the element's CURRENT value as the tween's END state when the tween is
     * created. A stylesheet rule that pre-hid an element under the readiness
     * guard would be read as the destination and the tween would animate
     * `opacity: 0 → 0`, stranding the block invisible forever. The hidden state
     * comes from the tween instead, which is also what keeps decision 3 honest:
     * no JS, no readiness attribute, no inline style, no hidden content.
     *
     * WHY the script adds no selector class and touches no markup: every anchor
     * it needs already carries a `c35-` prefix, and each query is resolved from
     * this block's own `.c35-section` root, so nothing here can reach a sibling
     * block on the same page (components 32-38 all render together).
     */
    function setupNemMotion() {
        document.querySelectorAll('.c35-section').forEach((section) => {
            // Heading group. `.c35-muted` is NOT a safe anchor on its own: the
            // field cards reuse it for their body copy, so the description is
            // only the heading's when it is not inside a card. The title's own
            // column is the fallback for the (rarer) block configured with no
            // description, and it needs one extra hop — the title sits inside
            // the left column of the two-column grid, so the grid is its
            // grandparent. Resolving this through `.c35-muted` alone would have
            // put a trigger on a card that the stagger below also animates.
            const headingDescription =
                Array.from(section.querySelectorAll('.c35-muted')).find((node) => !node.closest('.c35-card')) ?? null;
            const title = section.querySelector('.c35-title');
            const heading = headingDescription?.parentElement ?? title?.parentElement?.parentElement ?? null;

            // Eyebrow, title and paragraph settle as ONE group: they read as a
            // single sentence, so splitting them would fight the copy.
            if (heading) {
                revealSection(heading, {
                    y: 30,
                    duration: 0.75,
                    ease: 'power3.out',
                });
            }

            // Four training-field cards in a single row. Even per-item offset
            // (`staggerFrom` left at GSAP's 'start') so the sequence reads as a
            // deliberate left-to-right count rather than an arbitrary cascade.
            const firstCard = section.querySelector('.c35-card');
            const cardsRow = firstCard?.parentElement ?? null;

            if (cardsRow) {
                revealStagger(cardsRow, {
                    selector: '.c35-card',
                    stagger: 0.09,
                    y: 30,
                    duration: 0.7,
                    ease: 'power3.out',
                });
            }

            // WHY `.c35-module` is NOT revealed — this is the P1 repair, and the
            // absence is the point, not an oversight.
            //
            // `revealSection` / `revealStagger` build `gsap.from()` tweens, and
            // `gsap.from()` renders its START values immediately, so merely
            // REGISTERING a trigger on this container writes `opacity: 0` inline
            // at page load, before the reader has scrolled anywhere. That is safe
            // only for as long as the trigger is guaranteed to fire. If it never
            // does — an anchor jump that lands the panel below the `top 85%` start
            // line, an unexpected restored scroll position, a teardown that runs
            // between registration and the first scroll event — the `opacity: 0`
            // simply stays. And `.c35-module` is not display-only: it holds the
            // `role="tablist"` phase tabs, each one a focusable `<button>`, plus
            // the `x-show` panel. A stranded reveal there does not look like a
            // missed animation, it looks like invisible-but-still-focusable tab
            // controls sitting in the accessibility tree, which is a WCAG failure
            // rather than a taste call.
            //
            // WHY dropping it beats retargeting it: every element between the tab
            // strip and the section root is an ANCESTOR of the tab strip, so there
            // is no non-interactive wrapper inside `.c35-module` to hand the
            // reveal to, and moving it up to `.c35-section` would re-introduce the
            // same hazard one level higher. The block keeps its movement from the
            // two targets that are genuinely display-only — the heading group and
            // the `.c35-card` stagger — and the dark panel arrives with the
            // stylesheet, which is the same behaviour every no-JS and
            // reduced-motion reader already gets.
            //
            // This is the same discipline `Component_34` applied to its
            // `<video controls>` and `Component_37` to `.c37-panel`: leave
            // anything holding a focusable control exactly where the stylesheet
            // puts it.

            // The two downloads get their own, later beat, so they read as the
            // block's exit point rather than arriving with the frame. They sit on
            // `.c35-module`'s dark gradient, and the second one is an outline
            // button, so this is transform-only motion: nothing here changes the
            // background it is drawn on. The opacity ramp is also the shortest on
            // the page (0.45s, 0.07s apart) so the outline never sits long at low
            // opacity against the navy.
            //
            // Their own Tailwind hover lift survives GSAP owning `transform`,
            // because Tailwind v4's `-translate-y-*` sets the standalone
            // `translate` property, which composes with `transform` instead of
            // competing for it. (That is exactly the trap the component-34
            // stylesheet hover rule fell into by writing `transform` directly.)
            const firstDownload = section.querySelector('.c35-download');
            const downloadsRow = firstDownload?.parentElement ?? null;

            if (downloadsRow) {
                revealStagger(downloadsRow, {
                    selector: '.c35-download',
                    stagger: 0.07,
                    y: 14,
                    duration: 0.45,
                    ease: 'power2.out',
                });
            }
        });
    }

    // Call order is load-bearing: `motionDisabled()` gates on `initialized`, so
    // any trigger registered before this call would silently do nothing.
    initMotion();
    setupNemMotion();

    // Decision 7, mirrored from the helper: on a client-side navigation the
    // helper tears its triggers down and re-arms motion, so the triggers have to
    // be registered again. `Layout.astro` registers no ClientRouter today, so
    // this never fires — it exists so the block cannot silently go static if SPA
    // mode is ever enabled. The first-event guard mirrors the helper's own: Astro
    // also dispatches `astro:page-load` on the initial load, and re-registering
    // there would put a second ScrollTrigger on the same elements.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupNemMotion();
    });
</script>