---
// Franja de experiencia para el tema Acuario (componente-34-acuario).
// Replica `landing-sealand/visitas-escolares/index.html:85-114` (#experiencia).
//
// El origen es una `section-dark`: fondo degradado azul marino y texto claro.
// Ese degradado (#06172e → #0a2f57 → #0b4965) NO se copia. Aquí el fondo se
// construye mezclando variables semánticas con color-mix(), de modo que la
// franja hereda la identidad de Acuario Inbursa configurada en setup-site.
//
// La galería es un repeatable que lleva media anidada (`galeria[].imagen`), así
// que este bloque sí necesita entrada en el deep-populate de strapi.js: sin el
// populate + merge, las figuras salen sin imagen.
import { stringifyRichText, getStrapiUrl } from "../../lib/strapi.js";

export interface Props {
    color_fondo?: string;
    eyebrow?: string;
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    video?: any;
    poster_video?: any;
    chips?: any[];
    galeria?: any[];
    color_eyebrow_override?: string;
    color_titulo_override?: string;
    color_texto_override?: string;
}

const {
    color_fondo,
    eyebrow,
    titulo,
    htmlTag = "h2",
    descripcion,
    video,
    poster_video,
    chips = [],
    galeria = [],
    color_eyebrow_override,
    color_titulo_override,
    color_texto_override,
} = Astro.props;

const TitleTag = htmlTag as any;

// Cascada: el override del editor (hex del color picker) gana; si no hay, la
// variable de tema definida en setup-site. Esta sección es oscura, así que el
// texto por defecto es --neutral-text-inverted.
const sectionBg = color_fondo || "var(--surface-brand-primary)";
const eyebrowColor = color_eyebrow_override || "var(--accent-highlight-tertiary)";
const titleColor = color_titulo_override || "var(--neutral-text-inverted)";
const textColor = color_texto_override || "var(--neutral-text-inverted)";

// Media plano (campos top-level): getStrapiUrl devuelve null si el editor no
// subió archivo, y en ese caso el slot se omite en lugar de dejar un <video>
// roto o un póster vacío.
const videoUrl = getStrapiUrl(video);
const posterUrl = getStrapiUrl(poster_video);

// Sólo pintamos chips y figuras que tienen algo real; un repeatable vacío en
// Strapi llega como `[]` y no debe dejar una caja de cristal huérfana.
const listaChips = chips.filter((c) => c?.texto);
const figuras = galeria.filter((f) => f?.imagen || f?.pie_de_imagen);
---

<section class="c34-section relative w-full overflow-hidden py-[68px] lg:py-[82px] xl:py-[104px]" style={`--bg-base: ${sectionBg}; color: ${textColor};`}>
    <div class="container relative mx-auto px-4 md:px-6 max-w-7xl">
        {/* Encabezado de dos columnas (1fr .72fr) alineadas al borde inferior,
            igual que .section-heading del origen. */}
        {(eyebrow || titulo || descripcion) && (
            <div class="c34-heading grid grid-cols-1 lg:grid-cols-[1fr_0.72fr] gap-[18px] lg:gap-[70px] items-end mb-[36px] lg:mb-[56px]">
                <div>
                    {eyebrow && (
                        <p class="font-[family-name:var(--font-secundaria)] text-[12px] font-bold uppercase tracking-[0.17em] mb-4" style={`color: ${eyebrowColor};`}>
                            {eyebrow}
                        </p>
                    )}

                    {titulo && (
                        <TitleTag class="c34-title font-[family-name:var(--font-principal)] font-bold" style={`color: ${titleColor};`}>
                            {titulo}
                        </TitleTag>
                    )}
                </div>

                {descripcion && (
                    <div
                        class="font-[family-name:var(--font-secundaria)] font-normal text-[17px] mb-1 [&>p]:mb-0"
                        style={`color: color-mix(in srgb, ${textColor} 72%, transparent);`}
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>
        )}

        {/* Rejilla 1.4fr .6fr: el video domina y la lista de zonas temáticos va
            en una columna estrecha, tal cual .video-grid. */}
        {(videoUrl || listaChips.length > 0) && (
            <div class="c34-media grid grid-cols-1 lg:grid-cols-[1.4fr_0.6fr] gap-6 items-stretch">
                {videoUrl && (
                    <div class="c34-video-shell rounded-[28px] overflow-hidden p-[10px]">
                        <video
                            controls
                            preload="metadata"
                            poster={posterUrl || undefined}
                            class="c34-video w-full aspect-[16/9] object-cover rounded-[20px] block"
                        >
                            Tu navegador no puede reproducir este video.
                        </video>
                    </div>
                )}

                {listaChips.length > 0 && (
                    <div class="c34-chips flex flex-wrap content-start gap-[10px] rounded-[28px] p-[30px]">
                        {listaChips.map((c) => (
                            <span class="c34-chip rounded-full px-[13px] py-[10px] font-[family-name:var(--font-secundaria)] text-[13px] font-bold">
                                {c.texto}
                            </span>
                        ))}
                    </div>
                )}
            </div>
        )}

        {/* Galería: 3 columnas con la primera figura ocupando las dos filas. El
            reparto .gallery-large / :nth-child(4) lo replican las clases
            c34-figure-lg y c34-figure-wide del <style> de abajo. */}
        {figuras.length > 0 && (
            <div class="c34-gallery mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_0.7fr_0.7fr] gap-[18px]">
                {figuras.map((f, i) => {
                    const imgUrl = getStrapiUrl(f.imagen);
                    return (
                        <figure class={`c34-figure relative m-0 overflow-hidden rounded-[24px] ${i === 0 ? "c34-figure-lg" : ""} ${i === 3 ? "c34-figure-wide" : ""}`}>
                            {imgUrl && (
                                <img src={imgUrl} alt={f.texto_alt_imagen || ""} loading="lazy" class="c34-figure-img w-full h-full object-cover" />
                            )}

                            {f.pie_de_imagen && (
                                <figcaption class="c34-caption absolute left-[18px] bottom-4 rounded-full px-3 py-2 font-[family-name:var(--font-secundaria)] text-[12px] font-bold backdrop-blur-[8px]">
                                    {f.pie_de_imagen}
                                </figcaption>
                            )}
                        </figure>
                    );
                })}
            </div>
        )}
    </div>
</section>

<style>
    /* Equivale al `linear-gradient(150deg, #06172e, #0a2f57 60%, #0b4965)` del
       origen. El color base lo inyecta el override del editor (--bg-base) y los
       dos paradas siguientes se derivan de variables de tema mezcladas entre sí:
       hacia --surface-brand-secondary en el centro y hacia un acento para el
       extremo, que es donde el origen se vuelve más azulado. */
    .c34-section {
        background-image: linear-gradient(
            150deg,
            var(--bg-base, var(--surface-brand-primary)) 0%,
            color-mix(in srgb, var(--surface-brand-secondary) 62%, var(--bg-base, var(--surface-brand-primary))) 60%,
            color-mix(in srgb, var(--accent-highlight-primary) 24%, var(--bg-base, var(--surface-brand-primary))) 100%
        );
    }

    /* Escala no-role del origen: h2 es `clamp(34px, 4.2vw, 58px)`, deliberadamente
       por encima de los 32px del role scale. Se conserva el clamp; la familia
       siempre viene de --font-principal. */
    .c34-title {
        font-size: clamp(34px, 4.2vw, 58px);
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    /* Pozo más oscuro que el fondo para el video (#021225 en el origen):
       --neutral-background-strong es la zona de alto contraste, así que al
       mezclarla con la base baja el tono sin introducir un color nuevo. */
    .c34-video-shell {
        background-color: color-mix(in srgb, var(--neutral-background-strong) 55%, var(--bg-base, var(--surface-brand-primary)));
        box-shadow: 0 28px 70px color-mix(in srgb, var(--neutral-background-strong) 28%, transparent);
    }

    /* Cristal de la lista de chips: relleno y borde translúcidos derivados del
       color de texto, igual que los rgba(255,255,255,…) del origen. */
    .c34-chips {
        background-color: color-mix(in srgb, var(--neutral-text-inverted) 8%, transparent);
        border: 1px solid color-mix(in srgb, var(--neutral-text-inverted) 15%, transparent);
    }

    .c34-chip {
        background-color: color-mix(in srgb, var(--neutral-text-inverted) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--neutral-text-inverted) 12%, transparent);
        color: var(--neutral-text-inverted);
    }

    /* Fondo de reserva mientras carga la foto (#0b2746 en el origen), para que
       la figura no se vea como un hueco si el editor aún no sube la imagen. */
    .c34-figure {
        background-color: color-mix(in srgb, var(--surface-brand-secondary) 45%, var(--bg-base, var(--surface-brand-primary)));
    }

    .c34-figure-img {
        transition: transform 0.5s ease;
    }

    /* THE HOVER ZOOM, but only on the paths where the script does not run. This
       rule is the no-JS and reduced-motion fallback and nothing else.

       WHY it stays after the script took the zoom over: `initMotion()` returns
       before writing `data-motion="ready"` when the reader asked for reduced
       motion, and with JS off the module never loads at all. On both paths the
       script writes no inline transform, this rule is the only thing zooming the
       photo, and the 0.5s ease above is what eases it, so the affordance the
       block had before the motion layer survives intact.

       WHY it cannot be the hover zoom under motion: GSAP's inline `transform` is
       the same property and outranks it. That is the regression this rule used to
       suffer from: the scrubbed parallax wrote `transform` and silently killed the
       zoom. The script now hands this exact zoom to a GSAP tween writing the
       `scale` channel, which composes with the parallax's `yPercent` in one
       matrix, so the two no longer compete for `transform`. This rule is never in
       effect while that tween exists. */
    .c34-figure:hover .c34-figure-img {
        transform: scale(1.04);
    }

    .c34-caption {
        background-color: color-mix(in srgb, var(--bg-base, var(--surface-brand-primary)) 68%, transparent);
        color: var(--neutral-text-inverted);
    }

    /* Filas de 260px y primera figura a dos alturas, tal cual el grid del origen. */
    @media (min-width: 1024px) {
        .c34-gallery {
            grid-template-rows: 260px 260px;
        }

        .c34-figure-lg {
            grid-row: 1 / 3;
        }

        .c34-figure-wide {
            grid-column: 2 / 4;
        }
    }

    /* Hasta 1020px el origen pasa a 2 columnas y la figura grande toma el ancho
        completo; bajo 680px todo se apila en una columna. */
    @media (max-width: 1023px) {
        .c34-gallery {
            grid-template-rows: 300px 240px 240px;
        }

        .c34-figure-lg {
            grid-row: auto;
            grid-column: 1 / 3;
        }

        .c34-figure-wide {
            grid-column: 1 / 3;
        }
    }

    @media (max-width: 680px) {
        .c34-gallery {
            grid-template-rows: 280px 230px 230px 230px;
        }

        .c34-figure-lg,
        .c34-figure-wide {
            grid-column: auto;
        }
    }

    /* --- Motion layer (T3). Decision 3 + the Astro scoping trap. ---
       *
       * WHY `:global()`: Astro puts its scope attribute on every compound, so a
       * plain `[data-motion="ready"] .c34-figure-img` compiles to
       * `[data-astro-cid-x][data-motion=ready] .c34-figure-img[data-astro-cid-x]`
       * and demands that ONE element carry both attributes — but `data-motion`
       * is written on <html>, which never gets a cid. It compiles and never
       * matches. `:global()` leaves the guard unscoped while `.c34-figure-img`
       * stays scoped to this component.
       *
       * WHAT is left here, and why the headroom scale moved into the script: the
       * `scale: 1.16` headroom used to live in this rule so it would survive the
       * helper's `clearProps: 'all'` teardown. It no longer needs to. Making GSAP
       * the single owner of this element's transform means the headroom is a
       * `scale` value inside the very matrix GSAP already writes, and the teardown
       * already covers it, because `.c34-figure-img` is one of the helper's own
       * tracked targets: `killOwnedTriggers()` clears exactly the elements the
       * parallax registered, so the scale drops back to 1 together with the
       * parallax, and `setupExperienceMotion()` puts it back on re-init.
       *
       * WHY 1.16 with `distance: 6` (unchanged, now set from the script):
       * `.c34-figure-img` is `w-full h-full object-cover` inside an
       * `overflow-hidden` figure, so it fills its box exactly and any vertical
       * travel would uncover the top or bottom edge. A 1.16 scale about the centre
       * leaves (1.16 - 1) / 2 = 8% of headroom per side, and `distance: 6` is 6%
       * of the image height, so headroom survives at either end of the scrub
       * (worst case 6 * 1.16 = 6.96%).
       *
       * WHY `transition: none` and why it is still a stylesheet rule:
       * `.c34-figure-img` carries `transition: transform 0.5s ease` for the no-JS
       * hover zoom above, and a CSS transition applies to the inline transform
       * GSAP writes on every scrub frame as well, which would smear the parallax
       * half a second behind the scroll position and double-ease the hover tween.
       * A stylesheet declaration is the only place this can live: `clearProps:
       * 'all'` empties `style.cssText`, so an inline `style.transition` would not
       * survive the teardown.
       *
       * WHY under the guard: with JS off, reduced motion on, or before the
       * helper initializes, `data-motion` is never written, no inline transform
       * exists to transition, and the gallery renders and behaves exactly as the
       * pre-motion build: original transition, original hover zoom, no scale. */
    :global([data-motion="ready"]) .c34-figure-img {
        transition: none;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { initMotion, parallaxLayer, prefersReducedMotion, revealSection, revealStagger, splitReveal } from "../../scripts/motion";

    /*
     * The headroom the parallax needs to avoid uncovering the edge of its
     * `overflow-hidden` figure, and the zoom the pre-motion stylesheet applied on
     * hover. Both are ratios against the image's own box, so multiplying them is
     * exactly "4% bigger than it was" — the same visual result the CSS
     * `transform: scale(1.04)` gave before, without a second owner of `transform`.
     */
    const HEADROOM_SCALE = 1.16;
    const HOVER_ZOOM = 1.04;
    const HOVER_DURATION = 0.5;

    /*
     * Experience band motion (T3) — decision 5: fire-once reveals everywhere,
     * `scrub` only on the decorative gallery images.
     *
     * WHY this is the one component that imports GSAP directly: `motion.ts` owns
     * scroll-trigger lifecycle, but it cannot own an affordance the reader starts
     * with the pointer. The hover zoom is not a scroll animation and must keep
     * working under reduced motion (it is direct manipulation the user initiated,
     * not autonomous movement), so it cannot be one of the helper's reveal
     * triggers either. Everything scroll-driven still goes through the helper.
     *
     * WHY there is no hidden-state CSS for the reveals: `revealSection` /
     * `revealStagger` are built on `gsap.from()`, which reads the element's
     * CURRENT value as the tween's END state when the tween is created. A
     * stylesheet rule that pre-hid an element under `[data-motion="ready"]`
     * would be read as the destination and the tween would animate
     * `opacity: 0 → 0`, stranding the block invisible forever. The hidden state
     * comes from the tween instead, which is also what makes decision 3 hold:
     * no JS, no readiness attribute, no inline style, no hidden content.
     *
     * WHY `.c34-video-shell` and `.c34-video` are deliberately NOT animated: a
     * reveal writes `opacity: 0` inline the moment the script runs, and the
     * `<video controls>` is the one element in this block whose loss the reader
     * cannot recover from by scrolling on. Leaving it out is what guarantees
     * that a JS failure, reduced motion, or a trigger that never fires still
     * leaves the video visible and playable. The band gets its movement from
     * the chips, the gallery and the parallax instead.
     */
    function setupExperienceMotion() {
        // The helper's own switch is `prefersReducedMotion() || !initialized`, and
        // `initMotion()` (called first, on every path) only sets `initialized`
        // when reduced motion is off — so the negation of the same check is
        // exactly when the helper's triggers are live. The direct GSAP calls
        // below ride the same switch instead of inventing a second one.
        const reduced = prefersReducedMotion();

        // Every query resolves from this block's own `.c34-section` root and is
        // scoped by the `c34-` prefix, so nothing here can reach a sibling block
        // on the same page (components 32-38 all render together).
        document.querySelectorAll('.c34-section').forEach((section) => {
            // The heading settles in three beats: the eyebrow rises, the title
            // assembles word by word and the description rises after it.
            //
            // WHY the heading CONTAINER is not revealed as a block: the title
            // lives inside it and `splitReveal` already leaves the parts at
            // `opacity: 0` when it is registered, so a fade on the parent
            // would mask the words that are still assembling.
            const heading = section.querySelector('.c34-heading');
            if (heading) {
                // The title sits in the FIRST column of the two-column heading
                // grid; the description, when the editor filled it, is the
                // second one.
                const titleColumn = heading.querySelector(':scope > div');
                const title = titleColumn?.querySelector('.c34-title') ?? null;

                if (title && title.tagName !== 'H1') {
                    splitReveal(title, {
                        type: 'words',
                        y: 26,
                        duration: 0.75,
                        stagger: 0.045,
                        // Sin máscara: el interlineado del título es 1.08 y una
                        // caja de recorte de SplitText cortaría las
                        // ascendentes y las descendentes.
                        mask: false,
                    });
                }

                const eyebrow = titleColumn?.querySelector(':scope > p') ?? null;
                if (eyebrow) {
                    revealSection(eyebrow, {
                        y: 18,
                        duration: 0.65,
                        ease: 'power2.out',
                    });
                }

                const description = heading.children.length > 1 ? heading.children[1] : null;
                if (description) {
                    revealSection(description, {
                        y: 22,
                        duration: 0.7,
                        ease: 'power2.out',
                        delay: 0.08,
                    });
                }
            }

            // ...then the chips cascade down the narrow column. `selector` picks
            // the chips out of their own container so the stagger sequences the
            // chips, not the glass panel behind them.
            const chips = section.querySelector('.c34-chips');
            if (chips) {
                revealStagger(chips, {
                    selector: '.c34-chip',
                    stagger: 0.07,
                    y: 16,
                    duration: 0.55,
                });
            }

            const gallery = section.querySelector('.c34-gallery');
            if (!gallery) {
                return;
            }

            // The gallery is the clearest stagger on the page: each figure rises
            // into its clipped box, so nothing that overflows is ever visible
            // mid-flight.
            revealStagger(gallery, {
                selector: '.c34-figure',
                stagger: 0.1,
                y: 34,
                duration: 0.7,
                ease: 'power3.out',
            });

            // Continuous drift behind the reveal. `distance: 6` is 6% of each
            // image's own height, and the headroom scale below is what keeps that
            // travel from uncovering the top or bottom edge of its
            // `overflow-hidden` figure. `trigger: gallery` overrides the helper's
            // default (the layer's own parent, a 260px row) so the whole set of
            // figures shares one long scrub range instead of six jittery short
            // ones.
            section.querySelectorAll<HTMLElement>('.c34-figure').forEach((figure) => {
                const layer = figure.querySelector<HTMLElement>('.c34-figure-img');
                if (!layer) {
                    return;
                }

                if (reduced) {
                    // Reduced motion: no parallax, so no headroom is needed, and
                    // no inline transform exists — which leaves the stylesheet's
                    // `:hover` zoom and its 0.5s transition as the whole
                    // affordance, exactly as before the motion layer.
                    return;
                }

                // ONE owner for the whole transform, written as two channels of
                // the same matrix: GSAP holds `scale` (the headroom, and the
                // hover zoom) and `yPercent` (the parallax). The headroom used to
                // be a stylesheet `scale` property, which was a second owner and
                // is now inside this transform where the `clearProps: 'all'`
                // teardown already reaches it.
                gsap.set(layer, { scale: HEADROOM_SCALE });

                parallaxLayer(layer, {
                    distance: 6,
                    trigger: gallery,
                });

                // Decision 7: this function runs again on a client-side
                // navigation, and the re-run must not stack a second pair of
                // listeners on the same figure. The flag lives on the element and
                // is untouched by `clearProps`, which only empties `style`.
                if (figure.dataset.c34HoverBound === 'true') {
                    return;
                }

                figure.dataset.c34HoverBound = 'true';

                let zoomTween: ReturnType<typeof gsap.to> | null = null;

                // WHY these two handlers re-read `prefersReducedMotion()` at event
                // time instead of reusing the `reduced` value captured above: the
                // helper watches `(prefers-reduced-motion: reduce)` and, when the
                // reader flips it mid-session, kills every trigger it owns and runs
                // `clearProps: 'all'` on the parallax targets — which strips the
                // inline `transform` these handlers write AND removes
                // `data-motion`, handing the zoom back to the stylesheet's `:hover`
                // rule and its 0.5s transition. These listeners survive that
                // teardown, because they are plain `addEventListener` calls and not
                // helper-owned triggers. Without the live check, the very next hover
                // would put `scale(1.2064)` back inline and re-violate the
                // preference the reader just asked for, and `mouseleave` would then
                // leave the image parked at the 1.16 headroom. Reading the query per
                // event makes the handlers self-cancelling the instant the
                // preference takes effect, with no second watcher that would have to
                // be torn down in step with the helper's. A zoom already in flight
                // when the switch flips runs out its `HOVER_DURATION` and is killed
                // on the next pointer event; after that nothing writes.
                figure.addEventListener('mouseenter', () => {
                    if (prefersReducedMotion()) {
                        // Reduced motion is on: the stylesheet's own `:hover` zoom
                        // is the whole affordance now, and it is the only thing
                        // allowed to touch `transform` on this element.
                        zoomTween?.kill();
                        return;
                    }

                    // Killing the previous tween instead of passing `overwrite`:
                    // an overwrite on this target would also reach the parallax,
                    // which is a different property but the same element, and the
                    // zoom is not allowed to be able to kill the drift.
                    zoomTween?.kill();
                    zoomTween = gsap.to(layer, {
                        scale: HEADROOM_SCALE * HOVER_ZOOM,
                        duration: HOVER_DURATION,
                        ease: 'power2.out',
                    });
                });

                figure.addEventListener('mouseleave', () => {
                    // Same live check. Under reduced motion GSAP must not ease
                    // `scale` back down either: the teardown just handed this
                    // element back to the stylesheet's `:hover` rule, and a tween
                    // writing the same property would fight it.
                    if (prefersReducedMotion()) {
                        zoomTween?.kill();
                        return;
                    }

                    zoomTween?.kill();
                    zoomTween = gsap.to(layer, {
                        scale: HEADROOM_SCALE,
                        duration: HOVER_DURATION,
                        ease: 'power2.out',
                    });
                });
            });
        });
    }

    // Call order is load-bearing: `motionDisabled()` gates on `initialized`, so
    // any trigger registered before this call would silently do nothing.
    initMotion();
    setupExperienceMotion();

    // Decision 7, mirrored from the helper: on a client-side navigation the
    // helper tears its triggers down and re-arms motion, so the triggers have to
    // be registered again. `Layout.astro` registers no ClientRouter today, so
    // this never fires — it exists so the block cannot silently go static if SPA
    // mode is ever enabled. The first-event guard mirrors the helper's own: Astro
    // also dispatches `astro:page-load` on the initial load, and re-registering
    // there would put a second ScrollTrigger on the same elements.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupExperienceMotion();
    });
</script>