---
// src/components/acuario/Component_23_Acuario.astro
import { stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    color_fondo_seccion?: string;
    color_fondo_banner?: string;
    color_titulo_override?: string;
    color_texto_override?: string;
}

const {
    titulo,
    htmlTag = "h3",
    descripcion,
    color_fondo_seccion,
    color_fondo_banner,
    color_titulo_override,
    color_texto_override,
} = Astro.props;

const TitleTag = htmlTag;

// Defaults via setup-site CSS variables (regla del AGENTS.md: nunca hardcodear hex en class)
const finalSectionBg = color_fondo_seccion || "var(--surface-brand-primary)";
const finalBannerBg = color_fondo_banner || "var(--brand-interactive-base)";
const finalTitleColor = color_titulo_override || "var(--surface-brand-primary)";
const finalTextColor = color_texto_override || "var(--surface-brand-primary)";

const tituloStyle = color_titulo_override ? `color: ${color_titulo_override}` : undefined;
const descripcionStyle = color_texto_override ? `color: ${color_texto_override}` : undefined;
---

<section
    class="w-full py-10 md:py-14 relative overflow-hidden"
    style={`background-color: ${finalSectionBg};`}
>
    <div class="w-full max-w-[1280px] mx-auto px-4 md:px-6">
        <div
            class="w-full py-6 md:py-8 px-6 md:px-10"
            style={`background-color: ${finalBannerBg};`}
        >
            {titulo && (
                <TitleTag
                    class="font-[family-name:var(--font-principal)] text-[18px] md:text-[20px] font-black uppercase leading-tight mb-3"
                    style={`${tituloStyle ? tituloStyle + "; " : ""}color: ${finalTitleColor};`}
                >
                    {titulo}
                </TitleTag>
            )}

            {descripcion && (
                <div
                    class="font-[family-name:var(--font-secundaria)] text-[16px] md:text-[18px] font-normal leading-snug [&>p]:mb-2 last:[&>p]:mb-0 [&_strong]:font-bold [&_u]:underline [&_em]:italic"
                    style={`${descripcionStyle ? descripcionStyle + "; " : ""}color: ${finalTextColor};`}
                    set:html={stringifyRichText(descripcion)}
                />
            )}
        </div>
    </div>
</section>