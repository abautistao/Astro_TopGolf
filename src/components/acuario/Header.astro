---
import {
    getHeaderData,
    getStrapiUrl,
    getLocalizedUrl,
} from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "../dolphinaris/elements/Button.astro";
import type { Boton } from "../dolphinaris/elements/Button.astro";

interface Props {
    data?: any;
    locale?: string;
    alternateLinks?: Record<string, string>;
}

const { data, locale = "es", alternateLinks = {} } = Astro.props;
const headerData = data || (await getHeaderData());

const logoUrl = getStrapiUrl(headerData?.logo);
const logoMobileUrl = getStrapiUrl(headerData?.logo_mobile) || logoUrl;

const links = headerData?.links || [];
const social = headerData?.social || [];
const textoHorario = headerData?.texto_horario || "";

const ctaButtonRaw = headerData?.Boton;
let buttons: Boton[] = [];

if (ctaButtonRaw) {
    const ctaButtonLocalized = {
        ...ctaButtonRaw,
        url: getLocalizedUrl(ctaButtonRaw.url, locale)
    };
    buttons = [ctaButtonLocalized];
}

// Active menu detection (current page highlight)
const currentPath = (Astro.url.pathname || "/").replace(/\/$/, "") || "/";
const normalizeUrl = (u: string) => (u || "").replace(/\/$/, "") || "/";
const isLinkActive = (url?: string) => {
    if (!url) return false;
    return normalizeUrl(getLocalizedUrl(url, locale)) === currentPath;
};
const isLinkActiveOrChild = (link: any) => {
    if (isLinkActive(link.url)) return true;
    if (Array.isArray(link.sublinks) && link.sublinks.length > 0) {
        return link.sublinks.some((sub: any) => isLinkActive(sub.url));
    }
    return false;
};
---

<header class="acuario-header w-full relative z-50">
    <!-- Desktop Top Bar -->
    <div class="hidden md:flex w-full min-h-[60px] font-bold">
        <!-- Social Icons -->
            <div class="acuario-header-block bg-(--custom-color-01)! flex! items-center! justify-start! px-8! min-w-[420px]">
            <div class="flex items-center gap-5 text-white!">
                {social.map((item: any) => (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="text-white! hover:opacity-80! transition-opacity">
                            <i class={`${item.icono_clase} text-[17px]`}></i>
                    </a>
                ))}
            </div>
        </div>
        <!-- Horario / Text -->
        <div class="acuario-header-block flex-grow bg-[var(--surface-brand-secondary)] flex items-center justify-center">
            <div class="text-white text-xs md:text-[14px] font-[family-name:var(--font-principal)] font-bold tracking-wide uppercase">
                {textoHorario}
            </div>
        </div>
        <!-- Right Yellow Button Section -->
        {buttons.length > 0 && (
            <div class="acuario-header-block acuario-header-cta-block bg-(--brand-interactive-base)! flex! items-center! justify-center! px-12! self-stretch! cursor-pointer! hover:brightness-110! transition-all min-w-[250px]">
                <a href={buttons[0].url} class="acuario-header-cta cta-bounce inline-block text-(--surface-brand-primary)! font-[family-name:var(--font-principal)] font-extrabold! text-[20px]! tracking-wide uppercase hover:no-underline!">
                    {buttons[0].texto}
                </a>
            </div>
        )}
    </div>

    <!-- Main Navigation Bar -->
    <div class="bg-(--neutral-background-strong)! border-b-4! md:border-b-0! border-(--brand-interactive-base)!">
        <div class="max-w-[1440px] mx-auto! px-6! md:px-12! h-24! md:h-[100px]! flex! items-center! justify-between!">
            <!-- Logo -->
            <a href="/" class=" py-2!">
                <!-- Desktop Logo -->
                {logoUrl && (
                    <Image
                        src={logoUrl}
                        alt="Acuario"
                        inferSize={true}
                        class="acuario-header-block hidden! md:block! h-15! object-contain"
                    />
                )}
                <!-- Mobile Logo -->
                {logoMobileUrl && (
                    <Image
                        src={logoMobileUrl}
                        alt="Acuario Mobile"
                        inferSize={true}
                        class="acuario-header-block block! md:hidden! h-20 object-contain py-1"
                    />
                )}
            </a>

            <!-- Desktop Links -->
            <nav class="acuario-header-block hidden! md:flex! items-center! justify-end! gap-6! h-full! grow!">
                {links.map((link: any) => (
                    <div class="relative group h-full flex items-center">
                        <a
                            href={link.url ? getLocalizedUrl(link.url, locale) : '#'}
                            class={`flex! items-center! gap-1.5! font-[family-name:var(--font-principal)] text-[15px]! font-medium! tracking-wide! uppercase! transition-colors! hover:no-underline!  ${
                                isLinkActiveOrChild(link)
                                    ? "text-(--brand-interactive-base)!"
                                    : "text-white! hover:text-(--accent-highlight-primary)!"
                            }`}
                            aria-current={isLinkActive(link.url) ? "page" : undefined}
                        >
                            {link.texto}
                            {link.sublinks && link.sublinks.length > 0 && (
                                <i class={`fa-solid fa-chevron-down text-[10px] transition-transform duration-300 group-hover:rotate-180 mt-0.5 ${isLinkActiveOrChild(link) ? "text-[var(--brand-interactive-base)]" : ""}`}></i>
                            )}
                        </a>
                        
                        <!-- Dropdown -->
                        {link.sublinks && link.sublinks.length > 0 && (
                            <div class="absolute! top-full! left-0! opacity-0! invisible! group-hover:opacity-100! group-hover:visible! transition-all duration-300 w-max min-w-[240px] bg-white! border-t-4! border-(--brand-interactive-base) shadow-2xl z-50!">
                                <ul class="flex! flex-col!">
                                    {link.sublinks.map((sublink: any) => (
                                        <li>
                                            <a
                                                href={getLocalizedUrl(sublink.url, locale)}
                                                class={`block! px-8! py-4! font-[family-name:var(--font-principal)]! font-bold! text-[15px]! transition-colors hover:no-underline! ${
                                                    isLinkActive(sublink.url)
                                                        ? "bg-(--neutral-background-strong)! text-(--brand-interactive-base)!"
                                                        : "text-(--surface-brand-primary)! hover:bg-(--neutral-background-strong)! hover:text-(--brand-interactive-base)!"
                                                }`}
                                                aria-current={isLinkActive(sublink.url) ? "page" : undefined}
                                            >
                                                {sublink.texto}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                ))}
            </nav>

            <!-- Mobile Info & Hamburger -->
            <div class="acuario-header-block flex! md:hidden! items-center! gap-15!">
                <span class="text-white! text-[10px]! sm:text-xs! font-[family-name:var(--font-principal)] font-bold! tracking-wide uppercase! text-right! max-w-[150px]! leading-tight">
                    {textoHorario.split('/')[1]?.trim() || textoHorario} <!-- Shorten for mobile if contains / -->
                </span>
                <button id="mobile-menu-toggle" class="text-white! text-3xl! focus:outline-none ml-1! w-8! h-8! flex! items-center! justify-center!">
                    <span id="menu-icon"><i class="fa-solid fa-bars"></i></span>
                    <span id="close-icon" class="hidden!"><i class="fa-solid fa-xmark"></i></span>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Overlay Menu -->
<div id="mobile-menu" class="hidden! md:hidden! fixed! inset-0! top-[100px]! bg-white! z-40! overflow-y-auto! flex-col! pb-20! border-t-4! border-[var(--brand-interactive-base)]!">
    <nav class="flex flex-col">
        {links.map((link: any, index: number) => (
            <div class="mobile-menu-group border-b! border-gray-200!">
                <div class="mobile-menu-header flex! items-center! justify-between! px-6! py-4! bg-white! text-(--surface-brand-primary) transition-colors duration-300">
                    <a href={link.url ? getLocalizedUrl(link.url, locale) : '#'} class={`font-[family-name:var(--font-principal)] text-[15px]! uppercase! font-bold! grow! text-inherit! ${isLinkActiveOrChild(link) ? "text-[var(--brand-interactive-base)]" : ""}`} aria-current={isLinkActive(link.url) ? "page" : undefined}>
                        {link.texto}
                    </a>
                    {link.sublinks && link.sublinks.length > 0 && (
                        <button class="p-2! mobile-submenu-toggle focus:outline-none! text-inherit!" data-target={`submenu-${index}`}>
                            <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
                        </button>
                    )}
                </div>
                {link.sublinks && link.sublinks.length > 0 && (
                    <div id={`submenu-${index}`} class="hidden! flex-col! bg-white!">
                        {link.sublinks.map((sublink: any) => (
                            <a href={getLocalizedUrl(sublink.url, locale)} class={`block! px-8! py-3.5! font-[family-name:var(--font-principal)]! font-bold! text-[15px]! transition-colors border-t! border-gray-100! ${isLinkActive(sublink.url) ? "bg-[var(--neutral-background-strong)] text-[var(--brand-interactive-base)]" : "text-[var(--surface-brand-primary)] hover:bg-[var(--neutral-background-strong)] hover:text-[var(--brand-interactive-base)]"}`} aria-current={isLinkActive(sublink.url) ? "page" : undefined}>
                                {sublink.texto}
                            </a>
                        ))}
                    </div>
                )}
            </div>
        ))}
        {buttons.length > 0 && (
            <div class="p-6! mt-4!">
                <a href={buttons[0].url} class="block! w-full! text-center! bg-(--brand-interactive-base) text-(--surface-brand-primary) font-[family-name:var(--font-principal)]! font-bold! text-lg! py-4! rounded-md! uppercase! shadow-sm">
                    {buttons[0].texto}
                </a>
            </div>
        )}
    </nav>
</div>

<script>
    import { initMotion, revealStagger, hoverDepth } from "../../scripts/motion";

    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    toggle?.addEventListener("click", () => {
        const isHidden = menu?.classList.contains("hidden!");
        if (isHidden) {
            menu?.classList.remove("hidden!");
            menu?.classList.add("flex!");
            menuIcon?.classList.add("hidden!");
            closeIcon?.classList.remove("hidden!");
            document.body.style.overflow = "hidden!";
        } else {
            menu?.classList.add("hidden!");
            menu?.classList.remove("flex!");
            menuIcon?.classList.remove("hidden!");
            closeIcon?.classList.add("hidden!");
            document.body.style.overflow = "";
        }
    });

    // Mobile submenu toggles
    const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    submenuToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const targetId = btn.getAttribute('data-target');
            if (targetId) {
                const submenu = document.getElementById(targetId);
                const icon = btn.querySelector('i');
                const header = btn.closest('.mobile-menu-header');
                
                if (submenu?.classList.contains('hidden!')) {
                    submenu.classList.remove('hidden!');
                    submenu.classList.add('flex!');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                    
                    // Apply expanded styles to header wrapper
                    header?.classList.remove('bg-white!', 'text-[var(--surface-brand-primary)]!');
                    header?.classList.add('bg-[var(--surface-brand-primary)]!', 'text-[var(--brand-interactive-base)]!');
                } else {
                    submenu?.classList.add('hidden!');
                    submenu?.classList.remove('flex!');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                    
                    // Revert styles on header wrapper
                    header?.classList.add('bg-white!', 'text-[var(--surface-brand-primary)]!');
                    header?.classList.remove('bg-[var(--surface-brand-primary)]!', 'text-[var(--brand-interactive-base)]!');
                }
            }
        });
    });

    /* ================================================================
     * Capa de movimiento del header (T2).
     *
     * El header está por encima del pliegue: su entrada es una única
     * animación de carga, NO un reveal por scroll. `revealStagger` monta un
     * ScrollTrigger con `once: true` cuyo `start` por defecto (`top 85%`)
     * ya está cumplido con el header en el tope de la página, así que el
     * estagger se dispara en el primer frame y nunca vuelve a escribir.
     *
     * QUÉ se anima: los bloques internos del header (barra superior con
     * social/horario/CTA, los dos logos, la navegación de escritorio y el
     * bloque de información móvil). Todos son contenedores o imágenes: los
     * enlaces NUNCA son objetivo de un `gsap.from()` porque son focusables y
     * un reveal que no dispara los deja invisibles pero tabulables (S13). Por
     * eso la navegación se revela como contenedor, no enlace por enlace.
     *
     * LO QUE NO SE TOCA: el menú móvil (overlay + hamburguesa) queda fuera
     * del `<header>` en el DOM y su estado de apertura/cierre sigue siendo
     * responsabilidad del JS de vanilla que ya existía arriba.
     * ================================================================ */
    function setupAcuarioHeaderMotion() {
        document.querySelectorAll('.acuario-header').forEach((header) => {
            revealStagger(header, {
                selector: '.acuario-header-block',
                stagger: 0.07,
                y: 14,
                duration: 0.55,
                ease: 'power2.out',
            });

            /* CTA principal: acento de profundidad en escritorio.
             *
             * El `lift` lo pone GSAP y no Tailwind a propósito. Cuando GSAP
             * toma posesión de un transform escribe inline `translate: none;
             * rotate: none; scale: none; transform: …`, y una declaración
             * inline gana a cualquier regla de clase: un `hover:-translate-y-*`
             * de Tailwind sobre ese MISMO elemento deja de funcionar (medido
             * en Chromium con el build real de Tailwind v4). El proyecto es
             * un dueño por elemento: aquí el dueño es GSAP, así que la
             * elevación la hace `hoverDepth`.
             *
             * `maxTilt: 0` a propósito: el CTA además tiene su rebote
             * (`cta-bounce`), y sumar una inclinación 3D sobre un texto que
             * ya escala en bucle se lee como un glitch, no como profundidad.
             */
            const cta = header.querySelector('.acuario-header-cta');
            if (cta) {
                hoverDepth(cta, {
                    maxTilt: 0,
                    lift: -4,
                    scale: 1,
                    duration: 0.35,
                    ease: 'power2.out',
                });
            }
        });
    }

    // `initMotion()` va primero: `motionDisabled()` depende de él.
    initMotion();
    setupAcuarioHeaderMotion();

    // Decision 7 del helper: en una navegación del cliente los triggers se
    // desmontan y se vuelven a armar, así que hay que registrarlos de nuevo.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupAcuarioHeaderMotion();
    });
</script>

<style>
    /* --- Capa de movimiento (T2) ---------------------------------------
     *
     * El bloque amarillo del CTA lleva `transition-all` de Tailwind, que
     * incluye el canal `transform`. GSAP escribe el transform en cada frame
     * de la entrada, y si CSS también lo transiciona el reveal se interpola
     * dos veces (el doble easing que ya golpeó a otros bloques del tema).
     * Se dejan fuera `transform` y `opacity` de la lista y se conserva
     * `filter`, que es lo único que el hover de `brightness-110` anima.
     *
     * `:global()` es obligatorio: dentro de un `<style>` con scope de Astro
     * la forma desnuda compila a `[data-astro-cid-x][data-motion="ready"]
     * .acuario-header-cta-block[data-astro-cid-x]`, que exige que UN mismo
     * elemento tenga los dos atributos — pero `data-motion` vive en `<html>`,
     * que nunca lleva cid. Compila, y nunca hace match. */
    :global([data-motion="ready"]) .acuario-header-cta-block {
        transition-property: filter, translate, scale, rotate;
    }

    /* El rebote del CTA anima la propiedad `scale` (canal independiente) y
     * no `transform`.
     *
     * POR QUÉ: el mismo elemento sería dueño de su transform por dos vías si
     * `cta-bounce` siguiera animando `transform` — la animación CSS y el
     * `hoverDepth` de GSAP. Las declaraciones de animación ganan a las inline
     * de GSAP, así que el `lift` de GSAP quedaría muerto y ambos pelearían
     * por el mismo canal. Moviendo el rebote a `scale`, la composición es
     * `translate → rotate → scale → transform`: el rebote escala y el lift de
     * GSAP se mueve, sin que ninguna de las dos capas toque el canal de la
     * otra. El resultado visual del rebote es idéntico. */
    @keyframes cta-bounce-grow {
        0%,
        100% {
            scale: 1;
        }
        50% {
            scale: 1.08;
        }
    }
    .cta-bounce {
        animation: cta-bounce-grow 1.2s ease-in-out infinite;
        transform-origin: center;
    }
    @media (prefers-reduced-motion: reduce) {
        .cta-bounce {
            animation: none;
        }
    }
</style>
