---
// Proceso de reservación para el tema Acuario (componente-38-acuario).
// Replica `landing-sealand/visitas-escolares/index.html:243-256` (.process-section).
//
// La sección del origen invierte el tratamiento de la anterior: fondo blanco y
// tarjetas en el tono ice. Ninguno de esos colores se copia; se mapean a las
// dos superficies claras del tema (--neutral-text-inverted y
// --neutral-background-subtle) para conservar ese contraste.
//
// A diferencia de componente-34 y componente-36, NINGÚN repeatable de este
// bloque lleva media: `pasos` es un repeatable de texto puro y todos los campos
// de primer nivel son escalares o blocks, que el `populate=*` de la consulta
// base ya entrega. Por eso este bloque no necesita entrada en el
// deep-populate de strapi.js — es el mismo caso que componente-35.
import { stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    color_fondo?: string;
    eyebrow?: string;
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    pasos?: any[];
    color_eyebrow_override?: string;
    color_titulo_override?: string;
    color_texto_override?: string;
}

const {
    color_fondo,
    eyebrow,
    titulo,
    htmlTag = "h2",
    descripcion,
    pasos = [],
    color_eyebrow_override,
    color_titulo_override,
    color_texto_override,
} = Astro.props;

const TitleTag = htmlTag as any;

// Cascada: el override del editor (hex del color picker) gana; si no hay, la
// variable de tema definida en setup-site. Sección clara: el texto se tiñe con
// --surface-brand-primary, nunca con --neutral-text-inverted.
const sectionBg = color_fondo || "var(--neutral-text-inverted)";
const eyebrowColor = color_eyebrow_override || "var(--accent-highlight-primary)";
const titleColor = color_titulo_override || "var(--surface-brand-primary)";
const textColor = color_texto_override || "var(--surface-brand-primary)";

// Los pasos comparten el sub-componente de campo de formación (numero + titulo +
// descripcion). Se descartan los ítems vacíos para que un repeatable en blanco
// no deje una rejilla de cajas huérfanas.
const listaPasos = pasos.filter((p) => p?.numero || p?.titulo || p?.descripcion);
---

<section class="w-full py-[68px] lg:py-[82px] xl:py-[104px]" style={`background-color: ${sectionBg};`}>
    <div class="container mx-auto px-4 md:px-6 max-w-7xl">
        {/* Encabezado de dos columnas alineadas al borde inferior, igual que
            .section-heading del origen. */}
        {(eyebrow || titulo || descripcion) && (
            <div class="grid grid-cols-1 lg:grid-cols-[1fr_0.72fr] gap-[18px] lg:gap-[70px] items-end mb-[36px] lg:mb-[56px]">
                <div>
                    {eyebrow && (
                        <p class="font-[family-name:var(--font-secundaria)] text-[12px] font-bold uppercase tracking-[0.17em] mb-4" style={`color: ${eyebrowColor};`}>
                            {eyebrow}
                        </p>
                    )}

                    {titulo && (
                        <TitleTag class="c38-title font-[family-name:var(--font-principal)] font-bold" style={`color: ${titleColor};`}>
                            {titulo}
                        </TitleTag>
                    )}
                </div>

                {descripcion && (
                    <div
                        class="c38-muted font-[family-name:var(--font-secundaria)] font-normal text-[17px] mb-1 [&>p]:mb-0"
                        style={`color: color-mix(in srgb, ${textColor} 78%, transparent);`}
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>
        )}

        {/* Rejilla de pasos: 4 columnas en escritorio, 2 en tablet, 1 en móvil. */}
        {listaPasos.length > 0 && (
            <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 list-none p-0 m-0">
                {listaPasos.map((p, i) => (
                    <li class="c38-step p-[26px] rounded-[22px]">
                        {(p.numero || i + 1) && (
                            <span class="c38-step-numero grid place-items-center w-[38px] h-[38px] rounded-full font-[family-name:var(--font-principal)] font-bold">
                                {p.numero || i + 1}
                            </span>
                        )}

                        {p.titulo && (
                            <h3 class="c38-step-titulo font-[family-name:var(--font-principal)] font-bold text-[19px] mt-[22px] mb-[10px]">
                                {p.titulo}
                            </h3>
                        )}

                        {p.descripcion && (
                            <p class="c38-step-muted font-[family-name:var(--font-secundaria)] font-normal text-[14px] leading-relaxed mb-0">
                                {p.descripcion}
                            </p>
                        )}
                    </li>
                ))}
            </ol>
        )}
    </div>
</section>

<style>
    /* Escala no-role del origen: h2 es `clamp(34px, 4.2vw, 58px)` y en móvil
       baja a 36px. Se conserva el clamp; la familia sale de --font-principal. */
    .c38-title {
        font-size: clamp(34px, 4.2vw, 58px);
        line-height: 1.08;
        letter-spacing: -0.045em;
    }

    .c38-muted,
    .c38-step-muted {
        color: color-mix(in srgb, var(--surface-brand-primary) 70%, transparent);
    }

    /* Tarjeta en tono ice sobre fondo blanco: el filete del origen (#e0edf2) se
       expresa como marca de primario diluida. */
    .c38-step {
        background-color: var(--neutral-background-subtle);
        border: 1px solid color-mix(in srgb, var(--surface-brand-primary) 10%, transparent);
    }

    .c38-step-titulo {
        color: var(--surface-brand-primary);
    }

    /* Disco numerado: navy del origen con texto invertido. */
    .c38-step-numero {
        background-color: var(--surface-brand-primary);
        color: var(--neutral-text-inverted);
    }
</style>