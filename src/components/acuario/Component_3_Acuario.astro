---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
    ext?: string;
}

export interface Props {
    subtitulo?: string;
    titulo?: string;
    etiqueta_titulo?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span";
    imagen_decorativa?: StrapiMedia;
    descripcion?: string;
    boton?: any;
    slides?: any[];
    color_fondo?: string;
    youtube_url?: string;
}

const {
    subtitulo,
    titulo,
    etiqueta_titulo = "h2",
    imagen_decorativa,
    descripcion,
    boton,
    slides = [],
    color_fondo,
    youtube_url
} = Astro.props;

// Use the project's utility to render rich text
const renderHtml = (content: string) => {
    if (!content) return "";
    return stringifyRichText(content);
};

const isVideo = (url: string) => {
    return url?.match(/\.(mp4|webm|ogg)$/i);
};

const getYoutubeId = (url: string) => {
    if (!url) return null;
    const patterns = [
        /youtube\.com\/watch\?v=([a-zA-Z0-9_-]+)/,
        /youtu\.be\/([a-zA-Z0-9_-]+)/,
        /youtube\.com\/embed\/([a-zA-Z0-9_-]+)/,
        /youtube\.com\/shorts\/([a-zA-Z0-9_-]+)/,
    ];
    for (const p of patterns) {
        const m = url.match(p);
        if (m) return m[1];
    }
    return null;
};
const youtubeId = youtube_url ? getYoutubeId(youtube_url) : null;
// Normalize button
const btn = Array.isArray(boton) ? boton[0] : boton;

// Determine heading tag
const HeadingTag = etiqueta_titulo;

---

<section 
    class="w-full bg-[var(--surface-brand-primary)] py-12 md:py-20 overflow-hidden c3-section"
    style={color_fondo ? `background-color: ${color_fondo}` : ""}
>
    <div class="w-full max-w-[1440px] mx-auto px-6 md:px-12 flex flex-col md:flex-row gap-10 md:gap-16 items-center">
        
        <!-- Left Column: Content -->
        <div class="w-full md:w-1/2 flex flex-col items-center md:items-start text-center md:text-left z-10">
            
            {subtitulo && (
                <span class="c3-eyebrow w-full text-center font-[family-name:var(--font-secundaria)] text-[var(--accent-highlight-primary)] text-[16px] md:text-[24px] font-medium md:font-bold tracking-[0.05em] uppercase md:leading-[25px] mb-1">
                    {subtitulo}
                </span>
            )}

            {titulo && (
                <HeadingTag class="c3-title w-full text-center font-[family-name:var(--font-principal)] text-[var(--neutral-text-inverted)] text-[32px] md:text-[54px] font-bold md:font-black uppercase leading-tight md:leading-[1.2] mb-4">
                    {titulo}
                </HeadingTag>
            )}

            {imagen_decorativa && (
                <div class="c3-figure w-full mb-6 flex justify-center">
                    <img 
                        src={getStrapiUrl(imagen_decorativa)} 
                        alt={imagen_decorativa.alternativeText || "Decoración Acuario"} 
                        class="w-full max-w-[500px] h-auto object-contain"
                    />
                </div>
            )}

            {descripcion && (
                <div
                    class="c3-text w-full text-center md:text-justify font-[family-name:var(--font-secundaria)] text-[var(--neutral-text-inverted)] text-[16px] font-normal leading-[1.4] mb-8 [&>p>strong]:font-bold [&>p>strong]:text-[var(--neutral-text-inverted)] [&>p]:mb-4 last:[&>p]:mb-0"
                    set:html={renderHtml(descripcion)}
                />
            )}

            {btn && btn.texto && btn.url && (
                <div class="flex w-full justify-center mt-2">
                    <a 
                        href={btn.url} 
                        style="width: fit-content; max-width: max-content; display: inline-flex;"
                        class="items-center justify-center border-2 border-[var(--neutral-text-inverted)] text-[var(--neutral-text-inverted)] bg-[var(--surface-brand-primary)] md:bg-transparent font-[family-name:var(--font-principal)] font-bold text-[16px] py-3 px-10 rounded-[30px] uppercase hover:bg-[var(--neutral-text-inverted)] hover:text-[var(--surface-brand-primary)] transition-all text-center whitespace-nowrap"
                    >
                        {btn.texto}
                    </a>
                </div>
            )}
            
        </div>
        {youtubeId && (
            <div class="w-full md:w-1/2 relative">
                <div class="aspect-video w-full">
                    <iframe
                        src={`https://www.youtube.com/embed/${youtubeId}`}
                        title={titulo || "YouTube video"}
                        class="block! w-full! h-full! border-0"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen
                    />
                </div>
            </div>
        )}

        <!-- Right Column: Carousel -->
        {slides && slides.length > 0 && (
            <div class="c3-carousel w-full md:w-1/2 relative rounded-lg md:rounded-xl overflow-hidden shadow-2xl aspect-[4/3] md:aspect-video z-10">
                {slides && slides.length > 0 ? (
                    <div class="swiper acuario-componente-3-swiper w-full h-full absolute inset-0">
                        <div class="swiper-wrapper h-full">
                            {slides.map((slide) => {
                                const youtubeId = slide.youtube_url ? getYoutubeId(slide.youtube_url) : null;
                                const bgUrl = getStrapiUrl(slide.fondo);
                                const bgMobileUrl = slide.fondo_mobile ? getStrapiUrl(slide.fondo_mobile) : bgUrl;
                                const altText = slide.fondo?.alternativeText || "Acuario Media";
                                const isBgVideo = !youtubeId && isVideo(bgUrl);

                                return (
                                    <div class="swiper-slide w-full h-full relative bg-black">
                                        {youtubeId ? (
                                            <iframe
                                                src={`https://www.youtube.com/embed/${youtubeId}`}
                                                title={slide.texto_principal || "YouTube video"}
                                                class="absolute inset-0 w-full h-full"
                                                frameborder="0"
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                                allowfullscreen
                                            />
                                        ) : isBgVideo ? (
                                            <video
                                                src={bgUrl}
                                                autoplay
                                                loop
                                                muted
                                                playsinline
                                                class="absolute inset-0 w-full h-full object-cover"
                                            />
                                        ) : (
                                            <>
                                                <img
                                                    src={bgMobileUrl}
                                                    alt={altText}
                                                    class="md:hidden absolute inset-0 w-full h-full object-cover"
                                                />
                                                <img
                                                    src={bgUrl}
                                                    alt={altText}
                                                    class="hidden md:block absolute inset-0 w-full h-full object-cover"
                                                />
                                            </>
                                        )}
                                    </div>
                                );
                            })}
                        </div>
                        {slides.length > 1 && (
                            <div class="swiper-pagination"></div>
                        )}
                    </div>
                ) : (
                    <div class="w-full h-full flex items-center justify-center bg-black/20">
                        <p class="text-white/50 font-[family-name:var(--font-secundaria)]">No media found</p>
                    </div>
                )}
            </div>
        )}
    </div>
</section>

<style>
    /* Pagination styles for swiper to match the theme */
    :global(.acuario-componente-3-swiper .swiper-pagination-bullet) {
        background-color: var(--neutral-text-inverted);
        opacity: 0.6;
        width: 10px;
        height: 10px;
    }
    :global(.acuario-componente-3-swiper .swiper-pagination-bullet-active) {
        background-color: var(--brand-interactive-base);
        opacity: 1;
        width: 12px;
        height: 12px;
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Autoplay, Pagination, EffectFade } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';
    import 'swiper/css/effect-fade';
    import { initMotion, revealSection, floatLoop } from "../../scripts/motion";

    document.addEventListener('DOMContentLoaded', () => {
        const swiperElements = document.querySelectorAll('.acuario-componente-3-swiper');
        
        swiperElements.forEach((el) => {
            new Swiper(el as HTMLElement, {
                modules: [Autoplay, Pagination, EffectFade],
                effect: 'fade',
                fadeEffect: {
                    crossFade: true
                },
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
                loop: true,
            });
        });
    });

    /*
     * Motion del bloque (T5) — el bloque tiene DOS regiones independientes (la
     * columna de texto a la izquierda y el carrusel a la derecha) y cada una
     * recibe su propio trigger: una entrada en la columna no puede ocultar el
     * carrusel, ni al revés.
     *
     * Por qué NO se revela ninguna diapositiva: Swiper es dueño del transform de
     * sus diapositivas (efecto `fade` incluido), y una diapositiva en opacidad 0
     * se quedaría invisible hasta que el usuario la alcanzara con el dedo, sin
     * que el ScrollTrigger volviera a evaluarla (la posición de un trigger no
     * sigue el transform interno de Swiper). El carrusel entra como una sola
     * pieza: se revela su marco y las diapositivas aparecen con él.
     *
     * Por qué no hay CSS de estado inicial: `revealSection` y `floatLoop` se
     * apoyan en `gsap.from()`, que lee el valor ACTUAL del elemento como destino
     * del tween en el momento de crearlo. Una regla de hoja de estilos que
     * pre-ocultara el elemento bajo el guard `[data-motion="ready"]` sería leída
     * como ese destino y el tween animaría `opacity: 0 → 0`, dejando el bloque
     * invisible para siempre. El estado inicial lo pone el tween, que es lo que
     * mantiene la decisión 3: sin JS, con movimiento reducido o si el helper no
     * inicializa, no se escribe ningún estilo inline y el contenido se ve tal
     * cual.
     */
    function setupComponente3Motion() {
        // Cada consulta se resuelve desde la raíz `.c3-section` de ESTE bloque,
        // así que nada puede alcanzar a un componente-3 hermano en la misma
        // página.
        document.querySelectorAll('.c3-section').forEach((section) => {
            // Antetítulo: entra solo, es la primera señal de que el bloque
            // está por aparecer.
            const eyebrow = section.querySelector('.c3-eyebrow');
            if (eyebrow) {
                revealSection(eyebrow, {
                    y: 18,
                    duration: 0.55,
                    ease: 'power2.out',
                });
            }

            // Título. Si el editor eligió `h1` como etiqueta, NO se revela: un
            // h1 puede ser el elemento LCP y la decisión 4 exige que el texto
            // sobre el pliegue esté en el primer fotograma pintado. El h1 se
            // queda exactamente donde la hoja de estilos lo pone.
            const title = section.querySelector('.c3-title');
            if (title && title.tagName !== 'H1') {
                revealSection(title, {
                    y: 30,
                    duration: 0.75,
                    ease: 'power3.out',
                    delay: 0.08,
                });
            }

            // Texto descriptivo: entra después del título. Si el editor metió un
            // enlace dentro del texto enriquecido, el contenedor se deja
            // intacto (S13: nunca se revela como bloque un elemento que
            // contiene un control enfocable).
            const text = section.querySelector('.c3-text');
            if (text && !text.querySelector('a')) {
                revealSection(text, {
                    y: 24,
                    duration: 0.7,
                    ease: 'power3.out',
                    delay: 0.16,
                });
            }

            // La imagen decorativa es un ornamento, no una foto de contenido:
            // flota en bucle continuo en lugar de revelarse. El reveal se
            // aplica al ENVOLTORIO (`.c3-figure`) y el flotado a la imagen que
            // va dentro: son dos elementos distintos, así que no hay dos dueños
            // del mismo transform.
            const figure = section.querySelector('.c3-figure');
            const figureImage = figure ? figure.querySelector('img') : null;
            if (figure) {
                revealSection(figure, {
                    y: 18,
                    duration: 0.7,
                    ease: 'power3.out',
                    delay: 0.14,
                });
            }
            if (figureImage) {
                floatLoop(figureImage, {
                    distance: 8,
                    duration: 5.5,
                });
            }

            // El marco del carrusel: una sola entrada para todo el carrusel.
            // El marco (y no el `.swiper`) es el que se revela, porque el
            // `.swiper` raíz es `absolute inset-0` dentro de un marco que
            // recorta: un `y` sobre él abriría una franja vacía en el borde.
            const carousel = section.querySelector('.c3-carousel');
            if (carousel) {
                revealSection(carousel, {
                    y: 34,
                    duration: 0.85,
                    ease: 'power3.out',
                    delay: 0.1,
                });
            }

            // Deliberadamente NO hay `hoverDepth` en este bloque: dentro de la
            // diapositiva no hay una "tarjeta" sino la imagen o el video a
            // sangre dentro de un marco con `overflow-hidden`; inclinar eso
            // dejaría ver el fondo del slide en los bordes.
        });
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que
    // ningún trigger puede registrarse antes de esta llamada.
    initMotion();
    setupComponente3Motion();

    // Decisión 7, reflejada desde el helper: en una navegación del lado del
    // cliente el helper desmonta sus triggers y vuelve a armar el motion, así
    // que los triggers tienen que registrarse otra vez. `Layout.astro` no
    // registra ningún ClientRouter hoy, así que esto nunca se dispara; existe
    // para que el bloque no se quede estático si algún día se activa el modo
    // SPA. La guarda del primer evento replica la del propio helper: Astro
    // también dispara `astro:page-load` en la carga inicial, y volver a
    // registrar ahí pondría un segundo ScrollTrigger sobre los mismos
    // elementos.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupComponente3Motion();
    });
</script>
