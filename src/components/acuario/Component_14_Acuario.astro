---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    disposicion?: "texto_izquierda" | "texto_derecha" | "solo_texto_centrado" | "solo_texto";
    titulo?: string;
    subtitulo?: string;
    posicion_subtitulo?: "arriba" | "debajo";
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    media?: any;
    galeria?: { data: any[] } | any[];
    color_fondo?: string;
    color_texto?: string;
    color_titulo?: string;
    color_subtitulo?: string;
    imagen_fondo?: any;
}

const {
    disposicion = "texto_izquierda",
    titulo,
    subtitulo,
    posicion_subtitulo = "debajo",
    htmlTag = "h2",
    descripcion,
    media,
    galeria,
    color_fondo,
    color_texto,
    color_titulo,
    color_subtitulo,
    imagen_fondo,
} = Astro.props;

const TitleTag = htmlTag;
const finalBgColor = color_fondo || "var(--neutral-background-subtle)";
const finalTextColor = color_texto || "var(--surface-brand-primary)";
const finalTitleColor = color_titulo || finalTextColor;
const finalSubtitleColor = color_subtitulo || finalTextColor;
const bgImageStyle = imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none";

const hasMedia = media?.data || media;
const mediaUrl = hasMedia ? getStrapiUrl(media) : null;
const isVideo = hasMedia && (media?.data?.attributes?.mime?.startsWith('video/') || media?.mime?.startsWith('video/'));

const galleryFiles = (galeria?.data || galeria || []).filter(Boolean);
const hasGallery = galleryFiles.length > 0;
const mediaMode: "single" | "gallery" | "none" = hasGallery ? "gallery" : (hasMedia ? "single" : "none");

// Determinar las clases de flexbox basado en la disposición
let containerClasses = "flex flex-col items-center ";
let textContainerClasses = "w-full ";
let mediaContainerClasses = "w-full lg:w-1/2 relative ";

if (disposicion === "texto_izquierda") {
    containerClasses += "lg:flex-row lg:gap-10";
    textContainerClasses += "lg:w-1/2 lg:pr-8";
} else if (disposicion === "texto_derecha") {
    containerClasses += "lg:flex-row-reverse lg:gap-10";
    textContainerClasses += "lg:w-1/2 lg:pl-8";
} else if (disposicion === "solo_texto_centrado") {
    containerClasses = "flex flex-col items-center justify-center";
    textContainerClasses = "w-full text-center mx-auto";
    mediaContainerClasses = "hidden";
} else {
    // solo_texto
    containerClasses = "flex flex-col items-start";
    textContainerClasses = "w-full";
    mediaContainerClasses = "hidden";
}
---

<section
    class="w-full pt-12 md:pt-20 pb-7 md:pb-12 relative overflow-hidden"
    style={{
        backgroundColor: finalBgColor,
        backgroundImage: bgImageStyle,
        backgroundSize: "cover",
        backgroundPosition: "center",
    }}
>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10 max-w-7xl">
        <div class={containerClasses}>
            
            {/* Columna de Texto */}
            <div class={textContainerClasses}>
                {posicion_subtitulo === "arriba" ? (
                    <>
                        {subtitulo && (
                            <p
                                class={`font-[family-name:var(--font-principal)] text-[24px] font-bold uppercase mb-2 leading-[1em] ${disposicion === 'solo_texto_centrado' ? 'mx-auto' : ''}`}
                                style={color_subtitulo ? `color: ${finalSubtitleColor};` : `color: ${finalTextColor}; opacity: 0.85;`}
                            >
                                {subtitulo}
                            </p>
                        )}
                        {titulo && (
                            <TitleTag
                                class={`font-[family-name:var(--font-principal)] text-[40px] font-black uppercase mb-6 leading-[1em] ${disposicion === 'solo_texto_centrado' ? 'mx-auto' : ''}`}
                                style={`color: ${finalTitleColor};`}
                            >
                                {titulo}
                            </TitleTag>
                        )}
                    </>
                ) : (
                    <>
                        {titulo && (
                            <TitleTag
                                class={`font-[family-name:var(--font-principal)] text-[40px] font-black uppercase mb-2 leading-[1em] ${disposicion === 'solo_texto_centrado' ? 'mx-auto' : ''}`}
                                style={`color: ${finalTitleColor};`}
                            >
                                {titulo}
                            </TitleTag>
                        )}
                        {subtitulo && (
                            <p
                                class={`font-[family-name:var(--font-principal)] text-[24px] font-bold uppercase mb-6 leading-[1em] ${disposicion === 'solo_texto_centrado' ? 'mx-auto' : ''}`}
                                style={color_subtitulo ? `color: ${finalSubtitleColor};` : `color: ${finalTextColor}; opacity: 0.85;`}
                            >
                                {subtitulo}
                            </p>
                        )}
                    </>
                )}
                {descripcion && (
                    <div
                        class="font-[family-name:var(--font-secundaria)] text-[22px] font-normal leading-[24px] [&>p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:my-3 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:my-3 [&_li]:mb-1"
                        style={`color: ${finalTextColor};`}
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>

            {/* Columna de Media */}
            {mediaMode !== "none" && disposicion !== "solo_texto_centrado" && (
                <div class={mediaContainerClasses}>
                    {mediaMode === "gallery" ? (
                        <div class="acuario-14-swiper w-full h-[300px] md:h-[450px] rounded-[24px] overflow-hidden shadow-2xl relative">
                            <div class="swiper-wrapper h-full">
                                {galleryFiles.map((item: any) => {
                                    const url = getStrapiUrl(item);
                                    const isGalleryVideo = item?.attributes?.mime?.startsWith('video/') || item?.mime?.startsWith('video/');
                                    return (
                                        <div class="swiper-slide w-full h-full relative">
                                            {isGalleryVideo ? (
                                                <video
                                                    src={url}
                                                    class="absolute inset-0 w-full h-full object-cover"
                                                    autoplay
                                                    loop
                                                    muted
                                                    playsinline
                                                ></video>
                                            ) : (
                                                <img
                                                    src={url}
                                                    alt={titulo || "Galería"}
                                                    class="absolute inset-0 w-full h-full object-cover"
                                                />
                                            )}
                                        </div>
                                    );
                                })}
                            </div>
                            {galleryFiles.length > 1 && (
                                <div class="swiper-pagination"></div>
                            )}
                        </div>
                    ) : (
                        <div class="w-full h-auto min-h-[300px] md:min-h-[450px] rounded-[24px] overflow-hidden shadow-2xl relative">
                            {isVideo ? (
                                <video
                                    src={mediaUrl}
                                    class="absolute inset-0 w-full h-full object-cover"
                                    autoplay
                                    loop
                                    muted
                                    playsinline
                                ></video>
                            ) : (
                                <img
                                    src={mediaUrl}
                                    alt={titulo || "Media Acuario"}
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                            )}
                        </div>
                    )}
                </div>
            )}
            
<style>
    :global(.acuario-14-swiper .swiper-pagination-bullet) {
        background: white;
        opacity: 0.6;
        width: 10px;
        height: 10px;
        transition: all 0.3s ease;
    }
    :global(.acuario-14-swiper .swiper-pagination-bullet-active) {
        background: var(--brand-interactive-base);
        opacity: 1;
        width: 24px;
        border-radius: 5px;
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Pagination, Autoplay, EffectFade } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';
    import 'swiper/css/effect-fade';

    function initC14Swiper() {
        const sliders = document.querySelectorAll('.acuario-14-swiper');
        sliders.forEach((sliderElement) => {
            new Swiper(sliderElement as HTMLElement, {
                modules: [Pagination, Autoplay, EffectFade],
                slidesPerView: 1,
                effect: 'fade',
                fadeEffect: { crossFade: true },
                loop: true,
                autoplay: { delay: 4500, disableOnInteraction: false },
                pagination: { el: '.swiper-pagination', clickable: true },
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initC14Swiper);
</script>
