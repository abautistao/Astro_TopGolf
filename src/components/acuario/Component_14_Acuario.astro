---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    disposicion?: "texto_izquierda" | "texto_derecha" | "solo_texto_centrado" | "solo_texto";
    alineacion?: "left" | "center" | "right" | "justify";
    titulo?: string;
    subtitulo?: string;
    posicion_subtitulo?: "arriba" | "debajo";
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    descripcion?: any;
    media?: any;
    galeria?: { data: any[] } | any[];
    color_fondo?: string;
    color_texto?: string;
    color_titulo?: string;
    color_subtitulo?: string;
    imagen_fondo?: any;
}

const {
    disposicion = "texto_izquierda",
    alineacion = "center",
    titulo,
    subtitulo,
    posicion_subtitulo = "debajo",
    htmlTag = "h2",
    descripcion,
    media,
    galeria,
    color_fondo,
    color_texto,
    color_titulo,
    color_subtitulo,
    imagen_fondo,
} = Astro.props;

const TitleTag = htmlTag;
const finalBgColor = color_fondo || "var(--neutral-background-subtle)";
const finalTextColor = color_texto || "var(--surface-brand-primary)";
const finalTitleColor = color_titulo || finalTextColor;
const finalSubtitleColor = color_subtitulo || finalTextColor;
const bgImageStyle = imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none";

const hasMedia = media?.data || media;
const mediaUrl = hasMedia ? getStrapiUrl(media) : null;
const isVideo = hasMedia && (media?.data?.attributes?.mime?.startsWith('video/') || media?.mime?.startsWith('video/'));

const galleryFiles = (galeria?.data || galeria || []).filter(Boolean);
const hasGallery = galleryFiles.length > 0;
const mediaMode: "single" | "gallery" | "none" = hasGallery ? "gallery" : (hasMedia ? "single" : "none");

// Helper: alineacion enum -> Tailwind classes (solo aplica a modo solo_texto)
const alignTextClass = (a: "left" | "center" | "right" | "justify") =>
    a === "left" ? "text-left mx-0 mr-auto" :
    a === "right" ? "text-right ml-auto mr-0" :
    a === "justify" ? "text-justify mx-0" :
    "text-center mx-auto";

const alignItemsClass = (a: "left" | "center" | "right" | "justify") =>
    a === "right" ? "items-end" :
    a === "justify" ? "items-start" :
    a === "left" ? "items-start" :
    "items-center justify-center";

// Determinar las clases de flexbox basado en la disposición
let containerClasses = "flex flex-col items-center ";
let textContainerClasses = "w-full ";
let mediaContainerClasses = "w-full lg:w-1/2 relative flex justify-center";

if (disposicion === "texto_izquierda") {
    containerClasses += "lg:flex-row lg:gap-10";
    textContainerClasses += "lg:w-1/2 lg:pr-8";
} else if (disposicion === "texto_derecha") {
    containerClasses += "lg:flex-row-reverse lg:gap-10";
    textContainerClasses += "lg:w-1/2 lg:pl-8";
} else if (disposicion === "solo_texto_centrado") {
    containerClasses = `flex flex-col ${alignItemsClass(alineacion)}`;
    textContainerClasses = `w-full ${alignTextClass(alineacion)}`;
    mediaContainerClasses = "hidden";
} else {
    // solo_texto
    containerClasses = "flex flex-col items-start";
    textContainerClasses = "w-full";
    mediaContainerClasses = "hidden";
}
---

<section
    class="w-full pt-12 md:pt-20 pb-7 md:pb-12 relative overflow-hidden"
    style={{
        backgroundColor: finalBgColor,
        backgroundImage: bgImageStyle,
        backgroundSize: "cover",
        backgroundPosition: "center",
    }}
>
    <div class="container mx-auto px-6 md:px-12 relative z-10 max-w-7xl">
        <div class={containerClasses}>
            
            {/* Columna de Texto */}
            <div class={textContainerClasses}>
                {posicion_subtitulo === "arriba" ? (
                    <>
                        {subtitulo && (
                            <p
                                class={`font-[family-name:var(--font-principal)] text-[24px] font-bold uppercase mb-2 leading-[1em] ${alineacion === 'center' ? 'mx-auto' : ''}`}
                                style={color_subtitulo ? `color: ${finalSubtitleColor};` : `color: ${finalTextColor}; opacity: 0.85;`}
                            >
                                {subtitulo}
                            </p>
                        )}
                        {titulo && (
                            <TitleTag
                                class={`font-[family-name:var(--font-principal)] text-[40px] font-black uppercase mb-6 leading-[1em] ${alineacion === 'center' ? 'mx-auto' : ''}`}
                                style={`color: ${finalTitleColor};`}
                            >
                                {titulo}
                            </TitleTag>
                        )}
                    </>
                ) : (
                    <>
                        {titulo && (
                            <TitleTag
                                class={`font-[family-name:var(--font-principal)] text-[40px] font-black uppercase mb-2 leading-[1em] ${alineacion === 'center' ? 'mx-auto' : ''}`}
                                style={`color: ${finalTitleColor};`}
                            >
                                {titulo}
                            </TitleTag>
                        )}
                        {subtitulo && (
                            <p
                                class={`font-[family-name:var(--font-principal)] text-[24px] font-bold uppercase mb-6 leading-[1em] ${alineacion === 'center' ? 'mx-auto' : ''}`}
                                style={color_subtitulo ? `color: ${finalSubtitleColor};` : `color: ${finalTextColor}; opacity: 0.85;`}
                            >
                                {subtitulo}
                            </p>
                        )}
                    </>
                )}
                {descripcion && (
                    <div
                        class="font-[family-name:var(--font-secundaria)] text-[22px] font-normal leading-[24px] [&>p]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:my-3 [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:my-3 [&_li]:mb-1"
                        style={`color: ${finalTextColor};`}
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>

            {/* Columna de Media */}
            {mediaMode !== "none" && disposicion !== "solo_texto_centrado" && (
                <div class={mediaContainerClasses}>
                    {mediaMode === "gallery" ? (
                        <div class="acuario-14-swiper w-full md:w-91 h-112.5 rounded-[24px] overflow-hidden shadow-2xl relative">
                            <div class="swiper-wrapper h-full">
                                {galleryFiles.map((item: any) => {
                                    const url = getStrapiUrl(item);
                                    const isGalleryVideo = item?.attributes?.mime?.startsWith('video/') || item?.mime?.startsWith('video/');
                                    return (
                                        <div class="swiper-slide w-full h-full relative">
                                            {isGalleryVideo ? (
                                                <video
                                                    src={url}
                                                    class="absolute inset-0 w-full h-full object-cover"
                                                    autoplay
                                                    loop
                                                    muted
                                                    playsinline
                                                ></video>
                                            ) : (
                                                <img
                                                    src={url}
                                                    alt={titulo || "Galería"}
                                                    class="absolute inset-0 w-full h-full object-cover"
                                                />
                                            )}
                                        </div>
                                    );
                                })}
                            </div>
                            {galleryFiles.length > 1 && (
                                <div class="swiper-pagination"></div>
                            )}
                        </div>
                    ) : (
                        <div class="w-full h-auto min-h-[300px] md:min-h-[450px] rounded-[24px] overflow-hidden shadow-2xl relative">
                            {isVideo ? (
                                <video
                                    src={mediaUrl}
                                    class="absolute inset-0 w-full h-full object-cover"
                                    autoplay
                                    loop
                                    muted
                                    playsinline
                                ></video>
                            ) : (
                                <img
                                    src={mediaUrl}
                                    alt={titulo || "Media Acuario"}
                                    class="absolute inset-0 w-full h-full object-cover"
                                />
                            )}
                        </div>
                    )}
                </div>
            )}
            
<style>
    :global(.acuario-14-swiper .swiper-pagination-bullet) {
        background: white;
        opacity: 0.6;
        width: 10px;
        height: 10px;
        transition: all 0.3s ease;
    }
    :global(.acuario-14-swiper .swiper-pagination-bullet-active) {
        background: var(--brand-interactive-base);
        opacity: 1;
        width: 24px;
        border-radius: 5px;
    }

    /*
     * Holgura de la foto de cada slide.
     *
     * El parallax desplaza la imagen ±4% de su alto dentro del marco, y el marco
     * recorta (`overflow: hidden`): sin esta holgura el recorrido destaparía el
     * borde superior o inferior de la foto. La aritmética de la regla del
     * helper pide `scale >= 1 + 2 * (distancia / 100)`, o sea 1.08 para una
     * distancia de 4; aquí se usa 1.1 para dejar margen.
     *
     * WHY el guard `:global()`: dentro de un `<style>` con ámbito de Astro, la
     * forma desnuda compila a `[data-astro-cid-x][data-motion="ready"] .cls`, que
     * exige que UN elemento tenga los dos atributos, pero `data-motion` vive en
     * `<html>`, que no tiene id de ámbito. Con `:global()` el guard queda sin
     * ámbito y la regla sí compila y coincide.
     *
     * WHY una regla de hoja y no un estilo en línea: el helper limpia sus
     * triggers con `clearProps` sobre `transform` y `opacity` solamente, pero
     * una regla de hoja sobrevive al desmontaje y no compite con el transform que
     * escribe GSAP (aquí la escala va en la propiedad `scale`, no en `transform`).
     *
     * WHY bajo el guard: sin JS, con movimiento reducido o si el helper no
     * arranca, `data-motion` nunca se escribe, la foto se ve tal como estaba y
     * el bloque no cambia de aspecto.
     */
    :global([data-motion="ready"]) :global(.acuario-14-swiper .swiper-slide img) {
        scale: 1.1;
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Pagination, Autoplay, EffectFade } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/pagination';
    import 'swiper/css/effect-fade';
    import { initMotion, revealSection, parallaxLayer, ambientBubbles } from "../../scripts/motion";

    function initC14Swiper() {
        const sliders = document.querySelectorAll('.acuario-14-swiper');
        sliders.forEach((sliderElement) => {
            new Swiper(sliderElement as HTMLElement, {
                modules: [Pagination, Autoplay, EffectFade],
                slidesPerView: 1,
                effect: 'fade',
                fadeEffect: { crossFade: true },
                loop: true,
                autoplay: { delay: 4500, disableOnInteraction: false },
                pagination: { el: '.swiper-pagination', clickable: true },
            });
        });
    }

    /*
     * Movimiento del bloque (T6).
     *
     * Swiper.js es dueño del transform de sus slides: por eso NINGÚN trigger de
     * este script toca `.swiper-slide`. La profundidad se aplica a la FOTO de
     * dentro del slide, nunca al slide, y tampoco hay un reveal por slide: un
     * slide fuera de pantalla se quedaría en opacidad 0 hasta que el usuario lo
     * desplace, y la posición de un ScrollTrigger no sigue el transform interno
     * de Swiper.
     */
    function setupMotion() {
        // La galería es el ancla del bloque. Si el bloque se configuró con una sola
        // pieza de media (sin galería), esa caja hace de ancla y el bloque sigue
        // teniendo movimiento. Cada sección se resuelve por separado, así que
        // dos instancias del bloque en la misma página no se pisan.
        const swipers = Array.from(document.querySelectorAll('.acuario-14-swiper'));
        const mediaBoxes = Array.from(document.querySelectorAll('.min-h-\\[300px\\]'));

        const secciones = new Set(
            [...swipers, ...mediaBoxes]
                .map((elemento) => elemento.closest('section'))
                .filter((seccion): seccion is HTMLElement => seccion !== null),
        );

        for (const section of secciones) {
            // Burbujas de ambiente sobre la sección. El contenedor de la sección
            // tiene `z-10`, así que las burbujas quedan POR DEBAJO del contenido: no
            // tapan el texto ni la foto. Además el helper las crea con
            // `pointer-events: none` y `aria-hidden`, así que nunca capturan un clic.
            ambientBubbles(section, {
                count: 12,
                maxOnMobile: 5,
                duration: 16,
                rise: 110,
            });

            const swiper = section.querySelector('.acuario-14-swiper');
            const mediaBox = section.querySelector('.min-h-\\[300px\\]');

            if (swiper) {
                // La foto de cada slide se desplaza lentamente con el scroll. La
                // holgura que necesita el recorrido la pone la regla de hoja
                // `:global([data-motion="ready"] .acuario-14-swiper .swiper-slide img)`.
                const images = Array.from(swiper.querySelectorAll('.swiper-slide img'));

                parallaxLayer(images, {
                    distance: 4,
                });

                // El contenedor del carrusel entra con el bloque. Aquí sí puede bajar
                // la opacidad: dentro del carrusel no hay ningún control enfocable
                // (los bullets de paginación de Swiper 11 son `span`).
                revealSection(swiper, {
                    y: 32,
                    duration: 0.85,
                    ease: 'power3.out',
                });
            } else if (mediaBox) {
                revealSection(mediaBox, {
                    y: 32,
                    duration: 0.85,
                    ease: 'power3.out',
                });
            }
        }
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que un
    // trigger registrado antes de esta llamada no haría nada.
    initMotion();

    // Swiper primero: en modo `loop` clona los slides, y el movimiento tiene que
    // alcanzarlos a todos. Por eso el setup del movimiento va después del
    // arranque del carrusel.
    document.addEventListener('DOMContentLoaded', () => {
        initC14Swiper();
        setupMotion();
    });

    // Decisión 7, replicada desde el helper: en una navegación del lado del
    // cliente el helper desmonta sus triggers y vuelve a armar el movimiento, así
    // que los triggers tienen que registrarse otra vez. `Layout.astro` no registra
    // un ClientRouter hoy, así que esto nunca se dispara: existe para que el
    // bloque no se quede quieto si algún día se activa el modo SPA. El guardia
    // del primer evento es el mismo del helper: Astro también lanza
    // `astro:page-load` en la carga inicial, y registrarse ahí pondría un
    // segundo ScrollTrigger sobre los mismos elementos.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupMotion();
    });
</script>
