---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    subtitulo?: string;
    descripcion?: any;
    color_fondo?: string;
    imagen_fondo?: any;
    color_titulo?: string;
    color_texto?: string;
    color_subtitulo?: string;
    slides_desktop?: number;
    galeria?: { data: any[] } | any[];
    titulo_alineacion?: "center" | "left" | "right";
    subtitulo_alineacion?: "center" | "left" | "right";
    descripcion_alineacion?: "center" | "left" | "right";
}

const {
    titulo,
    htmlTag = "h2",
    subtitulo,
    descripcion,
    color_fondo,
    imagen_fondo,
    color_titulo,
    color_texto,
    color_subtitulo,
    slides_desktop = 3,
    galeria,
    titulo_alineacion = "center",
    subtitulo_alineacion = "center",
    descripcion_alineacion = "center",
} = Astro.props;

const desktopSlides = Math.max(2, Math.min(5, parseInt(String(slides_desktop), 10) || 3));
const tabletSlides = desktopSlides >= 4 ? 3 : 2;

const TitleTag = htmlTag;

// Strapi entrega la galería como `{ data: [...] }` o como arreglo plano según
// la forma del response; el `Array.isArray` sólo desambigua el tipo para que
// el compilador pueda leer `.data` sin cambiar el comportamiento (si el
// response trae la estructura sin `data`, se usa una lista vacía en lugar de
// reventar la build).
const mediaFiles: any[] = Array.isArray(galeria) ? galeria : (galeria?.data ?? []);
const hasHeader = Boolean(titulo || subtitulo || descripcion);

// Helper: enum → clase Tailwind text-align (default: center)
const alignClass = (a?: "center" | "left" | "right") =>
    a === "left" ? "text-left" :
    a === "right" ? "text-right" :
    "text-center";
---

<section
    class="w-full py-12 md:py-20 relative overflow-hidden c11-section"
    style={{
        backgroundColor: color_fondo || "var(--neutral-background-subtle)",
        backgroundImage: imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none",
        backgroundSize: "cover",
        backgroundPosition: "center",
    }}
>
    <div class="max-w-[1440px] mx-auto px-6 md:px-12 relative z-10">

        {hasHeader && (
            <div class="mb-8 md:mb-12">
                {titulo && (
                    <TitleTag
                        class={`c11-title font-[family-name:var(--font-principal)] text-[32px] md:text-[42px] font-bold uppercase leading-tight ${alignClass(titulo_alineacion)}`}
                        style={color_titulo ? { color: color_titulo } : { color: "var(--surface-brand-primary)" }}
                    >
                        {titulo}
                    </TitleTag>
                )}

                {subtitulo && (
                    <span
                        class={`c11-subtitle mt-3 block font-[family-name:var(--font-principal)] text-[16px] md:text-[20px] font-medium uppercase tracking-wide ${alignClass(subtitulo_alineacion)}`}
                        style={color_subtitulo ? { color: color_subtitulo } : { color: "var(--accent-highlight-primary, #4BA3B5)" }}
                    >
                        {subtitulo}
                    </span>
                )}

                {descripcion && (
                    <div
                        class={`c11-text mt-5 font-[family-name:var(--font-secundaria)] text-[15px] md:text-[17px] font-normal leading-relaxed [&>p]:mb-2 [&_strong]:font-bold [&_u]:underline [&_em]:italic ${alignClass(descripcion_alineacion)}`}
                        style={color_texto ? { color: color_texto } : { color: "var(--surface-brand-primary)" }}
                        set:html={stringifyRichText(descripcion)}
                    />
                )}
            </div>
        )}

        {mediaFiles.length > 0 && (
            <div class="relative w-full px-6 md:px-14">
                <div class="c11-frame overflow-hidden rounded-[24px]">
                    <div
                        class="acuario-carousel-swiper w-full pb-4 h-[336px] md:h-[384px] lg:h-[416px]"
                        data-desktop-slides={desktopSlides}
                        data-tablet-slides={tabletSlides}
                    >
                        <div class="swiper-wrapper h-full">
                            {mediaFiles.map((mediaFile: any) => {
                                const url = getStrapiUrl(mediaFile);
                                const isVideo = mediaFile?.attributes?.mime?.startsWith('video/') || mediaFile?.mime?.startsWith('video/');

                                return (
                                    <div class="swiper-slide">
                                        <div class="w-full h-full rounded-[24px] overflow-hidden shadow-md group relative">
                                            {isVideo ? (
                                                <video
                                                    src={url}
                                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                                    autoplay
                                                    loop
                                                    muted
                                                    playsinline
                                                ></video>
                                            ) : (
                                                <img
                                                    src={url}
                                                    alt="Galería Acuario"
                                                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                                                />
                                            )}
                                            <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors duration-300 pointer-events-none"></div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    </div>
                </div>

                <button
                    class="swiper-btn-prev absolute top-1/2 -translate-y-1/2 -left-2 md:-left-6 z-20 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center text-[var(--neutral-background-strong)] hover:text-[var(--brand-interactive-base)] transition-colors duration-300 focus:outline-none cursor-pointer"
                    aria-label="Anterior"
                >
                    <i class="fa-solid fa-angle-left text-2xl md:text-3xl"></i>
                </button>

                <button
                    class="swiper-btn-next absolute top-1/2 -translate-y-1/2 -right-2 md:-right-6 z-20 w-10 h-10 md:w-12 md:h-12 flex items-center justify-center text-[var(--neutral-background-strong)] hover:text-[var(--brand-interactive-base)] transition-colors duration-300 focus:outline-none cursor-pointer"
                    aria-label="Siguiente"
                >
                    <i class="fa-solid fa-angle-right text-2xl md:text-3xl"></i>
                </button>
            </div>
        )}

        <div class="acuario-carousel-pagination flex justify-center items-center gap-3 mt-6"></div>
    </div>
</section>

<style>
    .acuario-carousel-swiper .swiper-slide {
        transition: transform 0.4s ease, opacity 0.4s ease;
    }

    /* Desktop: ancho determinista basado en data-desktop-slides (slidesPerView: 'auto') */
    @media (min-width: 1023px) {
        .acuario-carousel-swiper[data-desktop-slides="2"] .swiper-slide {
            width: calc((100% - 24px * 1) / 2);
        }
        .acuario-carousel-swiper[data-desktop-slides="3"] .swiper-slide {
            width: calc((100% - 24px * 2) / 3);
        }
        .acuario-carousel-swiper[data-desktop-slides="4"] .swiper-slide {
            width: calc((100% - 24px * 3) / 4);
        }
        .acuario-carousel-swiper[data-desktop-slides="5"] .swiper-slide {
            width: calc((100% - 24px * 4) / 5);
        }
    }

    .swiper-btn-prev,
    .swiper-btn-next {
        user-select: none;
    }

    .swiper-btn-prev.swiper-button-disabled,
    .swiper-btn-next.swiper-button-disabled {
        opacity: 0.3;
        cursor: not-allowed;
    }

    /* Bullets de paginación: blanco inactivo, amarillo activo */
    :global(.acuario-carousel-pagination .swiper-pagination-bullet) {
        width: 18px;
        height: 18px;
        background-color: white;
        opacity: 0.8;
        transition: all 0.3s ease;
        margin: 0 !important;
    }

    :global(.acuario-carousel-pagination .swiper-pagination-bullet-active) {
        background-color: var(--brand-interactive-base, #FBF21A);
        opacity: 1;
    }
</style>

<script>
    import Swiper from 'swiper';
    import { Navigation, Pagination, Autoplay } from 'swiper/modules';
    import 'swiper/css';
    import 'swiper/css/navigation';
    import 'swiper/css/pagination';
    import { initMotion, revealSection, parallaxLayer, ambientBubbles } from "../../scripts/motion";

    function initCarouselSwiper() {
        const sliders = document.querySelectorAll('.acuario-carousel-swiper');

        sliders.forEach((sliderElement) => {
            const container = sliderElement.closest('.relative.w-full');
            const prevBtn = container?.querySelector('.swiper-btn-prev') as HTMLElement;
            const nextBtn = container?.querySelector('.swiper-btn-next') as HTMLElement;
            const section = sliderElement.closest('section');
            const paginationEl = section?.querySelector('.acuario-carousel-pagination') as HTMLElement;

            const desktopSlides = parseInt(sliderElement.getAttribute('data-desktop-slides') || '3', 10) || 3;
            const tabletSlides = parseInt(sliderElement.getAttribute('data-tablet-slides') || '2', 10) || 2;

            new Swiper(sliderElement as HTMLElement, {
                modules: [Navigation, Pagination, Autoplay],
                loop: true,
                slidesPerGroup: 1,
                autoplay: {
                    delay: 3500,
                    disableOnInteraction: false,
                },
                slidesPerView: 1.1,
                spaceBetween: 16,
                navigation: {
                    nextEl: nextBtn,
                    prevEl: prevBtn,
                },
                pagination: {
                    el: paginationEl,
                    clickable: true,
                },
                breakpoints: {
                    640: {
                        slidesPerView: 1.5,
                        spaceBetween: 20,
                    },
                    768: {
                        slidesPerView: tabletSlides,
                        spaceBetween: 24,
                    },
                    1023: {
                        slidesPerView: 'auto',
                        spaceBetween: 24,
                    },
                },
            });
        });
    }

    document.addEventListener('DOMContentLoaded', initCarouselSwiper);
    document.addEventListener('astro:page-load', initCarouselSwiper);

    /*
     * Motion del bloque (T5) — la galería es un carrusel de Swiper, así que el
     * bloque se mueve en bloque y nunca diapositiva por diapositiva.
     *
     * Por qué NO se revela ninguna diapositiva: Swiper es dueño del transform de
     * sus diapositivas, y una diapositiva en opacidad 0 se quedaría invisible
     * hasta que el usuario la alcanzara con el dedo, sin que el ScrollTrigger
     * volviera a evaluarla (la posición de un trigger no sigue el transform
     * interno de Swiper). El marco del carrusel entra como una sola pieza.
     *
     * Por qué el fondo no lleva parallax: la imagen de fondo del bloque es el
     * `background-image` CSS del propio `<section>`, y el helper sólo puede
     * desplazar un ELEMENTO. Convertir ese fondo en una capa `<img>` sería un
     * cambio de maquetación (y de maquetación nada más), y esta unidad es sólo
     * motion. Lo que sí se desplaza es el marco del carrusel, que es lo que da
     * la profundidad contra ese fondo fijo: es la misma lectura visual (contenido
     * que flota sobre una foto quieta) sin tocar el DOM.
     *
     * Por qué no hay CSS de estado inicial: `revealSection` se apoya en
     * `gsap.from()`, que lee el valor ACTUAL del elemento como destino del tween
     * en el momento de crearlo. Una regla de hoja de estilos que pre-ocultara
     * el elemento bajo el guard `[data-motion="ready"]` sería leída como ese
     * destino y el tween animaría `opacity: 0 → 0`, dejando el bloque invisible
     * para siempre. El estado inicial lo pone el tween, que es lo que mantiene
     * la decisión 3: sin JS, con movimiento reducido o si el helper no
     * inicializa, no se escribe ningún estilo inline y el contenido se ve tal
     * cual.
     */
    function setupComponente11Motion() {
        // Cada consulta se resuelve desde la raíz `.c11-section` de ESTE bloque.
        document.querySelectorAll('.c11-section').forEach((section) => {
            // Título. Si el editor eligió `h1` como etiqueta, NO se revela: un
            // h1 puede ser el elemento LCP y la decisión 4 exige que el texto
            // sobre el pliegue esté en el primer fotograma pintado.
            const title = section.querySelector('.c11-title');
            if (title && title.tagName !== 'H1') {
                revealSection(title, {
                    y: 28,
                    duration: 0.7,
                    ease: 'power3.out',
                });
            }

            const subtitle = section.querySelector('.c11-subtitle');
            if (subtitle) {
                revealSection(subtitle, {
                    y: 18,
                    duration: 0.6,
                    ease: 'power2.out',
                    delay: 0.08,
                });
            }

            // Texto descriptivo. Si el editor metió un enlace dentro del texto
            // enriquecido, el contenedor se deja intacto (S13: nunca se revela
            // como bloque un elemento que contiene un control enfocable).
            const text = section.querySelector('.c11-text');
            if (text && !text.querySelector('a')) {
                revealSection(text, {
                    y: 22,
                    duration: 0.7,
                    ease: 'power2.out',
                    delay: 0.16,
                });
            }

            // Burbujas ambiente: el bloque tiene imagen de fondo y recorta con
            // `overflow-hidden`, así que las burbujas quedan dentro. El helper
            // las crea con `pointer-events: none` y `aria-hidden`, no capturan
            // el clic y el contenido va en un contenedor con `z-10`, así que
            // quedan por detrás del texto.
            ambientBubbles(section, {
                count: 7,
                maxOnMobile: 4,
            });

            // El marco del carrusel: una sola entrada para toda la galería.
            //
            // La entrada es una ESCALA y no un `y` a propósito: el marco es el
            // que lleva el parallax (que escribe `yPercent`), y así los dos
            // movimientos usan canales distintos del mismo transform de GSAP
            // (`scale` de un lado, `yPercent` del otro) y no se pisan. La escala
            // no altera el ancho de maquetación, así que Swiper sigue midiendo
            // las diapositivas igual (mide con el ancho calculado y con
            // `offsetWidth`, no con el rectángulo en pantalla).
            const frame = section.querySelector('.c11-frame');
            if (frame) {
                revealSection(frame, {
                    y: 0,
                    scale: 0.95,
                    duration: 0.9,
                    ease: 'power3.out',
                });

                // Parallax contra la imagen de fondo. El marco no contiene
                // ningún control enfocable (los videos van sin `controls`), así
                // que el helper lo acepta sin `allowInteractive`; y los botones
                // de navegación son HERMANOS del marco, no ancestros, así que
                // ningún control enfocable queda bajo un transform con scrub.
                parallaxLayer(frame, {
                    distance: 3,
                    trigger: section,
                });
            }

            // Deliberadamente NO hay `hoverDepth` en este bloque: la imagen de
            // cada diapositiva ocupa el marco completo de la tarjeta y tanto el
            // marco del carrusel como la propia tarjeta recortan con
            // `overflow-hidden`, así que cualquier ascenso o escala de la
            // tarjeta quedaría cortado. El gesto de hover que el bloque ya
            // tiene (el `group-hover:scale-110` de la imagen) sí sobrevive,
            // porque GSAP nunca toca la imagen.
        });
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que
    // ningún trigger puede registrarse antes de esta llamada.
    initMotion();
    setupComponente11Motion();

    // Decisión 7, reflejada desde el helper: en una navegación del lado del
    // cliente el helper desmonta sus triggers y vuelve a armar el motion, así
    // que los triggers tienen que registrarse otra vez. `Layout.astro` no
    // registra ningún ClientRouter hoy, así que esto nunca se dispara; existe
    // para que el bloque no se quede estático si algún día se activa el modo
    // SPA.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupComponente11Motion();
    });
</script>