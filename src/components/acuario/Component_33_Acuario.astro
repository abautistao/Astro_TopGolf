---
// Franja introductoria de dos columnas para el tema Acuario (componente-33-acuario).
// Replica `landing-sealand/visitas-escolares/index.html:71-83` (.intro-strip).
//
// Fondo claro por defecto, así que el texto NO puede usar --neutral-text-inverted.
// No existe una variable --neutral-text-primary en el tema: la convención de los
// componentes claros del repo (p. ej. Component_15_Acuario) es teñir el texto con
// --surface-brand-primary, y aquí además se baja la opacidad con color-mix() para
// reproducir el tono "muted" del origen sin inventar una variable nueva ni un hex.
import { stringifyRichText, getStrapiUrl } from "../../lib/strapi.js";

export interface Props {
    eyebrow?: string;
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    parrafo?: any;
    boton?: any;
    imagen?: any;
    texto_alt_imagen?: string;
    color_fondo?: string;
    color_eyebrow_override?: string;
    color_titulo_override?: string;
    color_texto_override?: string;
}

const {
    eyebrow,
    titulo,
    htmlTag = "h2",
    parrafo,
    boton,
    imagen,
    texto_alt_imagen,
    color_fondo,
    color_eyebrow_override,
    color_titulo_override,
    color_texto_override,
} = Astro.props;

const TitleTag = htmlTag as any;

// Strapi entrega `repeatable: false` como objeto plano o envuelto en un arreglo
// según la forma del response; normalizamos igual que componente-3-acuario.
const btn = Array.isArray(boton) ? boton[0] : boton;

// Media plano (campo de primer nivel del bloque), no dentro de un repeatable:
// getStrapiUrl lo resuelve sin necesitar una entrada en el deep-populate de strapi.js.
const imageUrl = getStrapiUrl(imagen);

// Cascada: el override del editor (hex del color picker) gana; si no hay, la
// variable de tema definida en setup-site.
const finalBg = color_fondo || "var(--neutral-background-subtle)";
const eyebrowColor = color_eyebrow_override || "var(--brand-interactive-base)";
const titleColor = color_titulo_override || "var(--surface-brand-primary)";
const textColor = color_texto_override || "var(--surface-brand-primary)";
---

<section
    class="c33-section w-full py-16 md:py-[92px]"
    style={`background-color: ${finalBg};`}
>
    <div class="container mx-auto px-4 md:px-6 max-w-7xl">
        <div class="grid gap-[30px] lg:grid-cols-[0.85fr_1.15fr] lg:gap-[58px] items-center">
            {/* `c33-copy` / `c33-figure` son el único ancla de motion del bloque:
                las clases del origen (.intro-image, .btn-primary) no llevan
                prefijo de componente y podrían tocar otro bloque de la misma
                página. No cambian el layout, sólo dan un asidero con prefijo
                `c33-` al script de abajo. */}
            <div class="c33-copy">
                {eyebrow && (
                    <p class="mb-4 font-[family-name:var(--font-secundaria)] text-[12px] font-bold uppercase tracking-[0.17em]" style={`color: ${eyebrowColor};`}>
                        {eyebrow}
                    </p>
                )}

                {titulo && (
                    <TitleTag
                        class="intro-title font-[family-name:var(--font-principal)] font-bold"
                        style={`color: ${titleColor};`}
                    >
                        {titulo}
                    </TitleTag>
                )}

                {parrafo && (
                    <div
                        class="mt-6 mb-[30px] font-[family-name:var(--font-secundaria)] font-normal text-[18px] leading-relaxed [&>p]:mb-0"
                        style={`color: color-mix(in srgb, ${textColor} 78%, transparent);`}
                        set:html={stringifyRichText(parrafo)}
                    />
                )}

                {btn?.texto && (
                    <a
                        href={btn.url || "#"}
                        class="btn-primary inline-flex items-center justify-center min-h-[52px] px-[22px] py-[13px] rounded-full border border-transparent font-[family-name:var(--font-principal)] font-bold text-[14px] transition-transform hover:-translate-y-0.5"
                    >
                        {btn.texto}
                    </a>
                )}
            </div>

            {imageUrl && (
                <div class="intro-image c33-figure">
                    <img
                        src={imageUrl}
                        alt={texto_alt_imagen || ""}
                        loading="lazy"
                        class="w-full aspect-[4/3] lg:aspect-[16/9] object-cover rounded-[32px]"
                    />
                </div>
            )}
        </div>
    </div>
</section>

<style>
    .btn-primary {
        background-color: var(--surface-brand-primary);
        color: var(--neutral-text-inverted);
        box-shadow: 0 12px 26px color-mix(in srgb, var(--surface-brand-primary) 20%, transparent);
    }

    /* La imagen lleva la sombra suave del origen (--shadow), expresada sobre
       --surface-brand-primary para no fijarla a un color literal.
       La sombra vive en el MARCO y no en la `<img>` porque el marco recorta
       (ver abajo): dentro de un `overflow: hidden` la sombra de la imagen
       quedaría recortada y se perdería. El resultado dibujado es el mismo. */
    .intro-image {
        /* La caja recorta a la foto: es lo que permite que el zoom por scroll
           (`zoomImage`) escale la imagen sin que asome un borde por fuera del
           marco. El radio repite el `rounded-[32px]` de la propia `<img>` para
           que el recorte no convierta las esquinas redondeadas en rectas
           durante el zoom. */
        overflow: hidden;
        border-radius: 32px;
        box-shadow: 0 24px 70px color-mix(in srgb, var(--surface-brand-primary) 14%, transparent);
    }

    /* Escala no-role del origen: conserva el clamp en vez de los 32px del rol
       Título. La familia siempre viene de --font-principal. */
    .intro-title {
        font-size: clamp(36px, 4.2vw, 58px);
        line-height: 1.08;
        letter-spacing: -0.045em;
    }
</style>

<script>
    import { initMotion, revealSection, splitReveal, zoomImage } from "../../scripts/motion";

    /*
     * Intro motion (T9) — decision 5: fire-once, no `scrub` en los revelados.
     * La banda está por debajo del pliegue, así que sus dos columnas pueden
     * revelarse al hacer scroll y después se dejan quietas. El único `scrub`
     * del bloque es el zoom de la foto, que es scroll puro y no compite con
     * ningún control.
     *
     * POR QUÉ EL TEXTO NO SE REVELA COMO UN BLOQUE: dentro de `.c33-copy`
     * viven el título, que `splitReveal` ya deja partido y en opacidad 0 al
     * cargar, y el botón, que es focusable y por S13 no puede quedar
     * invisible. Un fade en el contenedor taparía las palabras recién
     * divididas, así que el antetítulo y el párrafo se revelan sueltos y el
     * título se arma por partes.
     *
     * WHY there is no `:global([data-motion="ready"])` hidden-state rule for
     * these elements (unlike the `scale` rule the hero needs for its
     * parallax): `revealSection` is built on `gsap.from()`, which records the
     * element's CURRENT value as the tween's END state the moment the tween is
     * created. A stylesheet rule that pre-hid the element under the readiness
     * guard would therefore be read as the destination, and the tween would
     * animate `opacity: 0 → 0` — the block would stay invisible forever. The
     * hidden state has to come from the tween itself, which is also what keeps
     * decision 3 honest: with JS off, with reduced motion on, or if the helper
     * refuses to initialize, no inline style is ever written and both columns
     * render exactly as the stylesheet leaves them.
     */
    function setupIntroMotion() {
        // Every query resolves from this block's own `.c33-section` root and is
        // scoped by the `c33-` prefix, so nothing here can reach a sibling
        // block on the same page (components 32-38 all render together).
        document.querySelectorAll('.c33-section').forEach((section) => {
            const copy = section.querySelector('.c33-copy');

            // The title assembles word by word. NEVER when the editor left it
            // as an `h1`: an `h1` can be the LCP element, and `splitReveal`
            // writes `opacity: 0` on every part at load.
            const title = copy?.querySelector('.intro-title') ?? null;
            if (title && title.tagName !== 'H1') {
                splitReveal(title, {
                    type: 'words',
                    y: 26,
                    duration: 0.75,
                    stagger: 0.045,
                    // Sin máscara: el interlineado del título es 1.08 y una caja
                    // de recorte de SplitText cortaría las ascendentes y las
                    // descendentes por arriba y por abajo.
                    mask: false,
                });
            }

            // The eyebrow is the first direct `<p>` of the copy column and the
            // paragraph the first direct `<div>`; both are plain text, so they
            // can be revealed on their own.
            const eyebrow = copy?.querySelector(':scope > p') ?? null;
            if (eyebrow) {
                revealSection(eyebrow, {
                    y: 18,
                    duration: 0.65,
                    ease: 'power2.out',
                });
            }

            const paragraph = copy?.querySelector(':scope > div') ?? null;
            if (paragraph) {
                revealSection(paragraph, {
                    y: 22,
                    duration: 0.7,
                    ease: 'power2.out',
                    delay: 0.1,
                });
            }

            // The photo takes the longer travel and starts a beat later, so the
            // two columns settle independently instead of arriving as one block.
            const figure = section.querySelector('.c33-figure');
            if (figure) {
                revealSection(figure, {
                    y: 56,
                    duration: 0.9,
                    ease: 'power3.out',
                    delay: 0.08,
                });

                // Slow scroll-driven zoom on the photo. `from: 1.05` starts the
                // image slightly oversized and the scrub brings it back to 1;
                // the clipping frame (`.intro-image`, `overflow: hidden`) keeps
                // every edge covered the whole way.
                const image = figure.querySelector('img');
                if (image) {
                    zoomImage(image, {
                        from: 1.05,
                        to: 1,
                        duration: 1.2,
                    });
                }
            }
        });
    }

    // Call order is load-bearing: `motionDisabled()` gates on `initialized`, so
    // any trigger registered before this call would silently do nothing.
    initMotion();
    setupIntroMotion();

    // Decision 7, mirrored from the helper: on a client-side navigation the
    // helper tears its triggers down and re-arms motion, so the triggers have to
    // be registered again. `Layout.astro` registers no ClientRouter today, so
    // this never fires — it exists so the block cannot silently go static if SPA
    // mode is ever enabled. The first-event guard mirrors the helper's own: Astro
    // also dispatches `astro:page-load` on the initial load, and re-registering
    // there would put a second ScrollTrigger on the same elements.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupIntroMotion();
    });
</script>