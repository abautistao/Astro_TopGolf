---
import { stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    subtitulo?: string;
    descripcion?: any;
    disclaimer?: string;
    color_fondo?: string;
    color_titulo_override?: string;
    color_subtitulo_override?: string;
    color_texto_override?: string;
    color_disclaimer_override?: string;
}

const {
    titulo,
    htmlTag = "h2",
    subtitulo,
    descripcion,
    disclaimer,
    color_fondo,
    color_titulo_override,
    color_subtitulo_override,
    color_texto_override,
    color_disclaimer_override,
} = Astro.props;

const TitleTag = htmlTag as any;

// Cascade: editor override (hex from the color picker) wins, otherwise the
// theme CSS variable defined by setup-site.
const finalBg = color_fondo || "var(--surface-brand-primary)";
const finalTitleColor = color_titulo_override || "var(--neutral-text-inverted)";
const finalSubtitleColor = color_subtitulo_override || "var(--accent-highlight-primary)";
const finalTextColor = color_texto_override || "var(--neutral-text-inverted)";
const finalDisclaimerColor = color_disclaimer_override || "var(--brand-interactive-base)";
---

<section
    class="c27-section w-full py-12 md:py-20"
    style={`background-color: ${finalBg}; color: ${finalTextColor};`}
>
    <div class="container mx-auto px-4 md:px-6 max-w-7xl text-center">
        {titulo && (
            <TitleTag
                class="c27-titulo font-[family-name:var(--font-principal)] text-[37px] font-bold leading-[31px]"
                style={`color: ${finalTitleColor};`}
            >
                {titulo}
            </TitleTag>
        )}

        {subtitulo && (
            <p
                class="c27-subtitulo font-[family-name:var(--font-principal)] text-[39px] font-black leading-[31px] mt-2"
                style={`color: ${finalSubtitleColor};`}
            >
                {subtitulo}
            </p>
        )}

        {descripcion && (
            <div
                class="c27-descripcion font-[family-name:var(--font-secundaria)] text-[16px] font-normal leading-[21px] mt-6 [&>p]:mb-3 [&_strong]:font-bold [&_u]:underline [&_em]:italic"
                set:html={stringifyRichText(descripcion)}
            />
        )}

        {disclaimer && (
            <p
                class="c27-disclaimer font-[family-name:var(--font-principal)] text-[18px] font-black leading-[25px] mt-6"
                style={`color: ${finalDisclaimerColor};`}
            >
                {disclaimer}
            </p>
        )}
    </div>
</section>

<script>
    import { initMotion, revealSection, splitReveal } from "../../scripts/motion";

    /*
     * Motion del bloque (T7) — un encabezado centrado con su descripción y su
     * descargo legal.
     *
     * Las anclas `c27-` son el único asidero del script: no cambian el layout,
     * sólo dan un nombre estable a cada pieza.
     *
     * El título se arma por palabras, SIN máscara. El encabezado va con
     * `leading-[31px]` sobre un cuerpo de 37px (interlineado negativo), y una
     * máscara de SplitText recorta la caja de línea: las letras se veían
     * cortadas por arriba y por abajo. Sin máscara las palabras entran igual,
     * sólo que desde su sitio.
     *
     * Si el editor dejó el título como `h1` no se parte: un `h1` es candidato a
     * LCP y `splitReveal` escribe `opacity: 0` en cada parte al cargar.
     */
    function setupAvisoMotion() {
        document.querySelectorAll('.c27-section').forEach((section) => {
            const titulo = section.querySelector('.c27-titulo');

            if (titulo && titulo.tagName !== 'H1') {
                splitReveal(titulo, {
                    type: 'words',
                    y: 24,
                    duration: 0.8,
                    stagger: 0.045,
                    mask: false,
                });
            }

            const subtitulo = section.querySelector('.c27-subtitulo');

            if (subtitulo) {
                revealSection(subtitulo, {
                    y: 14,
                    duration: 0.6,
                    delay: 0.1,
                });
            }

            const descripcion = section.querySelector('.c27-descripcion');

            if (descripcion) {
                revealSection(descripcion, {
                    y: 22,
                    duration: 0.7,
                    delay: 0.16,
                });
            }

            // El descargo legal entra más suave: es la nota al pie del bloque,
            // no el mensaje principal.
            const descargo = section.querySelector('.c27-disclaimer');

            if (descargo) {
                revealSection(descargo, {
                    y: 12,
                    duration: 0.85,
                    delay: 0.26,
                    ease: 'power1.out',
                });
            }
        });
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que un
    // trigger registrado antes de `initMotion()` no haría nada.
    initMotion();
    setupAvisoMotion();

    // Decisión 7, reflejada desde el helper: en una navegación del lado del
    // cliente el helper desmonta sus triggers y vuelve a armar el motion, así
    // que hay que registrar los triggers otra vez. `Layout.astro` no registra
    // un ClientRouter hoy, así que esto nunca se dispara; existe para que el
    // bloque no se quede estático si algún día se activa el modo SPA. El
    // guardia de primera carga es el mismo del helper: Astro también dispara
    // `astro:page-load` en la carga inicial y volver a registrar ahí dejaría
    // dos ScrollTrigger sobre los mismos elementos.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupAvisoMotion();
    });
</script>
