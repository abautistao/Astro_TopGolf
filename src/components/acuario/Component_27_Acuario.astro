---
import { stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    subtitulo?: string;
    descripcion?: any;
    disclaimer?: string;
    color_fondo?: string;
    color_titulo_override?: string;
    color_subtitulo_override?: string;
    color_texto_override?: string;
    color_disclaimer_override?: string;
}

const {
    titulo,
    htmlTag = "h2",
    subtitulo,
    descripcion,
    disclaimer,
    color_fondo,
    color_titulo_override,
    color_subtitulo_override,
    color_texto_override,
    color_disclaimer_override,
} = Astro.props;

const TitleTag = htmlTag as any;

// Cascade: editor override (hex from the color picker) wins, otherwise the
// theme CSS variable defined by setup-site.
const finalBg = color_fondo || "var(--surface-brand-primary)";
const finalTitleColor = color_titulo_override || "var(--neutral-text-inverted)";
const finalSubtitleColor = color_subtitulo_override || "var(--accent-highlight-primary)";
const finalTextColor = color_texto_override || "var(--neutral-text-inverted)";
const finalDisclaimerColor = color_disclaimer_override || "var(--brand-interactive-base)";
---

<section
    class="w-full py-12 md:py-20"
    style={`background-color: ${finalBg}; color: ${finalTextColor};`}
>
    <div class="container mx-auto px-4 md:px-6 max-w-7xl text-center">
        {titulo && (
            <TitleTag
                class="font-[family-name:var(--font-principal)] text-[37px] font-bold leading-[31px]"
                style={`color: ${finalTitleColor};`}
            >
                {titulo}
            </TitleTag>
        )}

        {subtitulo && (
            <p
                class="font-[family-name:var(--font-principal)] text-[39px] font-black leading-[31px] mt-2"
                style={`color: ${finalSubtitleColor};`}
            >
                {subtitulo}
            </p>
        )}

        {descripcion && (
            <div
                class="font-[family-name:var(--font-secundaria)] text-[16px] font-normal leading-[21px] mt-6 [&>p]:mb-3 [&_strong]:font-bold [&_u]:underline [&_em]:italic"
                set:html={stringifyRichText(descripcion)}
            />
        )}

        {disclaimer && (
            <p
                class="font-[family-name:var(--font-principal)] text-[18px] font-black leading-[25px] mt-6"
                style={`color: ${finalDisclaimerColor};`}
            >
                {disclaimer}
            </p>
        )}
    </div>
</section>
