---
const { texto_resaltado, texto_secundario, boton, color_texto_resaltado_override, color_texto_secundario_override, color_fondo_override } = Astro.props;

// Normalizamos el botón si viene como array o objeto singular
const btn = Array.isArray(boton) ? boton[0] : boton;

// Overrides de color (caen al default via class si no se definen)
const textoResaltadoStyle = color_texto_resaltado_override ? `color: ${color_texto_resaltado_override}` : undefined;
const textoSecundarioStyle = color_texto_secundario_override ? `color: ${color_texto_secundario_override}` : undefined;
const fondoStyle = color_fondo_override ? `background-color: ${color_fondo_override}; border-color: ${color_fondo_override};` : undefined;
---

<section
    class="w-full bg-[var(--accent-highlight-primary)] max-md:hover:bg-[var(--brand-interactive-base)] max-md:active:bg-[var(--brand-interactive-base)] transition-colors py-3 px-4 border-b border-[var(--accent-highlight-primary)] max-md:hover:border-[var(--brand-interactive-base)] max-md:active:border-[var(--brand-interactive-base)] overflow-hidden"
    style={fondoStyle}
>
    <div class="w-full max-w-[1440px] mx-auto flex flex-col md:flex-row items-center justify-center gap-4 md:gap-8 px-6 md:px-12">
        
        <!-- Text Container -->
        <div class="c2-texto flex flex-col md:flex-row items-center justify-center text-center md:text-left text-[var(--surface-brand-primary)]">
            {texto_resaltado && (
                <h2
                    class="font-[family-name:var(--font-principal)] text-[24px] md:text-[32px] font-bold uppercase md:mr-2"
                    style={textoResaltadoStyle}
                >
                    {texto_resaltado}
                </h2>
            )}
            {texto_secundario && (
                <p
                    class="font-[family-name:var(--font-principal)] text-[18px] md:text-[32px] font-bold uppercase mt-1 md:mt-0"
                    style={textoSecundarioStyle}
                >
                    <span class="border-b-[3px] border-[var(--surface-brand-primary)] md:border-none pb-1 md:pb-0">
                        {texto_secundario}
                    </span>
                </p>
            )}
        </div>

        <!-- Button Container -->
        {btn && btn.texto && btn.url && (
            <div class="hidden md:block mt-2 md:mt-0 flex-shrink-0">
                <a 
                    href={btn.url} 
                    class="inline-block bg-[var(--brand-interactive-base)] text-[var(--surface-brand-primary)] font-[family-name:var(--font-principal)] font-black text-[15px] py-2 px-8 md:px-10 rounded-full uppercase hover:brightness-110 transition-all shadow-[0_4px_10px_0_rgba(0,0,0,0.5)] text-center"
                >
                    {btn.texto}
                </a>
            </div>
        )}
        
    </div>
</section>

<script>
    import { initMotion, revealStagger } from "../../scripts/motion";

    /*
     * Motion de la barra de aviso (T3) — bloque cortísimo, arriba del pliegue.
     *
     * La receta es una sola entrada muy corta: un desplazamiento de 6px que
     * dura 0.4s. Sin fundido desde `opacity: 0`, porque esta barra vive
     * siempre arriba del pliegue y su texto tiene que estar pintado en el
     * primer frame (S8: nada de estado inicial invisible sobre texto
     * above-the-fold). Con `opacityFrom: 1` el helper sólo mueve el texto:
     * se pinta opaco desde el principio y aun así se mueve.
     *
     * El botón de la barra no se toca: dentro vive el enlace enfocable y
     * S13 prohíbe revelar un contenedor interactivo como un todo.
     */
    function setupAnnouncementMotion() {
        document.querySelectorAll('.c2-texto').forEach((texto) => {
            revealStagger(texto, {
                selector: 'h2, p',
                opacityFrom: 1,
                y: 6,
                duration: 0.4,
                stagger: 0.06,
                ease: 'power2.out',
            });
        });
    }

    // El orden importa: `motionDisabled()` depende de `initialized`, así que un
    // trigger registrado antes de `initMotion()` no haría nada.
    initMotion();
    setupAnnouncementMotion();

    // Decisión 7, reflejada desde el helper: en una navegación del lado del
    // cliente el helper desmonta sus triggers y vuelve a armar el motion, así
    // que hay que registrar los triggers otra vez. `Layout.astro` no registra
    // un ClientRouter hoy, así que esto nunca se dispara; existe para que la
    // barra no se quede estática si algún día se activa el modo SPA. El
    // guardia de primera carga es el mismo del helper: Astro también dispara
    // `astro:page-load` en la carga inicial y volver a registrar ahí dejaría
    // dos ScrollTrigger sobre los mismos elementos.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupAnnouncementMotion();
    });
</script>
