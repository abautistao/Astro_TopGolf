---
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";

export interface Props {
    titulo?: string;
    htmlTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "span" | "p";
    subtitulo?: string;
    descripcion?: string;
    color_fondo?: string;
    imagen_fondo?: any;
    tarjetas?: any[];
}

const {
    titulo,
    htmlTag = "h2",
    subtitulo,
    descripcion,
    color_fondo,
    imagen_fondo,
    tarjetas = []
} = Astro.props;

const TitleTag = htmlTag;
---

<section class="w-full py-12 md:py-20 relative overflow-hidden" style={{
    backgroundColor: color_fondo || "transparent",
    backgroundImage: imagen_fondo ? `url(${getStrapiUrl(imagen_fondo)})` : "none",
    backgroundSize: "cover",
    backgroundPosition: "center",
}}>
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl relative z-10">
        
        {/* Encabezado */}
        <div class="text-center mb-10 md:mb-16">
            {titulo && (
                <TitleTag class="font-[family-name:var(--font-principal)] text-[32px] md:text-[42px] font-bold text-white uppercase mb-2">
                    {titulo}
                </TitleTag>
            )}
            
            {subtitulo && (
                <span class="block font-[family-name:var(--font-principal)] text-[18px] md:text-[22px] font-medium text-white uppercase tracking-wide">
                    {subtitulo}
                </span>
            )}
            
            {descripcion && (
                <div 
                    class="mt-6 mx-auto max-w-3xl font-[family-name:var(--font-secundaria)] text-[16px] md:text-[18px] text-white font-normal leading-relaxed text-center [&>p]:mb-2 [&_strong]:font-bold [&_u]:underline [&_em]:italic"
                    set:html={stringifyRichText(descripcion)}
                />
            )}
        </div>

        {/* Grid de Tarjetas */}
        {tarjetas && tarjetas.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 justify-items-center">
                {tarjetas.map((tarjeta) => (
                    <div class="relative w-full max-w-[380px] rounded-[24px] overflow-hidden flex flex-col items-center text-center group transition-transform duration-300 hover:-translate-y-2 shadow-lg min-h-[480px]">
                        
                        {/* Imagen de Fondo */}
                        {tarjeta.imagen_fondo && (
                            <img 
                                src={getStrapiUrl(tarjeta.imagen_fondo)} 
                                alt="" 
                                class="absolute inset-0 w-full h-full object-cover z-0 transition-transform duration-700 group-hover:scale-110"
                            />
                        )}
                        
                        {/* Capa de Difuminación (Overlay) */}
                        <div 
                            class="absolute inset-0 z-0 mix-blend-multiply transition-opacity duration-300"
                            style={{ 
                                backgroundColor: tarjeta.color_overlay || "var(--surface-brand-primary)",
                                opacity: tarjeta.imagen_fondo ? 0.85 : 1
                            }}
                        ></div>
                        <div class="absolute inset-0 z-0 bg-gradient-to-t from-[var(--surface-brand-primary,#002A4E)]/90 via-transparent to-transparent"></div>

                        {/* Contenido (z-10) */}
                        <div class="relative z-10 flex flex-col items-center justify-between w-full h-full p-6 md:p-8">
                            
                            <div class="w-full flex flex-col items-center">
                                {/* Logo de la tarjeta */}
                                {tarjeta.imagen_logo && (
                                    <img 
                                        src={getStrapiUrl(tarjeta.imagen_logo)} 
                                        alt="Logo Promoción" 
                                        class="h-auto w-[180px] md:w-[220px] mb-6 drop-shadow-md"
                                    />
                                )}

                                {/* Textos Superiores */}
                                {tarjeta.texto_superior && (
                                    <span class="font-[family-name:var(--font-principal)] text-white text-[14px] md:text-[16px] font-bold uppercase tracking-wider mb-1 drop-shadow-sm px-2">
                                        {tarjeta.texto_superior}
                                    </span>
                                )}
                                {tarjeta.texto_secundario && (
                                    <span class="font-[family-name:var(--font-secundaria)] text-white/90 text-[12px] md:text-[13px] font-semibold uppercase tracking-widest mb-2 drop-shadow-sm">
                                        {tarjeta.texto_secundario}
                                    </span>
                                )}

                                {/* Precio Gigante */}
                                {tarjeta.precio && (
                                    <span class="font-[family-name:var(--font-principal)] text-white font-black text-[54px] md:text-[64px] leading-none drop-shadow-lg my-2">
                                        {tarjeta.precio}
                                    </span>
                                )}

                                {/* Texto Inferior (ej. POR PERSONA) */}
                                {tarjeta.texto_inferior && (
                                    <span class="font-[family-name:var(--font-principal)] text-white text-[12px] md:text-[14px] font-bold uppercase tracking-wide mt-1 drop-shadow-sm px-2">
                                        {tarjeta.texto_inferior}
                                    </span>
                                )}
                            </div>

                            {/* Acciones y Legales (Fondo) */}
                            <div class="w-full flex flex-col items-center mt-auto pt-8">
                                {/* Botón */}
                                {tarjeta.boton && (
                                    <a 
                                        href={tarjeta.boton.url || "#"} 
                                        class="inline-block w-[90%] bg-[var(--brand-interactive-base,#FBF21A)] hover:bg-white text-[var(--surface-brand-primary,#003F7F)] hover:text-[var(--brand-interactive-base,#FBF21A)] border-2 border-transparent hover:border-[var(--brand-interactive-base,#FBF21A)] font-[family-name:var(--font-principal)] font-bold text-[14px] md:text-[16px] py-3 px-6 rounded-[12px] shadow-md hover:shadow-lg transition-all duration-300 uppercase tracking-wide mb-4"
                                    >
                                        {tarjeta.boton.texto || "ADQUIÉRELO AQUÍ"}
                                    </a>
                                )}

                                {/* Disclaimer (Aplica reservando...) */}
                                {tarjeta.texto_disclaimer && (
                                    <div class="flex items-center gap-2 mb-4 w-full justify-center px-2">
                                        <div class="w-5 h-5 md:w-6 md:h-6 flex items-center justify-center bg-[var(--brand-interactive-base,#FBF21A)] text-[var(--surface-brand-primary,#003F7F)] rounded-full font-black text-[12px] md:text-[14px] shrink-0">
                                            !
                                        </div>
                                        <span class="font-[family-name:var(--font-secundaria)] text-white text-[11px] md:text-[13px] font-medium leading-tight">
                                            {tarjeta.texto_disclaimer}
                                        </span>
                                    </div>
                                )}

                                {/* Términos y Condiciones */}
                                {tarjeta.texto_terminos && (
                                    <a 
                                        href={tarjeta.enlace_terminos || "#"} 
                                        class="font-[family-name:var(--font-secundaria)] text-white/80 hover:text-white text-[9px] md:text-[10px] uppercase font-medium tracking-wider transition-colors underline decoration-white/30 hover:decoration-white underline-offset-4"
                                    >
                                        {tarjeta.texto_terminos}
                                    </a>
                                )}
                            </div>

                        </div>
                    </div>
                ))}
            </div>
        )}
    </div>
</section>
