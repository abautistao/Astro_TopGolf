---
import { getStrapiUrl } from "../../lib/strapi.js";

export interface Props {
    imagen_1?: any;
    imagen_2?: any;
    imagen_3?: any;
    imagen_4?: any;
    enlace_1?: string;
    enlace_2?: string;
    enlace_3?: string;
    enlace_4?: string;
    color_fondo?: string;
}

const {
    imagen_1,
    imagen_2,
    imagen_3,
    imagen_4,
    enlace_1,
    enlace_2,
    enlace_3,
    enlace_4,
    color_fondo,
} = Astro.props;

// Cascade: editor override (hex from the color picker) wins, otherwise the
// theme CSS variable defined by setup-site.
const finalBg = color_fondo || "var(--surface-brand-primary)";

// Build a normalized array of { url, href } pairs. getStrapiUrl returns null
// when the media is missing, so empty slots render nothing (no broken boxes).
const cells = [
    { url: getStrapiUrl(imagen_1), href: enlace_1 },
    { url: getStrapiUrl(imagen_2), href: enlace_2 },
    { url: getStrapiUrl(imagen_3), href: enlace_3 },
    { url: getStrapiUrl(imagen_4), href: enlace_4 },
].filter((cell) => Boolean(cell.url));
---

<section
    class="c30-section w-full py-12 md:py-20"
    style={`background-color: ${finalBg};`}
>
    <div class="container mx-auto px-4 md:px-6 max-w-7xl">
        <div class="c30-grid grid grid-cols-1 sm:grid-cols-2 gap-6">
            {cells.map((cell) => (
                /* Envoltorio de motion: conserva la caja de la celda (`w-full`
                   y la rejilla estira sus ítems) y es el elemento que se
                   revela. El reveal nunca apunta al enlace, que es focusable
                   (S13). */
                <div class="c30-item w-full">
                <div class="c30-cell w-full aspect-[4/3] overflow-hidden rounded-[24px]">
                    {cell.href ? (
                        <a href={cell.href} target="_blank" rel="noopener" class="block w-full h-full">
                            <img src={cell.url} alt="" class="c30-cell-img w-full h-full object-cover" loading="lazy" />
                        </a>
                    ) : (
                        <img src={cell.url} alt="" class="c30-cell-img w-full h-full object-cover" loading="lazy" />
                    )}
                </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script>
    import { initMotion, revealStagger, hoverDepth, zoomImage } from "../../scripts/motion";

    /*
     * Movimiento de la rejilla de imágenes (T4).
     *
     * Reparto de transforms: cada elemento tiene un único dueño.
     *   - `.c30-item`     → el reveal (opacidad + viaje vertical).
     *   - `.c30-cell`     → `hoverDepth` (inclinación + lift).
     *   - `.c30-cell-img` → `zoomImage` (zoom por scroll).
     *
     * Este bloque no lleva imagen de fondo (sólo color), así que no hay
     * `parallaxLayer` ni burbujas: las burbujas son para fondos con imagen y
     * aquí quedarían por encima de las fotos.
     *
     * El reveal nunca apunta al enlace, que es focusable: un `gsap.from()`
     * sobre un control lo deja invisible y tabulable si su trigger no dispara
     * (S13). De ahí el envoltorio `<div>` de cada celda.
     *
     * Sin JS o con `prefers-reduced-motion`, `initMotion()` no escribe
     * `data-motion` y ninguna de estas llamadas hace nada.
     */
    function setupMotion() {
        document.querySelectorAll('.c30-section').forEach((section) => {
            // Las imágenes llegan una detrás de otra.
            const grid = section.querySelector('.c30-grid');
            if (grid) {
                revealStagger(grid, {
                    selector: '.c30-item',
                    stagger: 0.12,
                    y: 30,
                    duration: 0.7,
                    ease: 'power3.out',
                });
            }

            // La profundidad la aporta el puntero, sólo en escritorio: el
            // helper registra el efecto dentro de un `gsap.matchMedia()`
            // `(hover: hover) and (pointer: fine)`.
            section.querySelectorAll('.c30-cell').forEach((cell) => {
                hoverDepth(cell, { maxTilt: 5, lift: -6 });
            });

            // Zoom por scroll de la foto, dentro de la caja `overflow-hidden`
            // de la celda. `from: 1.05` deja margen para que el recorte nunca
            // enseñe un borde.
            section.querySelectorAll('.c30-cell-img').forEach((image) => {
                zoomImage(image, { from: 1.05, duration: 1.2 });
            });
        });
    }

    // `initMotion()` va primero: `motionDisabled()` depende de él.
    initMotion();
    setupMotion();

    // Decision 7 (espejo del helper): hay que registrar los triggers otra vez
    // tras una navegación cliente.
    let initialLoadSeen = false;
    document.addEventListener('astro:page-load', () => {
        const isInitialLoad = !initialLoadSeen && document.readyState !== 'complete';
        initialLoadSeen = true;

        if (isInitialLoad) {
            return;
        }

        setupMotion();
    });
</script>