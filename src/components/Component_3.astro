---
// src/components/Component_3.astro

// 1. Importa las utilidades de Strapi
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";

// 2. Define la interfaz de las props que el componente recibirá desde Strapi
export interface Props {
  pre_titulo: string;
  titulo: string;
  contenido: any; // El Rich Text de Strapi viene como un objeto/array
  texto_boton: string;
  url_boton: string;
  imagen_superior: any;
  alt_imagen_superior: string;
  imagen_inferior_izquierda: any;
  alt_imagen_inferior_izquierda: string;
  imagen_inferior_derecha: any;
  alt_imagen_inferior_derecha: string;
}

// 3. Recibe las props desde Astro
const {
  pre_titulo,
  titulo,
  contenido,
  texto_boton,
  url_boton,
  imagen_superior,
  alt_imagen_superior,
  imagen_inferior_izquierda,
  alt_imagen_inferior_izquierda,
  imagen_inferior_derecha,
  alt_imagen_inferior_derecha,
} = Astro.props;

// 4. Procesa las URLs de las imágenes y el texto enriquecido
const imageUrl1 = getStrapiUrl(imagen_superior);
const imageUrl2 = getStrapiUrl(imagen_inferior_izquierda);
const imageUrl3 = getStrapiUrl(imagen_inferior_derecha);
const contentHtml = stringifyRichText(contenido);

// 5. Define URLs de placeholder por si no hay contenido en Strapi
const placeholderUrl1 = "https://placehold.co/800x600/a0aec0/ffffff?text=Imagen+1";
const placeholderUrl2 = "https://placehold.co/400x400/a0aec0/ffffff?text=Imagen+2";
const placeholderUrl3 = "https://placehold.co/400x400/a0aec0/ffffff?text=Imagen+3";
---

<section class="bg-[var(--neutral-background-subtle)] py-16 sm:py-24">
  <div class="max-w-8xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">

      {/* --- CONTENIDO DE TEXTO (DINÁMICO) --- */}
      <div class="flex flex-col gap-6 order-2 md:order-1">
        <p class="uppercase md:text-4xl font-semibold text-[var(--surface-brand-primary)] tracking-wide">
          {pre_titulo || "ES GOLF. NO ES GOLF."}
        </p>
        <h1 class="uppercase md:text-5xl font-bold text-[var(--brand-interactive-base)]">
          {titulo || "ES TOPGOLF"}
        </h1>
        <div class="prose prose-lg text-[var(--neutral-background-strong)]">
          <div set:html={contentHtml || "<p>Aquí en Topgolf, no hay presión para tener un buen swing de golf o sumar muchos puntos. <strong>Se trata de que todos se diviertan.</strong></p><p>Reúne todo esto en un mismo lugar y lo pasarás genial.</p>"} />
        </div>
        <div class="mt-4">
          <a
            href={url_boton || "#"}
            class="inline-block bg-[var(--brand-interactive-base)] text-[var(--neutral-text-inverted)] font-bold py-3 px-8 rounded-full text-center text-sm uppercase tracking-wider hover:bg-blue-800 transition-colors shadow-md"
          >
            {texto_boton || "RESERVA AQUÍ TU BAHÍA"}
          </a>
        </div>
      </div>

      {/* --- CONTENIDO DE IMÁGENES (DINÁMICO) --- */}
      <div class="flex flex-col gap-4 order-1 md:order-2">
        {/* --- IMAGEN SUPERIOR ALINEADA A LA DERECHA DE SU ESPACIO --- */}
        <div class="flex">
          {/* 1. Contenedor que ocupa el mismo ancho (2/3) que la imagen de abajo */}
          <div class="w-2/3">
            {/* 2. Flexbox para alinear la imagen a la derecha (justify-end) DENTRO de ese espacio */}
            <div class="flex justify-end">
              <img
                src={imageUrl1 || placeholderUrl1}
                alt={alt_imagen_superior || "Imagen de mujer comiendo"}
                class="w-3/4 object-cover shadow-lg h-[200px]"
              />
            </div>
          </div>
          {/* El 1/3 restante a la derecha queda vacío */}
        </div>

        {/* --- IMÁGENES INFERIORES (COMO REFERENCIA DE ANCHO) --- */}
        <div class="flex gap-4">
          {/* Imagen inferior izquierda (la referencia, 2/3) */}
          <img
            src={imageUrl2 || placeholderUrl2}
            alt={alt_imagen_inferior_izquierda || "Personas celebrando"}
            class="w-2/3 object-cover shadow-lg h-[300px]"
          />
          {/* Imagen inferior derecha (1/3) */}
          <img
            src={imageUrl3 || placeholderUrl3}
            alt={alt_imagen_inferior_derecha || "Familia en Topgolf"}
            class="w-1/3 object-cover shadow-lg h-[300px]"
          />
        </div>
      </div>
    </div>
  </div>
</section>