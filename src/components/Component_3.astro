---
// src/components/Component_3.astro

import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

export interface Props {
  pre_titulo: string;
  titulo: string;
  contenido: any;
  imagen_superior: any;
  alt_imagen_superior: string;
  imagen_inferior_izquierda: any;
  alt_imagen_inferior_izquierda: string;
  imagen_inferior_derecha: any;
  alt_imagen_inferior_derecha: string;
  Boton: Boton[];
}

const {
  pre_titulo,
  titulo,
  contenido,
  imagen_superior,
  alt_imagen_superior,
  imagen_inferior_izquierda,
  alt_imagen_inferior_izquierda,
  imagen_inferior_derecha,
  alt_imagen_inferior_derecha,
  Boton,
} = Astro.props;

const imageUrl1 = getStrapiUrl(imagen_superior);
const imageUrl2 = getStrapiUrl(imagen_inferior_izquierda);
const imageUrl3 = getStrapiUrl(imagen_inferior_derecha);
const contentHtml = stringifyRichText(contenido);

const placeholderUrl1 = "https://placehold.co/800x600/a0aec0/ffffff?text=Imagen+1";
const placeholderUrl2 = "https://placehold.co/400x400/a0aec0/ffffff?text=Imagen+2";
const placeholderUrl3 = "https://placehold.co/400x400/a0aec0/ffffff?text=Imagen+3";
const componentButtons: Boton[] = (Boton && !Array.isArray(Boton) ? [Boton] : Boton) || [
    {
        id: 1,
        texto: "RESERVA AQUÍ TU BAHÍA",
        url: "#",
        tipo: "version_3"
    }
];
---

<section class="bg-[var(--neutral-background-subtle)] py-10 md:py-20 px-1 md:px-10">

  <div class="max-w-8xl mx-auto px-0 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-12 items-center">

      <div class="flex flex-col gap-2 order-2 md:order-1 md:col-span-2 px-4 md:px-0" >
        <p class="whitespace-nowrap uppercase text-[32px] md:text-[52px] font-normal text-[var(--neutral-background-strong)] tracking-wide font-(family-name:--font-shields-sans-regular)">
          {pre_titulo || "ES GOLF. NO ES GOLF."}
        </p>
        <h1 class="tracking-normal uppercase text-5xl md:text-7xl font-semibold text-[var(--brand-interactive-base)] font-(family-name:--font-shields-sans-semibold-condensed)">
          {titulo || "ES TOPGOLF"}
        </h1>
        <div class="text-[var(--neutral-background-strong)] strapi-rich-text text-lg font-(family-name:--font-shields-sans-regular)">
          <div set:html={contentHtml || "<p>Aquí en Topgolf, no hay presión para tener un buen swing de golf o sumar muchos puntos. <strong>Se trata de que todos se diviertan.</strong></p><p>Reúne todo esto en un mismo lugar y lo pasarás genial.</p>"} />
        </div>
        <div class="mt-5">
          <ButtonGroup botones={componentButtons} clase="flex flex-col items-start"/>
      </div>
      </div>

      <div class="flex flex-col gap-4 order-1 md:order-2 md:col-span-3" style="overflow: hidden;">
        <div class="w-3/5">
          <div class="flex justify-end">
            <img
              src={imageUrl1 || placeholderUrl1}
              alt={alt_imagen_superior || "Imagen de mujer comiendo"}
              class="w-4/5 md:w-3/5 object-cover shadow-lg h-[230px]"
            />
          </div>
        </div>

        <div class="flex gap-4">
          <img
            src={imageUrl2 || placeholderUrl2}
            alt={alt_imagen_inferior_izquierda || "Personas celebrando"}
            class="w-3/5 object-cover shadow-lg h-[400px]"
          />
          <img
            src={imageUrl3 || placeholderUrl3}
            alt={alt_imagen_inferior_derecha || "Familia en Topgolf"}
            class="w-2/6 object-cover shadow-lg h-[400px]"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    .strapi-rich-text :global(strong) {
        color: var(--surface-brand-primary);
    }
    .strapi-rich-text :global(u) {
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: inherit;
    }
</style>