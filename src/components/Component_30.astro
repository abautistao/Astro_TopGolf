---
// src/components/Component_30.astro
import { stringifyRichText } from "../lib/strapi.js";

// 1. Definimos las interfaces para las props de Strapi
export interface Props {
  titulo: string;
  contenido: any; // Rich Text
  texto_boton: string;
  url_boton: string;
}

// 2. Recibimos las props y definimos placeholders
const { titulo, contenido, texto_boton, url_boton } = Astro.props;

const placeholderData: Props = {
  titulo: "¿QUIERES JUGAR TODO EL DÍA, TODOS LOS DÍAS SIN PREOCUPARTE POR LAS HORAS DE JUEGO?",
  contenido: [{ type: 'paragraph', children: [{ type: 'text', text: "¡Llegaste al lugar correcto!, para eso tenemos nuestras membresías, que te ofrecen una serie de beneficios en juego, alimentos y bebidas. Además podrás traer a tus amigos, familia, colegas o a quien tú quieras para que te acompañen en la diversión. Tenemos cupo limitado cada año. Escríbenos para brindarte más información." }] }],
  texto_boton: "MÁS INFORMACIÓN",
  url_boton: "#",
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
  titulo: titulo || placeholderData.titulo,
  contenido: stringifyRichText(contenido || placeholderData.contenido),
  texto_boton: texto_boton || placeholderData.texto_boton,
  url_boton: url_boton || placeholderData.url_boton,
};
---

<section class="bg-[var(--neutral-text-inverted)] py-16 sm:py-24">
    <div class="mx-auto max-w-5xl px-6 text-center lg:px-8">
        <h2 class="text-2xl font-bold text-[var(--neutral-background-strong)] sm:text-3xl">
            {dataToRender.titulo}
        </h2>
        <div class="mt-6 text-lg text-[var(--neutral-background-strong)] prose max-w-none" set:html={dataToRender.contenido}>
        </div>
        <div class="mt-10">
            <a href={dataToRender.url_boton} class="rounded-full bg-[var(--brand-interactive-base)] px-8 py-3.5 text-sm font-semibold text-[var(--neutral-text-inverted)]">
                {dataToRender.texto_boton}
            </a>
        </div>
    </div>
</section>

<style>
    .prose :global(p) {
        margin: 0;
    }
</style>