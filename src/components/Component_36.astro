---
// src/components/Component_36.astro
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";

// --- INTERFACES ---
export interface HorarioEspecial {
    id: number;
    texto: string;
}

export interface Props {
    // Sección: ACERCA DE TOPGOLF MONTERREY
    titulo?: string;
    descripcion?: any; // Rich Text para el cuerpo del texto

    
    texto_enlace_acerca?: string;
    url_enlace_acerca?: string;

    // Sección: DIRECCIÓN
    titulo_direccion?: string;
    texto_direccion?: any; // Rich Text para la dirección física
    telefono?: string;
    url_telefono?: string;
    texto_cta_bahia?: string;
    url_cta_bahia?: string;

    // Sección: HORARIOS
    titulo_horarios?: string;
    horario_lunes_miercoles?: string;
    horario_jueves?: string;
    horario_viernes_sabado?: string;
    titulo_horarios_especiales?: string;
    horarios_especiales?: HorarioEspecial[]; // Array de textos simples para horarios especiales
}

// --- DESTRUCTURING Y FALLBACKS ---
const {
    titulo,
    descripcion,
    texto_enlace_acerca,
    url_enlace_acerca,
    titulo_direccion,
    texto_direccion,
    telefono,
    url_telefono,
    texto_cta_bahia,
    url_cta_bahia,
    titulo_horarios,
    horario_lunes_miercoles,
    horario_jueves,
    horario_viernes_sabado,
    titulo_horarios_especiales,
    horarios_especiales,
} = Astro.props;


// --- PROCESAMIENTO DINÁMICO ---
const acercaHtml = stringifyRichText(descripcion);
const direccionHtml = stringifyRichText(texto_direccion);

// --- PLACEHOLDERS ---
const placeholderAcerca = `
    <p>
        <strong>Bienvenido a Topgolf,</strong> tu principal destino de
        entretenimiento. Y por destino de entretenimiento nos
        referimos a un lugar donde puedes venir para festejar un
        cumpleaños, despedidas de soltero o soltera, eventos
        corporativos, citas nocturnas o simplemente para divertirte
        con tus amigos y pasarla en grande
    </p>
`;
const placeholderDireccion = `
    Av. Ignacio Morones Prieto 100, Zona Las
    Callejones, 66228 San Pedro Garza García,
    N.L.
`;

const placeholderHorariosEspeciales: HorarioEspecial[] = [
    { id: 1, texto: "26 de mayo: 8 a. m. a 1 a. m." }
];

const horariosEspecialesToRender = horarios_especiales && horarios_especiales.length > 0
    ? horarios_especiales
    : placeholderHorariosEspeciales;

// Colores basados en el diseño:
const accentColor = '#9981DC'; // Color principal del borde y enlaces
const highlightColor = '#00FFFF'; // Color del fondo de los títulos de sección
const specialColor = '#FFFF00'; // Color del fondo de Horarios Especiales
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 px-4 sm:px-6 lg:px-8">
    <div class="container mx-auto max-w-7xl">
        <div class="grid grid-cols-1 lg:grid-cols-7 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-blue-700">

        {/* --- COLUMNA 1: ACERCA DE TOPGOLF MONTERREY --- */}
        <div class="p-6 md:p-8 lg:p-8 lg:pl-4 lg:pm-4 lg:col-span-3">
            <h3 class="text-xl font-bold uppercase tracking-wider text-[var(--neutral-background-strong)] mb-6">
                {titulo || "ACERCA DE TOPGOLF MONTERREY"}
            </h3>
            <div class="text-[var(--neutral-background-strong)] leading-relaxed prose max-w-none">
                <div set:html={acercaHtml || placeholderAcerca} />
            </div>
            <div class="mt-4 text-[var(--neutral-background-strong)]">
                <span class="text-[var(--neutral-background-strong)] font-semibold text-md">
                    ¿Eres nuevo en Topgolf?
                </span>
                <a href={url_enlace_acerca || '#'} class="text-sm ml-1 relative group text-[var(--brand-interactive-base)]">
                    {texto_enlace_acerca || "Aprende a jugar"}
                    <span class="absolute bottom-0 left-0 w-full h-0.5"></span>
                </a>
            </div>
        </div>

        {/* --- COLUMNA 2: DIRECCIÓN Y CONTACTO --- */}
        <div class="p-6 md:p-8 lg:p-8 lg:pl-4 lg:pm-4 lg:col-span-2">
            <div class="bg-[var(--accent-highlight-secondary)] inline-block px-2 py-1 mb-6 font-semibold uppercase text-[var(--surface-brand-primary)]" >
                {titulo_direccion || "DIRECCIÓN"}
            </div>

            <div class="text-sm text-[var(--neutral-background-strong)] leading-relaxed whitespace-pre-line">
                <div set:html={direccionHtml || placeholderDireccion} />
            </div>

            <div class="mt-6 flex items-center text-[var(--brand-interactive-base)]">
                <i class="fas fa-phone fa-sm"></i>
                <a href={`tel:${url_telefono || '8115481000'}`} class="text-sm font-semibold" >
                {telefono || '81 1548 1000'}
                </a>
            </div>

            {/* Botón/Enlace de Reserva */}
            <div class="mt-4 flex items-center text-[var(--brand-interactive-base)]">
                <i class="fas fa-shopping-cart fa-sm"></i>
                <a href={url_cta_bahia || '#'} class="text-sm font-semibold uppercase">
                {texto_cta_bahia || 'RESERVA TU BAHÍA'}
                </a>
            </div>
        </div>

        {/* --- COLUMNA 3: HORARIOS --- */}
        <div class="p-6 md:p-8 lg:p-8 lg:pl-4 lg:pm-4 lg:col-span-2">
            <div class="bg-[var(--accent-highlight-secondary)] inline-block px-2 py-1 mb-6 font-semibold uppercase text-[var(--surface-brand-primary)]">
                {titulo_horarios || "HORARIOS"}
            </div>

            <p class="text-sm text-[var(--neutral-background-strong)] mt-1 whitespace-pre-line">
                Lunes a miércoles: {horario_lunes_miercoles || '10 a. m. a 12 a. m.'}
            </p>
            <p class="text-sm text-[var(--neutral-background-strong)] mt-1 whitespace-pre-line">
                Jueves: {horario_jueves || '10 a. m. a 1 a. m.'}
            </p>
            <p class="text-sm text-[var(--neutral-background-strong)] mt-1 whitespace-pre-line">
                Viernes y sábado: {horario_viernes_sabado || '10 a. m. a 2 a. m.'}
            </p>

            {/* Horarios Especiales */}
            <div class="inline-block px-2 py-1 mt-4 mb-3 font-semibold uppercase text-[var(--surface-brand-primary)] bg-[var(--accent-highlight-primary)]">
                {titulo_horarios_especiales || "HORARIOS ESPECIALES"}
            </div>

            {horariosEspecialesToRender.map(item => (
                <p class="text-sm font-bold text-[var(--neutral-background-strong)] mt-1">
                    {item.texto}
                </p>
            ))}
        </div>
        </div>
    </div>
</section>

<style>
    /* Estilos para asegurar que el Rich Text de Strapi se vea correctamente */
    .prose :global(strong) {
        font-weight: 700;
        color: var(--neutral-text-heavy); /* Color para el texto en negritas */
    }
    .prose :global(a) {
        /* Imitar el estilo de enlace de la columna 1 */
        color: v-bind('accentColor');
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    /* Ajuste para evitar doble línea divisora en móvil */
    @media (max-width: 1023px) {
        .divide-y-2 > div:first-child {
            padding-top: 0;
        }
    }
</style>
