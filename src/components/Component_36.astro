---
// src/components/Component_36.astro
import { getStrapiUrl, stringifyRichText, formatUrl } from "../lib/strapi.js";

// --- INTERFACES ---
export interface HorarioEspecial {
    id: number;
    texto: string;
}

export interface Props {
    // Sección: ACERCA DE TOPGOLF MONTERREY
    titulo?: string;
    descripcion?: any; // Rich Text para el cuerpo del texto

    texto_enlace_acerca?: string;
    url_enlace_acerca?: string;

    // Sección: DIRECCIÓN
    subtitulo_1?: string;
    descripcion_1?: any; // Rich Text para la dirección física
    descripcion_2?: any; // Rich Text para la dirección física
    descripcion_3?: any; // Rich Text para la dirección física
    telefono?: string;
    url_telefono?: string;
    texto_cta_bahia?: string;
    url_cta_bahia?: string;

    // Sección: HORARIOS
    subtitulo_2?: string;
    horario_lunes_miercoles?: string;
    horario_jueves?: string;
    horario_viernes_sabado?: string;
    subtitulo_3?: string;
    horarios_especiales?: HorarioEspecial[]; // Array de textos simples para horarios especiales
}

// --- DESTRUCTURING Y FALLBACKS ---
const {
    titulo,
    descripcion,
    texto_enlace_acerca,
    url_enlace_acerca,
    subtitulo_1,
    descripcion_1,
    telefono,
    url_telefono,
    texto_cta_bahia,
    url_cta_bahia,
    subtitulo_2,
    descripcion_2,
    horario_lunes_miercoles,
    horario_jueves,
    horario_viernes_sabado,
    subtitulo_3,
    descripcion_3,
    horarios_especiales,
} = Astro.props;

// --- PROCESAMIENTO DINÁMICO ---
const acercaHtml = stringifyRichText(descripcion);
const direccionHtml = stringifyRichText(descripcion_1);
const horariosHtml = stringifyRichText(descripcion_2);
const horariosEspecialesHtml = stringifyRichText(descripcion_3);

// --- PLACEHOLDERS ---
const placeholderAcerca = `
    <p>
        lorem Ipsum
    </p>
`;
const placeholderDireccion = `
    Av. Ignacio Morones Prieto 100, Zona Las
    Callejones, 66228 San Pedro Garza García,
    N.L.
`;

const placeholderHorariosEspeciales: HorarioEspecial[] = [
    { id: 1, texto: "26 de mayo: 8 a. m. a 1 a. m." },
];

const horariosEspecialesToRender =
    horarios_especiales && horarios_especiales.length > 0
        ? horarios_especiales
        : placeholderHorariosEspeciales;

// Colores basados en el diseño:
const accentColor = "#9981DC"; // Color principal del borde y enlaces
const highlightColor = "#00FFFF"; // Color del fondo de los títulos de sección
const specialColor = "#FFFF00"; // Color del fondo de Horarios Especiales
---

<section
    class="w-full bg-[var(--neutral-text-inverted)] py-12 px-4 sm:px-6 lg:px-8"
>
    <div class="container mx-auto max-w-7xl">
        <div
            class="grid grid-cols-1 lg:grid-cols-7 divide-y-2 lg:divide-y-0 lg:divide-x-2 divide-blue-700"
        >
            {/* --- COLUMNA 1: ACERCA DE TOPGOLF MONTERREY --- */}
            <div class="md:p-8 lg:p-8 lg:pl-4 lg:pm-4 lg:col-span-3">
                <h3
                    style="font-family: var(--font-shields-sans-semibold-condensed);"
                    class="text-2xl font-bold uppercase tracking-wider text-[var(--neutral-background-strong)] mb-6"
                >
                    {titulo || "ACERCA DE TOPGOLF MONTERREY"}
                </h3>
                <div
                    style="font-family: var(--font-shields-sans-regular);"
                    class="text-[var(--neutral-background-strong)] leading-relaxed prose max-w-none"
                >
                    <div
                        class="strapi-rich-text"
                        set:html={acercaHtml || placeholderAcerca}
                    />
                </div>
            </div>

            {/* --- COLUMNA 2: DIRECCIÓN Y CONTACTO --- */}
            <div class="p-6 md:p-8 lg:p-8 lg:pl-4 lg:pm-4 lg:col-span-2">
                <div
                    style="font-family: var(--font-shields-sans-semibold-condensed);"
                    class="bg-[var(--accent-highlight-secondary)] inline-block px-2 py-1 mb-6 font-semibold uppercase text-[var(--surface-brand-primary)]"
                >
                    {subtitulo_1 || "DIRECCIÓN"}
                </div>

                <div
                    style="font-family: var(--font-shields-sans-regular);"
                    class="text-sm text-[var(--neutral-background-strong)] leading-relaxed whitespace-pre-line"
                >
                    <div
                        class="strapi-rich-text-2"
                        set:html={direccionHtml || placeholderDireccion}
                    />
                </div>
            </div>

            {/* --- COLUMNA 3: HORARIOS --- */}
            <div
                style="font-family: var(--font-shields-sans-regular);"
                class="p-6 md:p-8 lg:p-8 lg:pl-4 lg:pm-4 lg:col-span-2"
            >
                <div
                    style="font-family: var(--font-shields-sans-semibold-condensed) !important;"
                    class="bg-[var(--accent-highlight-secondary)] inline-block px-2 py-1 mb-6 font-semibold uppercase text-[var(--surface-brand-primary)]"
                >
                    {subtitulo_2 || "HORARIOS"}
                </div>

                <div
                    style="font-family: var(--font-shields-sans-regular);"
                    class="text-sm text-[var(--neutral-background-strong)] leading-relaxed whitespace-pre-line"
                >
                    <div
                        class="strapi-rich-text"
                        set:html={horariosHtml || "Lorem Ipsum"}
                    />
                </div>

                {/* Horarios Especiales */}
                <div
                    style="font-family: var(--font-shields-sans-semibold-condensed);"
                    class="inline-block px-2 py-1 mt-4 mb-3 font-semibold uppercase text-[var(--surface-brand-primary)] bg-[var(--accent-highlight-primary)]"
                >
                    {subtitulo_3 || "HORARIOS ESPECIALES"}
                </div>

                <div
                    style="font-family: var(--font-shields-sans-regular);"
                    class="text-sm text-[var(--neutral-background-strong)] leading-relaxed whitespace-pre-line"
                >
                    <div
                        class="strapi-rich-text"
                        set:html={horariosEspecialesHtml || "Lorem Ipsum"}
                    />
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* Estilos para asegurar que el Rich Text de Strapi se vea correctamente */
    .prose :global(strong) {
        font-weight: 700;
        color: var(--neutral-text-heavy); /* Color para el texto en negritas */
    }
    .prose :global(a) {
        /* Imitar el estilo de enlace de la columna 1 */
        color: v-bind("accentColor");
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    /* Ajuste para evitar doble línea divisora en móvil */
    @media (max-width: 1023px) {
        .divide-y-2 > div:first-child {
            padding-top: 0;
        }
    }

    .strapi-rich-text :global(strong) {
        color: var(--neutral-background-strong);
        font-family: var(--font-tee-line-bold-italic);
        font-weight: bold;
    }

    .strapi-rich-text :global(u) {
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }

    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: var(--brand-interactive-base);
    }
    .strapi-rich-text-2 :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: var(--brand-interactive-base);
        text-transform: uppercase;
    }
    .strapi-rich-text-2 :global(i) {
        color: var(--brand-interactive-base);
        text-transform: uppercase;
    }

    /* --- Agrega esto aquí --- */
    .strapi-rich-text :global(li::marker) {
        /* Usa la variable de color que desees para el punto/número */
        color: var(--neutral-background-strong);

        /* Opcional: Si quieres que el bullet sea más grande o negrita */
        font-weight: bold;
        font-size: 1.2em;
    }
</style>
