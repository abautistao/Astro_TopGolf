---
// src/components/Component_4.astro
---
<section class="bg-white py-20 sm:py-28">
    <div class="max-w-6xl mx-auto px-4">
        <div class="flex flex-col items-center gap-8">
            <div class="flex flex-col items-center gap-8 lg:flex-row lg:items-center">
                <div class="inline-block bg-lime-400 transform -rotate-3 shadow-md shrink-0">
                    <h2 class="text-2xl md:text-3xl font-extrabold text-blue-800 py-3 px-8 uppercase tracking-tighter">
                        ¿Listo para jugar?
                    </h2>
                </div>

                <p class="text-xl text-center lg:text-left text-gray-700">
                Arma tu plan y visita Topgolf Monterrey
                </p>
            </div>

            <div class="shrink-0">
                <a href="#" class="inline-block bg-blue-700 text-white font-bold py-4 px-12 rounded-full text-center text-sm uppercase tracking-wider hover:bg-blue-800 transition-colors shadow-lg">
                Planea tu visita
                </a>
            </div>
        </div>
    </div>
</section>