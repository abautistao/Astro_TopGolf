---
// src/components/Component_22.astro
import { stringifyRichText } from "../lib/strapi.js";
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

export interface Props {
    tag: string;
    titulo: string;
    contenido: any; // Rich Text
    Boton?: Boton[];
}

// 2. Recibimos las props y definimos placeholders
const { tag, titulo, contenido , Boton  } = Astro.props;


const placeholderData: Props = {
    tag: "JUEGOS DE TOPGOLF MONTERREY",
    titulo: "DIVERSIÓN PARA TODOS LOS NIVELES",
    contenido: [
        { type: 'paragraph', children: [
        { type: 'text', text: "Tanto si eres un aspirante a profesional del golf como si estás recogiendo un palo por primera vez, Topgolf es el juego de todos. Nuestros objetivos gigantes facilitan la puntuación sin importar tu swing. Y nuestras pelotas de golf con microchip se puntúan solas, para que puedas concentrarte en la diversión. " },
        { type: 'link', url: '#', children: [{ type: 'text', text: '¡Ven a jugar!', bold: true }] }
        ]}
    ]
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
    tag: tag || placeholderData.tag,
    titulo: titulo || placeholderData.titulo,
    contenido: stringifyRichText(contenido || placeholderData.contenido),
};

const componentButtons:  Boton[] = (Boton && !Array.isArray(Boton) ? [Boton] : Boton) || [
                  {   id: 1,
                    texto:  "Lorem Ipsum",
                    url:  "#",
                    tipo: "version_3"
                }];
---

<section class="w-full text-[var(--neutral-text-inverted)] bg-custom-gradient">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 py-20 lg:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-10 items-center">
            <div class="text-left max-w-lg">
                <span class="inline-block bg-[var(--accent-highlight-secondary)] text-[var(--surface-brand-primary)] text-xs font-bold tracking-wider uppercase px-3 py-1 rounded">
                    {dataToRender.tag}
                </span>
                <h1 class="text-4xl md:text-6xl font-bold uppercase mt-4 leading-tight">
                    {dataToRender.titulo}
                </h1>
            </div>

            <div class="flex flex-col items-start lg:items-center">
                <div class="mb-8 text-base lg:text-lg text-left lg:text-center max-w-lg prose" set:html={dataToRender.contenido}>
                </div>
                <ButtonGroup botones={componentButtons} />
            </div>
        </div>
    </div>
</section>

<style>
    .bg-custom-gradient {
        background-image: linear-gradient(to right, var(--surface-brand-primary), var(--brand-interactive-base));
    }
    .prose :global(p) {
        color: var(--neutral-text-inverted);
        margin: 0;
    }
    .prose :global(a) {
        color: var(--neutral-text-inverted);
        font-weight: 700;
    }
    .prose :global(a:hover) {
        text-decoration: underline;
    }
</style>