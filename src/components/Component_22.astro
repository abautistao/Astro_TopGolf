---
// src/components/Component_22.astro

// Objeto con el contenido para facilitar la edición
const pageContent = {
    tag: "JUEGOS DE TOPGOLF MONTERREY",
    headline: "DIVERSIÓN PARA TODOS LOS NIVELES",
    paragraph: "Tanto si eres un aspirante a profesional del golf como si estás recogiendo un palo por primera vez, Topgolf es el juego de todos. Nuestros objetivos gigantes facilitan la puntuación sin importar tu swing. Y nuestras pelotas de golf con microchip se puntúan solas, para que puedas concentrarte en la diversión.",
    linkText: "¡Ven a jugar!",
    buttonText: "¡AGENDA TU VISITA!",
};
---

<section class="w-full text-[var(--neutral-text-inverted)] bg-custom-gradient">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 py-20 lg:py-32">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-10 items-center">
            <div class="text-left max-w-lg">
                <span class="inline-block bg-[var(--accent-highlight-secondary)] text-[var(--surface-brand-primary)] text-xs font-bold tracking-wider uppercase px-3 py-1 rounded">
                    {pageContent.tag}
                </span>
                <h1 class="text-4xl md:text-6xl font-bold uppercase mt-4 leading-tight">
                    {pageContent.headline}
                </h1>
            </div>

            <div class="flex flex-col items-start lg:items-center">
                <p class="text-base lg:text-lg text-left lg:text-center max-w-4lg">
                    {pageContent.paragraph}
                    <a href="#" class="font-bold hover:underline">{pageContent.linkText}</a>
                </p>

                <a href="#" class="inline-block mt-8 bg-[var(--neutral-text-inverted)] text-[var(--surface-brand-primary)] font-bold py-3 px-8 rounded-full uppercase tracking-wider hover:bg-gray-200 transition-colors duration-300">
                    {pageContent.buttonText}
                </a>
            </div>
        </div>
    </div>
</section>