---
// src/components/Component_40.astro
import { stringifyRichText } from "../lib/strapi.js";
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

// 1. Definimos la interfaz para las props de Strapi
export interface Props {
  titulo_principal: string;
  subtitulo_superior?: string;
  color_etiqueta?: string; // Mantenemos por compatibilidad, aunque el diseño tiene colores fijos
  descripcion: any; // Rich Text
  texto_final: any;
  Boton: Boton[];
  lista_beneficios?: { texto: string }[];
  imagen?: {
    data: {
      attributes: {
        url: string;
        alternativeText?: string;
      };
    };
  };
}

// 2. Recibimos las props y definimos placeholders
const {
  titulo_principal,
  subtitulo_superior,
  lista_beneficios,
  descripcion,
  texto_final,
  Boton,
  imagen,
} = Astro.props;

// Placeholders
const subtitlePlaceholder = "Topgolf Monterrey (7-24 Personas)";
const titlePlaceholder = "¿Que Incluye?";
const descriptionPlaceholder = `<p>Nuestros paquetes de fiesta lo hacen todo más fácil. Sin trabajo, sin estrés y sin desorden. Reserva en línea o solicita más información a nuestros organizadores de eventos, ¡y ven a celebrar!</p>`;
const benefitsPlaceholder = [
  { texto: "Palomitas de bienvenida (1 x persona)" },
  { texto: "Refresco refill (1 x persona)" },
  { texto: "Hamburguesa Jr (1 platillo x persona)" },
  { texto: "1 Pastel para el festejado (1 x festejado)" },
  { texto: "2 Dedos de Pollo (1 platillo x persona)" },
  { texto: "Adorno con globos (1 x bahía)" },
  { texto: "Tater Tots (1 platillo x persona)" },
  {
    texto: "Membresía lifetime para todos los invitados (con valor de $99 c/u)",
  },
];
const imagePlaceholder =
  "https://images.unsplash.com/photo-1594212699903-ec8a3eca50f5?ixlib=rb-4.0.3&auto=format&fit=crop&w=1000&q=80";

const componentButtons: Boton[] = (Boton && !Array.isArray(Boton)
  ? [Boton]
  : Boton) || [
  {
    id: 1,
    texto: "Reserva Aquí",
    url: "#",
    tipo: "version_1",
  },
  {
    id: 2,
    texto: "Ver Detalles",
    url: "#",
    tipo: "version_1",
  },
];

const descriptionHtml =
  stringifyRichText(descripcion) || descriptionPlaceholder;
const texto_finalHtml = stringifyRichText(texto_final); // Placeholder en template

const beneficios =
  lista_beneficios && lista_beneficios.length > 0
    ? lista_beneficios
    : benefitsPlaceholder;

const imageUrl = imagen?.data?.attributes?.url || imagePlaceholder;
---

<section
  class="w-full flex items-center justify-center min-h-screen p-4 font-(family-name:--font-shields-sans-regular)"
>
  <!-- Contenedor Principal de la Tarjeta -->
  <div
    class="bg-slate-50 rounded-3xl overflow-hidden shadow-xl max-w-6xl w-full flex flex-col lg:flex-row min-h-[600px]"
  >
    <!-- Columna Izquierda: Contenido -->
    <div
      class="w-full lg:w-1/2 p-8 md:p-12 flex flex-col justify-center relative bg-[var(--neutral-background-subtle)]"
    >
      <!-- Subtítulo Superior -->
      <h3
        class="text-[var(--brand-interactive-base)] font-bold tracking-tight text-sm md:text-base uppercase mb-2 font-(family-name:--font-shields-sans-bold)"
      >
        {subtitulo_superior || subtitlePlaceholder}
      </h3>

      <!-- Título Principal con fondo azul oscuro -->
      <div
        class="self-start bg-[var(--surface-brand-primary)] text-[var(--accent-highlight-primary)] px-4 py-2 mb-6 shadow-sm"
      >
        <h1
          class="text-3xl md:text-4xl font-black uppercase tracking-wider font-(family-name:--font-shields-sans-semibold-condensed)"
        >
          {titulo_principal || titlePlaceholder}
        </h1>
      </div>

      <!-- Texto descriptivo -->
      <div
        class="text-gray-600 mb-8 leading-relaxed text-sm md:text-base prose prose-sm max-w-none prose-p:my-2"
      >
        <div set:html={descriptionHtml} />
      </div>

      <!-- Lista de Beneficios (Grid de 2 columnas) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-y-3 gap-x-6 mb-10">
        {
          beneficios.map((item) => (
            <div class="flex items-start gap-2">
              <svg
                class="w-5 h-5 text-[#00aa55] flex-shrink-0 mt-0.5"
                fill="currentColor"
                viewBox="0 0 20 20"
              >
                <path
                  fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"
                />
              </svg>
              <span class="text-gray-700 text-sm font-medium">
                {item.texto || item}
              </span>
            </div>
          ))
        }
      </div>

      <!-- Botones de Acción -->
      <div class="flex flex-col sm:flex-row gap-4 items-center mb-6">
        <ButtonGroup botones={componentButtons} />
      </div>

      <!-- Nota al pie -->
      <div class="text-xs text-gray-400">
        <div
          set:html={texto_finalHtml ||
            "Precio incluye IVA y cargo por servicio."}
        />
      </div>
    </div>

    <!-- Columna Derecha: Imagen -->
    <div
      class="w-full lg:w-1/2 bg-[#00bfff] relative h-64 lg:h-auto overflow-hidden"
    >
      <!-- Imagen -->
      <img
        src={imageUrl}
        alt="Promo Image"
        class="absolute inset-0 w-full h-full object-cover object-center"
      />
      <!-- Overlay opcional -->
      <div
        class="absolute inset-0 bg-gradient-to-l from-transparent to-black/5 pointer-events-none"
      >
      </div>
    </div>
  </div>
</section>

<style>
  /* Estilos específicos si son necesarios, pero estamos usando Tailwind directo como se solicitó */
</style>
