---
// src/components/Component_21.astro

// Datos para las tarjetas de promoción.
// Es fácil añadir, quitar o modificar promociones aquí.
// NOTA: Las rutas de las imágenes son placeholders. Debes reemplazarlas con tus propias imágenes.
const placeholderImageUrl = "https://placehold.co/600x400/2d3748/ffffff?text=Promoción";

const promotionsData = [
    {
        title: "JUEGA GRATIS TODO LO QUE QUIERAS",
        description: "Consume $650 por persona en alimentos y bebidas, y nosotros te regalamos el juego.",
        imgSrc: "",
        altText: "Personas jugando en Topgolf.",
        href: "#"
    },
    {
        title: "LOS LUNES YA NO VAN A SER LO MISMO",
        description: "Los lunes vas a poder venir a jugar por solo $300 la hora, ahora sí, ¡no nos llames nosotros!",
        imgSrc: "",
        altText: "Mujer sonriendo en un campo de golf.",
        href: "#"
    },
    {
        title: "JUEVES A SÁBADO DE TOPGOLF NIGHT",
        description: "Alarga hasta el cierre por $1,000. Jueves a partir de las 10:00 p.m. Viernes a Sábado a partir de las 11:00 p.m.",
        imgSrc: "",
        altText: "Dos personas celebrando en Topgolf.",
        href: "#"
    },
    {
        title: "APROVECHA LA 3RA HORA GRATIS",
        description: "Reservas 2 horas de juego y obtén la 3ra hora ¡completamente gratis! ¿Te lo vas a perder?",
        imgSrc: "",
        altText: "Promoción de 3 horas de juego gratis.",
        href: "#"
    },
    {
        title: "THE TOPGOLF BIRTHDAY EXPERIENCE",
        description: "Te queremos regalar la mejor experiencia de cumpleaños, para que la pases de lo lindo, más age a pro-ish.",
        imgSrc: "",
        altText: "Grupo de amigos en Topgolf.",
        href: "#"
    },
    {
        title: "2X1 EN LOS FAVORITOS DE TOPGOLF",
        description: "¡Aprovecha los favoritos de Topgolf al 2x1! Martes a Jueves y Domingo en platillos. Viernes y Domingo en bebidas.",
        imgSrc: "",
        altText: "Promoción de 2x1 en Topgolf.",
        href: "#"
    },
    {
        title: "LA TARJETA MÁS DIVERTIDA DE TOPGOLF",
        description: "Haz que tu juego sea más divertido, 10% adicional exclusivamente comprando en línea.",
        imgSrc: "",
        altText: "Mano sosteniendo una tarjeta de Topgolf.",
        href: "#"
    },
];
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <p class="text-left text-sm font-bold text-[var(--brand-interactive-base)] mb-2 mt-4 uppercase tracking-wider">
        LA DIVERSIÓN SIGUE EN TOPGOLF MONTERREY
        </p>
        <h2 class="text-center text-3xl md:text-5xl font-bold text-[var(--neutral-background-strong)]  mb-10 md:mb-16">
        CONOCE NUESTRAS PROMOCIONES
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {promotionsData.map(promo => (
            <a href={promo.href} class="group flex flex-col bg-[var(--neutral-background-subtle)] shadow-md hover:shadow-xl transition-all duration-300 ease-in-out overflow-hidden">

            <div class="overflow-hidden">
                <img
                src={promo.imgSrc || placeholderImageUrl}
                alt={promo.altText}
                class="w-full h-52 object-cover group-hover:scale-105 transition-transform duration-300 ease-in-out"
                />
            </div>

            <div class="p-6 flex-grow flex justify-between items-start">
                <div class="flex-1 pr-4">
                <h3 class="text-[26px] leading-tight text-[var(--brand-interactive-base)]">
                    {promo.title}
                </h3>
                <p class="mt-3 text-base text-[var(--neutral-background-strong)]">
                    {promo.description}
                </p>
                </div>

                <div class="flex-shrink-0 pt-1">
                    <i class="fa-solid fa-chevron-right text-2xl text-[var(--feedback-positive-base)]"></i>
                </div>
            </div>

            </a>
        ))}
        </div>

    </div>
</section>