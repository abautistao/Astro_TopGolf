---
// src/components/errors/404.astro
import { Image } from "astro:assets";

// Asegúrate de importar tu imagen aquí.
import bgImage from "../../assets/background-404.png";
---

<section class="relative w-full min-h-[550px] md:min-h-[650px] flex items-center justify-center overflow-hidden font-sans text-[var(--neutral-text-inverted)]">
    <div class="absolute inset-0 w-full h-full z-0">
        <Image
        src={bgImage}
        alt="Fondo de estadio"
        class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-slate-600/80 mix-blend-multiply"></div>
    </div>

    <div class="relative z-10 container mx-auto px-4 text-center flex flex-col items-center justify-center h-full" style="font-family: var(--font-shields-sans-regular);">

        <h1 class="text-[230px] md:text-[350px] font-semibold leading-none tracking-tighter select-none">
        404
        </h1>

        <h2 class="font-semibold text-[36px] md:text-[96px] uppercase tracking-tight mb-4 mt-[-1rem] md:mt-[-2rem]">
        Página no encontrada
        </h2>

        <p class="text-[var(--neutral-text-inverted)] text-sm md:text-lg mx-auto mb-10 font-normal whitespace-nowrap">
            Parece que fallaste el objetivo. Usa los botones de abajo para volver a anotar.
        </p>

        <a
            href="/"
            class="font-bold inline-block px-8 py-3 border border-[var(--neutral-text-inverted)] rounded-full text-[var(--neutral-text-inverted)] text-xs md:text-sm  uppercase transition-all hover:scale-105"
        >
        Regresar al Home
        </a>
    </div>
</section>