---
// src/components/errors/Generic_404.astro
const { lang } = Astro.props;

const i18n = {
    en: {
        title: "Page Not Found",
        desc: "Sorry, we couldn't find the page you're looking for.",
        btn: "Go Home",
        link: "/en",
    },
    es: {
        title: "Página no encontrada",
        desc: "Lo sentimos, no pudimos encontrar la página que buscas.",
        btn: "Ir al Inicio",
        link: "/es", // or "/"
    },
};

const currentLang = lang || "es";
const t = i18n[currentLang] || i18n.es;
---

<section
    class="flex items-center justify-center min-h-[60vh] px-6 py-24 bg-gray-50 text-gray-900"
>
    <div class="text-center max-w-lg">
        <h1 class="text-9xl font-bold text-gray-200 mb-4">404</h1>
        <h2 class="text-3xl font-semibold mb-4">{t.title}</h2>
        <p class="text-gray-600 mb-8">{t.desc}</p>
        <a
            href={t.link}
            class="inline-block px-6 py-3 bg-black text-white rounded-md hover:bg-gray-800 transition-colors duration-300 font-medium"
        >
            {t.btn}
        </a>
    </div>
</section>
