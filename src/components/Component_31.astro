---
// src/components/Component_31.astro
import dotsPattern from '../assets/Artwork_bg.png';
import dotsPatternMobile from '../assets/Artwork_1.png';
---

<section class="relative bg-[var(--neutral-text-inverted)] py-16 sm:py-24">
    <div class="mx-auto">
        <div class="relative z-10 mx-4 overflow-hidden bg-[var(--surface-brand-primary)] px-6 py-20 shadow-xl sm:mx-0  sm:px-16 sm:py-28">
            <div class="mx-auto flex max-w-2xl flex-col items-center text-center">
                <h2 class="text-2xl font-bold uppercase tracking-tight text-[var(--accent-highlight-secondary)] sm:text-4xl">
                    MEMBRESÍA PLATINUM
                </h2>

                <p class="mt-6 text-md leading-8 text-[var(--neutral-text-inverted)]">
                    Si tu plan es traer a amigos o familia, o simplemente venir a jugar y practicar tu swing varias veces por semana, entonces esta membresía es para ti.
                </p>
                <p class="mt-2 text-md leading-8 text-[var(--neutral-text-inverted)]">
                    Conoce aquí los beneficios que tenemos:
                </p>

                <div class="mt-10">
                    <a href="#" class="rounded-full bg-[var(--neutral-text-inverted)] px-12 py-3.5 text-base font-semibold text-[var(--brand-interactive-base)]">
                        CONOCE MÁS
                    </a>
                </div>
            </div>
        </div>
        <img
            src={dotsPattern.src}
            width={dotsPattern.width}
            height={dotsPattern.height}
            alt="Patrón de puntos decorativo"
            class="absolute bottom-8 right-0 z-0 hidden h-auto w-auto sm:block"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
        />
        <img
            src={dotsPatternMobile.src}
            width={dotsPatternMobile.width}
            height={dotsPatternMobile.height}
            alt="Patrón de puntos decorativo"
            class="absolute bottom-33 right-0 z-0 block translate-y-1/2 sm:hidden"
            aria-hidden="true"
            loading="lazy"
            decoding="async"
        />
    </div>
</section>