---
// src/components/Component_2.astro
import { getStrapiUrl } from "../lib/strapi.js";
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

export interface Card {
  id: number;
  titulo: string;
  descripcion: string;
  etiqueta?: string;
  alt_imagen: string;
  imagen: any;
  Boton: Boton[]; // La tarjeta ahora espera recibir el componente Boton desde Strapi.
}

export interface Props {
  identificador: string;
  tarjetas: Card[];
}

const { identificador, tarjetas } = Astro.props;
const carouselId = identificador || "carousel-principal";

// El placeholder ahora también debe simular la nueva estructura del botón.
const placeholderCard: Card = {
  id: 0,
  titulo: "Título de Ejemplo",
  descripcion: "Esta es una descripción de ejemplo para la tarjeta.",
  alt_imagen: "Imagen de placeholder",
  imagen: { data: null },
  Boton: [{ // El placeholder ahora contiene un array de Boton
    id: 1,
    texto: "VER MÁS",
    url: "#",
    tipo: "version_1"
  }],
};

const cardsToRender = tarjetas && tarjetas.length > 0 ? tarjetas : [placeholderCard];
---

<section class="w-full py-12 font-sans bg-[var(--neutral-text-inverted)]">
  <div class="relative max-w-8xl mx-auto px-4 sm:px-6">
    <div
      id={carouselId}
      class="overflow-x-auto scroll-smooth pb-8 -mb-8 scrollbar-hide"
      data-total-cards={cardsToRender.length}
    >
      <div class="flex gap-6">
        {cardsToRender.map(card => {
          const imageUrl = getStrapiUrl(card.imagen);
          const placeholderImageUrl = `https://placehold.co/400x450/2d3748/ffffff?text=${encodeURIComponent(card.titulo)}`;

          const cardButtons: Boton[] = (card.Boton && !Array.isArray(card.Boton) ? [card.Boton] : card.Boton) || [
            { id: card.id, texto: "Ver Más", url: "#", tipo: "version_1" }
          ];

          return (
            <div class="carousel-card relative flex-shrink-0 w-80 md:w-96 h-[450px] rounded-lg overflow-hidden group text-white">
              <img
                src={imageUrl || placeholderImageUrl}
                alt={card.alt_imagen || "Imagen de la tarjeta"}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_0%_100%,_rgba(0,0,0,0.9)_0%,_rgba(0,0,0,0.6)_35%,_rgba(0,0,0,0)_70%)]"></div>
              <div class="relative z-10 flex flex-col justify-end h-full p-6">
                <h3 class="text-3xl font-bold  text-[var(--accent-highlight-primary)]" style="font-family: var(--font-shields-sans-semibold);">{card.titulo}</h3>
                <p class="mt-2 text-sm  text-[var(--neutral-text-inverted)]" style="font-family: var(font-shields-sans-regular);">{card.descripcion}</p>

                <div class="mt-8">
                  <ButtonGroup botones={cardButtons} />
                </div>

              </div>
              {card.etiqueta && (
                <div class="absolute top-4 left-4 bg-[var(--accent-feedback-strong)] text-[var(--surface-brand-primary)] text-xs font-bold px-3 py-1 rounded-md z-20" style="font-family: var(--font-shields-sans-semibold);">{card.etiqueta}</div>
              )}

            </div>
          )
        })}
      </div>
    </div>

    <div class="mt-8 flex justify-between items-center">
      <div class="flex gap-3">
        <button
          id={`prev-btn-${carouselId}`}
          class="w-10 h-10 bg-[var(--surface-brand-primary)] rounded-full flex items-center justify-center transition-colors disabled:opacity-50 text-[var(--accent-highlight-secondary)]
                focus-visible:ring-8 focus-visible:ring-[var(--accent-highlight-secondary)] focus-visible:ring-offset-4
                hover:bg-[var(--surface-brand-primary)]"
          aria-label="Anterior"
        >
          <i class="fa-solid fa-chevron-left fa-xl"></i>
        </button>

        <button
          id={`next-btn-${carouselId}`}
          class="w-10 h-10 bg-[var(--surface-brand-primary)] rounded-full flex items-center justify-center transition-colors text-[var(--accent-highlight-secondary)]
                focus-visible:ring-8 focus-visible:ring-[var(--accent-highlight-secondary)] focus-visible:ring-offset-4
                hover:bg-[var(--surface-brand-primary)]"
          aria-label="Siguiente"
        >
          <i class="fa-solid fa-chevron-right fa-xl"></i>
        </button>
      </div>

      <div class="hidden sm:flex items-center gap-2 text-sm">
        <i class="fa-solid fa-location-dot fa-lg text-[var(--brand-interactive-base)]"></i>
        <span class="text-[var(--neutral-background-strong)]">
          Estás viendo contenido de <strong>Topgolf Monterrey</strong>
        </span>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ carouselId }}>
  function setupCarousel(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const prevBtn = document.getElementById(`prev-btn-${containerId}`);
    const nextBtn = document.getElementById(`next-btn-${containerId}`);
    const cards = container.querySelectorAll('.carousel-card');
    const totalCards = parseInt(container.dataset.totalCards, 10);

    if (cards.length === 0 || !prevBtn || !nextBtn) return;

    let currentIndex = 0;

    const updateScrollDistance = () => {
      if (cards.length === 0) return 0;
      const cardWidth = cards[0].offsetWidth;
      const cardGap = parseInt(window.getComputedStyle(cards[0].parentElement).gap, 10) || 0;
      return cardWidth + cardGap;
    }

    let scrollDistance = updateScrollDistance();

    const updateButtons = () => {
      if (!container || !prevBtn || !nextBtn) return;
      prevBtn.disabled = currentIndex === 0;

      // Cálculo más robusto para deshabilitar el botón "siguiente"
      const containerWidth = container.clientWidth;
      const contentWidth = container.scrollWidth;
      const currentScroll = container.scrollLeft;

      nextBtn.disabled = currentScroll + containerWidth >= contentWidth - 10; // -10 para margen de error
    };

    const scrollToCurrent = () => {
        container.scrollTo({ left: currentIndex * scrollDistance, behavior: 'smooth' });
    };

    nextBtn.addEventListener('click', () => {
      const visibleCards = Math.floor(container.clientWidth / scrollDistance);
      const maxIndex = totalCards - visibleCards;
      if (currentIndex < maxIndex) {
        currentIndex++;
        scrollToCurrent();
      }
    });

    prevBtn.addEventListener('click', () => {
      if (currentIndex > 0) {
        currentIndex--;
        scrollToCurrent();
      }
    });

    // Escuchar el evento de scroll para actualizar los botones
    container.addEventListener('scroll', updateButtons, { passive: true });

    // Re-calcular en resize para responsividad
    window.addEventListener('resize', () => {
      scrollDistance = updateScrollDistance();
      updateButtons();
    });

    // Llamada inicial
    updateButtons();
  }

  // Inicializamos el carrusel específico de este componente
  document.addEventListener('astro:page-load', () => {
    // Usamos la variable carouselId que pasamos desde Astro
    setupCarousel(carouselId);
  });
  // Fallback para cuando no se usan View Transitions
  if (document.readyState === 'complete') {
    setupCarousel(carouselId);
  } else {
    document.addEventListener('DOMContentLoaded', () => {
       setupCarousel(carouselId);
    });
  }
</script>

<style is:global>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>