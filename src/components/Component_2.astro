---
// src/components/Component_2.astro
import { getStrapiUrl } from "../lib/strapi.js";
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

// --- CAMBIO 1: Actualizamos la interfaz de 'Card' ---
// Eliminamos 'texto_boton' y 'url_boton' y añadimos la relación al componente 'Boton'.
// Esto alinea la estructura con la que usas en Component_1.
export interface Card {
  id: number;
  titulo: string;
  descripcion: string;
  etiqueta?: string;
  alt_imagen: string;
  imagen: any;
  Boton: Boton[]; // La tarjeta ahora espera recibir el componente Boton desde Strapi.
}

export interface Props {
  identificador: string;
  tarjetas: Card[];
}

const { identificador, tarjetas } = Astro.props;
const carouselId = identificador || "carousel-principal";

// El placeholder ahora también debe simular la nueva estructura del botón.
const placeholderCard: Card = {
  id: 0,
  titulo: "Título de Ejemplo",
  descripcion: "Esta es una descripción de ejemplo para la tarjeta.",
  alt_imagen: "Imagen de placeholder",
  imagen: { data: null },
  Boton: [{ // El placeholder ahora contiene un array de Boton
    id: 1,
    texto: "VER MÁS",
    url: "#",
    tipo: "version_1"
  }],
};

const cardsToRender = tarjetas && tarjetas.length > 0 ? tarjetas : [placeholderCard];
---

<section class="w-full py-12 font-sans bg-[var(--neutral-text-inverted)]">
  <div class="relative max-w-8xl mx-auto px-4 sm:px-6">
    <div
      id={carouselId}
      class="overflow-x-auto scroll-smooth pb-8 -mb-8 scrollbar-hide"
      data-total-cards={cardsToRender.length}
    >
      <div class="flex gap-6">
        {cardsToRender.map(card => {
          const imageUrl = getStrapiUrl(card.imagen);
          const placeholderImageUrl = `https://placehold.co/400x450/2d3748/ffffff?text=${encodeURIComponent(card.titulo)}`;

          const cardButtons: Boton[] = (card.Boton && !Array.isArray(card.Boton) ? [card.Boton] : card.Boton) || [
            { id: card.id, texto: "Ver Más", url: "#", tipo: "version_1" }
          ];

          return (
            <div class="carousel-card relative flex-shrink-0 w-80 md:w-96 h-[450px] rounded-lg overflow-hidden group text-white">
              <img
                src={imageUrl || placeholderImageUrl}
                alt={card.alt_imagen || "Imagen de la tarjeta"}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-[radial-gradient(circle_at_0%_100%,_rgba(0,0,0,0.9)_0%,_rgba(0,0,0,0.6)_35%,_rgba(0,0,0,0)_70%)]"></div>
              <div class="relative z-10 flex flex-col justify-end h-full p-6">
                <h3 class="text-3xl font-bold  text-[var(--accent-highlight-primary)]">{card.titulo}</h3>
                <p class="mt-2 text-sm  text-[var(--neutral-text-inverted)]">{card.descripcion}</p>

                <div class="mt-8">
                  <ButtonGroup botones={cardButtons} />
                </div>

              </div>
              {card.etiqueta && (
                <div class="absolute top-4 left-4 bg-[var(--accent-feedback-strong)] text-[var(--surface-brand-primary)] text-xs font-bold px-3 py-1 rounded-md z-20">{card.etiqueta}</div>
              )}

            </div>
          )
        })}
      </div>
    </div>

    {/* El resto del componente permanece igual */}
    <div class="mt-8 flex justify-between items-center">
      {/* ... */}
    </div>
  </div>
</section>

<script define:vars={{ carouselId }}>
  // El script no necesita cambios
</script>

<style is:global>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
</style>