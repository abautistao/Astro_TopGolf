---
// src/components/Component_5.astro
// Importa tus imágenes desde la carpeta de assets
import partyImage from '../assets/2c8481df4c822d9c15e21537c3ededbbc9a6e81f.png';
import dotsPattern from '../assets/Artwork.png';
import dotsPatternMobile from '../assets/Artwork_1.png';
---

<section class="relative overflow-x-hidden py-16 sm:py-24">
    <div class="relative max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8">
        <img
        src={dotsPattern.src}
        alt="Patrón de puntos decorativo"
        class="absolute top-0 right-0 transform -translate-y-1/4 translate-x-1/4 z-0 hidden lg:block"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
        />

        <div class="relative lg:flex lg:items-center lg:justify-end lg:min-h-[500px]">
            <div class="lg:absolute lg:top-0 lg:left-0 lg:w-4/5 lg:h-full">
                <img
                src={partyImage.src}
                alt="Grupo de amigos disfrutando de un evento en Topgolf"
                class="w-full h-full object-cover rounded-lg shadow-xl"
                loading="lazy"
                decoding="async"
                width="760"
                height="500"
                />
            </div>
            <div class="mt-8 lg:mt-0 relative z-10 w-full lg:w-1/2 bg-blue-900 p-8 md:p-12 text-white rounded-lg shadow-2xl">

                <h2 class="text-4xl lg:text-5xl font-bold tracking-tight uppercase">
                Haz tu evento <span class="block text-cyan-300">Memorable</span>
                </h2>

                <p class="mt-6 text-lg text-gray-200">
                En días soleados, de lluvia; de día o de noche, haz que tu próxima fiesta o evento grupal sea más animado en Topgolf. Somos la fusión perfecta de diversión, comida y servicio perfectos para tu próximo cumpleaños, evento de empresa, recaudación de fondos o reunión social.
                </p>

                <div class="mt-8">
                    <a href="#" class="inline-block bg-white text-blue-950 font-bold uppercase tracking-wider py-3 px-8 rounded-full transition-transform duration-300 hover:scale-105">
                        Fiestas y Eventos
                    </a>
                </div>

                <img
                src={dotsPatternMobile.src}
                alt="Patrón decorativo móvil"
                class="absolute bottom-0 right-0 transform translate-x-1/4 translate-y-1/4 w-24 h-24 lg:hidden"
                aria-hidden="true"
                />
            </div>
        </div>
    </div>
</section>