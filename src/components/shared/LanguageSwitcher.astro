---
const { class: className, alternateLinks = {} } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = Astro.params.lang || "en";

// Environment Check
const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const locales = [
    { code: "es", label: "Español" },
    { code: "en", label: "English" },
];

function getLocalizedPath(targetLang) {
    if (alternateLinks[targetLang]) {
        return alternateLinks[targetLang];
    }

    const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
    const segments = currentPath.split("/").filter(Boolean);
    
    if (segments.length > 0 && (segments[0] === "es" || segments[0] === "en")) {
        segments[0] = targetLang;
    } else {
        segments.unshift(targetLang);
    }
    
    // Drop prefix if target language is default locale
    if (segments[0] === defaultLocale) {
        segments.shift();
    }
    
    return "/" + segments.join("/");
}
---

{
    isMultiLanguage && (
        <div class={`language-switcher flex flex-col gap-2 ${className}`}>
            {locales.map((locale) => {
                const flagUrl =
                    locale.code === "es"
                        ? "https://flagcdn.com/w40/mx.png" // Spanish -> Mexico Flag
                        : "https://flagcdn.com/w40/us.png"; // English -> USA Flag

                return (
                    <a
                        href={getLocalizedPath(locale.code)}
                        class={`flex items-center gap-2 px-2 py-1 ${currentLang === locale.code ? "font-bold bg-gray-100 rounded" : "opacity-70 hover:opacity-100"}`}
                    >
                        <img
                            src={flagUrl}
                            alt={locale.label}
                            class="w-5 h-auto rounded-sm border border-gray-300"
                        />
                        <span class="text-xs uppercase">{locale.code}</span>
                    </a>
                );
            })}
        </div>
    )
}
