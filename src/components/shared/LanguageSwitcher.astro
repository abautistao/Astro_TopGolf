---
const { class: className, alternateLinks = {} } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = Astro.params.lang || "en";

const locales = [
    { code: "es", label: "Español" },
    { code: "en", label: "English" },
];

function getLocalizedPath(targetLang) {
    // 1. Check if we have an explicit alternate link for this language
    // console.log('LanguageSwitcher target:', targetLang, 'Alternates:', alternateLinks);
    if (alternateLinks[targetLang]) {
        return alternateLinks[targetLang];
    }

    // 2. Fallback: Replace the first path segment
    const segments = currentPath.split("/").filter(Boolean);
    if (segments.length > 0 && (segments[0] === "es" || segments[0] === "en")) {
        segments[0] = targetLang;
    } else {
        segments.unshift(targetLang);
    }
    return "/" + segments.join("/");
}
---

<div class={`language-switcher ${className}`}>
    {
        locales.map((locale) => (
            <a
                href={getLocalizedPath(locale.code)}
                class={`px-2 py-1 ${currentLang === locale.code ? "font-bold underline" : "opacity-70 hover:opacity-100"}`}
            >
                {locale.code.toUpperCase()}
            </a>
        ))
    }
</div>
