---
// src/components/shared/Icono.astro
import { icon as getIconData } from '@fortawesome/fontawesome-svg-core';

// Importamos los iconos gratuitos (Solid y Brands)
import * as solidIcons from '@fortawesome/free-solid-svg-icons';
import * as brandIcons from '@fortawesome/free-brands-svg-icons';

export interface Props {
  name: string;
  pack?: 'solid' | 'brands'; // Cambiamos los packs disponibles a los gratuitos
  class?: string;
}

const { name, pack = 'solid', class: className } = Astro.props;

// Combinamos los diccionarios de iconos según el pack
const allIcons = pack === 'brands' ? brandIcons : solidIcons;

// Convierte 'golf-ball' -> 'GolfBall'
const camelCaseName = name
  .split('-')
  .map(part => part.charAt(0).toUpperCase() + part.slice(1))
  .join('');

// En la versión gratuita, el export es simplemente 'fa' + 'Nombre' (ej: faGolfBall)
const iconExportName = `fa${camelCaseName}`;

const iconObject = allIcons[iconExportName];
let iconHtml = '';

if (iconObject) {
  const iconData = getIconData(iconObject, { classes: className });
  // FontAwesome devuelve un array de strings en .html, tomamos el primero
  iconHtml = Array.isArray(iconData.html) ? iconData.html[0] : iconData.html;
} else {
  console.warn(`[Icono.astro] Icono "${name}" no encontrado en pack "${pack}".`);
  
  // Fallback al icono de pregunta (si existe en el pack solid)
  const fallback = solidIcons['faQuestion'];
  if (fallback) {
    const fallbackData = getIconData(fallback, { classes: className });
    iconHtml = Array.isArray(fallbackData.html) ? fallbackData.html[0] : fallbackData.html;
  }
}
---
<Fragment set:html={iconHtml} />