---
interface Props {
    codigo: string;
    url_seven_rooms: string;
}

const { codigo, url_seven_rooms} = Astro.props;
const partySize = Astro.url.searchParams.get('party_size') || 1;
const date = Astro.url.searchParams.get('date');
const time = Astro.url.searchParams.get('time') || 1;
let sevenRoomsUrl = url_seven_rooms 

if(url_seven_rooms.includes('client_id')) {
    sevenRoomsUrl += '&party_size='  + partySize
}else {
    sevenRoomsUrl += '?party_size='  + partySize
}

if(date) {
    sevenRoomsUrl += '&date=' + date
}

if(time) {
    sevenRoomsUrl += '&start_time=' + time
}

console.log(sevenRoomsUrl)
---

<div class="w-full iframe-container">
    <iframe 
       src={sevenRoomsUrl}
        allow="geolocation; microphone; camera"
        title="SevenRooms Reservation">
    </iframe>
</div>

<style>
    .iframe-container :global(iframe) {
        width: 100%;
        height: 100vh;
        border: none;
        display: block;
    }
</style>
