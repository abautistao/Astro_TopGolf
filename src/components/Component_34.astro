---
// src/components/Component_34.astro
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";

export interface Props {
    tag: string;
    headline: string;
}

const {
    tag,
    headline,
} = Astro.props;
---

<section class="w-full text-[var(--neutral-text-inverted)] bg-custom-gradient">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 py-12 sm:py-16">
        <div class="text-left">
            <span class="font-(family-name:--font-shields-sans-regular) inline-block bg-[var(--accent-highlight-secondary)] text-[var(--surface-brand-primary)] text-xs font-bold tracking-wider uppercase px-3 py-1 rounded">
                {tag || "TOPGOLF MONTERREY"}
            </span>
            <h1 class="font-(family-name:--font-shields-sans-condensed) text-4xl md:text-7xl font-bold uppercase mt-4 leading-tight whitespace-nowrap ">
                {headline || "PREGUNTAS FRECUENTES"}
            </h1>
        </div>
    </div>
</section>
