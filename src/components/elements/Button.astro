---
import { formatUrl } from '../../lib/strapi';
export interface Boton {
    id: number;
    texto: string;
    url: string;
    tipo: 'version_1' | 'version_2'| 'version_3'| 'version_4'| 'version_5'| 'version_6';
}

export interface Props {
    botones: Boton[];
    clase?: string;
}

const {
    botones,
    clase = "w-full flex flex-col items-center gap-4 sm:w-auto sm:flex-row"
} = Astro.props;
---

<div class={clase}>
    {botones.map(boton => (
        <a
            href={formatUrl(boton.url)}
            class:list={[
                'transform rounded-full font-bold uppercase transition-all hover:scale-105 font-(family-name:--font-shields-sans-bold)',
                'w-[60%] sm:w-auto',
                'px-4 py-3 sm:px-8 sm:py-3',
                'text-center flex justify-center items-center text-sm sm:text-base',

                {
                    'bg-[var(--neutral-text-inverted)] text-[var(--surface-brand-primary)] shadow-lg': boton.tipo === 'version_1',
                    'border-2 border-[var(--accent-highlight-secondary)] text-[var(--accent-highlight-secondary)]': boton.tipo === 'version_2',
                    'bg-[var(--brand-interactive-base)] text-[var(--neutral-text-inverted)]': boton.tipo === 'version_3',
                    'bg-[var(--surface-brand-primary)] text-[var(--accent-highlight-secondary)]': boton.tipo === 'version_4',
                    'border-2 border-[var(--brand-interactive-base)] text-[var(--brand-interactive-base)]':  boton.tipo === 'version_5',
                    'border-2 border-[var(--neutral-text-inverted)] text-[var(--neutral-text-inverted)]':  boton.tipo === 'version_6',
                }
            ]}
            set:html={boton.texto}
        >
        </a>
    ))}
</div>