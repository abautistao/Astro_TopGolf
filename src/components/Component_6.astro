---
// src/components/Component_6.astro

// --- 1. IMPORTACIÓN DE IMÁGENES ---
// Asegúrate de que las rutas a tus imágenes sean correctas.
import mainImage from '../assets/top_golf_bg.jpg';
import dotsPattern from '../assets/Artwork.png';

// --- 2. DEFINICIÓN DE PROPS ---
// Agregamos props para el botón y el texto secundario para mayor flexibilidad.
const {
    title = "PLANEA TU VISITA",
    location = "TOPGOLF MONTERREY",
    buttonText = "RESERVA AQUÍ TU BAHÍA"
} = Astro.props;
---

<section class="relative bg-white font-sans">
    <div class="max-w-7xl mx-auto lg:grid lg:grid-cols-2">
        <div class="relative z-10 flex flex-col justify-center py-12 px-6 sm:px-10 lg:py-24">

        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-800 uppercase tracking-tight mb-4">
            {title}
        </h1>

        <p class="text-lg text-slate-600 max-w-2xl mb-8 leading-relaxed">
            Ya sea para reservar una bahía, una fiesta o simplemente visitarnos,
            te facilitamos la reunión con tu equipo. ¿No encuentras lo que necesitas?
            <a href="#" class="text-cyan-500 font-semibold underline underline-offset-2 decoration-cyan-500/50 hover:text-cyan-600 transition-colors">
            ¡Contáctanos!
            </a>
        </p>

        <div class="flex items-center gap-2 mb-8">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6 text-blue-700">
            <path fill-rule="evenodd" d="M12 2.25c-5.185 0-9.375 4.19-9.375 9.375 0 2.33.866 4.49 2.375 6.25a18.736 18.736 0 005.625 4.375c.497.307 1.135.307 1.632 0 2.25-1.383 4.25-3.075 5.625-4.375 1.509-1.76 2.375-3.92 2.375-6.25C21.375 6.44 17.185 2.25 12 2.25zm1.5 6a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" clip-rule="evenodd" />
            </svg>
            <span class="text-sm font-bold text-blue-700 uppercase tracking-wider">
            {location}
            </span>
        </div>

        <div class="mt-4">
            <a href="#" class="inline-block bg-blue-900 text-white uppercase font-bold text-sm tracking-widest px-8 py-3 rounded-full hover:bg-blue-800 transition-colors duration-300">
            {buttonText}
            </a>
        </div>

        <p class="mt-8 text-sm text-slate-500">
            ¿Necesitas ayuda? <a href="#" class="text-cyan-500 hover:underline">Consulta nuestras preguntas frecuentes</a>
        </p>

        <img
            src={dotsPattern.src}
            alt="Patrón decorativo"
            class="hidden lg:block absolute bottom-0 left-0 -translate-x-1/4 translate-y-1/4 w-40 h-auto z-0"
            aria-hidden="true"
        />
        </div>

        <div class="hidden lg:block relative">
        <img
            src={mainImage.src}
            alt="Jugador de Topgolf en acción"
            class="absolute inset-0 w-full h-full object-cover"
        />
        </div>

    </div>
</section>