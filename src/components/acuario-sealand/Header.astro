---
import {
    getHeaderData,
    getStrapiUrl,
    getLocalizedUrl,
} from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "../dolphinaris/elements/Button.astro";
import type { Boton } from "../dolphinaris/elements/Button.astro";

interface Props {
    data?: any;
    locale?: string;
    alternateLinks?: Record<string, string>;
}

const { data, locale = "es", alternateLinks = {} } = Astro.props;
const headerData = data || (await getHeaderData());

const logoUrl = getStrapiUrl(headerData?.logo);
const logoMobileUrl = getStrapiUrl(headerData?.logo_mobile) || logoUrl;

const links = headerData?.links || [];
const social = headerData?.social || [];
const textoHorario = headerData?.texto_horario || "";

const ctaButtonRaw = headerData?.Boton;
let buttons: Boton[] = [];

if (ctaButtonRaw) {
    const ctaButtonLocalized = {
        ...ctaButtonRaw,
        url: getLocalizedUrl(ctaButtonRaw.url, locale)
    };
    buttons = [ctaButtonLocalized];
}
---

<header class="w-full relative z-50">
    <!-- Desktop Top Bar -->
    <div class="hidden md:flex w-full h-12">
        <div class="flex-grow bg-[var(--accent-highlight-primary)] flex items-center justify-between px-8">
            <!-- Social Icons -->
            <div class="flex items-center gap-4 text-white">
                {social.map((item: any) => (
                    <a href={item.url} target="_blank" rel="noopener noreferrer" class="hover:opacity-80 transition-opacity">
                        <i class={`${item.icono_clase} text-xl`}></i>
                    </a>
                ))}
            </div>
            <!-- Horario / Text -->
            <div class="text-white text-sm font-[family-name:var(--font-secundaria)] font-medium">
                {textoHorario}
            </div>
        </div>
        <!-- Right Yellow Button Section -->
        {buttons.length > 0 && (
            <div class="bg-[var(--brand-interactive-base)] flex items-center justify-center px-10 h-full cursor-pointer hover:brightness-110 transition-all">
                <a href={buttons[0].url} class="text-[var(--neutral-background-strong)] font-[family-name:var(--font-principal)] font-bold text-lg uppercase">
                    {buttons[0].texto}
                </a>
            </div>
        )}
    </div>

    <!-- Main Navigation Bar -->
    <div class="bg-[var(--surface-brand-primary)] border-b-4 md:border-b-0 border-[var(--brand-interactive-base)]">
        <div class="max-w-[1440px] mx-auto px-4 md:px-8 h-20 md:h-24 flex items-center justify-between">
            <!-- Logo -->
            <a href="/" class="shrink-0 h-full py-2">
                <!-- Desktop Logo -->
                {logoUrl && (
                    <Image
                        src={logoUrl}
                        alt="Acuario Sealand"
                        width={250}
                        height={100}
                        class="hidden md:block h-full w-auto object-contain"
                    />
                )}
                <!-- Mobile Logo -->
                {logoMobileUrl && (
                    <Image
                        src={logoMobileUrl}
                        alt="Acuario Sealand Mobile"
                        width={200}
                        height={80}
                        class="block md:hidden h-full w-auto object-contain py-1"
                    />
                )}
            </a>

            <!-- Desktop Links -->
            <nav class="hidden md:flex items-center gap-8 h-full">
                {links.map((link: any) => (
                    <div class="relative group h-full flex items-center">
                        <a
                            href={link.url ? getLocalizedUrl(link.url, locale) : '#'}
                            class="flex items-center gap-2 text-white font-[family-name:var(--font-principal)] text-sm tracking-wide uppercase hover:text-[var(--accent-highlight-primary)] transition-colors"
                        >
                            {link.texto}
                            {link.sublinks && link.sublinks.length > 0 && (
                                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300 group-hover:rotate-180"></i>
                            )}
                        </a>
                        
                        <!-- Dropdown -->
                        {link.sublinks && link.sublinks.length > 0 && (
                            <div class="absolute top-full left-0 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 w-max min-w-[240px] bg-[var(--surface-brand-primary)] border-t-4 border-[var(--accent-highlight-primary)] shadow-2xl z-50">
                                <ul class="flex flex-col py-2">
                                    {link.sublinks.map((sublink: any) => (
                                        <li>
                                            <a
                                                href={getLocalizedUrl(sublink.url, locale)}
                                                class="block px-6 py-3 text-white font-[family-name:var(--font-secundaria)] text-sm hover:bg-[var(--accent-highlight-primary)] transition-colors"
                                            >
                                                {sublink.texto}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                ))}
            </nav>

            <!-- Mobile Info & Hamburger -->
            <div class="flex md:hidden items-center gap-4">
                <span class="text-white text-xs font-[family-name:var(--font-secundaria)]">
                    {textoHorario.split('/')[1]?.trim() || textoHorario} <!-- Shorten for mobile if contains / -->
                </span>
                <button id="mobile-menu-toggle" class="text-white text-3xl focus:outline-none">
                    <i class="fa-solid fa-bars" id="menu-icon"></i>
                    <i class="fa-solid fa-xmark hidden" id="close-icon"></i>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Overlay Menu (Placeholder for future expansion) -->
<div id="mobile-menu" class="hidden md:hidden fixed inset-0 top-[84px] bg-[var(--surface-brand-primary)] z-40 px-6 py-8 overflow-y-auto">
    <nav class="flex flex-col gap-6">
        {links.map((link: any, index: number) => (
            <div class="border-b border-white/10 pb-4">
                <div class="flex items-center justify-between">
                    <a href={link.url ? getLocalizedUrl(link.url, locale) : '#'} class="text-white font-[family-name:var(--font-principal)] text-lg uppercase font-bold">
                        {link.texto}
                    </a>
                    {link.sublinks && link.sublinks.length > 0 && (
                        <button class="text-white p-2 mobile-submenu-toggle focus:outline-none" data-target={`submenu-${index}`}>
                            <i class="fa-solid fa-chevron-down transition-transform duration-300"></i>
                        </button>
                    )}
                </div>
                {link.sublinks && link.sublinks.length > 0 && (
                    <div id={`submenu-${index}`} class="hidden flex-col pl-4 pt-4 gap-3">
                        {link.sublinks.map((sublink: any) => (
                            <a href={getLocalizedUrl(sublink.url, locale)} class="text-white/80 font-[family-name:var(--font-secundaria)] text-base hover:text-white transition-colors">
                                {sublink.texto}
                            </a>
                        ))}
                    </div>
                )}
            </div>
        ))}
        {buttons.length > 0 && (
            <div class="pt-4">
                <a href={buttons[0].url} class="block w-full text-center bg-[var(--brand-interactive-base)] text-[var(--neutral-background-strong)] font-[family-name:var(--font-principal)] font-bold text-lg py-4 rounded-md uppercase">
                    {buttons[0].texto}
                </a>
            </div>
        )}
    </nav>
</div>

<script>
    const toggle = document.getElementById("mobile-menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const menuIcon = document.getElementById("menu-icon");
    const closeIcon = document.getElementById("close-icon");

    toggle?.addEventListener("click", () => {
        const isHidden = menu?.classList.contains("hidden");
        if (isHidden) {
            menu?.classList.remove("hidden");
            menuIcon?.classList.add("hidden");
            closeIcon?.classList.remove("hidden");
            document.body.style.overflow = "hidden";
        } else {
            menu?.classList.add("hidden");
            menuIcon?.classList.remove("hidden");
            closeIcon?.classList.add("hidden");
            document.body.style.overflow = "";
        }
    });

    // Mobile submenu toggles
    const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
    submenuToggles.forEach(toggle => {
        toggle.addEventListener('click', (e) => {
            const btn = e.currentTarget as HTMLButtonElement;
            const targetId = btn.getAttribute('data-target');
            if (targetId) {
                const submenu = document.getElementById(targetId);
                const icon = btn.querySelector('i');
                if (submenu?.classList.contains('hidden')) {
                    submenu.classList.remove('hidden');
                    submenu.classList.add('flex');
                    if (icon) icon.style.transform = 'rotate(180deg)';
                } else {
                    submenu?.classList.add('hidden');
                    submenu?.classList.remove('flex');
                    if (icon) icon.style.transform = 'rotate(0deg)';
                }
            }
        });
    });
</script>
