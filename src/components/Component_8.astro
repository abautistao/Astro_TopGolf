---
// src/components/Component_8.astro
import { getStrapiUrl } from "../lib/strapi.js"; // Asegúrate que la ruta es correcta

import exampleImage from "../assets/2c8481df4c822d9c15e21537c3ededbbc9a6e81f.png";

// Definimos la estructura de los datos que el componente espera recibir.
export interface Card {
    label: string;
    image: any; // El tipo de imagen de Strapi o un objeto de imagen de Astro
    alt: string;
}

export interface Props {
    title: string;
    description: string;
    cards: Card[];
}

// Recibimos los props. Si no se pasan, usamos estos datos de ejemplo.
const {
    title = "¡HAZ QUE TU JUEGO SEPA MEJOR!",
    description = "Encontrarás un nuevo giro en la comida que más te gusta, especialidades locales y cervezas, además de nuevas creaciones inesperadas. Con porciones para compartir e ingredientes frescos de alta calidad, sabemos que la comida y las bebidas serán la cereza en el pastel de tu experiencia con nosotros.",
    cards = [
        // CAMBIO: Usamos la imagen importada en la primera tarjeta
        { label: "BONELESS XL PARA COMPARTIR", image: exampleImage, alt: "Boneless en un recipiente con salsas." },
        { label: "BUENOS DRINKS", image: null, alt: "Bebidas refrescantes y coloridas." },
        { label: "HAMBURGUESA AHUMADA EN CASA", image: null, alt: "Hamburguesa con tocino y papas." },
        { label: "FLATBREADS PEPPERONI", image: null, alt: "Pizza de pepperoni en una tabla." },
    ]
} = Astro.props;

// URL base para los placeholders, con un tamaño más adecuado para la cuadrícula
const placeholderUrl = (text: string) => `https://placehold.co/600x400/2d3748/ffffff?text=${encodeURIComponent(text)}`;
---

<section class="w-full bg-[var(--neutral-background-subtle)] py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="text-3xl font-extrabold text-[var(--neutral-text-heavy)] sm:text-4xl">
                {title}
            </h2>
            <p class="mt-4 max-w-3xl mx-auto text-lg text-[var(--neutral-text-subtle)]">
                {description}
            </p>
        </div>
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-8">
        {cards.map((card) => {
            let imageUrl = null;
            if (card.image) {
            if (card.image.src) {
                imageUrl = card.image.src;
            } else {
                imageUrl = getStrapiUrl(card.image);
            }
            }

            return (
            <a href="#" class="relative block overflow-hidden">
                <img
                src={imageUrl || placeholderUrl(card.label)}
                alt={card.alt}
                class="h-64 w-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-0 w-full bg-[#0D111791] p-4">
                <h3 class="text-sm font-semibold uppercase text-[var(--neutral-text-inverted)] tracking-wider">
                    {card.label}
                </h3>
                </div>
            </a>
            );
        })}
        </div>
        <div class="mt-10 flex items-center justify-center gap-4">
            <a href="#" class="inline-flex items-center justify-center rounded-full bg-[var(--brand-interactive-base)] px-8 py-3 font-semibold text-[var(--neutral-text-inverted)] shadow-sm transition hover:opacity-80 focus:outline-none focus:ring-2 focus:ring-offset-2">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="mr-2 h-5 w-5">
                <path d="M6.3 2.841A1.5 1.5 0 004 4.11V15.89a1.5 1.5 0 002.3 1.269l9.344-5.89a1.5 1.5 0 000-2.538L6.3 2.84z" />
                </svg>
                VER MENÚ
            </a>
            <a href="#" class="inline-flex items-center justify-center rounded-full border-2 border-[var(--brand-interactive-base)] px-8 py-3 font-semibold text-[var(--brand-interactive-base)] transition hover:bg-[var(--brand-interactive-base)] hover:text-[var(--neutral-text-inverted)] focus:outline-none focus:ring-2 focus:ring-offset-2">
                BENEFICIOS DE UNA CAVA
            </a>
        </div>
        <div class="mt-6 text-center">
            <p class="text-xs text-[var(--neutral-text-subtle)]">
                Las selecciones del menú están sujetas a disponibilidad y pueden variar según el lugar.
            </p>
        </div>
    </div>
</section>