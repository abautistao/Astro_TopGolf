---
// src/components/Component_14.astro
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";

// 1. Definimos la interfaz para las props con la estructura aplanada
export interface Props {
  titulo_izquierda?: string;
  descripcion_izquierda?: string;
  texto_link_izquierda?: string;
  url_link_izquierda?: string;
  imagen_izquierda?: any;
  titulo_derecha?: string;
  descripcion_derecha?: any; // Rich Text
  icono_derecha?: string; // Font Awesome icon classes
}

// 2. Recibimos las props de Strapi, con valores por defecto
const { 
    titulo_izquierda = 'COMIDA Y BEBIDA',
    descripcion_izquierda = 'Amamos la diversión, pero también sabemos cómo lucirnos en la cocina.',
    texto_link_izquierda = 'Ver el menú de Topgolf',
    url_link_izquierda = '#',
    imagen_izquierda = null,
    titulo_derecha = 'CÓDIGO DE CONDUCTA',
    descripcion_derecha = 'Nos comprometemos a brindar una experiencia excelente en un ambiente acogedor e inclusivo para que podamos divertirnos juntos. Por lo tanto, para todas las partes involucradas (y nos referimos a las partes), les rogamos que sigan nuestro [código de conducta](#).',
    icono_derecha = 'fa-solid fa-shield-halved' // Default icon
} = Astro.props;

// 3. Procesamos los datos para el renderizado
const leftCardImageUrl = getStrapiUrl(imagen_izquierda);
const placeholderImageUrl = `https://placehold.co/150x150/e0e0e0/333?text=Imagen`;

const rightCardDescriptionHtml = stringifyRichText(descripcion_derecha);

---
<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16">
    <div class="container mx-auto flex flex-col justify-center gap-6 px-5 md:flex-row md:items-stretch md:max-w-4xl">
        
        {/* Tarjeta Izquierda */}
        <div class="flex-1 rounded-xl bg-[var(--neutral-background-subtle)] p-6 shadow-sm md:w-[48%]">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center md:items-start lg:items-center">
                <div class="min-w-[150px] overflow-hidden rounded-lg sm:h-[150px] sm:w-[150px]">
                    <img
                        src={leftCardImageUrl || placeholderImageUrl}
                        alt={imagen_izquierda?.data?.attributes?.alternativeText || 'Imagen para ' + titulo_izquierda}
                        class="h-full w-full object-cover"
                        width="150"
                        height="150"
                        loading="lazy"
                        decoding="async"
                    />
                </div>
                <div class="flex flex-col">
                    <h2 class="text-xl font-bold text-[var(--neutral-background-strong)]">{titulo_izquierda}</h2>
                    <p class="mt-2 text-[var(--neutral-background-strong)]">{descripcion_izquierda}</p>
                    <a
                        href={url_link_izquierda}
                        class="mt-4 inline-flex items-center gap-2 font-bold text-[var(--brand-interactive-base)] transition-colors duration-200 hover:text-[var(--brand-interactive-base)] focus:outline-none focus:ring-2 focus:ring-[var(--brand-interactive-base)] focus:ring-offset-2"
                    >
                        {texto_link_izquierda}
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2.5"
                            stroke="currentColor"
                            class="h-6 w-6"
                        >
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>

        {/* Tarjeta Derecha */}
        <div class="flex-1 rounded-xl bg-[var(--surface-brand-primary)] p-6 shadow-sm md:w-[48%] flex flex-col items-center">
            <div class="flex h-10 w-10 items-center justify-center rounded-full border-4 border-solid border-[var(--surface-brand-primary)] bg-[var(--surface-brand-primary)]">
                <i class:list={[icono_derecha, "text-2xl text-[var(--neutral-text-inverted)]"]}></i>
            </div>
            <div class="mt-4 flex h-full flex-col items-center justify-center text-center">
                <h2 class="text-xl font-bold text-[var(--neutral-text-inverted)]">{titulo_derecha}</h2>
                <div class="mt-4 text-[var(--neutral-text-inverted)]" set:html={rightCardDescriptionHtml} />
            </div>
        </div>
    </div>
</section>
