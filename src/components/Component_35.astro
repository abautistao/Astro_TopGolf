---
// src/components/Component_35.astro
import { stringifyRichText } from "../lib/strapi.js";

export interface Props {
    ayuda_texto: any;
    placeholder_input: string;
    texto_boton: string;
}

const { ayuda_texto, placeholder_input, texto_boton } = Astro.props;

const helpTextHtml = stringifyRichText(ayuda_texto);

const placeholderAyuda = `
<p>
¿Necesitas ayuda con tu experiencia en Topgolf o tienes preguntas urgentes que necesitas resolver pronto? Haz clic en una de las secciones a continuación para encontrar la respuesta. Si necesitas más ayuda, <a href="#" class="border-b-2 border-[var(--feedback-positive-dark)] pb-0.5 font-medium text-[var(--brand-interactive-base)]">envíanos un mensaje</a>.
</p>
`;
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-16 sm:py-24 px-4">
    <div
        style="font-family: var(--font-shields-sans-regular);"
        class="mx-auto max-w-7xl"
    >
        <div
            class="text-center text-lg text-[var(--neutral-background-strong)] strapi-rich-text"
            set:html={helpTextHtml || placeholderAyuda}
        />

        <form id="search-form" action="/" class="mt-8 flex gap-x-3">
            <label for="search-input" class="sr-only">Palabra clave</label>

            <input
                id="search-input"
                name="query"
                type="search"
                required
                class="block w-full flex-auto rounded-md border-1 border-[var(--brand-interactive-base)]-300 px-4 py-2.5 text-[var(--neutral-background-strong)] sm:text-sm sm:leading-6"
                placeholder={placeholder_input ||
                    "palabra clave. ejemplo fiestas"}
            />

            <button
                type="submit"
                class="flex-none rounded-md bg-[var(--brand-interactive-base)] px-10 py-2.5 text-sm font-normal text-[var(--neutral-text-inverted)]"
            >
                {texto_boton || "BUSCAR"}
            </button>
        </form>
    </div>
</section>
<style>
    .strapi-rich-text :global(a) {
        border-bottom: 2px solid var(--feedback-positive-dark);
        padding-bottom: 0.125rem;
        font-weight: 500;
        color: var(--brand-interactive-base);
    }
    :global(.search-highlight) {
        background-color: #ffeb3b;
        color: black;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const searchForm = document.getElementById("search-form");
        const searchInput = document.getElementById(
            "search-input",
        ) as HTMLInputElement;

        if (searchForm && searchInput) {
            searchForm.addEventListener("submit", (e) => {
                e.preventDefault();
                const term = searchInput.value.trim();

                // Limpiar resaltados anteriores
                removeHighlights();

                if (term) {
                    highlightText(term);
                }
            });
        }

        function removeHighlights() {
            const highlights = document.querySelectorAll(".search-highlight");
            highlights.forEach((mark) => {
                const parent = mark.parentNode;
                if (parent) {
                    parent.replaceChild(
                        document.createTextNode(mark.textContent || ""),
                        mark,
                    );
                    parent.normalize(); // Unir nodos de texto adyacentes
                }
            });
        }

        function highlightText(term: string) {
            if (!term) return;

            const regex = new RegExp(`(${escapeRegExp(term)})`, "gi");
            const walker = document.createTreeWalker(
                document.body,
                NodeFilter.SHOW_TEXT,
                {
                    acceptNode: (node) => {
                        // Ignorar scripts, estilos y el propio input
                        if (
                            node.parentElement &&
                            (node.parentElement.tagName === "SCRIPT" ||
                                node.parentElement.tagName === "STYLE" ||
                                node.parentElement.tagName === "NOSCRIPT" ||
                                node.parentElement.isContentEditable ||
                                node.parentElement.closest("form") ===
                                    document.getElementById("search-form")) // Evitar resaltar dentro del form de búsqueda
                        ) {
                            return NodeFilter.FILTER_REJECT;
                        }
                        return NodeFilter.FILTER_ACCEPT;
                    },
                },
            );

            const textNodes = [];
            let node;
            while ((node = walker.nextNode())) {
                textNodes.push(node);
            }

            let firstMatch = null;

            textNodes.forEach((textNode) => {
                const text = textNode.textContent || "";
                if (regex.test(text)) {
                    const fragment = document.createDocumentFragment();

                    // Reset regex
                    regex.lastIndex = 0;

                    const parts = text.split(regex);

                    // Si parts tiene más de 1 elemento, hubo coincidencia
                    if (parts.length > 1) {
                        parts.forEach((part) => {
                            if (part.toLowerCase() === term.toLowerCase()) {
                                const mark = document.createElement("mark");
                                mark.className = "search-highlight";
                                mark.textContent = part;
                                fragment.appendChild(mark);

                                // Intentar revelar contenido oculto si es necesario
                                revealElement(mark);

                                if (!firstMatch) firstMatch = mark;
                            } else {
                                fragment.appendChild(
                                    document.createTextNode(part),
                                );
                            }
                        });

                        if (textNode.parentNode) {
                            textNode.parentNode.replaceChild(
                                fragment,
                                textNode,
                            );
                        }
                    }
                }
            });

            if (firstMatch) {
                // Pequeño delay para permitir que las animaciones de apertura terminen (si las hay)
                setTimeout(() => {
                    (firstMatch as HTMLElement).scrollIntoView({
                        behavior: "smooth",
                        block: "center",
                    });
                }, 300);
            }
        }

        function revealElement(element: HTMLElement) {
            let parent = element.parentElement;
            while (parent && parent !== document.body) {
                // 1. Manejo de <details> nativo
                if (parent.tagName === "DETAILS") {
                    (parent as HTMLDetailsElement).open = true;
                }

                // 2. Manejo de Alpine.js (x-data)
                // Buscamos si el padre es un componente Alpine
                if (parent.hasAttribute("x-data")) {
                    // Verificamos si el elemento (o uno de sus ancestros hasta llegar a este componente) está oculto
                    // Una forma sencilla es ver si tiene display: none o si está dentro de un x-show que está false.
                    // Pero como no tenemos acceso fácil al estado reactivo de Alpine desde fuera sin usar __x,
                    // intentaremos encontrar el trigger que controla este contenido.

                    // Asumimos patrón común: un botón hermano o cercano que tiene @click o x-on:click
                    // En Component_37, el trigger está en un div hermano anterior al contenedor del contenido.

                    // Buscamos dentro del componente Alpine un elemento que parezca un trigger
                    const triggers = parent.querySelectorAll(
                        "[x-on\\:click], [@click]",
                    );

                    // Esta parte es heurística. En Component_37, el trigger tiene @click="open = !open".
                    // Y el contenido tiene x-show="open".
                    // Si el contenido donde está el match está oculto (display: none), intentamos clickear el trigger.

                    // Chequeamos si el elemento visiblemente está oculto
                    if (
                        window.getComputedStyle(element).display === "none" ||
                        element.offsetParent === null
                    ) {
                        // Intentar encontrar el trigger más cercano relacionado
                        // En Component_37, el trigger es un hermano previo del contenedor del contenido.
                        // Estructura:
                        // <div x-data>
                        //   <div @click>TRIGGER</div>
                        //   <div x-show>CONTENIDO (aquí está el match)</div>
                        // </div>

                        // Subimos hasta encontrar el contenedor directo dentro del x-data
                        let current = element;
                        while (current && current.parentElement !== parent) {
                            current = current.parentElement as HTMLElement;
                        }

                        if (current) {
                            // Buscamos un hermano anterior que tenga click
                            let sibling = current.previousElementSibling;
                            while (sibling) {
                                if (
                                    sibling.hasAttribute("@click") ||
                                    sibling.hasAttribute("x-on:click")
                                ) {
                                    (sibling as HTMLElement).click();
                                    break;
                                }
                                sibling = sibling.previousElementSibling;
                            }
                        }
                    }
                }

                parent = parent.parentElement;
            }
        }

        function escapeRegExp(string: string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
        }
    });
</script>
