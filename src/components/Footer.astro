---

<footer class="bg-gradient-to-r from-[#000299] to-[#0004FF] text-white font-sans">
    <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-3 lg:gap-8">
            <div>
                <h3 class="font-bold tracking-wider text-cyan-300">VEN A JUGAR</h3>
                <ul class="mt-4 space-y-3 text-sm">
                    <li><a href="#" class="hover:underline">Planea tu visita a Topgolf</a></li>
                    <li><a href="#" class="hover:underline">Cómo jugar</a></li>
                    <li><a href="#" class="hover:underline">Promociones</a></li>
                    <li><a href="#" class="hover:underline">Clases de golf</a></li>
                    <li><a href="#" class="hover:underline">Contáctanos</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-bold tracking-wider text-cyan-300">MÁS SOBRE NOSOTROS</h3>
                <ul class="mt-4 space-y-3 text-sm">
                    <li><a href="#" class="hover:underline">Términos y condiciones</a></li>
                    <li><a href="#" class="hover:underline">Aviso de privacidad</a></li>
                    <li><a href="#" class="hover:underline">Facturación</a></li>
                    <li><a href="#" class="hover:underline">Administrar preferencia de cookies</a></li>
                </ul>
            </div>
            <div>
                <h3 class="font-bold tracking-wider text-cyan-300">REGÍSTRATE PARA RECIBIR OFERTAS</h3>
                <p class="mt-4 text-sm">
                    Regístrate con tu correo y recibe nuestras mejores ofertas, descuentos exclusivos y novedades antes que nadie.
                </p>
                <button class="mt-6 w-full bg-white text-blue-800 font-bold py-3 px-6 rounded-full hover:bg-gray-200 transition-colors sm:w-auto">
                    SUSCRÍBETE
                </button>
                <div class="mt-4 flex items-center space-x-2">
                    <div class="relative inline-block w-10 h-5 cursor-pointer">
                        <div class="w-full h-full rounded-full bg-white/30"></div>
                        <div class="absolute top-1/2 left-1 h-3 w-3 -translate-y-1/2 rounded-full bg-white"></div>
                    </div>
                    <span class="text-xs">Cambiar el contraste</span>
                </div>
            </div>
        </div>

        <hr class="my-10 border-t-2 border-white" />

        <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-between">

            <div class="w-40">
                <a href="/">
                    <img src={logo.src} alt="Logo de TopGolf Monterrey" class="h-auto w-full" />
                </a>
            </div>

            <p class="text-xs text-center sm:text-left">
                &copy; {new Date().getFullYear()} Topgolf International, Inc. Reservados todos los derechos.
            </p>

            <div class="flex items-center space-x-4">
                {socialIcons.map(icon => (
                    <a href={icon.href} title={icon.name} class="text-white hover:text-white/80 transition-opacity">
                        <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d={icon.path} clip-rule="evenodd" />
                        </svg>
                    </a>
                ))}
            </div>
        </div>

        <div class="mt-4 border-t-2 border-white"></div>
    </div>
</footer>