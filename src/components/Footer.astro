---
// 1. Importa el logo, igual que en el Header
import { getFooterData, getStrapiUrl,stringifyRichText, formatUrl } from '../lib/strapi';
import logo from '../assets/logo-TopGolf.png';
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

// Iconos de redes sociales (Esta parte ya estaba correcta)

const footerData = await getFooterData();

const titulo_1 = footerData?.columna_1 || 'Lorem Ipsum';
const titulo_2 = footerData?.columna_2 || 'Lorem Ipsum ';
const titulo_3 = footerData?.columna_3 || 'Lorem Ipsum';
const links_1 = footerData?.links_columna_1 || [];
const links_2 = footerData?.links_columna_2 || [];
const socialIcons = footerData?.social || [];
const logoUrl = getStrapiUrl(footerData?.logo) || '/default-logo.svg';
const descripcion_columna_3 = stringifyRichText(footerData?.descripcion_columna_3 || 'Lorem Ipsum');
const terminos_and_conditions = stringifyRichText(footerData?.terminos_and_conditions || 'Lorem Ipsum');
const buttonBanner: Boton[] = (footerData.Boton3 && !Array.isArray(footerData.Boton3) ? [footerData.Boton3] : footerData.Boton3) || [
    {
        id: 1,
        texto: "Reserva Ahora",
        url: "#",
        tipo: "version_1"
    }
];
---

<footer class="bg-gradient-to-r from-[var(--surface-brand-secondary)] to-[var(--brand-interactive-base)] text-[var(--neutral-text-inverted)]" style="font-family: var(--font-shields-sans-regular);">
    <div class="px-12 py-12 lg:px-20">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:gap-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <div>
                    <h3 class="font-black tracking-wider text-[var(--accent-highlight-secondary)] uppercase text-sm md:text-2xl">{titulo_1}</h3>
                    <ul class="mt-4 space-y-3 text-xs md:text-base">
                        {links_1.map(link => (
                            <li><a href={formatUrl(link.url)} class="hover:underline">{link.texto}</a></li>
                        ))}
                    </ul>
                </div>

                <div>
                    <h3 class="font-black tracking-wider text-[var(--accent-highlight-secondary)] uppercase text-sm md:text-2xl">{titulo_2}</h3>
                    <ul class="mt-4 space-y-3 text-xs md:text-base">
                        {links_2.map(link => (
                            <li><a href={formatUrl(link.url)} class="hover:underline">{link.texto}</a></li>
                        ))}
                    </ul>
                </div>
            </div>

            <div>
                <h3 class="font-black tracking-wider text-[var(--accent-highlight-secondary)] uppercase text-sm md:text-2xl">{titulo_3}</h3>
                <div class="mt-4 my-2 text-sm md:text-base" set:html={descripcion_columna_3}></div>
                <ButtonGroup botones={buttonBanner} />
                <div class="mt-4 flex items-center space-x-2">
                    <div id="contrast-switcher" class="relative inline-block w-10 h-5 cursor-pointer">
                        <div class="w-full h-full rounded-full bg-white/30"></div>
                        <div class="absolute top-1/2 left-1 h-3 w-3 -translate-y-1/2 rounded-full bg-[var(--neutral-text-inverted)] transition-transform duration-200 ease-in-out"></div>
                    </div>
                    <span class="text-xs">Cambiar el contraste</span>
                </div>
            </div>
        </div>

        <hr class="my-10 border-t-[3px] border-[var(--neutral-text-inverted)]" />

        <div class="flex flex-col items-center gap-8 sm:flex-row sm:justify-between">
            <div class="order-2 sm:order-1">
                <a href="/">
                    <img src={logoUrl} alt="Logo de TopGolf Monterrey" class="h-20 w-auto" />
                </a>
            </div>

            <div class="order-3 sm:order-2 text-xs text-center sm:text-left sm:text-sm" set:html={terminos_and_conditions}></div>

           <div class="order-1 sm:order-3 flex items-center space-x-4">
                {socialIcons.map(icon => (
                    <a
                        href={formatUrl(icon.url)}
                        title={icon.name}
                        class="text-[var(--accent-highlight-secondary)] sm:text-[var(--neutral-text-inverted)] hover:text-[var(--neutral-text-inverted)]/80 transition-opacity"
                    >
                        <span class="text-2xl" set:html={icon.icon}></span>
                    </a>
                ))}
            </div>
        </div>

        <hr class="my-10 border-t-[3px] border-[var(--neutral-text-inverted)]" />
    </div>
</footer>
<style>
    :root {
        --footer-link-underline: var(--accent-highlight-secondary);
    }

    footer a {
        text-decoration-color: transparent;
        transition: text-decoration-color 0.3s ease, color 0.3s ease;
    }

    footer a:hover {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-decoration-color: var(--footer-link-underline);
    }

    #contrast-switcher.active > div:last-child {
        transform: translateX(20px);
    }
</style>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const switcher = document.getElementById('contrast-switcher');
        const body = document.body;

        const dispatchThemeChangeEvent = (theme) => {
            const event = new CustomEvent('theme-changed', { detail: { theme } });
            document.dispatchEvent(event);
        };

        const activateDarkMode = () => {
            body.classList.add('dark-mode');
            switcher.classList.add('active');
            localStorage.setItem('theme', 'dark');
            dispatchThemeChangeEvent('dark');
        };

        const deactivateDarkMode = () => {
            body.classList.remove('dark-mode');
            switcher.classList.remove('active');
            localStorage.removeItem('theme');
            dispatchThemeChangeEvent('light');
        };

        if (localStorage.getItem('theme') === 'dark') {
            activateDarkMode();
        } else {
            // Dispatch initial theme for components that load after this script
            dispatchThemeChangeEvent('light');
        }

        switcher.addEventListener('click', () => {
            if (body.classList.contains('dark-mode')) {
                deactivateDarkMode();
            } else {
                activateDarkMode();
            }
        });
    });
</script>