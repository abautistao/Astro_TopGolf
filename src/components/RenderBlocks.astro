    "secciones.componente-33": Component_33,
    "secciones.componente-34": Component_34,
    "secciones.componente-35": Component_35,
    "secciones.componente-36": Component_36,
    "secciones.componente-37": Component_37,
};
---

{
    blocks &&
        blocks.map((bloque) => {
            const Componente = componentsMap[bloque.__component];
            return Componente ? (
                <Componente {...bloque} />
            ) : (
                <p>Componente no encontrado: {bloque.__component}</p>
            );
        })
}
