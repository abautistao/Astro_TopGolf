---
// src/components/Header.astro
import logo from '../assets/logo-TopGolf.png';
---

<header class="flex h-20 font-sans text-[var(--neutral-text-inverted)] shadow-md relative z-30">
    <div class="bg-gradient-to-r from-[var(--surface-brand-secondary)] to-[var(--brand-interactive-base)] flex shrink-0 items-center justify-center px-8">
        <a href="/">
            <img src={logo.src} alt="Logo de TopGolf Monterrey" class="w-40 h-auto" />
        </a>
    </div>

    <div class="flex items-center justify-between w-full px-6 bg-[var(--surface-brand-primary)]">
        <nav class="hidden lg:flex">
            <ul class="flex items-center space-x-10 text-sm font-bold">
                <li><a href="#" class="tracking-wide transition-colors hover:text-gray-300">FIESTAS Y EVENTOS</a></li>
                <li><a href="#" class="tracking-wide transition-colors hover:text-gray-300">COMIDA Y BEBIDA</a></li>
                <li>
                    <button id="open-jugar-overlay" class="flex items-center tracking-wide transition-colors hover:text-gray-300">
                        JUGAR
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-1 text-[var(--accent-feedback-strong)] transition-transform" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                </li>
            </ul>
        </nav>

        <div class="flex items-center space-x-6">
            <div class="items-center hidden space-x-2 md:flex">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[var(--accent-highlight-secondary)]" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                </svg>
                <div class="text-xs">
                    <p class="text-sm font-bold">MONTERREY</p>
                    <div class="flex items-center opacity-80">
                        <span class="uppercase">MARS, A 10 A.M.</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1" viewBox="0 0 20 20" fill="currentColor">
                            <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <a href="#" class="bg-[var(--neutral-text-inverted)] text-[var(--surface-brand-primary)] font-bold text-xs px-4 py-2.5 rounded-md whitespace-nowrap hover:bg-gray-200 transition-colors">
                    RESERVA AQUÍ TU BAHÍA
                </a>
                <a href="#" class="border-2 border-[var(--accent-highlight-secondary)] text-[var(--accent-highlight-secondary)] font-bold text-xs px-4 py-2.5 rounded-md whitespace-nowrap hover:bg-[var(--accent-highlight-secondary)] hover:text-[var(--surface-brand-secondary)] transition-colors">
                    PLANEA TU EVENTO
                </a>
            </div>
        </div>
    </div>
</header>

<div id="jugar-overlay-container" class="hidden">

    <div id="jugar-backdrop" class="fixed inset-0  bg-opacity-70 z-20"></div>

    <div class="fixed top-20 left-0 right-0 bottom-0 z-40 overflow-y-auto">
        <div class="bg-[var(--surface-brand-primary)] p-8 text-white">
            <button id="close-jugar-overlay" class="absolute text-5xl font-light text-white transition-transform top-2 right-10 hover:scale-125 z-50">
                &times;
            </button>

            <div class="container grid grid-cols-1 gap-5 mx-auto md:grid-cols-2 lg:grid-cols-4 max-w-7xl">

                <a href="#" class="relative block overflow-hidden rounded-lg group aspect-square">
                    <img src="/images/planea-visita.jpg" alt="Planea tu visita" class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-black bg-opacity-40"></div>
                    <div class="absolute bottom-0 left-0 p-4">
                        <h3 class="text-2xl font-bold">PLANEA TU VISITA</h3>
                        <p class="text-sm opacity-80">Encuentra la mejor manera de Jugar</p>
                    </div>
                    <div class="absolute p-2 bg-green-500 rounded-full bottom-4 right-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                    </div>
                </a>

                <a href="#" class="relative block overflow-hidden rounded-lg group aspect-square">
                    <img src="/images/fiestas.jpg" alt="Fiestas" class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-black bg-opacity-40"></div>
                    <div class="absolute bottom-0 left-0 p-4">
                        <h3 class="text-2xl font-bold">FIESTAS</h3>
                        <p class="text-sm opacity-80">Para grupos de 7 personas o más</p>
                    </div>
                     <div class="absolute p-2 bg-green-500 rounded-full bottom-4 right-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                    </div>
                </a>
                 <a href="#" class="relative block overflow-hidden rounded-lg group aspect-square">
                    <img src="/images/kids-teens.jpg" alt="Kids & Teens" class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-black bg-opacity-40"></div>
                    <div class="absolute bottom-0 left-0 p-4">
                        <h3 class="text-2xl font-bold">KIDS & TEENS</h3>
                        <p class="text-sm opacity-80">Ofertas y novedades</p>
                    </div>
                    <div class="absolute p-2 bg-green-500 rounded-full bottom-4 right-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                    </div>
                </a>
                <a href="#" class="relative block overflow-hidden rounded-lg group aspect-square">
                    <img src="/images/como-jugar.jpg" alt="Cómo Jugar" class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-110" />
                    <div class="absolute inset-0 bg-black bg-opacity-40"></div>
                    <div class="absolute bottom-0 left-0 p-4">
                        <h3 class="text-2xl font-bold">CÓMO JUGAR</h3>
                        <p class="text-sm opacity-80">Conoce más antes de tu visita</p>
                    </div>
                    <div class="absolute p-2 bg-green-500 rounded-full bottom-4 right-4">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-white"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    const openButton = document.getElementById('open-jugar-overlay');
    const closeButton = document.getElementById('close-jugar-overlay');
    const overlayContainer = document.getElementById('jugar-overlay-container'); // Apuntamos al nuevo contenedor principal
    const backdrop = document.getElementById('jugar-backdrop'); // El fondo negro
    const arrow = openButton.querySelector('svg');

    function openOverlay() {
        overlayContainer.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        arrow.style.transform = 'rotate(180deg)';
    }

    function closeOverlay() {
        overlayContainer.classList.add('hidden');
        document.body.style.overflow = '';
        arrow.style.transform = 'rotate(0deg)';
    }

    openButton.addEventListener('click', openOverlay);
    closeButton.addEventListener('click', closeOverlay);
    backdrop.addEventListener('click', closeOverlay); // NUEVO: Cierra el menú al hacer clic en el fondo

    document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && !overlayContainer.classList.contains('hidden')) {
            closeOverlay();
        }
    });
</script>