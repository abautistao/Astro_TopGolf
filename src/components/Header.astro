---
// src/components/Header.astro
import { getHeaderData, getStrapiUrl,stringifyRichText } from '../lib/strapi';
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

const headerData = await getHeaderData();

const logoUrl = getStrapiUrl(headerData?.logo) || '/default-logo.svg';
const links = headerData?.links || [];
const botones = headerData?.botones || [];
const ubicacion = headerData?.ubicacion || 'UBICACION';
const horario = headerData?.horario || 'MAR: 9 A.M. A 12 A.M.';
const direccion = stringifyRichText(headerData?.direccion || {});
const texto_boton = headerData?.texto_boton || 'CLICK AQUI';
const url_boton = headerData?.url_boton || '#';
console.log(headerData);
const buttonBanner: Boton[] = (headerData.Boton && !Array.isArray(headerData.Boton) ? [headerData.Boton] : headerData.Boton) || [
    {
        id: 1,
        texto: "Reserva Ahora",
        url: "#",
        tipo: "version_1"
    }
];

const buttons: Boton[] = (headerData.Botones2 && !Array.isArray(headerData.Botones2) ? [headerData.Botones2] : headerData.Botones2) || [
    {
        id: 1,
        texto: "Reserva Ahora",
        url: "#",
        tipo: "version_1"
    }
];

// Filtra los links que tienen dropdowns para crear los overlays
const linksWithDropdowns = links.filter(link => link.tiene_dropdown && link.dropdown_items && link.dropdown_items.length > 0);
---

<header class="relative z-40 flex flex-col font-sans text-[var(--neutral-text-inverted)] shadow-md">
    <div class="flex items-center justify-between w-full h-20 px-4 bg-[var(--surface-brand-secondary)] lg:h-24">
        
        <!-- Logo y Menú Móvil -->
        <div class="flex items-center lg:hidden">
            <button id="mobile-menu-toggle" class="p-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8 text-[var(--accent-feedback-strong)]">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                </svg>
            </button>
            <a href="/" class="ml-4 sm:ml-0">
                <img src={logoUrl} alt="Logo de TopGolf Monterrey" class="w-32 h-auto" />
            </a>
        </div>

        <!-- Logo Desktop -->
        <div class="hidden lg:flex items-center h-full w-[280px] bg-gradient-to-r from-[var(--surface-brand-secondary)] to-[var(--brand-interactive-base)] shrink-0 px-8 relative">
            <a href="/">
                <img src={logoUrl} alt="Logo" class="w-40 h-auto" />
            </a>
        </div>

        <div class="flex items-center justify-between w-full h-full lg:px-6">
            <!-- Navegación Desktop -->
            <nav class="hidden lg:flex">
                <ul class="flex items-center space-x-10 text-sm font-bold">
                    {links.map(link => (
                        <li>
                            {link.tiene_dropdown && link.dropdown_items && link.dropdown_items.length > 0 ? (
                                <button 
                                    class="flex items-center tracking-wide transition-colors hover:text-[var(--accent-feedback-strong)] dropdown-trigger"
                                    data-dropdown-id={`desktop-${link.id}`}
                                >
                                    {link.texto}
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-1 text-[var(--accent-feedback-strong)] transition-transform dropdown-arrow" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                            ) : (
                                <a href={link.url} class="tracking-wide transition-colors hover:text-[var(--accent-feedback-strong)]">{link.texto}</a>
                            )}
                        </li>
                    ))}
                </ul>
            </nav>

            <!-- Botones de Acción y Locación -->
            <div class="flex items-center space-x-2 sm:space-x-3 lg:space-x-6">
                <div class="hidden lg:flex items-center space-x-2 relative">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-[var(--accent-highlight-secondary)]" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                    </svg>
                    <button id="location-toggle-desktop" class="text-left text-xs">
                        <p class="text-sm font-bold">{ubicacion}</p>
                        <div class="flex items-center opacity-80">
                            <span class="uppercase">{horario}</span>
                            <svg id="location-arrow-desktop" xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    </button>
                    <div id="location-details-desktop" class="absolute hidden top-full right-0 mt-2 p-4 w-72 bg-[var(--brand-interactive-base)] rounded-md shadow-lg text-[var(--neutral-text-inverted)] z-50">
                        <div class="my-2" set:html={direccion}></div>
                         <ButtonGroup botones={buttonBanner} />
                    </div>
                </div>

             <ButtonGroup botones={buttons} />
            </div>
        </div>
    </div>
</header>

<!-- Barra de Locación Móvil -->
<div class="relative z-30 font-sans text-[var(--neutral-text-inverted)] bg-[var(--surface-brand-primary)] lg:hidden">
    <button id="location-toggle-mobile" class="flex items-center justify-between w-full px-4 py-3 text-sm font-bold bg-[var(--brand-interactive-base)]">
        <span>{ubicacion}</span>
        <div class="flex items-center">
            <span>{horario}</span>
            <svg id="location-arrow-mobile" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
        </div>
    </button>
    <div id="location-details-mobile" class="hidden px-4 py-5 bg-[var(--brand-interactive-base)]">
        <div set:html={direccion}></div>
        <ButtonGroup botones={buttonBanner} />
    </div>
</div>

<!-- Overlay Menú Móvil -->
<div id="mobile-menu-overlay" class="fixed inset-0 z-50 hidden bg-[var(--surface-brand-primary)] text-[var(--neutral-text-inverted)] overflow-y-auto">
    <div class="flex items-center justify-between h-20 px-4">
        <a href="/">
            <img src={logoUrl} alt="Logo de TopGolf Monterrey" class="w-40 h-auto" />
        </a>
        <button id="mobile-menu-close" class="p-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-8 h-8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <div class="p-4">
        <nav>
            <ul class="flex flex-col text-xl font-bold divide-y divide-blue-800">
                {links.map(link => (
                    <li class="py-4">
                        {link.tiene_dropdown && link.dropdown_items && link.dropdown_items.length > 0 ? (
                            <>
                                <button class="flex items-center justify-between w-full mobile-dropdown-trigger" data-dropdown-id={`mobile-${link.id}`}>
                                    <span>{link.texto}</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-[var(--accent-feedback-strong)] transition-transform dropdown-arrow" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                                    </svg>
                                </button>
                                <div id={`mobile-${link.id}-submenu`} class="hidden mt-4">
                                    <div class="grid grid-cols-2 gap-4">
                                        {link.dropdown_items.map(item => (
                                            <a href={item.url} class="relative block overflow-hidden rounded-lg group aspect-w-1 aspect-h-1">
                                                <img src={getStrapiUrl(item.imagen)} alt={item.titulo} class="object-cover w-full h-full"/>
                                                <div class="absolute inset-0  bg-opacity-40"></div>
                                                <h3 class="absolute text-lg font-bold bottom-2 left-2">{item.titulo}</h3>
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            </>
                        ) : (
                            <a href={link.url}>{link.texto}</a>
                        )}
                    </li>
                ))}
            </ul>
        </nav>
    </div>
</div>

<!-- Overlays para Dropdowns de Escritorio -->
{linksWithDropdowns.map(link => (
    <div id={`desktop-${link.id}-overlay`} class="fixed inset-0 hidden z-50 dropdown-overlay">
        <div class="absolute inset-0 bg-black bg-opacity-70 dropdown-backdrop"></div>
        <div class="relative w-full h-full flex items-start justify-center pt-24 pb-8 overflow-y-auto">
            <div class="bg-[var(--surface-brand-primary)] p-8 text-[var(--neutral-text-inverted)] rounded-lg max-w-7xl w-full mx-4 relative">
                <button class="absolute text-5xl font-light text-[var(--neutral-text-inverted)] transition-transform top-4 right-10 hover:scale-125 z-50 dropdown-close">
                    &times;
                </button>
                <h2 class="text-4xl font-bold text-center mb-8">{link.texto}</h2>
                
                <div class="container grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mx-auto">
                    {link.dropdown_items.map((item, index) => {
                        // Lógica para diferentes layouts de tarjetas
                       
                        if (index < 2) { // Primeras 2 tarjetas son grandes
                            return (
                                <a href={item.url} class="relative block overflow-hidden rounded-lg group h-full">
                                    <img src={getStrapiUrl(item.imagen)} alt={item.titulo} class="absolute inset-0 object-cover w-full h-full transition-transform duration-300 group-hover:scale-110" />
                                    <div class="absolute inset-0 "></div>
                                    <div class="relative flex flex-col justify-end h-full p-4 min-h-[400px]">
                                        <h3 class="text-2xl font-bold">{item.titulo}</h3>
                                        <p class="text-sm opacity-80">{item.subtitulo}</p>
                                    </div>
                                    <div class="absolute p-2 bg-[var(--accent-feedback-strong)] rounded-full bottom-4 right-4">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-[var(--neutral-text-inverted)]"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                                    </div>
                                </a>
                            );
                        } else { // El resto se agrupan en una cuadrícula
                            return null; // Renderiza las siguientes en el siguiente bloque
                        }
                    })}

                    <div class="grid grid-cols-2 grid-rows-2 gap-5">
                         {link.dropdown_items.slice(2).map(item => (
                            <a href={item.url} class="relative block overflow-hidden rounded-lg group aspect-square">
                                <img src={getStrapiUrl(item.imagen)} alt={item.titulo} class="object-cover w-full h-full transition-transform duration-300 group-hover:scale-110" />
                                <div class="absolute inset-0  "></div>
                                <div class="absolute bottom-0 left-0 p-4">
                                    <h3 class="text-xl font-bold">{item.titulo}</h3>
                                    <p class="text-xs opacity-80">{item.subtitulo}</p>
                                </div>
                                <div class="absolute p-2 bg-[var(--accent-feedback-strong)] rounded-full bottom-4 right-4">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-6 h-6 text-[var(--neutral-text-inverted)]"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    </div>
))}

<script>
document.addEventListener('DOMContentLoaded', () => {
    // --- LÓGICA PARA EL MENÚ MÓVIL ---
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileMenuClose = document.getElementById('mobile-menu-close');
    const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

    if (mobileMenuToggle) {
        mobileMenuToggle.addEventListener('click', () => {
            mobileMenuOverlay.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        });
    }
    if (mobileMenuClose) {
        mobileMenuClose.addEventListener('click', () => {
            mobileMenuOverlay.classList.add('hidden');
            document.body.style.overflow = '';
        });
    }

    // --- LÓGICA PARA DROPDOWNS EN MÓVIL ---
    const mobileDropdownTriggers = document.querySelectorAll('.mobile-dropdown-trigger');
    mobileDropdownTriggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
            const dropdownId = trigger.getAttribute('data-dropdown-id');
            const submenu = document.getElementById(`${dropdownId}-submenu`);
            const arrow = trigger.querySelector('.dropdown-arrow');
            if (submenu) {
                submenu.classList.toggle('hidden');
            }
            if (arrow) {
                arrow.classList.toggle('rotate-180');
            }
        });
    });

    // --- LÓGICA PARA EL DESPLEGABLE DE UBICACIÓN (MÓVIL) ---
    const locationToggleMobile  = document.getElementById('location-toggle-mobile');
    const locationDetailsMobile = document.getElementById('location-details-mobile');
    const locationArrowMobile   = document.getElementById('location-arrow-mobile');

    if (locationToggleMobile) {
        locationToggleMobile.addEventListener('click', () => {
            locationDetailsMobile.classList.toggle('hidden');
            locationArrowMobile.classList.toggle('rotate-180');
        });
    }

    // --- LÓGICA GENÉRICA PARA DROPDOWNS DE ESCRITORIO ---
    const desktopDropdownTriggers = document.querySelectorAll('.dropdown-trigger');
    const dropdownOverlays = document.querySelectorAll('.dropdown-overlay');

    desktopDropdownTriggers.forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const dropdownId = trigger.getAttribute('data-dropdown-id');
            const overlay = document.getElementById(`${dropdownId}-overlay`);
            const arrow = trigger.querySelector('.dropdown-arrow');

            // Cierra otros overlays abiertos
            closeAllDropdowns();

            if (overlay) {
                overlay.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            }
            if (arrow) {
                arrow.classList.add('rotate-180');
            }
        });
    });

    function closeAllDropdowns() {
        dropdownOverlays.forEach(overlay => {
            overlay.classList.add('hidden');
        });
        desktopDropdownTriggers.forEach(trigger => {
            const arrow = trigger.querySelector('.dropdown-arrow');
            if (arrow) {
                arrow.classList.remove('rotate-180');
            }
        });
        document.body.style.overflow = '';
    }

    // Event listeners para cerrar overlays
    dropdownOverlays.forEach(overlay => {
        const closeButton = overlay.querySelector('.dropdown-close');
        const backdrop = overlay.querySelector('.dropdown-backdrop');
        
        if (closeButton) {
            closeButton.addEventListener('click', closeAllDropdowns);
        }
        if (backdrop) {
            backdrop.addEventListener('click', closeAllDropdowns);
        }
    });

    // --- LÓGICA PARA EL DESPLEGABLE DE UBICACIÓN (ESCRITORIO) ---
    const locationToggleDesktop     = document.getElementById('location-toggle-desktop');
    const locationDetailsDesktop    = document.getElementById('location-details-desktop');
    const locationArrowDesktop      = document.getElementById('location-arrow-desktop');

    if (locationToggleDesktop) {
        locationToggleDesktop.addEventListener('click', (event) => {
            event.stopPropagation();
            locationDetailsDesktop.classList.toggle('hidden');
            locationArrowDesktop.classList.toggle('rotate-180');
        });
    }

    // Cierra el menú de ubicación de escritorio si se hace clic fuera
    document.addEventListener('click', (event) => {
        if (locationToggleDesktop && !locationToggleDesktop.contains(event.target) && locationDetailsDesktop && !locationDetailsDesktop.contains(event.target)) {
            locationDetailsDesktop.classList.add('hidden');
            if (locationArrowDesktop) {
                locationArrowDesktop.classList.remove('rotate-180');
            }
        }
    });

    // Cerrar con la tecla Escape
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
            closeAllDropdowns();
        }
    });
});
</script>
