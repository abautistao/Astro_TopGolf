---
// Importa las imágenes estáticas directamente desde la carpeta assets
// Asegúrate de que las rutas sean correctas respecto a la ubicación de tu componente
import mainImage from "../assets/19cb7e4a88bc52ddcc5b548bcdd8f0366b2891f8.jpg";
import dotsPattern from "../assets/Artwork.png";
import dotsPatternSquare from "../assets/Artwork_square.png";

// Definimos los datos estáticos para el contenido textual
const pageContent = {
    sectionTitle: "EN TOPGOLF HACEMOS",
    mainHeadline: "LA DIFERENCIA",
    introText: "Olvídate de los planes aburridos en restaurantes o salones encerrados de conferencias. Tenemos todo para hacer tus fiestas y eventos inolvidables, somos sin duda el lugar más divertido de la ciudad.",
    features: [
        {
        title: "¡DIVERSIÓN PARA TODOS!",
        description: "Ya sea que seas un aspirante a profesional del golf o que estés empuñando un palo por primera vez, Topgolf es diversión para todos. Y es una forma única de entretener a amigos o colegas corporativos en un ambiente muy no corporativo."
        },
        {
        title: "TU EVENTO COMO TE GUSTA",
        description: "Contamos con un equipo completo que tiene las habilidades necesarias para realizar cualquier evento desde 12 hasta 900 personas. Además, nos gusta escuchar tus ideas, proponer nuevas y trabajar junto contigo para hacer realidad el evento de tus sueños."
        },
        {
        title: "MENÚ DISEÑADO POR NUESTRO CHEF",
        description: "Nos orgullecemos de nuestra comida, tenemos platillos diseñados por chefs para apelar a los paladares de tus invitados. También tenemos servicio de catering para atender a grupos grandes y pequeños, ¡aquí nadie se queda con hambre... o con antojo!"
        },
        {
        title: "HAZLO AÚN MEJOR",
        description: "¿Quieres la experiencia completa? ¡Hay mucho más bien que solo puedes encontrar en Topgolf! Clases grupales con nuestro coach, tableros de juego en tiempo real entre tus invitados, decoraciones especiales, regalos, la primicia de nuestra tienda de retail y mucho más."
        }
    ]
};
---
<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16">
<div class="grid grid-cols-1 lg:grid-cols-2 min-h-screen font-sans p-4 lg:p-16 lg:pl-20 relative">
        {/* IMAGEN PRINCIPAL (Estática) */}
    <div class="lg:order-last">
        <img
            src={mainImage.src}
            alt="Un grupo de amigos brindando alegremente en un evento de Topgolf"
            class="w-full h-full object-cover min-h-[400px] lg:min-h-screen"
            loading="lazy"
            decoding="async"
        />
    </div>

    <img
        src={dotsPattern.src}
        alt="Patrón decorativo de puntos"
        class="absolute z-0 bottom-0 left-0 w-125 hidden lg:block"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
    />

    <img
        src={dotsPatternSquare.src}
        alt="Patrón decorativo de puntos"
        class="absolute bottom-0 left-0 z-0 w-40 lg:hidden"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
    />

    <img
        src={dotsPatternSquare.src}
        alt="Patrón decorativo de puntos"
        class="absolute bottom-32 left-0 z-0 w-40 lg:hidden"
        aria-hidden="true"
        loading="lazy"
        decoding="async"
    />

    <div class="bg-[var(--surface-brand-primary)] text-[var(--neutral-text-inverted)] py-8 px-0 sm:p-16 lg:p-20 relative flex flex-col justify-center">
        <div class="z-10 p-5 lg:p-0 xl:p-0">
            <h2 class="text-xl md:text-2xl tracking-wider uppercase">{pageContent.sectionTitle}</h2>
            <h1 class="text-5xl md:text-7xl font-semibold uppercase my-2">{pageContent.mainHeadline}</h1>

            <p class="mt-6 text-base max-w-2xl ">{pageContent.introText}</p>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 mt-12 ">
                {pageContent.features.map((feature) => (
                    <div>
                        <h3 class="flex items-center mb-2 text-[var(--accent-highlight-secondary)]">
                            <i class="fas fa-circle-check text-[var(--accent-feedback-strong)] mr-3 flex-shrink-0"></i>
                            {feature.title}
                        </h3>
                        <p class="text-sm opacity-90">{feature.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </div>
</div>
</section>