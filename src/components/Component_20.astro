---
// src/components/Component_20.astro
import { getStrapiUrl } from "../lib/strapi.js";
import dotsPattern from "../assets/Artwork.png";
import dotsPatternSquare from "../assets/Artwork_square.png";
import { stringifyRichText } from "../lib/strapi.js";


const FALLBACK_IMAGE_URL = "https://placehold.co/1024x1280/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Definimos las interfaces para las props de Strapi
export interface Feature {
  id: number;
  titulo: string;
  descripcion: any;
}

export interface StrapiMedia {
  id: number;
  url: string;
  alternativeText: string | null;
}

export interface Props {
  imagen_principal: StrapiMedia | null;
  titulo_seccion: string;
  titulo_principal: string;
  texto_introduccion: any;
  caracteristicas: Feature[];
}

// 2. Recibimos las props y definimos placeholders
const { imagen_principal, titulo_seccion, titulo_principal, texto_introduccion, caracteristicas } = Astro.props;

const placeholderData: Props = {
  titulo_seccion: "EN TOPGOLF HACEMOS",
  titulo_principal: "LA DIFERENCIA",
  texto_introduccion: "Olvídate de los planes aburridos...",
  imagen_principal: null,
  caracteristicas: [
    { id: 1, titulo: "¡DIVERSIÓN PARA TODOS!", descripcion: "Ya sea que seas un aspirante a profesional del golf..." },
    { id: 2, titulo: "TU EVENTO COMO TE GUSTA", descripcion: "Contamos con un equipo completo..." },
  ]
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
  titulo_seccion: titulo_seccion || placeholderData.titulo_seccion,
  titulo_principal: titulo_principal || placeholderData.titulo_principal,
  contentHtml: stringifyRichText(texto_introduccion) || placeholderData.texto_introduccion,

  caracteristicas: caracteristicas && caracteristicas.length > 0 ? caracteristicas : placeholderData.caracteristicas,
};

const imageUrl = imagen_principal
    ? getStrapiUrl(imagen_principal)
    : FALLBACK_IMAGE_URL;
const imageAlt = imagen_principal?.alternativeText || "Imagen principal de la sección";
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16">
  <div class="grid grid-cols-1 lg:grid-cols-2 min-h-screen font-sans p-4 lg:p-16 lg:pl-20 relative">
    <div class="lg:order-last">
      <img
        src={imageUrl}
        alt={imageAlt}
        class="w-full h-full object-cover min-h-[400px] lg:min-h-screen"
        loading="lazy"
        decoding="async"
      />
    </div>

    <img src={dotsPattern.src} alt="Patrón decorativo de puntos" class="absolute z-0 bottom-0 left-0 w-125 hidden lg:block" aria-hidden="true" loading="lazy" decoding="async" />
    <img src={dotsPatternSquare.src} alt="Patrón decorativo de puntos" class="absolute bottom-0 left-0 z-0 w-40 lg:hidden" aria-hidden="true" loading="lazy" decoding="async" />
    <img src={dotsPatternSquare.src} alt="Patrón decorativo de puntos" class="absolute bottom-32 left-0 z-0 w-40 lg:hidden" aria-hidden="true" loading="lazy" decoding="async" />

    <div class="bg-[var(--surface-brand-primary)] text-[var(--neutral-text-inverted)] py-8 px-0 sm:p-16 lg:p-20 relative flex flex-col justify-center">
      <div style="font-family: var(--font-shields-sans-regular);" class="z-10 p-5 lg:p-0 xl:p-0">
        <h2 class="text-xl md:text-2xl tracking-wider uppercase">{dataToRender.titulo_seccion}</h2>
        <h1 class="text-5xl md:text-7xl font-semibold uppercase my-2" style="font-family: var(--font-shields-sans-semibold) !important;">{dataToRender.titulo_principal}</h1>
        <div class="mt-6 text-base max-w-2xl" set:html={dataToRender.contentHtml} ></div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10 mt-12">
          {dataToRender.caracteristicas.map((feature) => (
            <div>
              <h3 class="flex items-center mb-2 text-[var(--accent-highlight-secondary)]">
                <i class="fas fa-circle-check text-[var(--accent-feedback-strong)] mr-3 flex-shrink-0"></i>
                {feature.titulo}
              </h3>
              <div class="text-sm opacity-90" set:html={stringifyRichText(feature.descripcion)} ></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>