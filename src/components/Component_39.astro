---
// src/components/Component_10.astro
import { stringifyRichText } from "../lib/strapi.js";
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

// 1. Definimos la interfaz para las props de Strapi
export interface Props {
  titulo_principal: string;
  color_etiqueta: string;
  descripcion: any; // Rich Text
  texto_final: any;
  Boton: Boton[];
}

// 2. Recibimos las props y definimos placeholders
const { titulo_principal, color_etiqueta, descripcion, texto_final, Boton } =
  Astro.props;

const componentButtons: Boton[] = (Boton && !Array.isArray(Boton)
  ? [Boton]
  : Boton) || [
  {
    id: 1,
    texto: "Botón CTA",
    url: "#",
    tipo: "version_1",
  },
];
const descriptionHtml = stringifyRichText(descripcion);
const texto_finalHtml = stringifyRichText(texto_final);
const placeholderDescriptionHtml = `<p><strong class="font-bold">Bienvenido a Topgolf,</strong> tu principal destino de entretenimiento. Y por destino de entretenimiento nos referimos a un lugar donde puedes venir para festejar un cumpleaños, despedidas de soltero o soltera, eventos corporativos, citas nocturnas o simplemente para divertirte con tus amigos y pasarla en grande.</p>`;
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16">
  <div
    class="mx-auto flex w-11/12 max-w-7xl flex-col items-center justify-center gap-6 text-center lg:flex-row"
  >
    <div class="flex flex-col items-center justify-center">
      <div class="relative flex items-center justify-center mb-8">
        <h2
          class="font-(family-name:--font-shields-sans-semibold-condensed) text-[var(--surface-brand-primary)] text-center text-4xl font-semibold uppercase sm:text-5xl md:text-6xl lg:text-7xl px-4 py-2"
          style={`transform: rotate(-1.66deg); background-color: ${color_etiqueta};`}
        >
          {titulo_principal || "La Experiencia"}
        </h2>
      </div>
      <div
        class="max-w-6xl font-(family-name:--font-shields-sans-regular) mt-12 text-balance text-lg font-light leading-relaxed text-[var(--neutral-text-default)] prose lg:prose-lg strapi-rich-text px-3"
      >
        <div set:html={descriptionHtml || placeholderDescriptionHtml} />
      </div>
    </div>
  </div>
  <div class="mt-10 flex flex-row items-center justify-center gap-4">
    <ButtonGroup botones={componentButtons} />
  </div>
  <div
    class="mb-10 font-(family-name:--font-shields-sans-regular) text-xs font-normal mt-8 text-center text-[var(--neutral-background-strong)] max-w-6xl mx-auto prose strapi-rich-text2 px-3"
  >
    <div set:html={texto_finalHtml || "Lorem Ipsum"} />
  </div>
</section>
<style>
  .text-shadow-md {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }
  .strapi-rich-text :global(strong) {
    color: var(--neutral-background-strong);
    font-family: var(--font-tee-line-bold-italic);
    font-weight: bold;
  }

  .strapi-rich-text :global(u) {
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .strapi-rich-text :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    color: var(--brand-interactive-base);
  }
  .strapi-rich-text2 :global(a) {
    color: var(--brand-interactive-base);
  }

  /* --- Agrega esto aquí --- */
  .strapi-rich-text :global(li::marker) {
    /* Usa la variable de color que desees para el punto/número */
    color: var(--neutral-background-strong);

    /* Opcional: Si quieres que el bullet sea más grande o negrita */
    font-weight: bold;
    font-size: 1.2em;
  }
</style>
