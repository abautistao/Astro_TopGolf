---
// src/components/Component_10.astro
import { stringifyRichText } from "../lib/strapi.js";

// 1. Definimos la interfaz para las props de Strapi
export interface Props {
  titulo_principal: string;
  subtitulo: string;
  descripcion: any; // Rich Text
  texto_final: string;
}

// 2. Recibimos las props y definimos placeholders
const {
  titulo_principal,
  subtitulo,
  descripcion,
  texto_final,
} = Astro.props;

const descriptionHtml = stringifyRichText(descripcion);
const placeholderDescriptionHtml = `<p><strong class="font-bold">Bienvenido a Topgolf,</strong> tu principal destino de entretenimiento. Y por destino de entretenimiento nos referimos a un lugar donde puedes venir para festejar un cumpleaños, despedidas de soltero o soltera, eventos corporativos, citas nocturnas o simplemente para divertirte con tus amigos y pasarla en grande.</p>`;
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 sm:py-16" style="font-family: var(--font-shields-sans-regular);">
  <div class="mx-auto flex w-11/12 max-w-7xl flex-col items-center justify-center gap-6 text-center lg:flex-row">
    <div class="flex flex-col items-center justify-center">
      <div class="relative flex items-center justify-center mb-8">
        <h2
          class="bg-[var(--accent-highlight-secondary)] text-[var(--surface-brand-primary)] text-center text-4xl font-semibold uppercase sm:text-5xl md:text-6xl lg:text-7xl px-4 py-2"
          style="transform: rotate(-1.66deg); font-family: var(--font-shields-sans-semibold) !important;"
        >
          {titulo_principal || "La Experiencia"}
        </h2>
        <h3
          class="bg-[var(--surface-brand-primary)] absolute top-[85%] text-center text-xl uppercase text-[var(--neutral-text-inverted)] px-4 py-1"
        >
          {subtitulo || "de Topgolf"}
        </h3>
      </div>
      <div class="mt-12 text-balance text-lg font-light leading-relaxed text-[var(--neutral-text-default)] prose lg:prose-lg strapi-rich-text">
          <div set:html={descriptionHtml || placeholderDescriptionHtml} />
      </div>
    </div>
  </div>
  <p class="mt-8 text-center text-lg font-bold text-[--neutral-background-strong)]">
    {texto_final || "Así es como funciona Topgolf:"}
  </p>
</section>
<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    .strapi-rich-text :global(strong) {
        color: var(--neutral-background-strong);
    }
    .strapi-rich-text :global(u) {
        text-decoration-color: var(--neutral-background-strong);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--neutral-background-strong);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: inherit;
    }
</style>
