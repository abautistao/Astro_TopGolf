---
// src/components/blu/Component_3_Blu.astro
const images = [
    { src: "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_gallery_1.jpg", text: "Blu: Experiencia de día a noche", class: "col-span-2 row-span-2" },
    { src: "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_gallery_2.jpg", text: "Momentos Diseñados para Celebrar", class: "col-span-1 row-span-1" },
    { src: "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_gallery_3.jpg", text: "Brindis bajo el Sol", class: "col-span-1 row-span-2" },
    { src: "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_gallery_4.jpg", text: "Vibra Caribeña", class: "col-span-1 row-span-1" },
];
---

<section class="w-full bg-[#eae7e2] pb-20 md:pb-32 px-6">
    <div class="max-w-[1440px] mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 grid-rows-2 gap-4 h-[600px] md:h-[800px]">
            {images.map((img, index) => (
                <div class={`relative overflow-hidden group cursor-pointer ${img.class}`}>
                    <img 
                        src={img.src} 
                        alt={img.text} 
                        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                    />
                    <!-- Overlay Gradient -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    
                    <!-- Text Overlay -->
                    <div class="absolute bottom-0 left-0 p-6 md:p-8 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                        <p class="text-white font-bold text-lg md:text-2xl leading-tight uppercase tracking-tight">
                            {img.text}
                        </p>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
