---
// src/components/blu/Component_3_Blu.astro

interface Props {
    subtitulo?: string;
    titulo?: string;
}

const { subtitulo = "La Experiencia que", titulo = "Flota en el Caribe" } =
    Astro.props;
---

<section class="w-full py-8 md:py-8 px-6 relative overflow-hidden">
    <div class="max-w-[1440px] mx-auto text-center relative z-10">
        {
            subtitulo && (
                <span class="block text-2xl md:text-4xl font-[family-name:var(--font-blu-body)] text-[var(--surface-brand-primary)] mb-1 tracking-tight">
                    {subtitulo}
                </span>
            )
        }
        {
            titulo && (
                <h2 class="text-5xl md:text-8xl font-[family-name:var(--font-blu-title)] text-[var(--surface-brand-primary)] leading-[1] md:leading-tight">
                    {titulo}
                </h2>
            )
        }
    </div>
</section>
