---
// src/components/blu/Component_6_Blu.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";
import { Image } from "astro:assets";

interface Testimonial {
    texto: string;
    autor: string;
    rol: string;
    foto: any;
}

interface Props {
    titulo: string;
    subtitulo?: string;
    citas: Testimonial[];
}

const {
    titulo = "LO QUE DICE LA VIBRA",
    subtitulo = "Sol • Música • Momentos",
    citas = [
        {
            texto: "Es una experiencia única en el medio del mar, buena vibra, música y el servicio de lo mejor, realmente un sitio para repetir en diversas ocasiones.",
            autor: "Alondra Campos",
            rol: "Pass Member",
            foto: "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/author_test.jpg"
        }
    ]
} = Astro.props;
---

<section class="relative w-full py-20 md:py-40 px-6 overflow-hidden font-[family-name:var(--font-blu-body)]">
    <!-- Background Image with Parallax effect simulation -->
    <div class="absolute inset-0 z-0">
        <Image 
            src="https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_testimonials_bg.jpg" 
            alt="Background" 
            width={1920}
            height={1080}
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-white/20"></div>
    </div>

    <div class="relative z-10 max-w-[1440px] mx-auto">
        <div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-4">
            <h2 class="text-4xl md:text-5xl font-bold text-[var(--surface-brand-primary)] uppercase tracking-tight font-[family-name:var(--font-blu-title)]">
                {titulo}
            </h2>
            {subtitulo && (
                <p class="text-lg md:text-xl text-[var(--surface-brand-primary)]/60 font-medium italic">
                    {subtitulo}
                </p>
            )}
        </div>

        <div class="max-w-4xl">
            {citas.map(cita => (
                <div class="bg-white p-8 md:p-16 shadow-2xl rounded-sm relative mb-8">
                    <i class="fa-solid fa-quote-left text-4xl md:text-6xl text-[var(--neutral-background-subtle)]/20 absolute top-8 left-8"></i>
                    
                    <blockquote class="text-xl md:text-3xl text-[var(--surface-brand-primary)] font-medium leading-relaxed mb-12 relative z-10 font-[family-name:var(--font-blu-title)] strapi-rich-text">
                        <Fragment set:html={stringifyRichText(cita.texto)} />
                    </blockquote>

                    <div class="flex items-center gap-6">
                        <Image 
                            src={getStrapiUrl(cita.foto) || cita.foto} 
                            alt={cita.autor} 
                            width={100}
                            height={100}
                            class="w-16 h-16 rounded-full object-cover border-2 border-[var(--neutral-background-subtle)]" 
                        />
                        <div>
                            <p class="text-xl font-bold text-[var(--surface-brand-primary)] uppercase tracking-tight font-[family-name:var(--font-blu-title)]">{cita.autor}</p>
                            <p class="text-sm text-[var(--surface-brand-primary)]/50 font-bold uppercase tracking-widest">{cita.rol}</p>
                        </div>
                    </div>

                    <!-- Pagination simulation -->
                    <div class="absolute bottom-8 right-16 flex gap-2">
                        <div class="w-12 h-1.5 bg-[var(--surface-brand-primary)]"></div>
                        <div class="w-3 h-1.5 bg-[var(--surface-brand-primary)]/20"></div>
                        <div class="w-3 h-1.5 bg-[var(--surface-brand-primary)]/20"></div>
                        <div class="w-3 h-1.5 bg-[var(--surface-brand-primary)]/20"></div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
