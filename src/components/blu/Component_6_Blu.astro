---
// src/components/blu/Component_6_Blu.astro
interface Props {
    titulo?: string;
    subtitulo?: string;
    citas?: any[];
}

const {
    titulo = "Lo que dice la vibra",
    subtitulo = "Sol • Música • Momentos",
    citas = [
        {
            texto: "Es una experiencia única en el medio del mar, buena vibra, música y el servicio de lo mejor, realmente un sitio para repetir en diversas ocasiones.",
            autor: "Alondra Campos",
            rol: "Pass Member",
            foto: "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/author_test.jpg"
        }
    ]
} = Astro.props;
---

<section class="relative w-full py-20 md:py-40 px-6 overflow-hidden">
    <!-- Background Image with Parallax effect simulation -->
    <div class="absolute inset-0 z-0">
        <img 
            src="https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_testimonials_bg.jpg" 
            alt="Background" 
            class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-white/20"></div>
    </div>

    <div class="relative z-10 max-w-[1440px] mx-auto">
        <div class="flex flex-col md:flex-row items-end justify-between mb-16 gap-4">
            <h2 class="text-4xl md:text-5xl font-bold text-[#012b49] uppercase tracking-tight">
                {titulo}
            </h2>
            <p class="text-lg md:text-xl text-[#012b49]/60 font-medium italic">
                {subtitulo}
            </p>
        </div>

        <div class="max-w-4xl">
            {citas.map(cita => (
                <div class="bg-white p-8 md:p-16 shadow-2xl rounded-sm relative">
                    <i class="fa-solid fa-quote-left text-4xl md:text-6xl text-[#1d91b4]/20 absolute top-8 left-8"></i>
                    
                    <blockquote class="text-xl md:text-3xl text-[#012b49] font-medium leading-relaxed mb-12 relative z-10">
                        {cita.texto}
                    </blockquote>

                    <div class="flex items-center gap-6">
                        <img 
                            src={cita.foto} 
                            alt={cita.autor} 
                            class="w-16 h-16 rounded-full object-cover border-2 border-[#1d91b4]" 
                        />
                        <div>
                            <p class="text-xl font-bold text-[#012b49] uppercase tracking-tight">{cita.autor}</p>
                            <p class="text-sm text-[#012b49]/50 font-bold uppercase tracking-widest">{cita.rol}</p>
                        </div>
                    </div>

                    <!-- Pagination simulation -->
                    <div class="absolute bottom-8 right-16 flex gap-2">
                        <div class="w-12 h-1.5 bg-[#012b49]"></div>
                        <div class="w-3 h-1.5 bg-[#012b49]/20"></div>
                        <div class="w-3 h-1.5 bg-[#012b49]/20"></div>
                        <div class="w-3 h-1.5 bg-[#012b49]/20"></div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>
