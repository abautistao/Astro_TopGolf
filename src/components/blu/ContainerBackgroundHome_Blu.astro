---
// src/components/blu/ContainerBackgroundHome_Blu.astro
import { getStrapiUrl } from "../../lib/strapi.js";
import Component_1_Blu from "./Component_1_Blu.astro";
import Component_2_Blu from "./Component_2_Blu.astro";
import Component_3_Blu from "./Component_3_Blu.astro";
import Component_4_Blu from "./Component_4_Blu.astro";
import Component_5_Blu from "./Component_5_Blu.astro";
import Component_6_Blu from "./Component_6_Blu.astro";
import Component_13_Blu from "./Component_13_Blu.astro";
import Spacer from "./Spacer.astro";

interface Props {
    fondoDesktop?: any;
    fondoMovil?: any;
    fondoFijo?: boolean;
    // Componentes individuales como campos de Strapi
    componente_1?: any;
    componente_2?: any;
    componente_3?: any;
    componente_4?: any;
    componente_5?: any;
    componente_6?: any;
    componente_13?: any;
    padding_top?: string;
}

const {
    fondoDesktop,
    fondoMovil,
    fondoFijo = false,
    componente_1,
    componente_2,
    componente_3,
    componente_4,
    componente_5,
    componente_6,
    componente_13,
    padding_top,
} = Astro.props;

const desktopUrl = getStrapiUrl(fondoDesktop);
const mobileUrl = getStrapiUrl(fondoMovil) || desktopUrl;
---

<section id="container-widget-background" class="relative z-30 w-full overflow-visible flex flex-col">
    {/* Fondo separado optimizado */}
    <div
        class:list={[
            "top-0 left-0 bg-cover bg-center bg-no-repeat pointer-events-none -z-10 custom-background-layer",
            /* Usamos siempre absolute para evitar problemas de rendering con fixed/will-change */
            "absolute w-full h-full",
        ]}
        style={{
            "--bg-desktop": `url('${desktopUrl}')`,
            "--bg-mobile": `url('${mobileUrl}')`,
        }}
    >
    </div>

    <style>
        .custom-background-layer {
            background-image: var(--bg-desktop);
        }
        @media (max-width: 768px) {
            .custom-background-layer {
                background-image: var(--bg-mobile);
            }
        }
    </style>

    {/* --- RENDERIZADO DE COMPONENTES POR SLOTS --- */}
    <div class="relative z-10 w-full">
        <Spacer height="150px" />
        {componente_1 && <Component_1_Blu {...componente_1} />}
        {componente_2 && <Component_2_Blu {...componente_2} />}
        {componente_3 && <Component_3_Blu {...componente_3} />}
        {componente_4 && <Component_4_Blu {...componente_4} />}
        {componente_5 && <Component_5_Blu {...componente_5} />}
        {componente_6 && <Component_6_Blu {...componente_6} />}
        {componente_13 && <Component_13_Blu {...componente_13} />}

        {/* Slot por si se usa de forma manual en el código */}
        <slot />
    </div>
</section>
<style define:vars={{ padding_top }}>
    #container-widget-background {
        padding-top: var(--padding_top);
    }
</style>