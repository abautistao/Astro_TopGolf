---
// src/components/blu/Component_15_Blu.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText, getBlogBySlug } from "../../lib/strapi.js";


interface Noticia {
    id: number;
    titulo: string;
    descripcion: string;
    imagen: any;
    slug?: string;
    enlace?: string;
}

interface Props {
    titulo?: string;
    blogs?: Noticia[] | { data: any[] }; // Support Array or Strapi Relation
    fondoImagen?: any;
    codigoColorFondo?: string;
}

const {
    titulo = "MÁS NOTICIAS",
    blogs: rawNoticias,
    fondoImagen,
    codigoColorFondo = "#EBE5DE",
} = Astro.props;

// Normalize 'noticias' from either direct array or Strapi relation
let noticias: Noticia[] = [];
console.log("Raw Noticias Input:", JSON.stringify(rawNoticias, null, 2));

if (rawNoticias) {
    const dataList = Array.isArray(rawNoticias) ? rawNoticias : (rawNoticias.data || []);
    
    // Async map to hydration full data if needed
    noticias = await Promise.all(dataList.map(async (item: any) => {
        // Basic attr extraction
        let attr = item.attributes || item; 
        const id = item.id || attr.id;
        const slug = attr.slug;

        // HYDRATION STRATEGY: 
        // If we have a slug but missing deep data (like SEO or Image nested objects), 
        // fetch the full blog post locally to ensure we have everything.
        // We assume if 'SEO' is missing, we probably need to fetch.
        if (slug && !attr.SEO && !attr.imagen?.data) {
             console.log(`Hydrating blog data for slug: ${slug}`);
             const fullBlog = await getBlogBySlug(slug);
             if (fullBlog) {
                 attr = fullBlog.attributes || fullBlog; // Update attributes with full data
             }
        }
        
        // SEO Fallbacks
        const seo = attr.SEO || {};
        
        return {
            id: id,
            titulo: attr.titulo || seo.metaTitle || "Sin Título",
            // Description might be rich text or plain text, or come from a specific field like 'resumen'
            // Fallback to metaDescription if main content is empty
            descripcion: attr.descripcion || attr.description || attr.resumen || attr.summary || seo.metaDescription || "", 
            // Image sources prioritized: Direct field -> SEO Image -> Fallback
            imagen: attr.imagen || attr.MainImage || attr.image || attr.imagen_destacada || attr.cover || seo.metaImage, 
            slug: attr.slug,
            enlace: attr.enlace
        };
    }));
}

// Fallback data if empty
if (noticias.length === 0) {
    noticias = [
        {
            id: 1,
            titulo: "COMO VIVIR LO MEJOR EL MAR CARIBE",
            descripcion: "Lorem ipsum dolor sit amet consectetur. Diam sed aliquet arcu eget nisl turpis amet. Vestibulum imperdiet molestie euismod dui arcu amet elit.",
            imagen: "https://placehold.co/600x600/e2e8f0/1e293b?text=News+1",
            slug: "blog-post-1"
        },
        // ... (truncated fallback for brevity in logic, but keeping full in file if needed, 
        // essentially we just want to ensure legal data structure)
        {
             id: 2,
             titulo: "EXPERIENCIAS QUE FLUYEN CON EL VIENTO",
             descripcion: "Quis quam viverra vulputate pretium morbi lobortis. Leo eu diam in id mi. Ut eget blandit velit quisque tellus neque faucibus.",
             imagen: "https://placehold.co/600x600/e2e8f0/1e293b?text=News+2",
             slug: "blog-post-2"
        },
        {
             id: 3,
             titulo: "LA MAGIA DE UN ATARDECER EN BLU",
             descripcion: "Non ultrices id adipiscing ut. Eleifend faucibus urna sed enim volutpat feugiat aenean amet sed. Tortor massa facilisis at viverra facilisi.",
             imagen: "https://placehold.co/600x600/e2e8f0/1e293b?text=News+3",
             slug: "blog-post-3"
        }
    ];
}

// Background Logic
const bgUrl = fondoImagen ? getStrapiUrl(fondoImagen) : null;
const bgColor = codigoColorFondo;

const styleAttribute = bgUrl 
  ? `background-image: url('${bgUrl}'); background-size: cover; background-position: center;` 
  : `background-color: ${bgColor};`;

---

<section class="w-full py-16 md:py-24 overflow-hidden relative" style={styleAttribute}>
    <div class="max-w-[1440px] mx-auto px-6">
        
        <!-- Header -->
        <h2 class="text-3xl md:text-5xl font-[family-name:var(--font-blu-title)] text-[var(--surface-brand-primary)] uppercase text-center mb-12 md:mb-16">
            {titulo}
        </h2>

        <!-- Carousel Container -->
        <div class="relative w-full overflow-hidden news-carousel-container">
            
            <!-- Track -->
            <div 
                id="news-track"
                class="flex transition-transform duration-500 ease-out"
                style="transform: translateX(0px);"
            >
                {noticias.map((item) => (
                    <div class="w-full md:w-1/3 px-4 flex-shrink-0">
                        <div class="flex flex-col h-full group">
                            <!-- Image -->
                            <div class="w-full h-64 md:h-120 overflow-hidden mb-6 relative">
                                {(() => {
                                    const imgSrc = getStrapiUrl(item.imagen) || item.imagen;
                                    // Ensure we have a valid source. If it's a string (URL) use <img> if needed or rely on Astro's Image to handle remote if configured.
                                    // If still undefined/null, use fallback.
                                    const finalSrc = imgSrc || "https://placehold.co/600x600/e2e8f0/1e293b?text=No+Image";
                                    
                                    return (
                                        <Image
                                            src={finalSrc}
                                            alt={item.titulo}
                                            width={600}
                                            height={600}
                                            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                                        />
                                    );
                                })()}
                            </div>
                            
                            <!-- Content -->
                            <div class="flex flex-col flex-grow">
                                <h3 class="text-xl md:text-2xl font-[family-name:var(--font-blu-title)] text-[var(--surface-brand-primary)] uppercase leading-tight mb-4">
                                    {item.titulo}
                                </h3>
                                
                                <div class="text-[var(--surface-brand-primary)] font-[family-name:var(--font-blu-body)] text-sm md:text-base leading-relaxed opacity-80 mb-4 line-clamp-4">
                                    {
                                        item.descripcion && item.descripcion.includes('<') 
                                        ? <Fragment set:html={stringifyRichText(item.descripcion)} />
                                        : <p>{item.descripcion}</p>
                                    }
                                </div>
                                
                                <a 
                                    href={item.enlace || `/blog/${item.slug}`} 
                                    class="text-[#1D91B4] font-bold font-[family-name:var(--font-blu-body)] text-sm md:text-base hover:opacity-80 mt-auto inline-block"
                                >
                                    Read More...
                                </a>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
            
            <!-- Dots -->
            <div class="flex justify-center mt-12 gap-3">
                {noticias.map((_, index) => (
                    // We render bullets based on how many "pages" or items we have. 
                    // For desktop (3 items), it's trickier. 
                    // Let's implement a simple dot per item for now, or per "slide" logic.
                    // For simplicity, one dot per item, active state handles visuals.
                    <button 
                         class="news-dot w-3 h-3 rounded-full bg-[var(--surface-brand-primary)]/20 hover:bg-[var(--surface-brand-primary)]/50 transition-colors"
                         data-index={index}
                         aria-label={`Go to slide ${index + 1}`}
                    ></button>
                ))}
            </div>

        </div>
    </div>
</section>

<script>
    function initNewsCarousel() {
        const track = document.getElementById('news-track');
        const dots = document.querySelectorAll('.news-dot');
        
        if (!track || dots.length === 0) return;
        
        const items = track.children;
        const totalItems = items.length;
        let currentIndex = 0;
        
        // Determine visible items per slide based on screen width
        const getItemsPerSlide = () => window.innerWidth >= 768 ? 3 : 1;
        
        function updateCarousel(index) {
            const itemsPerSlide = getItemsPerSlide();
            const maxIndex = totalItems - itemsPerSlide; 
            
            // Clamp index
            if (index < 0) index = 0;
            if (index > maxIndex) index = maxIndex; 
            // Loop logic (optional, but requested behavior usually implies loop or stop)
            // Let's stick to standard slider bounds for simplicity first, or loop if content duplicates.
            // Simple bound check:
            currentIndex = index;

            const itemWidthPercent = 100 / itemsPerSlide;
            const translateX = -(currentIndex * itemWidthPercent);
            
            track.style.transform = `translateX(${translateX}%)`;
            
            // Update dots
            // Logic: if 3 items visible, dot 0 represents item 0, dot 1 item 1... 
            // Often dots represent "pages".
            // Let's highlight the dot matching the starting item.
            dots.forEach((dot, i) => {
                if (i === currentIndex) {
                    dot.classList.add('bg-[var(--surface-brand-primary)]', 'w-4');
                    dot.classList.remove('bg-[var(--surface-brand-primary)]/20');
                } else {
                    dot.classList.remove('bg-[var(--surface-brand-primary)]', 'w-4');
                    dot.classList.add('bg-[var(--surface-brand-primary)]/20');
                }
            });
        }
        
        // Initial set
        updateCarousel(0);
        
        // Click events
        dots.forEach((dot, i) => {
           dot.addEventListener('click', () => {
               // Limit click to valid start indices for desktop
               const itemsPerSlide = getItemsPerSlide();
               if (i > totalItems - itemsPerSlide) {
                   updateCarousel(totalItems - itemsPerSlide);
               } else {
                   updateCarousel(i);
               }
           }); 
        });
        
        // Resize handler
        window.addEventListener('resize', () => {
            updateCarousel(currentIndex);
        });
        
        // Swipe Support
        let touchStartX = 0;
        let touchEndX = 0;
        
        track.addEventListener('touchstart', (e) => {
            touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        
        track.addEventListener('touchend', (e) => {
            touchEndX = e.changedTouches[0].screenX;
            handleSwipe();
        }, { passive: true });
        
        function handleSwipe() {
            if (touchEndX < touchStartX - 50) {
                // Next
                const itemsPerSlide = getItemsPerSlide();
                if (currentIndex < totalItems - itemsPerSlide) {
                    updateCarousel(currentIndex + 1);
                }
            }
            if (touchEndX > touchStartX + 50) {
                // Prev
                if (currentIndex > 0) {
                     updateCarousel(currentIndex - 1);
                }
            }
        }
    }
    
    // Init
    initNewsCarousel();
    document.addEventListener("astro:page-load", initNewsCarousel);
</script>
