---
// src/components/blu/Component_5_Blu.astro
import { Image } from "astro:assets";

interface GalleryItem {
    id: number;
    src: string;
    titulo: string;
    subtitulo?: string;
    tipo: "image" | "video";
}

interface Props {
    items?: GalleryItem[];
}

const {
    items = [
        {
            id: 1,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4",
            titulo: "Blu: Experiencia\nde día a noche",
            tipo: "video",
        },
        {
            id: 2,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4",
            titulo: "Experiencias\nBlu",
            tipo: "video",
        },
        {
            id: 3,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
            titulo: "Celebraciones\nFrente al Mar",
            tipo: "video",
        },
        {
            id: 4,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4",
            titulo: "Momentos\nDiseñados\npara\nCelebrar",
            tipo: "video",
        },
    ],
} = Astro.props;

// Clases de posicionamiento para el diseño de mosaico 4-items
const gridClasses = [
    "col-span-2 row-span-1", // Item 1 (Ancho)
    "col-span-1 row-span-2", // Item 2 (Alto)
    "col-span-1 row-span-1", // Item 3 (Pequeño)
    "col-span-1 row-span-1", // Item 4 (Pequeño)
];
---

<section
    class="w-full bg-[var(--surface-brand-secondary)] py-12 md:py-24 px-6 overflow-hidden"
>
    <div class="max-w-[1440px] mx-auto">
        <div
            id="experience-mosaic"
            class="grid grid-cols-2 md:grid-cols-3 gap-4 h-[700px] md:h-[800px]"
        >
            {
                items.map((item, index) => (
                    <div
                        class:list={[
                            "relative overflow-hidden group rounded-3xl cursor-pointer mosaic-item",
                            gridClasses[index] || "col-span-1 row-span-1",
                            index === 0 ? "hidden md:block" : "", // Opcional: Ocultar o reordenar en móvil si es necesario
                        ]}
                        data-index={index}
                    >
                        {/* Media Content */}
                        {item.tipo === "video" ? (
                            <video
                                src={item.src}
                                autoplay
                                loop
                                muted
                                playsinline
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                        ) : (
                            <Image
                                src={item.src}
                                alt={item.titulo}
                                width={index === 0 ? 1000 : 500}
                                height={index === 1 ? 1000 : 500}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                        )}

                        {/* Overlay Gradient always present on mobile active, active on hover on desktop */}
                        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 md:group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center text-center p-6 mosaic-overlay">
                            <h3 class="text-white text-2xl md:text-3xl font-[family-name:var(--font-blu-title)] leading-tight whitespace-pre-line transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                {item.titulo}
                            </h3>
                        </div>

                        {/* Mobile specific active state helper (shows via script) */}
                        <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-1000 md:hidden mobile-active-overlay" />
                    </div>
                ))
            }

            {
                /* Versión Móvil: Si el item 0 se ocultó, podemos añadir una versión optimizada aquí o dejar que el grid fluya */
            }
            {
                items[0] && (
                    <div class="md:hidden col-span-2 row-span-1 relative overflow-hidden rounded-3xl mosaic-item">
                        <video
                            src={items[0].src}
                            autoplay
                            loop
                            muted
                            playsinline
                            class="w-full h-full object-cover"
                        />
                        <div class="absolute inset-0 bg-black/40 opacity-0 transition-opacity duration-500 flex items-center justify-center text-center p-6 mobile-active-overlay">
                            <h3 class="text-white text-xl font-[family-name:var(--font-blu-title)] whitespace-pre-line">
                                {items[0].titulo}
                            </h3>
                        </div>
                    </div>
                )
            }
        </div>
    </div>
</section>

<style>
    /* Estilos para el estado activo en móvil */
    :global(.mosaic-item.is-active .mobile-active-overlay) {
        opacity: 1 !important;
    }

    :global(.mosaic-item.is-active h3) {
        transform: translateY(0) !important;
        opacity: 1 !important;
    }

    /* En escritorio el hover normal de Tailwind maneja todo */
</style>

<script>
    function initMosaic() {
        if (window.innerWidth >= 768) return;

        const items = document.querySelectorAll(".mosaic-item");
        let currentIndex = 0;

        function rotateActive() {
            items.forEach((item) => item.classList.remove("is-active"));

            // Elegir uno aleatorio o secuencial
            currentIndex = Math.floor(Math.random() * items.length);
            items[currentIndex].classList.add("is-active");

            // Cambiar cada 3 segundos
            setTimeout(rotateActive, 3000);
        }

        rotateActive();
    }

    // Ejecutar al cargar y en cambios de tamaño
    initMosaic();
</script>
