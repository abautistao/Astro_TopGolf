---
// src/components/blu/Component_5_Blu.astro
import { Image } from "astro:assets";

interface GalleryItem {
    id: number;
    src: string;
    titulo: string;
    subtitulo?: string;
    tipo: "image" | "video";
}

interface Props {
    items?: GalleryItem[];
}

const {
    items = [
        {
            id: 1,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4",
            titulo: "Blu: Experiencia\nde día a noche",
            tipo: "video",
        },
        {
            id: 2,
            src: "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo",
            titulo: "Experiencias\nBlu",
            tipo: "imagen",
        },
        {
            id: 3,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4",
            titulo: "Celebraciones\nFrente al Mar",
            tipo: "video",
        },
        {
            id: 4,
            src: "https://storage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4",
            titulo: "Momentos\nDiseñados\npara\nCelebrar",
            tipo: "video",
        },
    ],
} = Astro.props;

// Clases de posicionamiento para el diseño de mosaico 4-items
const gridClasses = [
    "col-span-2 row-span-1", // Item 1 (Ancho)
    "col-span-1 row-span-2", // Item 2 (Alto)
    "col-span-1 row-span-1", // Item 3 (Pequeño)
    "col-span-1 row-span-1", // Item 4 (Pequeño)
];
---

<section class="w-full py-12 md:py-24 px-6 overflow-hidden">
    <div class="max-w-[1440px] mx-auto">
        <div
            id="experience-mosaic"
            class="grid grid-cols-2 md:grid-cols-3 gap-4 h-[700px] md:h-[800px]"
        >
            {
                items.map((item, index) => (
                    <div
                        class:list={[
                            "relative overflow-hidden group rounded-xl cursor-pointer mosaic-item",
                            gridClasses[index] || "col-span-1 row-span-1",
                            index === 0 ? "hidden md:block" : "", // Opcional: Ocultar o reordenar en móvil si es necesario
                        ]}
                        data-index={index}
                    >
                        {/* Media Content */}
                        {item.tipo === "video" ? (
                            <video
                                src={item.src}
                                autoplay
                                loop
                                muted
                                playsinline
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                        ) : (
                            <Image
                                src={item.src}
                                alt={item.titulo}
                                width={index === 0 ? 1000 : 500}
                                height={index === 1 ? 1000 : 500}
                                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                        )}

                        {/* Overlay: Handles both Desktop Hover and Mobile Active state */}
                        <div class="absolute inset-0 bg-[var(--neutral-background-strong)]/70 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-start text-left p-10 mosaic-overlay">
                            <h3 class="text-white text-2xl md:text-5xl font-[family-name:var(--font-blu-title)] leading-tight whitespace-pre-line transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                {item.titulo}
                            </h3>
                        </div>
                    </div>
                ))
            }

            {
                /* Versión Móvil: Elemento extra para el item 0 si está oculto en el grid principal */
            }
            {
                items[0] && (
                    <div class="md:hidden col-span-2 row-span-1 relative overflow-hidden rounded-xl mosaic-item">
                        <video
                            src={items[0].src}
                            autoplay
                            loop
                            muted
                            playsinline
                            class="w-full h-full object-cover"
                        />
                        <div class="absolute inset-0 bg-[var(--neutral-background-strong)]/70 opacity-0 transition-opacity duration-500 flex items-center justify-start text-left p-10 mosaic-overlay">
                            <h3 class="text-white text-2xl font-[family-name:var(--font-blu-title)] whitespace-pre-line transform translate-y-4 transition-transform duration-500">
                                {items[0].titulo}
                            </h3>
                        </div>
                    </div>
                )
            }
        </div>
    </div>
</section>

<style>
    /* Estilos para el estado activo en móvil usando el mismo overlay */
    :global(.mosaic-item.is-active .mosaic-overlay) {
        opacity: 1 !important;
    }

    :global(.mosaic-item.is-active h3) {
        transform: translateY(0) !important;
    }
</style>

<script>
    function initMosaic() {
        const items = Array.from(document.querySelectorAll(".mosaic-item"));
        if (items.length < 2) return;

        // 1. Obtener orden aleatorio inicial (solo una vez al cargar)
        const indices = items.map((_, i) => i);
        for (let i = indices.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [indices[i], indices[j]] = [indices[j], indices[i]];
        }

        // 2. Crear dos grupos para alternar (ej: elementos 1 y 3 vs 2 y 4)
        const group1 = indices.filter((_, i) => i % 2 === 0);
        const group2 = indices.filter((_, i) => i % 2 !== 0);

        let showGroup1 = true;

        function togglePairs() {
            // Apagar todos
            items.forEach((item) => item.classList.remove("is-active"));

            setTimeout(() => {
                // Seleccionar grupo actual y encenderlo
                const currentGroup = showGroup1 ? group1 : group2;
                currentGroup.forEach((idx) => {
                    items[idx].classList.add("is-active");
                });

                showGroup1 = !showGroup1;

                // Reiniciar ciclo
                setTimeout(togglePairs, 2500);
            }, 1000);
        }

        togglePairs();
    }

    initMosaic();
</script>
