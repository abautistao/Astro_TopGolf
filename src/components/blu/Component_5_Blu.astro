---
// src/components/blu/Component_5_Blu.astro
interface Props {
    titulo?: string;
    imagen?: string;
    beneficios?: string[];
    precioOferta?: string;
    precioRegular?: string;
    tipo?: "navy" | "cyan";
}

const {
    titulo = "VIP de Segundo Nivel",
    imagen = "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_exp_1.jpg",
    beneficios = [
        "Cabina o espacio privado en la primer planta",
        "Cóctel de bienvenida por persona",
        "Servicio de mesero personalizado",
        "Acceso a áreas comunes",
        "Toalla de playa incluida",
    ],
    precioOferta = "$799 MXN",
    precioRegular = "$1099 MXN",
    tipo = "navy",
} = Astro.props;

const bgColor = tipo === "navy" ? "bg-[#012b49]" : "bg-[#1d91b4]";
const textColor = "text-white";
---

<div class="flex flex-col bg-white overflow-hidden shadow-xl group h-full">
    <!-- Image -->
    <div class="relative h-64 overflow-hidden">
        <img
            src={imagen}
            alt={titulo}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class={`absolute top-0 right-0 p-4 ${bgColor}`}>
            <i class="fa-solid fa-chevron-right text-white"></i>
        </div>
    </div>

    <!-- Content -->
    <div class="p-8 flex-grow flex flex-col">
        <h3
            class="text-2xl font-bold text-[#012b49] mb-6 uppercase tracking-tight"
        >
            {titulo}
        </h3>

        <ul class="space-y-3 mb-8 flex-grow">
            {
                beneficios.map((beneficio) => (
                    <li class="flex items-start gap-3 text-sm text-[#012b49]/70 leading-tight">
                        <span class="text-[#1d91b4] mt-1">•</span>
                        {beneficio}
                    </li>
                ))
            }
        </ul>

        <!-- Prices -->
        <div class="grid grid-cols-2 gap-4 border-t border-gray-100 pt-6 mb-8">
            <div class="text-center">
                <p
                    class="text-[10px] uppercase tracking-widest text-[#1d91b4] font-bold mb-1"
                >
                    Precio Oferta
                </p>
                <p class="text-xl font-bold text-[#1d91b4]">{precioOferta}</p>
            </div>
            <div class="text-center border-l border-gray-100">
                <p
                    class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-1"
                >
                    Precio Regular
                </p>
                <p class="text-xl font-bold text-gray-400 line-through">
                    {precioRegular}
                </p>
            </div>
        </div>

        <!-- Button -->
        <button
            class={`w-full py-4 ${bgColor} text-white font-bold tracking-[0.2em] uppercase transition-all hover:opacity-90 active:scale-[0.98]`}
        >
            RESERVAR AQUÍ
        </button>
    </div>
</div>
