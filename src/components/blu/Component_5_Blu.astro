---
// src/components/blu/Component_5_Blu.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi.js";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    titulo: string;
    imagen: any;
    beneficios: string[];
    precioOferta?: string;
    precioRegular?: string;
    tipo?: "navy" | "cyan";
    boton?: Boton | null;
}

const {
    titulo = "VIP de Segundo Nivel",
    imagen = "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_exp_1.jpg",
    beneficios = [
        "Cabina o espacio privado en la primer planta",
        "Cóctel de bienvenida por persona",
        "Servicio de mesero personalizado",
    ],
    precioOferta = "$799 MXN",
    precioRegular = "$1099 MXN",
    tipo = "navy",
    boton = { id: 1, texto: "RESERVAR AQUÍ", url: "#", tipo: "version_1" },
} = Astro.props;

const strapiImageUrl = getStrapiUrl(imagen) || imagen;
const bgColor =
    tipo === "navy"
        ? "bg-[var(--surface-brand-primary)]"
        : "bg-[var(--neutral-background-subtle)]";

const buttons: Boton[] = boton ? [boton] : [];
---

<div class="flex flex-col bg-white overflow-hidden shadow-xl group h-full">
    <!-- Image -->
    <div class="relative h-64 overflow-hidden">
        <Image
            src={strapiImageUrl}
            alt={titulo}
            width={600}
            height={400}
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div class={`absolute top-0 right-0 p-4 ${bgColor}`}>
            <i class="fa-solid fa-chevron-right text-white"></i>
        </div>
    </div>

    <!-- Content -->
    <div class="p-8 flex-grow flex flex-col">
        <h3
            class="text-2xl font-bold text-[var(--surface-brand-primary)] mb-6 uppercase tracking-tight font-[family-name:var(--font-blu-title)]"
        >
            {titulo}
        </h3>

        <ul class="space-y-3 mb-8 flex-grow">
            {
                beneficios.map((beneficio) => (
                    <li class="flex items-start gap-3 text-sm text-[var(--surface-brand-primary)]/70 leading-tight font-[family-name:var(--font-blu-body)]">
                        <span class="text-[var(--neutral-background-subtle)] mt-1">
                            •
                        </span>
                        {beneficio}
                    </li>
                ))
            }
        </ul>

        <!-- Prices -->
        <div class="grid grid-cols-2 gap-4 border-t border-gray-100 pt-6 mb-8">
            <div class="text-center">
                <p
                    class="text-[10px] uppercase tracking-widest text-[var(--neutral-background-subtle)] font-bold mb-1 font-[family-name:var(--font-blu-body)]"
                >
                    Precio Oferta
                </p>
                <p
                    class="text-xl font-bold text-[var(--neutral-background-subtle)] font-[family-name:var(--font-blu-body)]"
                >
                    {precioOferta}
                </p>
            </div>
            <div class="text-center border-l border-gray-100">
                <p
                    class="text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-1 font-[family-name:var(--font-blu-body)]"
                >
                    Precio Regular
                </p>
                <p
                    class="text-xl font-bold text-gray-400 line-through font-[family-name:var(--font-blu-body)]"
                >
                    {precioRegular}
                </p>
            </div>
        </div>

        <!-- Button -->
        <Button botones={buttons} clase="w-full" />
    </div>
</div>

<style>
    /* Estilos para el botón dentro del card (sobreescribiendo si es necesario) */
    :global(.w-full > a) {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
    }
</style>
