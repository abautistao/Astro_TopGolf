---
// src/components/blu/Footer.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    data?: any;
}

const { data } = Astro.props;
const logoUrl =
    getStrapiUrl(data?.logo) ||
    "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_logo_white_b9f2913e77.png";

const year = new Date().getFullYear();
---

<footer
    class="w-full bg-[var(--surface-brand-primary)] pt-16 pb-10 px-6 text-white overflow-hidden relative font-[family-name:var(--font-blu-body)]"
>
    <!-- Background element (Whale Tail / Curve) -->
    <div
        class="absolute bottom-0 right-0 md:top-0 md:right-0 opacity-10 pointer-events-none z-0"
    >
        {
            logoUrl && (
                <Image
                    src={logoUrl}
                    alt=""
                    width={800}
                    height={800}
                    class="w-[600px] md:w-[900px] h-auto grayscale object-contain translate-x-1/3 translate-y-1/3 md:translate-y-[-20%]"
                />
            )
        }
    </div>

    <div class="max-w-[1440px] mx-auto relative z-10">
        <div
            class="grid grid-cols-1 md:grid-cols-12 gap-y-12 md:gap-x-8 mb-16 md:mb-24"
        >
            <!-- 1. Logo & Socials (Desktop: Left | Mobile: Bottom) -->
            <div
                class="md:col-span-3 flex flex-col-reverse md:flex-col items-center md:items-start gap-8 md:gap-12 order-3 md:order-1"
            >
                {
                    logoUrl && (
                        <Image
                            src={logoUrl}
                            alt="Blu Ocean Club"
                            width={280}
                            height={120}
                            class="h-24 md:h-20 w-auto object-contain"
                        />
                    )
                }

                <div class="flex gap-4">
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-[var(--neutral-background-subtle)] flex items-center justify-center text-[var(--surface-brand-primary)] hover:bg-white transition-all"
                    >
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-[var(--neutral-background-subtle)] flex items-center justify-center text-[var(--surface-brand-primary)] hover:bg-white transition-all"
                    >
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-[var(--neutral-background-subtle)] flex items-center justify-center text-[var(--surface-brand-primary)] hover:bg-white transition-all"
                    >
                        <i class="fa-brands fa-tiktok"></i>
                    </a>
                    <a
                        href="#"
                        class="w-10 h-10 rounded-full bg-[var(--neutral-background-subtle)] flex items-center justify-center text-[var(--surface-brand-primary)] hover:bg-white transition-all"
                    >
                        <i class="fa-brands fa-whatsapp"></i>
                    </a>
                </div>
            </div>

            <!-- 2. Links (Desktop: Center | Mobile: Top) -->
            <div
                class="md:col-span-4 grid grid-cols-2 gap-4 md:gap-8 order-1 md:order-2"
            >
                <!-- Nosotros -->
                <div>
                    <h4
                        class="text-lg md:text-xl font-bold mb-6 text-[#75C5DB]"
                    >
                        Nosotros
                    </h4>
                    <ul class="space-y-3 md:space-y-4 text-sm opacity-80">
                        <li>
                            <a
                                href="#"
                                class="hover:text-[var(--neutral-background-subtle)] transition-colors"
                                >Home</a
                            >
                        </li>
                        <li>
                            <a
                                href="#"
                                class="hover:text-[var(--neutral-background-subtle)] transition-colors"
                                >Booking</a
                            >
                        </li>
                        <li>
                            <a
                                href="#"
                                class="hover:text-[var(--neutral-background-subtle)] transition-colors"
                                >Contacto</a
                            >
                        </li>
                    </ul>
                </div>

                <!-- Nuestros Productos -->
                <div>
                    <h4
                        class="text-lg md:text-xl font-bold mb-6 text-[#75C5DB]"
                    >
                        Nuestros Productos
                    </h4>
                    <ul class="space-y-3 md:space-y-4 text-sm opacity-80">
                        <li>
                            <a
                                href="#"
                                class="hover:text-[var(--neutral-background-subtle)] transition-colors"
                                >Productos</a
                            >
                        </li>
                        <li>
                            <a
                                href="#"
                                class="hover:text-[var(--neutral-background-subtle)] transition-colors"
                                >Galería de Fotos</a
                            >
                        </li>
                    </ul>
                </div>
            </div>

            <!-- 3. Newsletter (Desktop: Right | Mobile: Middle) -->
            <div class="md:col-span-5 order-2 md:order-3">
                <div
                    class="bg-[#215270]/40 p-8 md:p-10 rounded-3xl border border-white/5 backdrop-blur-sm"
                >
                    <h4
                        class="text-lg md:text-xl font-bold text-[#75C5DB] uppercase mb-4"
                    >
                        REGÍSTRATE PARA RECIBIR OFERTAS
                    </h4>
                    <p
                        class="text-xs md:text-sm opacity-70 mb-6 leading-relaxed"
                    >
                        Regístrate con tu correo y recibe nuestras mejores
                        ofertas, descuentos exclusivos y novedades antes que
                        nadie.
                    </p>
                    <div class="flex flex-col gap-4">
                        <Button
                            botones={[
                                {
                                    id: 1,
                                    texto: "SUSCRÍBETE",
                                    url: "#",
                                    tipo: "version_5",
                                },
                            ]}
                            clase="w-full md:w-auto"
                        />
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Footer -->
        <div
            class="border-t border-white/10 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] md:text-xs opacity-60"
        >
            <p>© {year} Blu Ocean Club all rights reserved</p>
            <div class="flex gap-6 md:gap-8">
                <a href="#" class="hover:opacity-100">Privacy Policy</a>
                <a href="#" class="hover:opacity-100">Cookie Policy</a>
                <a href="#" class="hover:opacity-100">Cookie Policy</a>
            </div>
        </div>
    </div>
</footer>

<style>
    /* Estilos para el botón dentro del footer */
    :global(.flex .w-full > a) {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
    }
</style>
