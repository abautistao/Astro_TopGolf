---
// src/components/blu/Footer.astro
import { getStrapiUrl, stringifyRichText } from "../../lib/strapi";
import { Image } from "astro:assets";
import Button from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

interface Props {
    data?: any;
}

const { data } = Astro.props;
const logoUrl =
    getStrapiUrl(data?.logo) ||
    "https://res.cloudinary.com/dmv76307y/image/upload/v1736741753/blu_logo_white_b9f2913e77.png";

const year = new Date().getFullYear();

const subscribeButton: Boton[] = [
    { id: 1, texto: "SUSCRIBIRME", url: "#", tipo: "version_1" },
];
---

<footer
    class="w-full bg-[var(--surface-brand-primary)] pt-20 pb-10 px-6 text-white overflow-hidden relative font-[family-name:var(--font-blu-body)]"
>
    <!-- Whale Tail Shadow (Design element) -->
    <div class="absolute bottom-0 right-[-10%] opacity-10 pointer-events-none">
        {
            logoUrl && (
                <Image
                    src={logoUrl}
                    alt=""
                    width={800}
                    height={500}
                    class="w-[800px] h-auto grayscale object-contain"
                />
            )
        }
    </div>

    <div class="max-w-[1440px] mx-auto relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-20">
            <!-- Company Info -->
            <div class="md:col-span-1">
                {
                    logoUrl && (
                        <Image
                            src={logoUrl}
                            alt="Blu Ocean Club"
                            width={200}
                            height={80}
                            class="h-16 w-auto mb-8 object-contain"
                        />
                    )
                }
                <div class="flex gap-4">
                    <a
                        href="#"
                        class="w-10 h-10 border border-white/20 rounded-full flex items-center justify-center hover:bg-[var(--neutral-background-subtle)] hover:border-[var(--neutral-background-subtle)] transition-all"
                    >
                        <i class="fa-brands fa-facebook-f"></i>
                    </a>
                    <a
                        href="#"
                        class="w-10 h-10 border border-white/20 rounded-full flex items-center justify-center hover:bg-[var(--neutral-background-subtle)] hover:border-[var(--neutral-background-subtle)] transition-all"
                    >
                        <i class="fa-brands fa-instagram"></i>
                    </a>
                    <a
                        href="#"
                        class="w-10 h-10 border border-white/20 rounded-full flex items-center justify-center hover:bg-[#1d91b4] hover:border-[#1d91b4] transition-all"
                    >
                        <i class="fa-brands fa-tiktok"></i>
                    </a>
                </div>
            </div>

            <!-- Links 1 -->
            <div>
                <h4
                    class="text-sm font-bold uppercase tracking-[0.2em] mb-8 text-[var(--neutral-background-subtle)] font-[family-name:var(--font-blu-title)]"
                >
                    Nosotros
                </h4>
                <ul
                    class="space-y-4 text-sm font-medium tracking-widest opacity-70"
                >
                    <li>
                        <a href="#" class="hover:opacity-100 transition-opacity"
                            >Inicio</a
                        >
                    </li>
                    <li>
                        <a href="#" class="hover:opacity-100 transition-opacity"
                            >Galería</a
                        >
                    </li>
                    <li>
                        <a href="#" class="hover:opacity-100 transition-opacity"
                            >Contacto</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Links 2 -->
            <div>
                <h4
                    class="text-sm font-bold uppercase tracking-[0.2em] mb-8 text-[var(--neutral-background-subtle)] font-[family-name:var(--font-blu-title)]"
                >
                    Nuestros Productos
                </h4>
                <ul
                    class="space-y-4 text-sm font-medium tracking-widest opacity-70"
                >
                    <li>
                        <a href="#" class="hover:opacity-100 transition-opacity"
                            >Exclusivos</a
                        >
                    </li>
                    <li>
                        <a href="#" class="hover:opacity-100 transition-opacity"
                            >Plata de Playa</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Newsletter -->
            <div class="bg-white/5 p-8 rounded-lg border border-white/10">
                <h4
                    class="text-sm font-bold uppercase tracking-[0.2em] mb-4 text-center"
                >
                    Registrate para recibir ofertas
                </h4>
                <p
                    class="text-[10px] text-center opacity-60 uppercase mb-6 leading-relaxed"
                >
                    Se de los primeros en enterarte de las mejores experiencias
                    y ofertas exclusivas.
                </p>
                <div class="flex flex-col gap-3">
                    <input
                        type="email"
                        placeholder="TU CORREO"
                        class="bg-white/10 border border-white/20 p-3 text-xs tracking-widest uppercase focus:outline-none focus:border-[var(--neutral-background-subtle)]"
                    />
                    <Button botones={subscribeButton} clase="w-full" />
                </div>
            </div>
        </div>

        <!-- Bottom Footer -->
        <div
            class="border-t border-white/10 pt-10 flex flex-col md:flex-row justify-between items-center gap-6"
        >
            <p
                class="text-[10px] uppercase font-bold tracking-[0.2em] opacity-40"
            >
                © {year} Blu Ocean Club. Todos los derechos reservados.
            </p>
            <div
                class="flex gap-8 text-[10px] uppercase font-bold tracking-[0.2em] opacity-40"
            >
                <a href="#" class="hover:opacity-100">Políticas de Privacidad</a
                >
                <a href="#" class="hover:opacity-100">Términos y Condiciones</a>
                <a href="#" class="hover:opacity-100">Cookies</a>
            </div>
        </div>
    </div>
</footer>

<style>
    /* Estilos para el botón dentro del footer */
    :global(.flex .w-full > a) {
        display: block !important;
        width: 100% !important;
        text-align: center !important;
    }
</style>
