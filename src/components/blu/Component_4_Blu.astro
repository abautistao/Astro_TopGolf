---
// src/components/blu/Component_4_Blu.astro
import Card from "./Component_5_Blu.astro";

interface Props {
    titulo?: string;
    experiencias?: any[];
}

const {
    titulo = "Experiencias que Fluyen",
    experiencias = [
        {
            titulo: "VIP de Segundo Nivel",
            tipo: "navy",
            precioOferta: "$799 MXN",
            precioRegular: "$1099 MXN",
            beneficios: [
                "Cabina o espacio privado en la primer planta",
                "Cóctel de bienvenida por persona",
                "Asientos y mesas con sombrillas",
            ],
        },
        {
            titulo: "Blu+ Platinum",
            tipo: "navy",
            precioOferta: "$1099 MXN",
            precioRegular: "$1999 MXN",
            beneficios: [
                "Ubicación preferencial",
                "Cena premium incluida",
                "Barra libre nacional",
            ],
        },
    ],
} = Astro.props;
---

<section class="w-full bg-[#f9f9f9] py-20 md:py-32 px-6">
    <div class="max-w-[1440px] mx-auto">
        <h2
            class="text-4xl md:text-5xl font-bold text-[#012b49] text-center mb-20 uppercase tracking-tight"
        >
            {titulo}
        </h2>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-10 max-w-5xl mx-auto"
        >
            {experiencias.map((exp) => <Card {...exp} />)}
        </div>
    </div>
</section>
