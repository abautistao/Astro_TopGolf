---
// src/components/Component_1.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';
// Definimos la interfaz de las props que el componente recibirá desde Strapi.
export interface Props {
    imagen_fondo: any;
    alt_imagen_fondo: string;
    logo: any;
    alt_logo: string;
    titulo: string;
    texto_banner: string;
    texto_boton: string;
    url_boton: string;
    texto_ayuda: any;
    Boton: Boton[];// Puede ser un string o un arreglo de Strapi
}

const {
    imagen_fondo,
    alt_imagen_fondo,
    logo,
    alt_logo,
    titulo,
    texto_banner,
    Boton,
    texto_ayuda,
} = Astro.props;



const heroBackgroundUrl = getStrapiUrl(imagen_fondo);
const topgolfLogoUrl = getStrapiUrl(logo);

// URLs de placeholder en caso de que no haya imagen en Strapi
const placeholderBgUrl = `https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo`;
const placeholderLogoUrl = `https://placehold.co/300x80/ffffff/2d3748?text=Logo`;

const helpTextHtml = stringifyRichText(texto_ayuda);
const buttonBanner: Boton[] = (Boton && !Array.isArray(Boton) ? [Boton] : Boton) || [
    {
        id: 1,
        texto: "Reserva Ahora",
        url: "#",
        tipo: "version_1"
    }
];
---
<section class="relative w-full min-h-[550px] md:min-h-[650px]">
    <img
        src={heroBackgroundUrl || placeholderBgUrl}
        alt={alt_imagen_fondo || "Imagen de fondo de placeholder"}
        class="absolute inset-0 object-cover w-full h-full"
    />
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Contenido central -->
    <div class="relative z-10 flex flex-col items-center justify-center h-[550px] md:h-[650px] text-center">
        <img
        src={topgolfLogoUrl || placeholderLogoUrl}
        alt={alt_logo || "Logo de placeholder"}
        class="transform w-80 -rotate-6 md:w-96"
        />
        <h1 class="-mt-4 font-extrabold tracking-tighter uppercase text-shadow-md text-7xl md:text-8xl text-[var(--neutral-text-inverted)]" style="font-family: var(--font-shields-sans-semibold);">
        {titulo || "Título de Ejemplo"}
        </h1>
    </div>

    <!-- Franja blanca dentro del section -->
    <div class="relative bg-[var(--neutral-text-inverted)] h-40">
        <div class="absolute -top-28 sm:-top-20 left-0 right-0 z-20 mx-4 md:mx-[150px] min-h-[180px] rounded-2xl bg-[var(--surface-brand-secondary)] px-4 sm:px-6 py-6 text-center shadow-lg flex flex-col items-center justify-center">

            <div class="flex flex-col items-center justify-center gap-3 px-2 py-2 text-center sm:flex-row sm:gap-4 sm:px-6">
                <p class="text-lg sm:text-2xl font-bold text-[var(--neutral-text-inverted)]" style="font-family: var(--font-tee-line-bold);">
                    {texto_banner || "Descubre la mejor manera de jugar"}
                </p>
                <ButtonGroup botones={buttonBanner} />
            </div>

            <div class="py-2 text-sm text-center text-[var(--neutral-text-inverted)] strapi-rich-text" style="font-family: var(--font-shields-sans-regular);">
                <p set:html={helpTextHtml}></p>
            </div>
        </div>
    </div>

<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    .strapi-rich-text :global(strong) {
        color: var(--accent-highlight-secondary);
    }
    .strapi-rich-text :global(u) {
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: inherit;
    }
</style>