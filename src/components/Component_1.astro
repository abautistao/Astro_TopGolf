---
// src/components/Component_1.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";

// Definimos la interfaz de las props que el componente recibirá desde Strapi.
export interface Props {
    imagen_fondo: any;
    alt_imagen_fondo: string;
    logo: any;
    alt_logo: string;
    titulo: string;
    texto_banner: string;
    texto_boton: string;
    url_boton: string;
    texto_ayuda: any; // Puede ser un string o un arreglo de Strapi
}

const {
    imagen_fondo,
    alt_imagen_fondo,
    logo,
    alt_logo,
    titulo,
    texto_banner,
    texto_boton,
    url_boton,
    texto_ayuda,
} = Astro.props;

const heroBackgroundUrl = getStrapiUrl(imagen_fondo);
const topgolfLogoUrl = getStrapiUrl(logo);

// URLs de placeholder en caso de que no haya imagen en Strapi
const placeholderBgUrl = `https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo`;
const placeholderLogoUrl = `https://placehold.co/300x80/ffffff/2d3748?text=Logo`;

const helpTextHtml = stringifyRichText(texto_ayuda);
---
<section class="relative w-full text-white min-h-[550px] md:min-h-[650px]">
    <img
        src={heroBackgroundUrl || placeholderBgUrl}
        alt={alt_imagen_fondo || "Imagen de fondo de placeholder"}
        class="absolute inset-0 object-cover w-full h-full"
    />
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Contenido central -->
    <div class="relative z-10 flex flex-col items-center justify-center h-[550px] md:h-[650px] text-center">
        <img
        src={topgolfLogoUrl || placeholderLogoUrl}
        alt={alt_logo || "Logo de placeholder"}
        class="transform w-80 -rotate-6 md:w-96"
        />
        <h1 class="-mt-4 font-extrabold tracking-tighter uppercase text-shadow-md text-7xl md:text-8xl">
        {titulo || "Título de Ejemplo"}
        </h1>
    </div>

    <!-- Franja blanca dentro del section -->
    <div class="relative bg-white h-40">
        <div class="absolute -top-20 left-0 right-0 z-20 mx-[150px] min-h-[180px] rounded-2xl bg-[var(--surface-brand-secondary)] px-6 py-6 text-center shadow-lg flex flex-col items-center justify-center">
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4 px-6 py-2 text-center">
                <p class="text-2xl font-bold text-[var(--neutral-text-inverted)]">{texto_banner || "Descubre la mejor manera de jugar"}</p>
                <a href={url_boton || '#'} class="flex-shrink-0 rounded-full bg-[var(--neutral-text-inverted)] px-6 py-2 text-sm font-bold text-[var(--surface-brand-primary)] shadow-lg transition hover:bg-gray-200">
                    {texto_boton || "RESERVA AQUÍ TU BAHÍA"}
                </a>
            </div>

            <div class="py-2 text-center text-sm">
                <p class="text-[var(--neutral-text-inverted)]">
                    <span class="text-[var(--accent-highlight-secondary)] font-bold">¿Necesitas ayuda?</span> Consulta nuestras
                    <a href="#" class="underline  text-[var(--neutral-text-inverted)] decoration-[var(--accent-highlight-secondary)] decoration-2">preguntas frecuentes</a> o
                    <a href="#" class="underline  text-[var(--neutral-text-inverted)] decoration-[var(--accent-highlight-secondary)] decoration-2">descubre cómo funciona Topgolf</a>.
                </p>
            </div>
        </div>
    </div>

<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
</style>