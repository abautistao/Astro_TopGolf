---
// src/components/Component_1.astro
import { Image } from "astro:assets";
import { getStrapiUrl } from "../lib/strapi.js";

// Definimos la interfaz de las props que el componente recibirá desde Strapi.
export interface Props {
    imagen_fondo: any;
    alt_imagen_fondo: string;
    logo: any;
    alt_logo: string;
    titulo: string;
    texto_banner: string;
    texto_boton: string;
    url_boton: string;
    texto_ayuda: any; // Puede ser un string o un arreglo de Strapi
}

const {
    imagen_fondo,
    alt_imagen_fondo,
    logo,
    alt_logo,
    titulo,
    texto_banner,
    texto_boton,
    url_boton,
    texto_ayuda,
} = Astro.props;

const heroBackgroundUrl = getStrapiUrl(imagen_fondo);
const topgolfLogoUrl = getStrapiUrl(logo);

// URLs de placeholder en caso de que no haya imagen en Strapi
const placeholderBgUrl = `https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo`;
const placeholderLogoUrl = `https://placehold.co/300x80/ffffff/2d3748?text=Logo`;


// Función para convertir el Rich Text de Strapi (JSON) a un string de HTML.
const stringifyRichText = (richText: any): string => {
  if (!richText) return '';
  if (typeof richText === 'string') return richText;

  if (Array.isArray(richText)) {
    return richText.map(block =>
      block.children.map((child: any) => {
        let text = child.text || '';
        if (child.bold) text = `<strong>${text}</strong>`;
        if (child.italic) text = `<em>${text}</em>`;
        if (child.underline) text = `<u>${text}</u>`;
        return text;
      }).join('')
    ).join('<br>');
  }
  return '';
};

const helpTextHtml = stringifyRichText(texto_ayuda);
---

<section class="relative h-[550px] w-full text-white md:h-[650px]">
    <img 
        src={heroBackgroundUrl || placeholderBgUrl} 
        alt={alt_imagen_fondo || "Imagen de fondo de placeholder"} 
        class="absolute inset-0 object-cover w-full h-full"
    />
    <div class="absolute inset-0 bg-black/30"></div>
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center">
        <img 
            src={topgolfLogoUrl || placeholderLogoUrl} 
            alt={alt_logo || "Logo de placeholder"} 
            class="transform w-80 -rotate-6 md:w-96" 
        />
        <h1 class="-mt-4 font-extrabold tracking-tighter uppercase text-shadow-md text-7xl md:text-8xl">
            {titulo || "Título de Ejemplo"}
        </h1>
    </div>

    <div class="absolute bottom-0 left-0 right-0 z-20 bg-[var(--surface-brand-secondary)] text-white">
        <div class="container flex flex-col items-center justify-between gap-4 px-6 py-2 mx-auto text-center sm:flex-row sm:text-left">
            <p class="text-lg font-semibold">{texto_banner || "Descubre la mejor manera de jugar"}</p>
            <a
                href={url_boton || '#'}
                class="flex-shrink-0 rounded-full bg-white px-5 py-1.5 text-xs font-bold text-blue-900 shadow-lg transition hover:bg-gray-200"
            >
                {texto_boton || "RESERVA AQUÍ"}
            </a>
        </div>
        <div class="bg-[var(--primary-color)] py-1 text-center text-xs">
            <p set:html={helpTextHtml || "<b>¿Necesitas ayuda?</b> Contacta con nosotros."} />
        </div>
    </div>
</section>

<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
</style>