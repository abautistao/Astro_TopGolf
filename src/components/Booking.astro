---
/**
 * @component Booking
 * @description Este componente renderiza un plugin de booking externo dentro de un <iframe>.
 * Prioriza los parámetros de la URL, pero puede usar valores preconfigurados desde Strapi como fallback.
 */
import type { HTMLAttributes } from 'astro/types';

// Interfaz de props para recibir datos desde Strapi.
export interface Props extends HTMLAttributes<'div'> {
    plugin_id?: string | null;
    user_language?: string | null;
    producto_id?: string | null;
    set_producto_id?: string | null;
    promocode?: string | null;
    set_promocode?: string | null;
    pax_min?: number | null;
    pax_max?: number | null;
    reservacion_fecha?: string | null; // Se usa string para fechas para simplificar el paso
}

const { 
    plugin_id: strapiPluginId = null, 
    user_language: strapiUserLanguage = null,
    producto_id: strapiProductoId = null,
    set_producto_id: strapiSetProductoId = null,
    promocode: strapiPromocode = null,
    set_promocode: strapiSetPromocode = null,
    pax_min: strapiPaxMin = null,
    pax_max: strapiPaxMax = null,
    reservacion_fecha: strapiReservacionFecha = null,
    ...rest 
} = Astro.props;

const vmgPluginUrl = import.meta.env.VMG_PLUGIN_URL;
---

<div id="booking-container" {...rest}>
    <!-- El contenido se generará dinámicamente por el script -->
</div>

<script define:vars={{ 
    vmgPluginUrl, 
    strapiPluginId, 
    strapiUserLanguage,
    strapiProductoId,
    strapiSetProductoId,
    strapiPromocode,
    strapiSetPromocode,
    strapiPaxMin,
    strapiPaxMax,
    strapiReservacionFecha
}}>
    document.addEventListener('DOMContentLoaded', function() {
        const container = document.getElementById('booking-container');
        if (!container) return;

        // 1. Leer parámetros desde la URL (prioridad alta).
        const searchParams = new URLSearchParams(window.location.search);
        
        // Función auxiliar para obtener el valor: URL > Strapi > null
        const getParam = (paramName, strapiValue) => {
            const urlValue = searchParams.get(paramName);
            return urlValue !== null ? urlValue : strapiValue;
        };

        const plugin_id = getParam('plugin_id', strapiPluginId);
        const user_language = getParam('user_language', strapiUserLanguage);
        const producto_id = getParam('producto_id', strapiProductoId);
        const set_producto_id = getParam('set_producto_id', strapiSetProductoId);
        const promocode = getParam('promocode', strapiPromocode);
        const set_promocode = getParam('set_promocode', strapiSetPromocode);
        const pax_min = getParam('pax_min', strapiPaxMin);
        const pax_max = getParam('pax_max', strapiPaxMax);
        const reservacion_fecha = getParam('reservacion_fecha', strapiReservacionFecha);

        // 2. Validar que los parámetros requeridos existan.
        if (!plugin_id || !user_language) {
            container.innerHTML = `
                <div class="container text-center mx-auto px-4">
                    <h1 class="text-2xl font-bold" style="font-family: var(--font-shields-sans-bold);">Faltan parámetros requeridos</h1>
                    <p class="mt-4" style="font-family: var(--font-shields-sans-regular);">
                        Asegúrate de que la URL incluya <strong>plugin_id</strong> y <strong>user_language</strong>, o que el componente esté configurado en el CMS.
                    </p>
                </div>
            `;
            return;
        }

        // 3. Crear y configurar el iframe si los parámetros son válidos.
        const iframe = document.createElement('iframe');
        iframe.id = 'booking-iframe';
        iframe.style.width = '100%';
        iframe.style.border = 'none';
        iframe.style.minHeight = '500px';
        iframe.scrolling = 'no';
        iframe.title = 'Formulario de Reservación';
        container.appendChild(iframe);

        // 4. Construir el objeto de parámetros para el script del plugin,
        //    incluyendo solo los que tienen un valor.
        const scriptParams = {
            plugin_id,
            user_language,
        };
        if (producto_id) scriptParams.producto_id = producto_id;
        if (set_producto_id) scriptParams.set_producto_id = set_producto_id;
        if (promocode) scriptParams.promocode = promocode;
        if (set_promocode) scriptParams.set_promocode = set_promocode;
        if (pax_min) scriptParams.pax_min = pax_min;
        if (pax_max) scriptParams.pax_max = pax_max;
        if (reservacion_fecha) scriptParams.reservacion_fecha = reservacion_fecha;
        
        const scriptParamsJSON = JSON.stringify(scriptParams);

        const iframeContent = `
            <!DOCTYPE html>
            <html lang="${user_language}">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0">
                <title>Booking Plugin</title>
                <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" crossorigin="anonymous">
                <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.2/css/all.min.css" rel="stylesheet">
                <style>body { visibility: hidden; min-height: 400px; }</style>
            </head>
            <body>
                <div id="pluginContainer" class="container"></div>
                <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"><\/script>
                <script>
                    jQuery(document).ready(function($) {
                        if (!'${vmgPluginUrl}') {
                            console.error('VMG_PLUGIN_URL no está configurada.');
                            return;
                        }
                        const pluginBaseUrl = 'https://${vmgPluginUrl}';
                        const scriptUrl = pluginBaseUrl + '/js/pluginscripts.js';

                        $.getScript(scriptUrl, function() {
                            "use strict";
                            $.pluginUrl = pluginBaseUrl + '/requesterv2.php';
                            $.post($.pluginUrl, ${scriptParamsJSON}, function(data, status) {
                                jQuery("#pluginContainer").html(data);
                                document.body.style.visibility = 'visible';
                            });
                        });

                        let lastHeight = 0;
                        const observer = new MutationObserver(() => {
                            const newHeight = document.body.scrollHeight;
                            if (newHeight !== lastHeight) {
                                lastHeight = newHeight;
                                window.parent.postMessage({ type: 'resize-iframe', height: newHeight }, '*');
                            }
                        });
                        observer.observe(document.body, { childList: true, subtree: true, attributes: true });
                    });
                <\/script>
            </body>
            </html>
        `;

        iframe.srcdoc = iframeContent;

        window.addEventListener('message', function(event) {
            if (event.source === iframe.contentWindow && event.data.type === 'resize-iframe') {
                iframe.style.height = event.data.height + 'px';
            }
        });
    });
</script>
