---
// src/components/Component_28.astro
import { stringifyRichText } from '../../lib/strapi.js';

// 1. Definimos las interfaces para las props de Strapi
export interface Props {
  titulo: string;
  terminos: any; // Rich Text
  subtitulo: string
  descripcion: string
  color_texto_titulo: string
  color_fondo_titulo: string
}

// 2. Recibimos las props y definimos placeholders
const { titulo, terminos, subtitulo, descripcion, color_texto_titulo, color_fondo_titulo } = Astro.props;

const placeholderData: Props = {
  titulo: "Términos y condiciones",
  terminos: [
    {
      type: "list",
      format: "unordered",
      children: [
        {
          type: "list-item",
          children: [{ type: "text", text: "Venta exclusiva en línea." }],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "El saldo de la tarjeta de regalo no es reembolsable por dinero en efectivo.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "El saldo de la tarjeta de regalo no puede transferirse a otra tarjeta.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "El monto en dinero cargado en la tarjeta de regalo se encuentra en moneda nacional (MXN).",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "Cualquier saldo cargado por el usuario podrá ser utilizado como método de pago para adquirir cualquier producto o servicio dentro de Topgolf Monterrey.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "Cualquier saldo regalado como promoción por Topgolf (en este caso las cargas de saldo, otorgarán puntos promocionales equivalentes al 10% de lo abonado) sólo podrá ser utilizado para tiempo de juego con una vigencia de 6 meses a partir de la fecha de la carga.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "El saldo en la tarjeta de regalo abonado no expira, solo el saldo promocional.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "Los puntos regalados no pueden ser utilizados el mismo día de la compra, estos serán válidos 24hrs después de la compra.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            {
              type: "text",
              text: "En caso de robo o extravío de la tarjeta de regalo, el propietario y/o titular de la misma, deberá reportarlo de inmediato a Topgolf Monterrey para llevar a cabo la cancelación del plástico y transferencia de saldo, el cual estará condicionado sin excepción a la presentación del ticket de compra original o digital, la falta de ticket deslinda a Topgolf Monterrey de llevar a cabo cualquier transferencia de saldo sin responsabilidad alguna.",
            },
          ],
        },
        {
          type: "list-item",
          children: [
            { type: "text", text: "Vigencia a diciembre de 2025.", bold: true },
          ],
        },
      ],
    },
  ],
  subtitulo: '¿Visitaste Topgolf Monterrey?',
  descripcion: '¿Visitaste Topgolf Monterrey?',
  color_texto_titulo: '#050786',
  color_fondo_titulo: 'aqua',
};

// 3. Preparamos los datos para renderizar
const tituloToRender = titulo || placeholderData.titulo;
const subtituloToRender = subtitulo || placeholderData.subtitulo;
const descripcionToRender = stringifyRichText(descripcion || placeholderData.descripcion);
const terminosHtml = stringifyRichText(terminos || placeholderData.terminos);
---

<section class="w-full bg-[var(--neutral-background-subtle)] py-12 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        { titulo && (
          <h2 id="title-component28" class="mb-4 max-w-[76%] md:max-w-[55%] !mx-auto font-(family-name:--font-shields-sans-semibold-condensed) text-center text-2xl lg:text-5xl font-bold text-[var(--neutral-background-strong)] py-2">
              {tituloToRender}
          </h2>
        )}

        {descripcion && (
          <div class="text-md mb-2 md:text-xl font-(family-name:--font-tee-line-bold-italic) text-center" set:html={descripcionToRender}></div>
        )}

        {subtitulo && (
          <h3 class="font-(family-name:--font-shields-sans-black) text-center text-xl lg:text-3xl font-bold text-[var(--neutral-background-strong)]">
              {subtituloToRender}
          </h3>
        )}
        <div class="font-(family-name:--font-shields-sans-regular) mt-8 text-[var(--neutral-background-strong)] prose max-w-none text-base md:text-lg strapi-rich-text" set:html={terminosHtml}></div>
    </div>
</section>
<style define:vars={{ color_texto_titulo, color_fondo_titulo }}>
  .prose :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
  }

  .text-shadow-md {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  .strapi-rich-text :global(strong) {
    color: var(--neutral-background-strong);
    font-family: var(--font-tee-line-bold-italic);
    font-weight: bold;
  }

  .strapi-rich-text :global(u) {
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .strapi-rich-text :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    color: var(--brand-interactive-base);
  }

  /* --- Agrega esto aquí --- */
  .strapi-rich-text :global(li::marker) {
    color: var(--neutral-background-strong);
    font-weight: bold;
    font-size: 1.2em;
  }

  #title-component28 {
    color: var(--color_texto_titulo);
    background-color: var(--color_fondo_titulo);
  }
</style>
