---
// src/components/Component_25.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';

const FALLBACK_IMAGE_URL = "https://placehold.co/600x400/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Definimos las interfaces para las props de Strapi
export interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
}

export interface Props {
    tag: string;
    titulo_linea_1: string;
    titulo_linea_2: string;
    contenido: any; // Rich Text
    texto_boton: string;
    url_boton: string;
    imagen: StrapiMedia | null;
    Boton: Boton[];
}

// 2. Recibimos las props y definimos placeholders
const { tag, titulo_linea_1, titulo_linea_2, contenido, texto_boton, url_boton, imagen, Boton } = Astro.props;

const placeholderData: Props = {
  tag: "JUEGOS DE TOPGOLF MONTERREY",
    titulo_linea_1: "¡REGALA",
    titulo_linea_2: "DIVERSIÓN!",
    contenido: [
        { type: 'paragraph', children: [{ type: 'text', text: "Contenido de ejemplo para la descripción." }] }
    ],
    texto_boton: "COMPRA TU TARJETA DE REGALO",
    url_boton: "#",
    imagen: null,
    Boton: []
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
    tag: tag || placeholderData.tag,
    titulo_linea_1: titulo_linea_1 || placeholderData.titulo_linea_1,
    titulo_linea_2: titulo_linea_2 || placeholderData.titulo_linea_2,
    contenido: stringifyRichText(contenido || placeholderData.contenido),
    texto_boton: texto_boton || placeholderData.texto_boton,
    url_boton: url_boton || placeholderData.url_boton,
};

const imageUrl = (imagen
    ? getStrapiUrl(imagen)
    : null) || FALLBACK_IMAGE_URL;
const imageAlt = imagen?.alternativeText || "Imagen descriptiva";
const componentButtons: Boton[] = (Boton && !Array.isArray(Boton) ? [Boton] : Boton) || [
    {
        id: 1,
        texto: texto_boton || dataToRender.texto_boton,
        url: url_boton || dataToRender.url_boton,
        tipo: "version_3"
    }
];
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-12 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-10 items-center">
            <div class="bg-[var(--neutral-text-inverted)] p-4 md:p-12 text-left z-10 order-last lg:order-first">
                <span class="font-(family-name:--font-shields-sans-bold) inline-block bg-[var(--surface-brand-primary)] text-[var(--accent-highlight-secondary)] text-xs font-bold tracking-wider uppercase px-3 py-1 rounded">
                    {dataToRender.tag}
                </span>
                <h1 class="text-[28px] sm:text-[82px] font-(family-name:--font-shields-sans-semibold-condensed) font-semibold uppercase mt-4 leading-none text-[var(--neutral-background-strong)] break-words">
                    {dataToRender.titulo_linea_1} <br class="hidden lg:block"/>
                    <span class="text-[var(--neutral-backßground-strong)]">{dataToRender.titulo_linea_2}</span>
                </h1>
                <div  class="font-(family-name:--font-shields-sans-regular)  mb-6 mt-6 text-base lg:text-lg text-[var(--neutral-background-strong)] max-w-lg prose" set:html={dataToRender.contenido}></div>
                <div class="mt-4 w-full">
                    <ButtonGroup
                        botones={componentButtons}
                        clase="flex flex-row items-start gap-4 whitespace-nowrap"
                    />
                </div>
            </div>
            <div class="flex justify-center items-center h-full order-first lg:order-last">
                <Image src={imageUrl} alt={imageAlt} class="w-full h-auto max-w-xl" inferSize={true} />
            </div>
        </div>
    </div>
</section>

<style>
    .prose :global(p) {
        color: var(--neutral-background-strong);
        margin: 0;
    }
    .prose :global(a) {
        color: var(--neutral-background-strong);
        font-weight: 700;
    }
    .prose :global(a:hover) {
        text-decoration: underline;
    }
</style>