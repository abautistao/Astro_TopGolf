---
// src/components/Component_29.astro
import { getStrapiUrl, stringifyRichText, getHeadingTag } from '../../lib/strapi.js';

const FALLBACK_IMAGE_URL = "https://placehold.co/1920x500/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Definimos las interfaces para las props de Strapi
export interface StrapiMedia {
  id: number;
  url: string;
  alternativeText: string | null;
}

export interface Props {
  titulo: string;
  descripcion: any; // Rich Text
  imagen_fondo: StrapiMedia | null;
  imagen_superpuesta: StrapiMedia | null;
  nivel_heading?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

// 2. Recibimos las props y definimos placeholders
const { titulo, descripcion, imagen_fondo, imagen_superpuesta, nivel_heading } = Astro.props;

const placeholderData: Props = {
  titulo: "MEMBRESÍAS",
  descripcion: [{ type: 'paragraph', children: [{ type: 'text', text: "Contenido de ejemplo para la sección de membresías." }] }],
  imagen_fondo: null,
  imagen_superpuesta: null,
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
  titulo: titulo || placeholderData.titulo,
  descripcion: stringifyRichText(descripcion || placeholderData.descripcion),
};

const backgroundImageUrl = imagen_fondo
    ? getStrapiUrl(imagen_fondo)
    : FALLBACK_IMAGE_URL;

// La imagen superpuesta es opcional y puede no tener fallback
const overlayImageUrl = imagen_superpuesta
    ? getStrapiUrl(imagen_superpuesta)
    : '';

const HeadingTag = getHeadingTag(nivel_heading);
---

<section class="relative w-full text-(--neutral-text-inverted) bg-cover bg-center md:bg-top bg-no-repeat" style={`background-image: url(${backgroundImageUrl})`}>
    {overlayImageUrl && <div class="absolute inset-0 bg-cover bg-center opacity-60" style={`background-image: url(${overlayImageUrl})`}></div>}

    <div class="relative max-w-7xl mx-auto flex items-center min-h-[500px] px-4 sm:px-6 lg:px-8">
        <div class="text-left max-w-3xl lg:mr-auto">
            <HeadingTag class="text-5xl md:text-[90px] font-bold uppercase leading-tight break-words font-(family-name:--font-shields-sans-condensed)">
                {dataToRender.titulo}
            </HeadingTag>
            <div class="mt-6 text-base break-words prose font-(family-name:--font-shields-sans-regular)" set:html={dataToRender.descripcion}>
            </div>
        </div>
    </div>
</section>

<style>
    .prose :global(p) {
        color: var(--neutral-text-inverted);
    }
</style>