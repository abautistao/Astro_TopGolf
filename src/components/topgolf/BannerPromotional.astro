---
// src/components/BannerPromotional.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import type { Boton } from "./elements/Button.astro";
import ButtonGroup from "./elements/Button.astro";

interface Props {
    titulo_principal?: string;
    titulo_secundario?: string;
    descripcion?: any;
    texto_resaltado?: string;
    imagen?: any;
    background: string
    Boton: Boton[];
}

const {
    titulo_principal,
    titulo_secundario,
    descripcion,
    texto_resaltado,
    imagen,
    background,
    Boton,
} = Astro.props;

const imagen_url = getStrapiUrl(imagen);
const descripcionHtml = stringifyRichText(descripcion);
const componentButtons: Boton[] = (Boton && !Array.isArray(Boton)
  ? [Boton]
  : Boton) || [
  {
    id: 1,
    texto: "RESERVA AQUÍ TU BAHÍA",
    url: "#",
    tipo: "version_1",
  },
];
// Fallback data
const data = {
    titulo_principal: titulo_principal || "",
    titulo_secundario: titulo_secundario || "",
    descripcion:
        descripcionHtml ||
        "Y lo mejor... ¡disfruta de DJ en vivo todos los viernes y sábados desde las 8 PM!",
    texto_resaltado: texto_resaltado || "Tráete ropa blanca para tu foto neón",
    imagen:
        imagen_url ||
        "https://s3-intl.topgolf.com/mexico/IMAGEN-POSADAS-948-x-374.png",
    background: background || '#0000EE',
};
---

<div id="promotional-banner" class="w-full overflow-hidden relative font-sans text-white">
    <!-- Contenido Flexible -->
    <div
        class="flex flex-col md:flex-row w-full mx-auto items-center relative z-20"
    >
        <!-- SECCIÓN IMAGEN (Izquierda en Desktop / Arriba en Mobile) -->
        <div class="w-full md:w-1/2 relative">
            <div
                class="relative w-full h-64 md:h-[400px] overflow-hidden bg-gray-900 shadow-2xl"
            >
                <Image
                    src={data.imagen}
                    alt="foto"
                    class="w-full h-full object-cover object-center opacity-90 hover:scale-105 transition-transform duration-700"
                    inferSize={true}
                />
            </div>
        </div>

        <!-- SECCIÓN TEXTO (Derecha en Desktop / Abajo en Mobile) -->
        <div
            class="w-full md:w-1/2 text-left flex flex-col justify-center px-4 md:px-10 py-8 md:py-0"
        >
            <!-- Título Secundario -->
            <h2
                class="text-5xl md:text-5xl font-medium tracking-wider uppercase mb-3 font-(family-name:--font-shields-sans-regular)"
            >
                {data.titulo_secundario}
                <span class="text-5xl md:text-5xl font-black uppercase leading-none mb-6 font-(family-name:--font-shields-sans-black)">
                    {data.titulo_principal}
                </span>
            </h2>

            <!-- Párrafo Descriptivo -->
            <div
                class="text-base md:text-lg font-light leading-relaxed opacity-90 space-y-4 font-(family-name:--font-shields-sans-regular)"
            >
                <div class="strapi-rich-text" set:html={data.descripcion} />
            </div>

            <div class="mt-5">
                {Boton && (
                    <ButtonGroup
                        botones={componentButtons}
                        clase="flex flex-col items-start"
                    />
                )}
            </div>
        </div>
    </div>
</div>

<style define:vars={{ background }}>
    /* Patrón de puntos personalizado */
    .dot-pattern {
        background-image: radial-gradient(#00ffff 2px, transparent 2px);
        background-size: 20px 20px; /* Espaciado entre puntos */
        width: 160px; /* Ancho del área de puntos */
        height: 160px; /* Alto del área de puntos */
    }

    /* Estilos para Rich Text */
    .strapi-rich-text :global(p) {
        margin-bottom: 1rem;
    }
    .strapi-rich-text :global(strong) {
        font-weight: 700;
        font-family: var(--font-tee-line-bold);
    }

    #promotional-banner {
        background-color: var(--background);
    }
</style>
