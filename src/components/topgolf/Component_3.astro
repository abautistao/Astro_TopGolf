---
// src/components/Component_3.astro

import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

export interface Props {
  pre_titulo: string;
  titulo: string;
  contenido: any;
  imagen_superior: any;
  alt_imagen_superior: string;
  imagen_inferior_izquierda: any;
  alt_imagen_inferior_izquierda: string;
  imagen_inferior_derecha: any;
  alt_imagen_inferior_derecha: string;
  Boton: Boton[];
}

const {
  pre_titulo,
  titulo,
  contenido,
  imagen_superior,
  alt_imagen_superior,
  imagen_inferior_izquierda,
  alt_imagen_inferior_izquierda,
  imagen_inferior_derecha,
  alt_imagen_inferior_derecha,
  Boton,
} = Astro.props;

const imageUrl1 = getStrapiUrl(imagen_superior);
const imageUrl2 = getStrapiUrl(imagen_inferior_izquierda);
const imageUrl3 = getStrapiUrl(imagen_inferior_derecha);
const contentHtml = stringifyRichText(contenido);

const placeholderUrl1 =
  "https://placehold.co/800x600/a0aec0/ffffff?text=Imagen+1";
const placeholderUrl2 =
  "https://placehold.co/400x400/a0aec0/ffffff?text=Imagen+2";
const placeholderUrl3 =
  "https://placehold.co/400x400/a0aec0/ffffff?text=Imagen+3";
const componentButtons: Boton[] = (Boton && !Array.isArray(Boton)
  ? [Boton]
  : Boton) || [
  {
    id: 1,
    texto: "RESERVA AQUÍ TU BAHÍA",
    url: "#",
    tipo: "version_3",
  },
];
---
<section class="content relative bg-[var(--neutral-background-subtle)]">
  <div class="mx-auto bg-transparent overflow-hidden pt-8 lg:pt-16 pb-8 lg:pb-16 pl-4 md:pl-8 lg:pl-16 pr-4 md:pr-8 lg:pr-0">
    <div class="-mt-8 md:mt-0 md:grid md:grid-cols-12 md:gap-8">
      <div class="absolute top-0 left-0 w-full h-8 md:hidden bg-white dark:bg-brand-navy"></div>
      <div class="-mx-4 md:m-0 md:row-start-1 md:col-span-7 relative z-0 md:col-start-6">
        <div class="size-full grid grid-rows-5 md:grid-rows-6 grid-cols-5 gap-4 md:gap-6">
          <div class="col-span-2 row-span-2 col-start-2 md:col-start-2">
            <Image
              src={imageUrl1 || placeholderUrl1}
              alt={alt_imagen_superior || "Imagen de mujer comiendo"}
              class="size-full object-cover object-center"
              inferSize={true}
            />
          </div>
          <div class="col-span-3 row-start-3 row-span-3 md:row-span-4 col-start-1">
            <Image
            src={imageUrl2 || placeholderUrl2}
            alt={alt_imagen_inferior_izquierda || "Personas celebrando"}
            class="size-full object-cover object-center"
            inferSize={true}
          />
          </div>
          <div class="mb-4 md:mb-0 col-span-2 row-span-4 row-start-2 col-start-4">
            <Image
            src={imageUrl3 || placeholderUrl3}
            alt={alt_imagen_inferior_derecha || "Familia en Topgolf"}
            class="size-full object-cover object-center"
            inferSize={true}
          />
          </div>
        </div>
      </div>
      <div class="mt-8 md:m-0 lg:py-12 xl:py-24 md:row-start-1 md:col-span-5 flex flex-col justify-center relative z-10 md:col-start-1">
        <div class="md:pr-6">
          <h2 class="mb-4 uppercase ">
            <span class="block font-(family-name:--font-shields-sans-condensed) text-4xl md:text-6xl">{pre_titulo || "ES GOLF. NO ES GOLF."}</span>
            <span class="block tracking-normal uppercase text-4xl md:text-6xl font-semibold text-[var(--brand-interactive-base)] font-(family-name:--font-shields-sans-semibold-condensed)">{titulo || "ES TOPGOLF"}</span>
          </h2>
         
          <div
            class="font-(family-name:--font-shields-sans-regular)"
            set:html={contentHtml ||
              "<p>Aquí en Topgolf, no hay presión para tener un buen swing de golf o sumar muchos puntos. <strong>Se trata de que todos se diviertan.</strong></p><p>Reúne todo esto en un mismo lugar y lo pasarás genial.</p>"}
          />
          <div class="mt-5">
          <ButtonGroup
            botones={componentButtons}
            clase="flex flex-col items-start"
          />
        </div>
        </div>
      </div>
    </div>
  </div>
</section>
<style>
  .text-shadow-md {
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }
  .strapi-rich-text :global(strong) {
    color: var(--surface-brand-primary);
    font-family: var(--font-tee-line-bold-italic);
    font-weight: bold;
  }
  .strapi-rich-text :global(u) {
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .strapi-rich-text :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    color: inherit;
  }
</style>