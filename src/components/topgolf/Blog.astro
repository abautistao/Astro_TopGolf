---
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText, formatUrl, getHeadingTag } from "../../lib/strapi.js";

interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
}

interface Blog {
    id: number;
    titulo: string;
    extract: string;
    image: StrapiMedia;
    image_mobile: StrapiMedia;
    slug?: string;
}

interface Props {
    titulo?: string;
    blogs?: Blog[] | { data: any[] }; // Support Array or Strapi Relation
    background?: string;
    filas?: number; // New prop for number of rows
    description: any
    nivel_heading?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    nivel_heading_blogs?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}


const {titulo, blogs, background, description, nivel_heading, nivel_heading_blogs } = Astro.props

const backgroundSection = background ? background : '#FFFFFF';
const FALLBACK_IMAGE_URL =
    "https://placehold.co/600x400/4a5568/ffffff?text=Promoción";

let noticias: Blog[] = [];


if(blogs) {
    const dataList = Array.isArray(blogs) ? blogs : (blogs.data || []);

    // Async map to hydration full data if needed
    noticias = await Promise.all(dataList.map(async (item: Blog) => {
        


        return {
            id: item.id,
            titulo:  item.titulo,
            extract: item.extract,
            image: item.image,
            image_mobile: item.image_mobile,
            slug: `/blog/${item.slug}`,
        }
    }));
}


const HeadingTag = getHeadingTag(nivel_heading);
const HeadingTagBlogs = getHeadingTag(nivel_heading_blogs);
---
<section id="blog-section" class="w-full py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 font-(family-name:--font-shields-sans-regular)">
        <div class="text-center mb-12">
            <HeadingTag class="font-(family-name:--font-shields-sans-semibold-condensed) text-[32px] sm:text-[42px] font-semibold text-(--neutral-background-strong) leading-none
                tracking-[0]">
                {titulo}
            </HeadingTag>

            {description && (
                <div set:html={stringifyRichText(description)} class="font-(family-name:--font-shields-sans-regular) mt-4 mx-auto text-base text-(--neutral-background-strong) prose"></div>
            )}
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                noticias.map((post) => {
                    const imageUrl = (post.image
                        ? getStrapiUrl(post.image)
                        : null) || FALLBACK_IMAGE_URL;

                    const imageAlt =
                        post.image?.alternativeText || post.titulo;


                    const imageUrlMobile = (post.image_mobile
                        ? getStrapiUrl(post.image_mobile)
                        : null) || FALLBACK_IMAGE_URL;

                    const imageAltMobile =
                        post.image_mobile?.alternativeText || post.titulo;

                    return (
                        <a
                            href={formatUrl(post.slug)}
                            class="group flex flex-col bg-(--neutral-background-subtle) shadow-md hover:shadow-xl transition-all duration-300 ease-in-out overflow-hidden hover:no-underline"
                        >
                            <div class="relative mb-4">
                                <Image
                                    src={imageUrl}
                                    alt={imageAlt}
                                    class="w-full h-52 object-cover object-center group-hover:scale-105 transition-transform duration-300 ease-in-out hidden md:block"
                                    inferSize={true}
                                />

                                <Image
                                    src={imageUrlMobile}
                                    alt={imageAltMobile}
                                    class="w-full object-cover object-center group-hover:scale-105 transition-transform duration-300 ease-in-out block md:hidden"
                                    inferSize={true}
                                />
                            </div>

                            <div class="font-(family-name:--font-shields-sans-regular) p-6 pt-0 grow flex justify-between items-start tracking-[0px]">
                                <div class="flex-1 pr-4">
                                    <HeadingTagBlogs class="text-[22px] md:text-[26px] leading-tight text-(--brand-interactive-base)">
                                        {post.titulo}
                                    </HeadingTagBlogs>
                                    <p
                                        class="mt-3 text-base text-(--neutral-background-strong)"
                                    >{post.extract}</p>
                                </div>
                                <div class="shrink-0 pt-1">
                                    <i class="fa-solid fa-chevron-right text-2xl text-(--feedback-positive-base)" />
                                </div>
                            </div>

                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
<style define:vars={{ backgroundSection }}>
    #blog-section {
        background: var(--backgroundSection);
    }
</style>