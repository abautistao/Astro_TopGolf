---
// src/components/Component_46.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import "@fancyapps/ui/dist/fancybox/fancybox.css";

export interface GaleriaItem {
    image: string
    title: string;
    is_video: boolean
    cover: string
    is_youtube: boolean
    youtube_url: string
}

export interface CategoriasGaleria {
    label: string
    description: string
    GaleriaItem: GaleriaItem[]
}

export interface Props {
    titulo_seccion: string;
    descripcion_seccion: any; // Rich Text
    categorias_galeria: CategoriasGaleria[]
}

// 2. Recibimos las props y definimos placeholders
const { titulo_seccion, descripcion_seccion, categorias_galeria } = Astro.props;


const placeholderImage = "https://placehold.co/600x400?text=No+Image";
---

<section class="w-full bg-(--neutral-text-inverted) py-12 sm:py-16" x-data="{ activeTab: 0 }">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 font-(family-name:--font-shields-sans-regular)">
        <div class="text-center mb-12">
            <h2 class="font-(family-name:--font-shields-sans-semibold-condensed) text-[28px] sm:text-[38px] font-semibold text-(--neutral-background-strong) leading-none
                tracking-[0]">
                {titulo_seccion}
            </h2>
            {descripcion_seccion && (
                <div class="font-(family-name:--font-shields-sans-regular) mt-4 mx-auto text-base text-(--neutral-background-strong) prose" set:html={stringifyRichText(descripcion_seccion)}></div>
            )}
        </div>

        <div class="flex flex-wrap border border-(--brand-interactive-base) mb-10">
            {categorias_galeria.map((cat: CategoriasGaleria, index: number) => {
                if(cat.label)
                    return (
                        <button
                            class="flex-1 py-3 px-6 text-center text-base lg:text-xl font-bold uppercase transition-colors duration-300 font-(family-name:--font-shields-sans-semibold-condensed) border-r border-(--brand-interactive-base) last:border-r-0 hover:bg-(--brand-interactive-base) hover:text-(--accent-feedback-strong)"
                            :class={`activeTab === ${index} ? 'bg-[var(--brand-interactive-base)] text-[var(--accent-feedback-strong)]' : 'text-base bg-transparent'`}
                            @click={`activeTab = ${index}`}
                        >
                            {cat.label}
                        </button>
                    )
            })}
        </div>
        <div>
            {categorias_galeria.map((cat: CategoriasGaleria, index: number) => (
                <div x-show={`activeTab === ${index}`} style="display: none;">
                    <div class="font-(family-name:--font-shields-sans-regular) mt-4 text-center mx-auto text-base text-(--neutral-background-strong) prose" set:html={stringifyRichText(cat.description)}></div>

                    <div id="gallery-grid" class="mt-10 grid gap-8 grid-cols-1 md:grid-cols-3">
                        {cat.GaleriaItem.map((gallery) => {
                            if(gallery.is_video) {
                                return (
                                    <a href={gallery.is_youtube ? gallery.youtube_url : getStrapiUrl(gallery.image)} data-fancybox="gallery" data-caption={gallery.title} class="relative">
                                        <Image
                                            src={getStrapiUrl(gallery.cover) || placeholderImage}
                                            alt={gallery.title}
                                            inferSize={true}
                                        />
                                        <!-- BOTÓN DE PLAY -->
                                        <button
                                            id="play-btn"
                                            class="absolute inset-0 !m-auto bg-white text-purple-600 rounded-full w-12 h-12 flex items-center justify-center shadow-2xl hover:cursor-pointer"
                                        >
                                            <svg
                                                class="w-8 h-8"
                                                fill="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path d="M8 5v14l11-7z"></path>
                                            </svg>
                                        
                                        </button>
                                    </a>
                                )
                            } else {
                                return (

                                <a href={getStrapiUrl(gallery.cover) || placeholderImage} data-fancybox="gallery" data-caption={gallery.title}>
                                    <Image 
                                        src={getStrapiUrl(gallery.cover) || placeholderImage} 
                                        alt={gallery.title} 
                                        inferSize={true} 
                                    />
                                </a>
                                )
                            }
                        })}
                        
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<script >
    import { Fancybox } from "@fancyapps/ui/dist/fancybox/";
    Fancybox.bind("[data-fancybox]", {});
</script>