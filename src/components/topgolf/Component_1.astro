---
// src/components/Component_1.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";
import BookingBox from "./elements/BookingBox.astro";
// Definimos la interfaz de las props que el componente recibirá desde Strapi.
export interface Props {
    imagen_fondo: any;
    alt_imagen_fondo: string;
    logo: any;
    alt_logo: string;
    titulo: string;
    texto_banner: string;
    texto_boton: string;
    url_boton: string;
    texto_ayuda: any;
    Boton: Boton[]; // Puede ser un string o un arreglo de Strapi
    url_submit_booking: string;
    showBookingBox: boolean
}

const {
    imagen_fondo,
    alt_imagen_fondo,
    logo,
    alt_logo,
    titulo,
    texto_banner,
    Boton,
    texto_ayuda,
    showBookingBox,
    url_submit_booking
} = Astro.props;

const heroBackgroundUrl = getStrapiUrl(imagen_fondo);
const topgolfLogoUrl = getStrapiUrl(logo);

// URLs de placeholder en caso de que no haya imagen en Strapi
const placeholderBgUrl = `https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo`;
const placeholderLogoUrl = `https://placehold.co/300x80/ffffff/2d3748?text=Logo`;

const helpTextHtml = stringifyRichText(texto_ayuda);
const buttonBanner: Boton[] = (Boton && !Array.isArray(Boton)
    ? [Boton]
    : Boton) || [
    {
        id: 1,
        texto: "Reserva Ahora",
        url: "#",
        tipo: "version_1",
    },
];

const isVideo = (url: string | undefined | null) => {
    if (!url) return false;
    const cleanUrl = url.split("?")[0].toLowerCase();
    return (
        cleanUrl.endsWith(".mp4") ||
        cleanUrl.endsWith(".webm") ||
        cleanUrl.endsWith(".ogg") ||
        cleanUrl.endsWith(".mov")
    );
};

const showVideo = isVideo(heroBackgroundUrl);
---

<section class="relative w-full min-h-[550px] md:min-h-[650px]">
    {
        showVideo ? (
            <video
                src={heroBackgroundUrl}
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                fetchpriority="high"
                class="absolute inset-0 w-full h-full object-cover"
            />
        ) : (
            <Image
                src={heroBackgroundUrl || placeholderBgUrl}
                alt={alt_imagen_fondo || "Imagen de fondo de placeholder"}
                class="absolute inset-0 object-cover w-full h-full"
                inferSize={true}
                loading="eager"
                fetchpriority="high"
            />
        )
    }
    <div class="absolute inset-0 bg-black/30"></div>

    <!-- Contenido central -->
    <div
        class="relative z-10 flex flex-col items-center justify-center h-[550px] md:h-[500px] text-center"
    >
        <Image
            src={topgolfLogoUrl || placeholderLogoUrl}
            alt={alt_logo || "Logo de placeholder"}
            class="transform w-50 md:w-80 z-20"
            inferSize={true}
        />
        <h1
            class="leading-none font-(family-name:--font-shields-sans-semibold-condensed) mt-2 md:-mt-10 tracking-normal uppercase text-shadow-md text-[var(--neutral-text-inverted)] font-semibold text-7xl text-center max-w-xs lg:text-left lg:max-w-none lg:text-[155px]"
        >
            {titulo || "Título de Ejemplo"}
        </h1>
    </div>

    <!-- Franja blanca dentro del section -->
    <div class:list={[
        'relative bg-[var(--neutral-text-inverted)] h-55 md:h-40',
    ]}>
        <div
            class:list={[
                'absolute z-20 rounded-2xl bg-[var(--surface-brand-secondary)] px-6 sm:px-10 py-6 text-center shadow-lg mx-4',
                {
                    'min-h-[180px] left-0 right-0 flex flex-col items-center justify-center md:mx-[150px] -top-28  sm:-top-20 ': !showBookingBox,
                    'block -top-30 md:-top-18 md:left-[50%] md:translate-x-[-50%]': showBookingBox
                }
            ]}
        >
            {showBookingBox ? (
                <BookingBox url_submit={url_submit_booking}/>
            ) : (
                <div
                    class="flex flex-col items-center justify-center gap-3 px-2 py-2 text-center sm:flex-row sm:gap-4 sm:px-6"
                >
                    <p
                        class="tracking-normal text-lg sm:text-2xl font-bold text-[var(--neutral-text-inverted)] font-(family-name:--font-tee-line-bold-italic)"
                    >
                        {texto_banner || "Descubre la mejor manera de jugar"}
                    </p>
                    <ButtonGroup botones={buttonBanner} />
                </div>
    
            )}
                <div
                    id="texto_ayuda"
                    class="py-2 text-normal font-sm text-center text-[var(--neutral-text-inverted)] strapi-rich-text font-(family-name:--font-shields-sans-regular)"
                >
                    <p set:html={helpTextHtml} />
                </div>
        </div>
    </div>
</section>
<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    .strapi-rich-text :global(strong) {
        color: var(--accent-highlight-secondary);
        font-family: var(--font-tee-line-bold-italic);
        font-weight: bold;
    }
    .strapi-rich-text :global(u) {
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: inherit;
    }
</style>
