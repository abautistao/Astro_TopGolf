---
// src/components/Component_24.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText, getHeadingTag } from '../../lib/strapi.js';
import dotsPatternMobile from '../../assets/Artwork_1.png';
import ArtworkSquare12 from '../../assets/Artwork_square_12_dot.png';
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';
const FALLBACK_IMAGE_URL = "https://placehold.co/760x500/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Definimos las interfaces para las props de Strapi
export interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
}

export interface Props {
    imagen_principal: StrapiMedia | null;
    titulo: string;
    descripcion: any; // Rich Text
    texto_boton: string;
    url_boton: string;
    Boton: Boton[];
    nivel_heading?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    
}

// 2. Recibimos las props y definimos placeholders
const { imagen_principal, titulo, descripcion, texto_boton, url_boton, Boton, nivel_heading } = Astro.props;

const placeholderData: Props = {
    titulo: "¡JUGAR GOLF NUNCA SERÁ IGUAL!",
    descripcion: [{ type: 'paragraph', children: [{ type: 'text', text: "Contenido de ejemplo para la descripción." }] }],
    texto_boton: "MÁS INFORMACIÓN",
    url_boton: "#",
    imagen_principal: null,
    Boton: []
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
    titulo: titulo || placeholderData.titulo,
    descripcion: stringifyRichText(descripcion || placeholderData.descripcion),
    texto_boton: texto_boton || placeholderData.texto_boton,
    url_boton: url_boton || placeholderData.url_boton,
};

const mainImageUrl = (imagen_principal
    ? getStrapiUrl(imagen_principal)
    : null) || FALLBACK_IMAGE_URL;
const mainImageAlt = imagen_principal?.alternativeText || "Imagen principal";
const componentButtons: Boton[] = (Boton && !Array.isArray(Boton) ? [Boton] : Boton) || [
    {
        id: 1,
        texto: texto_boton || dataToRender.texto_boton,
        url: url_boton || dataToRender.url_boton,
        tipo: "version_1" // Usamos version_1 como el estilo de botón principal
    }
];

const HeadingTag = getHeadingTag(nivel_heading);
---

<section class="relative overflow-hidden py-12 sm:py-16">
    <div class="relative mx-0 px-0 lg:pl-15">
        <Image src={ArtworkSquare12} alt="Patrón de puntos decorativo" class="absolute top-0 left-0 transform -translate-y-1/2 w-100 translate-x-52 z-0 hidden lg:block" aria-hidden="true" />
        <Image src={ArtworkSquare12} alt="Patrón de puntos decorativo" class="absolute top-0 left-0 transform -translate-y-1/2 w-100 -translate-x-55 z-0 hidden lg:block" aria-hidden="true" />
        <Image src={dotsPatternMobile} alt="Patrón de puntos decorativo" class="absolute bottom-0 -left-2 transform w-3/8 translate-y-1/12 z-0 lg:hidden" aria-hidden="true" />

        <div class="relative lg:flex lg:items-center lg:justify-start lg:min-h-[500px] xl:min-h-[600px]">
            <div class="lg:absolute lg:-top-10 lg:-right-40 lg:w-4/5 lg:h-full">
                <Image src={mainImageUrl} alt={mainImageAlt} class="w-full object-cover shadow-xl" inferSize={true} />
            </div>
            <div class="relative w-[90%] mx-auto -mt-[20px] lg:w-[calc(1/2*80%)] lg:mx-0 lg:mt-0 z-10">
                <div class="relative z-10 text-center bg-[var(--surface-brand-primary)] p-8 md:p-9 text-[var(--neutral-text-inverted)]  shadow-2xl lg:text-left">
                    <HeadingTag class="text-xl lg:text-[40px] whitespace-nowrap lg:whitespace-normal font-semibold tracking-[0] leading-none uppercase font-(family-name:--font-shields-sans-semibold-condensed)">
                        {dataToRender.titulo}
                    </HeadingTag>
                    <div class="font-(family-name:--font-shields-sans-regular) mb-6 mt-6 text-[13px] md:text-base text-[var(--neutral-text-inverted)] prose" set:html={dataToRender.descripcion} />
                    <div class="mt-5 w-full flex justify-start">
                        <div class="w-full transform hover:scale-105 transition-transform duration-300 ease-in-out origin-left">
                            <ButtonGroup botones={componentButtons} />
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .prose :global(p) {
        color: var(--neutral-text-inverted);
    }
</style>