---
// src/components/Component_34.astro
import { getHeadingTag } from '../../lib/strapi.js';

export interface Props {
    tag: string;
    headline: string;
    nivel_heading_titulo?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    nivel_heading_tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

const {
    tag,
    headline,
    nivel_heading_titulo,
    nivel_heading_tag
} = Astro.props;

const HeadingTag = getHeadingTag(nivel_heading_tag);
const HeadingTagTitulo = getHeadingTag(nivel_heading_titulo);
---

<section class="w-full text-(--neutral-text-inverted) bg-custom-gradient">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 py-12 sm:py-16">
        <div class="text-left">
            <HeadingTag class="font-(family-name:--font-shields-sans-regular) inline-block bg-(--accent-highlight-secondary) text-(--surface-brand-primary) text-xs font-bold tracking-wider uppercase px-3 py-1 rounded">
                {tag || "TOPGOLF MONTERREY"}
            </HeadingTag>
            <HeadingTagTitulo class="font-(family-name:--font-shields-sans-condensed) text-4xl md:text-7xl font-bold uppercase mt-4 leading-tight">
                {headline || "PREGUNTAS FRECUENTES"}
            </HeadingTagTitulo>
        </div>
    </div>
</section>
