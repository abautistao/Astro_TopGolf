---
import { Image } from "astro:assets";
import Button from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import Component_20 from './Component_20.astro'
import BookingModal from "./BookingModal.astro";

interface FormField {
    id: number;
    label: string;
    placeholder?: string;
    name: string;
    inputType:
        | "text"
        | "select"
        | "date"
        | "time"
        | "number"
        | "email"
        | "textarea"
        | "radio"
        | "checkbox"
        | "file"
        | "section_title";
    gridWidth: "full" | "half";
    options?: string; // Comma separated for select/radio
    required?: boolean;
}
interface Props {
  id: string;
  id_modal: string;
  titulo: string;
  descripcion: string;
  boton?: Boton
  image: string;
  delay?: number; // Tiempo en milisegundos para aparecer
  show_form: boolean
  form: FormField,
  Booking: any
}

const { id, image, titulo, descripcion, boton, delay, show_form, form, id_modal, Booking } = Astro.props;

const imageModal = getStrapiUrl(image);
---

<dialog
  id={id_modal}
  data-delay={delay}
  class="fixed inset-0 z-50 hidden m-auto max-h-[90vh] w-[100%] flex-col overflow-y-auto rounded-2xl border-none bg-white p-0 outline-none open:flex md:flex-row backdrop:bg-black/70 backdrop:backdrop-blur-md animate-in fade-in zoom-in duration-300"
  class:list={[
    { 'shadow-2xl': imageModal }
  ]}
>
  {imageModal && (
    <div class="relative w-full md:w-1/2 flex-shrink-0">
      <button
        id={`close-${id_modal}-mobile`}
        class="absolute top-2 right-2 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white/80 text-gray-700 transition-all hover:bg-white hover:scale-110 active:scale-90 md:hidden"
        aria-label="Cerrar"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
  
      <Image
        src={imageModal}
        alt="Playing"
        class="h-full w-full object-cover min-h-[250px]"
        inferSize={true}
        loading="lazy"
      />
    </div>
  )}

  <div class="relative w-full p-6 md:p-10">
    <button
      id={`close-${id_modal}`}
      class="absolute top-2 right-2 z-10 h-8 w-8 items-center justify-center rounded-full bg-white/80 text-gray-700 transition-all hover:bg-white hover:scale-110 active:scale-90"
      class:list={[
        {'hidden md:flex' : imageModal},
        {'flex md:flex' : !imageModal}
      ]}
      aria-label="Cerrar"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    {titulo && (
      <>
        <h2 class="mb-4 text-lg font-black leading-tight font-(family-name:--font-titling-gothic-fb-extended-bold) uppercase text-(--surface-brand-primary) md:text-xl">
          {titulo}
        </h2>
        <div class="mb-6 text-base leading-relaxed text-(--surface-brand-primary)" set:html={stringifyRichText(descripcion)}></div>
      </>
    )}

    {show_form && form && (
      <Component_20 id_form="comments" {...form} />
    )}

    {show_form && Booking && (
      <slot></slot>
      <BookingModal id_form="comments" {...Booking} />
    )}

    <div class="flex flex-col items-center gap-4 sm:flex-row">
      {boton && (
        <Button
          botones={[boton]}
          clase="flex flex-row gap-4 sm:gap-6 w-full justify-center items-center flex-wrap sm:flex-nowrap"
        />
      )}
    </div>
  </div>
</dialog>

<script is:inline define:vars={{ id_modal }}>
  window.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById(id_modal);
    const closeBtn = document.getElementById(`close-${id_modal}`);
    const closeBtnMobile = document.getElementById(`close-${id_modal}-mobile`);
    const delay = parseInt(modal?.getAttribute('data-delay') || '0');

    setTimeout(() => {
      if (modal && !modal.open && delay) {
        modal.showModal();
      }
    }, delay);

    closeBtn?.addEventListener('click', () => {
      modal.close();
    });

    closeBtnMobile?.addEventListener('click', () => {
      modal.close();
    });

    modal?.addEventListener('click', (e) => {
      if (e.target === modal) modal.close();
    });
  });
</script>

<style is:inline>
  dialog::backdrop {
    transition: opacity 0.5s ease;
  }
</style>