---
/**
 * @component Booking
 * @description Motor de reservas VMG en light DOM. El HTML del plugin vive en el
 * documento (los retornos del flujo —sesión, cookies, pasos— funcionan normal,
 * cosa que en iframe fallaba intermitente) y el CSS de Bootstrap que inyecta se
 * reescribe scopeado a `#booking-container` para que no contamine el header/footer
 * de Tailwind. Sin `!important`, sin iframe, sin Shadow DOM.
 *
 * Layout configurable desde Strapi (no se envía al plugin):
 * - `color_fondo`: color del wrapper (hex, e.g. "#002A4E"). Si hay `imagen_fondo`,
 *   funciona como fallback mientras la imagen carga.
 * - `imagen_fondo`: media opcional. Se renderiza como `<img>` overlay detrás del
 *   widget (object-cover/object-center, -z-10). Equivalente visual a
 *   `bg-[url(...)] bg-cover bg-center` con URL dinámica — Tailwind v4 compila
 *   valores arbitrarios en build time, así que un `bg-[url('${runtime}')]` no
 *   puede resolverse en runtime; el overlay `<img>` sí.
 * - `ancho`: "contenido" (default, mx-auto max-w-7xl con padding lateral) |
 *   "completo" (full width sin padding, como el comportamiento histórico).
 */
import type { HTMLAttributes } from 'astro/types';
import { getStrapiUrl } from "../../lib/strapi.js";

export interface Props extends HTMLAttributes<'div'> {
    plugin_id?: string | null;
    user_language?: string | null;
    producto_id?: string | null;
    set_producto_id?: string | null;
    promocode?: string | null;
    set_promocode?: string | null;
    pax_min?: number | null;
    pax_max?: number | null;
    reservacion_fecha?: string | null;
    vendedor_id?: string | null;
    /** Color de fondo del wrapper (hex). Usado como fallback mientras carga `imagen_fondo`. */
    color_fondo?: string | null;
    /** Imagen de fondo del wrapper. Si existe, se pinta como overlay con object-cover/center. */
    imagen_fondo?: any;
    /** "contenido" = mx-auto max-w-7xl con padding lateral (default); "completo" = full width. */
    ancho?: string | null;
}

const { color_fondo, imagen_fondo, ancho } = Astro.props;

const rawParams = {...Astro.props };
const vmgPluginUrlRaw = import.meta.env.PUBLIC_VMG_PLUGIN_URL;
const vmgPluginUrl = (vmgPluginUrlRaw || '').replace(/^https?:\/\//, '').replace(/\/$/, '');
const vmgPluginVersion = import.meta.env.PUBLIC_VMG_PLUGIN_VERSION;
const paramsLimpios: { [key: string]: any } = {};

// `__component` / `id` son metadatos del dynamic zone de Strapi.
// `color_fondo` / `imagen_fondo` / `ancho` son del wrapper, no del plugin.
// `class*` los añade el caller (no deberían llegar aquí, pero por si acaso).
const excludeKeys = new Set([
    '__component', 'id',
    'color_fondo', 'imagen_fondo', 'ancho',
    'class', 'class:list', 'className',
]);

for (const [key, value] of Object.entries(rawParams)) {
    if (excludeKeys.has(key)) continue;
    if (value) {
        paramsLimpios[key] = value;
    }
}

const bgUrl = imagen_fondo ? getStrapiUrl(imagen_fondo) : null;
const isFullWidth = ancho === "completo";

// Tailwind v4 compila `bg-[#hex]` arbitrarios en build time; un valor runtime
// (template literal) no tiene garantía de matchear el CSS emitido. Mantenemos
// la firma en el source por completitud y para que el scanner detecte la
// intención; si Tailwind no la emite, el wrapper queda transparente y el
// `div#booking-container` interior conserva su propio `bg-[#002a4e]`.
const sectionBgClass = color_fondo ? `bg-[${color_fondo}]` : "";
---

<section class:list={["relative w-full overflow-hidden", sectionBgClass]}>
    {bgUrl && (
        <img
            src={bgUrl}
            alt=""
            aria-hidden="true"
            class="absolute inset-0 w-full h-full object-cover object-center -z-10 pointer-events-none"
        />
    )}
    {isFullWidth ? (
        <div id="booking-container" class="font-(family-name:--font-shields-sans-bold) bg-[#002a4e] bg-cover bg-center bg-no-repeat bg-[url('https://cms.bluoceanclub.com/uploads/Booking_ce5a0fd70b.jpg')]">
            <!-- El widget VMG se monta aquí en light DOM. -->
        </div>
    ) : (
        <div class="mx-auto max-w-7xl px-4 md:px-8 py-10">
            <div id="booking-container" class="font-(family-name:--font-shields-sans-bold) bg-[#002a4e] bg-cover bg-center bg-no-repeat bg-[url('https://cms.bluoceanclub.com/uploads/Booking_ce5a0fd70b.jpg')]">
                <!-- El widget VMG se monta aquí en light DOM. -->
            </div>
        </div>
    )}
</section>

<script is:inline define:vars={{ paramsLimpios, vmgPluginUrl, vmgPluginVersion }}>
    (function () {
        var HOST_ID = 'booking-container';
        var host = document.getElementById(HOST_ID);
        if (!host || host.dataset.bookingReady === 'true') return;
        host.dataset.bookingReady = 'true';

        // Reescribe un CSS ya parseado por el navegador prefijando cada selector
        // con el scope. :root/html/body colapsan al scope (sus vars heredan dentro).
        function scopeCssText(cssText, scope) {
            var tmp = document.createElement('style');
            tmp.textContent = cssText;
            document.head.appendChild(tmp);
            var out = '';
            function emitSelector(sel) {
                return sel.split(',').map(function (s) {
                    s = s.trim();
                    if (!s || s === ':root' || s === 'html' || s === 'body') return scope;
                    return scope + ' ' + s;
                }).join(', ');
            }
            function proc(rules) {
                for (var i = 0; i < rules.length; i++) {
                    var r = rules[i];
                    if (r.type === 1) {
                        out += emitSelector(r.selectorText) + '{' + r.style.cssText + '}';
                    } else if (r.type === 4) {
                        out += '@media ' + r.media.mediaText + '{';
                        proc(r.cssRules);
                        out += '}';
                    } else if (r.type === 3) {
                        continue; // @import: se ignora, el CSS ya viene completo
                    } else {
                        try { out += r.cssText; } catch (e) { /* @font-face/@keyframes van tal cual */ }
                    }
                }
            }
            try { proc(tmp.sheet.cssRules); } catch (e) { /* hoja ilegible: fallback abajo */ }
            tmp.remove();
            return out;
        }

        var scopedCache = null;
        function scopeBootstrap() {
            var bootLink = null;
            var links = host.querySelectorAll('link[rel="stylesheet"]');
            for (var i = 0; i < links.length; i++) {
                if ((links[i].href || '').indexOf('bootstrap') !== -1) bootLink = links[i];
            }
            function applyScoped(cssText) {
                var scoped = scopeCssText(cssText, '#' + HOST_ID);
                if (!scoped) return; // fallback: se deja el link global original
                var old = document.getElementById('booking-scoped-css');
                if (old) old.remove();
                var st = document.createElement('style');
                st.id = 'booking-scoped-css';
                st.textContent = scoped;
                document.head.appendChild(st);
                if (bootLink) bootLink.remove();
            }
            if (scopedCache) { applyScoped(scopedCache); return; }
            var cssUrl = bootLink
                ? bootLink.href
                : 'https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css';
            fetch(cssUrl).then(function (r) { return r.text(); }).then(function (t) {
                scopedCache = t;
                applyScoped(t);
            }).catch(function () { /* sin scope: el widget sigue funcionando */ });
        }

        function loadGlobalScript(src) {
            return new Promise(function (resolve, reject) {
                if (src.indexOf('jquery') !== -1 && window.jQuery) return resolve();
                var selector = 'script[data-booking-src="' + src + '"]';
                var existing = document.querySelector(selector);
                if (existing) {
                    if (existing.dataset.loaded === 'true') return resolve();
                    existing.addEventListener('load', function () { resolve(); });
                    existing.addEventListener('error', reject);
                    return;
                }
                var s = document.createElement('script');
                s.src = src;
                s.async = true;
                s.dataset.bookingSrc = src;
                s.addEventListener('load', function () {
                    s.dataset.loaded = 'true';
                    resolve();
                });
                s.addEventListener('error', reject);
                document.head.appendChild(s);
            });
        }

        var pluginId = paramsLimpios.plugin_id || '';

        loadGlobalScript('https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js')
            .then(function () {
                return new Promise(function (resolve, reject) {
                    window.jQuery
                        .getScript('https://' + vmgPluginUrl + '/js/pluginscripts.js', resolve)
                        .fail(reject);
                });
            })
            .then(function () {
                var $ = window.jQuery;
                $.pluginUrl = 'https://' + vmgPluginUrl + '/' + vmgPluginVersion + '.php';
                var params = Object.assign({}, paramsLimpios, { plugin_id: pluginId });

                var urlParams = new URLSearchParams(window.location.search);
                urlParams.forEach(function (value, key) {
                    params[key] = value;
                });

                return new Promise(function (resolve, reject) {
                    $.post($.pluginUrl, params, function (data) {
                        $(host).html(data);
                        scopeBootstrap();
                        resolve();
                    }).fail(reject);
                });
            })
            .catch(function (err) {
                if (window.console && console.error) {
                    console.error('Booking widget failed:', err);
                }
            });
    })();
</script>
