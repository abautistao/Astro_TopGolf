---
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
    plugin_id?: string | null;
    user_language?: string | null;
    producto_id?: string | null;
    set_producto_id?: string | null;
    promocode?: string | null;
    set_promocode?: string | null;
    pax_min?: number | null;
    pax_max?: number | null;
    reservacion_fecha?: string | null;
    vendedor_id?: string | null;
}

const params = new URLSearchParams();
for (const [key, value] of Object.entries(Astro.props)) {
    if (key === '__component' || key === 'id') continue;
    if (value) params.set(key, String(value));
}
const iframeSrc = `/booking-widget?${params.toString()}`;
---

<iframe src={iframeSrc} title="Booking engine" loading="lazy" style="width:100%;border:0" height="1000"></iframe>
