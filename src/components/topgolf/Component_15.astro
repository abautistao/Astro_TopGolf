---
// src/components/Component_15.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText } from '../../lib/strapi.js';
import defaultDotsPattern from '../../assets/Artwork_bg.png';
import defaultDotsPatternMobile from '../../assets/Artwork_1.png';
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";
// 1. Definimos la interfaz para las props de Strapi
export interface Props {
    imagen_fondo?: any;
    alt_imagen_fondo?: string;
    etiqueta?: string;
    titulo?: string;
    subtitulo?: string;
    descripcion?: any; // Rich Text
    texto_boton?: string;
    url_boton?: string;
    imagen_decorativa_desktop?: any;
    alt_imagen_decorativa_desktop?: string;
    imagen_decorativa_mobile?: any;
    alt_imagen_decorativa_mobile?: string;
    Boton: Boton[];
}

// 2. Recibimos las props y definimos placeholders
const {
    imagen_fondo,
    alt_imagen_fondo,
    etiqueta,
    titulo,
    subtitulo,
    descripcion,
    texto_boton,
    url_boton,
    imagen_decorativa_desktop,
    alt_imagen_decorativa_desktop,
    imagen_decorativa_mobile,
    alt_imagen_decorativa_mobile,
    Boton,
} = Astro.props;

const placeholder = {
    imagen_fondo_url:
        "https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo",
    alt_imagen_fondo: "Imagen de fondo de Platzhalter",
    etiqueta: "TOPGOLF MONTERREY",
    titulo: "Fiestas y <br class='hidden md:block'>Eventos",
    subtitulo: "Más divertido en Topgolf",
    descripcion: [
        {
            type: "paragraph",
            children: [
                {
                    type: "text",
                    text: "Hemos realizado más de mil eventos en nuestros espacios, desde cumpleaños, baby shower, gender reveal, pedidas, graduaciones o eventos empresariales. ",
                },
                {
                    type: "text",
                    text: "¡Todos los días nos acompaña alguien celebrando algo!",
                    bold: true,
                },
            ],
        },
    ],
    texto_boton: "SOLICITAR INFORMACIÓN",
    url_boton: "#",
    imagen_decorativa_desktop_url: "https://placehold.co/200x200?text=Pattern",
    alt_imagen_decorativa_desktop:
        "Patrón de puntos decorativo para escritorio",
    imagen_decorativa_mobile_url: "https://placehold.co/100x100?text=Pattern",
    alt_imagen_decorativa_mobile: "Patrón de puntos decorativo para móvil",
};

const heroBackgroundUrl =
    getStrapiUrl(imagen_fondo) || placeholder.imagen_fondo_url;
const decorativeDesktopUrl =
    getStrapiUrl(imagen_decorativa_desktop) ||
    placeholder.imagen_decorativa_desktop_url;
const decorativeMobileUrl =
    getStrapiUrl(imagen_decorativa_mobile) ||
    placeholder.imagen_decorativa_mobile_url;
const descriptionHtml = stringifyRichText(
    descripcion || placeholder.descripcion,
);

const componentButtons: Boton[] = (Boton && !Array.isArray(Boton)
    ? [Boton]
    : Boton) || [
    {
        id: 1,
        texto: texto_boton || placeholder.texto_boton,
        url: url_boton || placeholder.url_boton,
        tipo: "version_1", // Usamos version_1 como el estilo de botón principal
    },
];

const isVideo = (url: string | undefined | null) => {
    if (!url) return false;
    const cleanUrl = url.split("?")[0].toLowerCase();
    return (
        cleanUrl.endsWith(".mp4") ||
        cleanUrl.endsWith(".webm") ||
        cleanUrl.endsWith(".ogg") ||
        cleanUrl.endsWith(".mov")
    );
};

const showVideo = isVideo(heroBackgroundUrl);
---

<section
    class="relative w-full text-[var(--neutral-text-inverted)] min-h-[550px] md:min-h-[650px] bg-[var(--neutral-text-inverted)]"
>
    {
        showVideo ? (
            <video
                src={heroBackgroundUrl}
                autoplay
                loop
                muted
                playsinline
                preload="auto"
                fetchpriority="high"
                class="absolute inset-0 w-full h-full object-cover"
            />
        ) : (
            <Image
                src={heroBackgroundUrl}
                alt={alt_imagen_fondo || placeholder.alt_imagen_fondo}
                class="absolute inset-0 object-cover w-full h-full"
                inferSize={true}
                loading="eager"
                fetchpriority="high"
            />
        )
    }
    
    <div class="absolute inset-0 bg-black/30"></div>

    <div
        class="relative z-10 flex flex-col items-center justify-center h-[550px] md:h-[650px] text-center"
    >
    </div>

    <div class="relative bg-[var(--neutral-text-inverted)] pb-0 md:pb-10">
        <div
            class="font-(family-name:--font-shields-sans-regular) relative -top-28 sm:-top-20 -mt-28 sm:-mt-20 z-20 mx-4 md:mx-[150px] min-h-[180px] bg-[var(--surface-brand-primary)] px-6 py-8 md:p-10 shadow-lg flex flex-col md:flex-row items-center justify-between gap-8 text-left text-white"
        >
            <div class="w-full md:w-5/12 flex-shrink-0">
                <span
                    class="bg-[var(--accent-highlight-secondary)] text-[var(--surface-brand-primary)] font-bold text-xs px-3 py-1 mb-4 inline-block font-(family-name:--font-shields-sans-bold)"
                >
                    {etiqueta || placeholder.etiqueta}
                </span>
                <h1
                    class="text-[40px] lg:text-[75px] font-semibold uppercase leading-none font-(family-name:--font-shields-sans-condensed) tracking-[0.01em]"
                    set:html={titulo || placeholder.titulo}
                />
                <p
                    class="font-normal uppercase tracking-wider mt-2 text-xl font-(family-name:--font-shields-sans-regular)"
                >
                    {subtitulo || placeholder.subtitulo}
                </p>
            </div>

            <div class="w-full md:w-7/12">
                <div
                    class="font-(family-name:--font-shields-sans-regular) mb-6 leading-relaxed strapi-rich-text text-lg font-normal"
                    set:html={descriptionHtml}
                />
                <ButtonGroup botones={componentButtons} />
            </div>
        </div>
        <Image
            src={decorativeDesktopUrl}
            alt={alt_imagen_decorativa_desktop ||
                placeholder.alt_imagen_decorativa_desktop}
            class="absolute bottom-8 right-4 z-10 hidden lg:block"
            aria-hidden="true"
            inferSize={true}
        />
        <Image
            src={decorativeMobileUrl}
            alt={alt_imagen_decorativa_mobile ||
                placeholder.alt_imagen_decorativa_mobile}
            class="absolute -bottom-[100px] right-0 -translate-y-2/3 z-10 block lg:hidden"
            aria-hidden="true"
            inferSize={true}
        />
    </div>
</section>

<style>
    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    .strapi-rich-text :global(strong) {
        color: var(--neutral_text_inverted);
        font-family: var(--font-tee-line-bold-italic);
        font-weight: bold;
    }
    .strapi-rich-text :global(u) {
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }
    .strapi-rich-text :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: var(--brand-interactive-base);
    }

    /* --- Agrega esto aquí --- */
    .strapi-rich-text :global(li::marker) {
        /* Usa la variable de color que desees para el punto/número */
        color: var(--neutral-background-strong);

        /* Opcional: Si quieres que el bullet sea más grande o negrita */
        font-weight: bold;
        font-size: 1.2em;
    }
</style>
