---
// src/components/blu/ContainerBackgroundHome_Blu.astro
import { formatUrl, stringifyRichText, getStrapiUrl } from "../../lib/strapi.js";
import Modal_TGM from "./Modal.astro";
import ArrowIcon from "../../assets/down-arrow-circle-cobalt.svg?raw"
import CalendarIcon from "../../assets/calendar-days.svg?raw"
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";
import { Image } from "astro:assets";
interface CardGalleryItem {
    descripcion: any;
}

interface CardGallery {
    header_label: string;
    header_label_color: string;
    header_title: string;
    header_title_color: string;
    header_descripcion: any;
    gallery: any[];
    price: string;
    text_saving: any[];
    CardGalleryItem: CardGalleryItem[];
    Boton: Boton[];
    label_ver_mas: string;
    label_ver_menos: string;
    ver_mas_contenido: string;
    badge_texto: string;
    badge_texto_color: string;
    badge_texto_fondo: string;
    label_price: string;
}
interface Props {
    // Componentes individuales como campos de Strapi
    Componente_40?: any[];
    Modal?: any;
    padding_top?: string;
    CardGallery: CardGallery[]
    titulo: string;
    descripcion: any;

}

const {    
    Modal,
    padding_top,
    CardGallery,
    titulo,
    descripcion
} = Astro.props;

console.log(Modal)
const arrowDataUri = `url("data:image/svg+xml;utf8,${encodeURIComponent(ArrowIcon)}")`;
const calendarDataUri = `url("data:image/svg+xml;utf8,${encodeURIComponent(CalendarIcon)}")`;
---

<section class="beneficios bg-[#F4F8F9] py-8 lg:py-0">
    <div class="container mx-auto px-6! lg:px-0!">
        <div class="lg:-mt-12 rounded-[20px] px-9 py-8 grid grid-cols-1 lg:grid-cols-4 gap-7 bg-white relative">
            <div class="beneficio">
                <i class="fa-regular fa-circle-check text-[#0B7A7C] mb-2"></i>
                <h3 class="font-(family-name:--font-shields-sans-bold)! text-xl">
                    No necesitas saber jugar
                </h3>
                <p class="font-(family-name:--font-shields-sans-regular)!">Juegos para todos los niveles y edades. Diversión desde el primer tiro.</p>
            </div>
            <div class="beneficio">
                <i class="fa-solid fa-golf-ball-tee text-[#0B7A7C] mb-2"></i>
                <h3 class="font-(family-name:--font-shields-sans-bold)! text-xl">Bahías juntas</h3>
                <p class="font-(family-name:--font-shields-sans-regular)!">Tu grupo juega lado a lado, sin separarse en toda la visita.</p>
            </div>
            <div class="beneficio">
                <i class="fa-solid fa-bowl-food text-[#0B7A7C] mb-2"></i>
                <h3 class="font-(family-name:--font-shields-sans-bold)! text-xl">Comida servida en tu bahía</h3>
                <p class="font-(family-name:--font-shields-sans-regular)!">Montaje tipo catering con porciones calculadas por invitado.</p>
            </div>
            <div class="beneficio">
                <i class="fa-solid fa-dollar-sign text-[#0B7A7C] mb-2"></i>
                <h3 class="font-(family-name:--font-shields-sans-bold)! text-xl">Precio claro, todo incluido</h3>
                <p class="font-(family-name:--font-shields-sans-regular)!">IVA y servicio incluidos. Ahorra reservando en línea.</p>
            </div>
        </div>
    </div>
</section>
<section id="container-widget-background" class="relative bg-[#F4F8F9]">
    <div class="w-full">
        <div class="container mx-auto px-6! lg:px-0 lg:py-6">
            {titulo && (
                <h2 class="text-5xl font-(family-name:--font-tee-line-bold-italic) text-center! mb-6!">{titulo}</h2>
            )}

            {descripcion && (
                <div class="rich-text-cards text-center! text-base font-(family-name:--font-shields-sans-regular)!" set:html={stringifyRichText(descripcion)}></div>
            )}

            <div id="packages" class="grid grid-cols-1 md:grid-cols-3 gap-6 py-10 items-start">
                {CardGallery.length && CardGallery.map((card, index) => (
                    <!-- Card -->
                    <div class="flex flex-col bg-(--neutral-background-subtle) shadow-sm rounded-3xl font-(family-name:--font-shields-sans-regular)!">
                        <div class="rounded-t-3xl py-3 px-4 bg-(--surface-brand-primary) text-(--accent-highlight-secondary) relative">
                            {card.badge_texto && (
                                <span class="absolute top-3 right-4 rounded-md bg-(--accent-highlight-primary) text-(--neutral-background-strong) text-sm px-2 py-1 font-(family-name:--font-shields-sans-bold)!">{card.badge_texto}</span>
                            )}

                            <p class="text-base text-muted-foreground-1 mb-0">
                                {card.header_label}
                            </p>
                            <h3 class="mb-0 font-(family-name:--font-shields-sans-bold)!">
                                {card.header_title}
                            </h3>
                            <div class="rich-text-card italic" set:html={stringifyRichText(card.header_descripcion)}></div>
                        </div>
                        <div id=`slider-cards-${index}` class="splide">
                            <div class="splide__arrows splide__arrows--ltr">
                                <button
                                    class="splide__arrow splide__arrow--prev"
                                    type="button"
                                    aria-label="Previous slide"
                                    aria-controls="splide01-track"
                                >
                                    
                                    <i class="fa-solid fa-chevron-left fa-md font-bold"></i>
                                </button>
                                <button
                                    class="splide__arrow splide__arrow--next"
                                    type="button"
                                    aria-label="Next slide"
                                    aria-controls="splide01-track"
                                >
                                    <i class="fa-solid fa-chevron-right fa-md font-bold"></i>
                                </button>
                            </div>
                            <div class="splide__track">
                                    <div class="splide__list">
                                        {card.gallery.map(promo => (
                                            <Image class="splide__slide" src={getStrapiUrl(promo)} inferSize={true} alt="Galeria Evento"/>
                                        ))}

                                    </div>
                            </div>
                        </div>

                        <div class="p-4 text-(--neutral-background-strong)">
                            <h4 class="font-(family-name:--font-shields-sans-bold)!">
                                {card.price} <span class="text-sm text-gray-500">{card.label_price}</span>
                            </h4>
                            <div class="bg-[#E3F4F4] text-[#0B4F51] font-(family-name:--font-shields-sans-bold)! py-2 px-3 mb-3 rounded-xl inline-block">
                                <div class="rich-text-card text-xs" set:html={stringifyRichText(card.text_saving)}></div>
                            </div>

                            {card.CardGalleryItem.length && (
                                <div class="mb-6">
                                    {card.CardGalleryItem.map(item => (
                                        <div class="flex gap-4 items-start">
                                            <i class="fas fa-circle-check text-(--feedback-positive-base)"></i>
                                            <div class="rich-text-card" set:html={stringifyRichText(item.descripcion)}></div>
                                        </div>
                                    ))}
                                </div>
                            )}

                            {card.ver_mas_contenido && (
                                <div class="menu border-t border-[#E3EAF0] flex flex-col mt-6 gap-3 py-2">
                                    <button class="menu-toggle bg-none border-none min-h-11! flex items-center justify-between w-full font-base font-bold text-[#0B7A7C] cursor-pointer font-(family-name:--font-shields-sans-bold)! focus:outline-none!">
                                        <span class="btn-text">{card.label_ver_mas}</span>
                                        <span class="icon" aria-hidden="true">+</span>
                                    </button>
    
                                    <div id="menu-fiesta" class="text-sm hidden">
                                        <div class="menu-fiesta" set:html={stringifyRichText(card.ver_mas_contenido)}></div> 
                                    </div>
                                </div>
                            )}

                            <ButtonGroup botones={[card.Boton]} clase="w-full"/>
                        </div>
                    </div>
                    <!-- End Card -->
                ))}
            </div>
        </div>
        {Modal && <Modal_TGM {...Modal}>
            <div class="bg-white sticky top-10 lg:top-5 z-99999 py-0 lg:py-6 mb-6 lg:mb-0 mx-auto lg:px-0 md:pt-5!">
                <form class="pav-widget w-full flex flex-wrap justify-center mb-6" method="get" action="">
                    <div id="form-players-modal" class=" md:flex-none rounded-lg border border-(--brand-interactive-base)! hover:border-white hover:border-opacity-70 relative">
                        <label class="mb-0!">
                            <span class="select-container">
                                <select id="pax_modal" name="pax" class="focus:outline-none appearance-none! pl-10 py-4! pr-7 cursor-pointer w-full min-w-16 md:min-w-24 lg:min-w-[7.5rem] bg-transparent text-gray-500! border-0! neon rounded md:rounded-full mb-0 font-shield-condensed lg:font-shield md:text-lg!">
                                    <option value="12">12 jugadores</option>
                                    <option value="13">13 jugadores</option>
                                    <option value="14">14 jugadores</option>
                                    <option value="15">15 jugadores</option>
                                    <option value="16">16 jugadores</option>
                                    <option value="17">17 jugadores</option>
                                    <option value="18">18 jugadores</option>
                                    <option value="19">19 jugadores</option>
                                    <option value="20">20 jugadores</option>
                                    <option value="21">21 jugadores</option>
                                    <option value="22">22 jugadores</option>
                                    <option value="23">23 jugadores</option>
                                    <option value="24">24 jugadores</option>
                                </select>
                            </span>
                        </label>
                    </div>
                </form>
            </div>
        </Modal_TGM>}

        {/* Slot por si se usa de forma manual en el código */}
        <slot />
    </div>
</section>
<style define:vars={{ padding_top, calendarDataUri, arrowDataUri }}>
    #form-calendar, #form-players {
        border: 3px solid var(--brand-interactive-base) !important;
    }

    #form-players {
        border-left: none !important;
    }
    #form-players-modal {
        border: 3px solid var(--brand-interactive-base) !important;
    }
    #container-widget-background {
        padding-top: var(--padding_top);
    }

    :global(.flatpickr-calendar) {
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
  

    .datepicker-input.neon, .flatpickr-input.neon {
        background: var(--calendarDataUri) no-repeat right 10px center;
        background-color: transparent;
        background-size: 16px 16px;
        background-position: left 12px center;
    }

    .rich-text-card :global(p) {
        margin-bottom: 0;
    }

    .select-container select.neon {
        background: var(--arrowDataUri) no-repeat right 10px center;
        background-color: transparent;
        background-size: 16px 16px;
        background-position: left 12px center;
    }

    .menu-fiesta :global(ul) {
        padding-left: 14px;
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 14px;
        margin: 0;
        list-style-type: disc;
        line-height: 1.45;
    }

    .menu-fiesta :global(p) {
        margin-top: 30px;
    }

    .rich-text-cards :global(strong) {
        font-family: var(--font-shields-sans-bold);
    }
</style>

<script>
    // 2. ZONA DE CLIENTE (Navegador)
  import flatpickr from "flatpickr";
  import 'flatpickr/dist/flatpickr.min.css';
  import { Spanish } from "flatpickr/dist/l10n/es.js"; // Importar idioma español
  import '@splidejs/splide/css';
  import Splide from '@splidejs/splide';

  document.addEventListener('DOMContentLoaded', () => {
    new Splide( '#slider-cards-0', {
        pagination: false,
        autoplay: true, 
        rewind: true
    } ).mount();

    new Splide( '#slider-cards-1', {
        pagination: false,
        autoplay: true, 
        rewind: true
    } ).mount();

    new Splide( '#slider-cards-2', {
        pagination: false,
        autoplay: true, 
        rewind: true
    } ).mount();

    // Ejecutar al cargar
    const dynamicBtn = document.querySelectorAll('.dynamic_btn');
    const modal = document.getElementById('vmg');
    const backdrop = document.getElementById(`backdrop-vmg`);

    const paxModal = document.getElementById('pax_modal');
    const buttonMenu = document.querySelectorAll('.menu-toggle')


    let pluginIdValue;
    let productoId;

    // Función para alternar el estado del modal
    const toggleModal = () => {
        backdrop?.classList.toggle('hidden')
        modal?.classList.toggle('hidden')
    };

    dynamicBtn.forEach(function(dBtn) {
        dBtn.addEventListener('click', function(btn) {
            
            pluginIdValue = btn.currentTarget?.dataset.vendedor_id;
            productoId = btn.currentTarget?.dataset.producto_id;
            btn.preventDefault()
            
            window.dispatchEvent(new CustomEvent('update-booking-plugin', {
                detail: { 
                    pluginId: pluginIdValue == 14106 ? 42 : 44,
                    vendedorId: pluginIdValue,
                    pax: paxModal.value
                }
            }));
            toggleModal()
        })
    })

    paxModal?.addEventListener('change', function(paxM) {
        paxM.preventDefault()
        
        window.dispatchEvent(new CustomEvent('update-booking-plugin', {
            detail: { 
                pluginId: pluginIdValue == 14106 ? 42 : 44,
                vendedorId: pluginIdValue,
                pax: paxModal.value
            }
        }));
    })
    buttonMenu.forEach(bMenu => {
        bMenu?.addEventListener('click', function(e){
            e.preventDefault()
            
            const menu = bMenu.nextElementSibling;
            const btnText = bMenu.querySelector('.btn-text');
            const btnIcon = bMenu.querySelector('.icon');

            // Alterna la visibilidad del menú
            menu?.classList.toggle('hidden');

            // Actualiza texto e ícono sin destruir la estructura HTML
            const isHidden = menu?.classList.contains('hidden');
            if (btnText) btnText.textContent = isHidden ? 'Ver Menú completo' : 'Ocultar menú';
            if (btnIcon) btnIcon.textContent = isHidden ? '+' : '−';
        })
    })
  })
</script>