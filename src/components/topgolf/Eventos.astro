---
// src/components/blu/ContainerBackgroundHome_Blu.astro
import { formatUrl } from "../../lib/strapi.js";
import Component_40_TGM from "./Component_40.astro";
import Modal_TGM from "./Modal.astro";
import ArrowIcon from "../../assets/down-arrow-circle-cobalt.svg?raw"
import CalendarIcon from "../../assets/calendar-days.svg?raw"

interface Props {
    // Componentes individuales como campos de Strapi
    Componente_40?: any[];
    Modal?: any;
    padding_top?: string;
}

const {    
    Modal,
    Componente_40,
    padding_top,
} = Astro.props;

const arrowDataUri = `url("data:image/svg+xml;utf8,${encodeURIComponent(ArrowIcon)}")`;
const calendarDataUri = `url("data:image/svg+xml;utf8,${encodeURIComponent(CalendarIcon)}")`;
---

<section id="container-widget-background" class="relative max-w-270 mx-auto">
    {/* --- RENDERIZADO DE COMPONENTES POR SLOTS --- */}
    <div
        class:list={[
            'sticky top-0 block py-8 z-99999 bg-white px-10 lg:px-0',
        ]}
    >
        <form class="pav-widget w-full flex flex-col! lg:flex-row! flex-wrap md:justify-center" method="get" action="">
            <div id="form-calendar" class="flex-1 md:flex-none lg:rounded-l-lg lg:rounded-r-none! border border-(--brand-interactive-base)! hover:border-white hover:border-opacity-70 relative">
                <label class="mb-0!">
                        <div role="application" class="datecalendar">
                            <div role="button" aria-label="Spacer" class="hidden">
                                <input tabindex="-1"/>
                            </div>
                                
                            <div class="button" role="button" aria-label="Date picker" tabindex="0" aria-expanded="false">
                            <input class="focus:outline-none flatpickr-input appearance-none! min-w-27.5 sm:min-w-40! md:min-w-0! w-full! px-2.5! py-4! lg:py-6! pl-10! mb-0! rounded-full! cursor-pointer bg-transparent neon border-none font-shield-condensed lg:font-shield text-gray-500 md:text-lg!" name="reservacion_fecha" id="date" tabindex="-1"/>
                        </div> 
                    </div>
                </label>
            </div>
            <div id="form-players" class="flex-1 md:flex-none lg:rounded-r-lg lg:rounded-l-none! border border-l-(--brand-interactive-base)! hover:border-white hover:border-opacity-70 relative">
                <label class="mb-0!">
                    <span class="select-container">
                        <select id="pax" name="pax" class="focus:outline-none appearance-none! pl-2.5 pl-10 py-4! lg:py-6! pr-7 cursor-pointer w-full min-w-16 md:min-w-24 lg:min-w-[7.5rem] bg-transparent text-gray-500! border-0! neon rounded md:rounded-full mb-0 font-shield-condensed lg:font-shield md:text-lg!">
                            <option value="1" selected>1 jugador</option>
                            <option value="2">2 jugadores</option>
                            <option value="3">3 jugadores</option>
                            <option value="4">4 jugadores</option>
                            <option value="5">5 jugadores</option>
                            <option value="6">6 jugadores</option>
                            <option value="7">7 jugadores</option>
                            <option value="8">8 jugadores</option>
                            <option value="9">9 jugadores</option>
                            <option value="10">10 jugadores</option>
                            <option value="11">11 jugadores</option>
                            <option value="12">12 jugadores</option>
                            <option value="13">13 jugadores</option>
                            <option value="14">14 jugadores</option>
                        </select>
                    </span>
                </label>
            </div>
        </form>
    </div>

    <div class="w-full flex">
        <div id="packages">
            {Componente_40 && Componente_40.map(comp => (
                <Component_40_TGM {...comp} />
            ))}
        </div>
        {Modal && <Modal_TGM {...Modal}>
            <div class="bg-white sticky top-5 lg:top-0 z-99999 py-0 lg:py-6 mb-6 lg:mb-0 mx-auto lg:px-0">
                <form class="pav-widget w-full flex flex-wrap md:justify-center mb-6" method="get" action="">
                    <div id="form-players-modal" class="flex-1 md:flex-none rounded-lg border border-(--brand-interactive-base)! hover:border-white hover:border-opacity-70 relative">
                        <label class="mb-0!">
                            <span class="select-container">
                                <select id="pax_modal" name="pax" class="focus:outline-none appearance-none! pl-10 py-4! pr-7 cursor-pointer w-full min-w-16 md:min-w-24 lg:min-w-[7.5rem] bg-transparent text-gray-500! border-0! neon rounded md:rounded-full mb-0 font-shield-condensed lg:font-shield md:text-lg!">
                                    <option value="1" selected>1 jugador</option>
                                    <option value="2">2 jugadores</option>
                                    <option value="3">3 jugadores</option>
                                    <option value="4">4 jugadores</option>
                                    <option value="5">5 jugadores</option>
                                    <option value="6">6 jugadores</option>
                                    <option value="7">7 jugadores</option>
                                    <option value="8">8 jugadores</option>
                                    <option value="9">9 jugadores</option>
                                    <option value="10">10 jugadores</option>
                                    <option value="11">11 jugadores</option>
                                    <option value="12">12 jugadores</option>
                                    <option value="13">13 jugadores</option>
                                    <option value="14">14 jugadores</option>
                                </select>
                            </span>
                        </label>
                    </div>
                </form>
            </div>
        </Modal_TGM>}

        {/* Slot por si se usa de forma manual en el código */}
        <slot />
    </div>
</section>
<style define:vars={{ padding_top, arrowDataUri, calendarDataUri }}>
    #form-calendar, #form-players {
        border: 3px solid var(--brand-interactive-base) !important;
    }

    #form-players {
        border-left: none !important;
    }
    #form-players-modal {
        border: 3px solid var(--brand-interactive-base) !important;
    }
    #container-widget-background {
        padding-top: var(--padding_top);
    }

    :global(.flatpickr-calendar) {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  

  .datepicker-input.neon, .flatpickr-input.neon {
    background: var(--calendarDataUri) no-repeat right 10px center;
    background-color: transparent;
    background-size: 16px 16px;
    background-position: left 12px center;
}

.select-container select.neon {
    background: var(--arrowDataUri) no-repeat right 10px center;
    background-color: transparent;
    background-size: 16px 16px;
    background-position: left 12px center;
}

@media (max-width: 480px) {
    #form-players {
        border-left: 3px solid var(--brand-interactive-base) !important;
        border-top: none !important
    }
}
</style>

<script>
    // 2. ZONA DE CLIENTE (Navegador)
  import flatpickr from "flatpickr";
  import 'flatpickr/dist/flatpickr.min.css';
  import { Spanish } from "flatpickr/dist/l10n/es.js"; // Importar idioma español

  // Función de inicialización para soportar View Transitions de Astro 5
  function initDatePickers() {
    const inputs = document.querySelectorAll('.flatpickr-input');

    inputs.forEach((input) => {
      // Leemos los datos que Astro inyectó en el HTML
        console.log("inicializar")
      flatpickr(input as HTMLInputElement, {
        locale: Spanish,
        dateFormat: "Y-m-d", // Formato amigable para Strapi (YYYY-MM-DD)
        altFormat: "Y-m-d", // Ej: Octubre 25, 2024
        minDate: "today",    // Opcional: no permitir fechas pasadas
        defaultDate: 'today',
      });
    });
  }

  // Ejecutar al cargar
  initDatePickers();
    const dynamicBtn = document.querySelectorAll('.dynamic_btn');
    const modal = document.getElementById('vmg');
    const date = document.getElementById('date');
    const pax = document.getElementById('pax');

    const paxModal = document.getElementById('pax_modal');


    let pluginIdValue;
    // Función para alternar el estado del modal
    const toggleModal = () => {
    modal?.showModal()
    };

    dynamicBtn.forEach(function(dBtn) {
        dBtn.addEventListener('click', function(btn) {
            
            pluginIdValue = btn.currentTarget?.dataset.vendedor_id;
            btn.preventDefault()
            
            paxModal.value = pax.value
            window.dispatchEvent(new CustomEvent('update-booking-plugin', {
                detail: { 
                    pluginId: 42,
                    vendedorId: pluginIdValue,
                    date: date.value,
                    pax: pax.value
                }
            }));
            toggleModal()
        })
    })

    paxModal?.addEventListener('change', function(paxM) {
        paxM.preventDefault()
        
        window.dispatchEvent(new CustomEvent('update-booking-plugin', {
            detail: { 
                pluginId: 42,
                vendedorId: pluginIdValue,
                date: date.value,
                pax: paxModal.value
            }
        }));
    })
    

</script>