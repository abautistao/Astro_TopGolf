---
// src/components/blu/ContainerBackgroundHome_Blu.astro
import { formatUrl } from "../../lib/strapi.js";
import Component_40_TGM from "./Component_40.astro";
import Modal_TGM from "./Modal.astro";
import ArrowIcon from "../../assets/down-arrow-circle-neon.svg?raw"

interface Props {
    // Componentes individuales como campos de Strapi
    Componente_40?: any[];
    Modal?: any;
    padding_top?: string;
}

const {    
    Modal,
    Componente_40,
    padding_top,
} = Astro.props;

const arrowDataUri = `url("data:image/svg+xml;utf8,${encodeURIComponent(ArrowIcon)}")`;
---

<section id="container-widget-background" class="relative max-w-270 mx-auto">
    {/* --- RENDERIZADO DE COMPONENTES POR SLOTS --- */}
    <div
        class:list={[
            'relative block rounded-2xl bg-(--surface-brand-secondary) px-6! sm:px-10! py-6! text-center shadow-lg mx-4',
        ]}
    >
        <form class="pav-widget w-full flex flex-wrap md:justify-center gap-2 sm:gap-y-4 mt-1 mb-3" method="get" action="">
    <div class="basis-full h-0 sm:hidden"></div>
    <div class="flex-1 md:flex-none rounded-full border border-(--accent-highlight-secondary) border-opacity-50 hover:border-white hover:border-opacity-70 relative">
    <label>
        <div class="label-text absolute z-10 -top-3 left-1.5 md:left-3.5 uppercase font-(family-name:--font-shields-sans-semibold-condensed) text-xxs md:text-md text-[var(--accent-highlight-secondary)] tracking-wide px-1.5 bg-[var(--surface-brand-secondary)] inline-block">Fecha</div>
        <div role="application" class="datecalendar">
            <div role="button" aria-label="Spacer" class="hidden">
                <input tabindex="-1"/></div>
                <div class="button" role="button" aria-label="Date picker" tabindex="0" aria-expanded="false">
                    <input class="flatpickr-input !appearance-none min-w-[110px] sm:min-w-40! md:min-w-0! w-full! h-12! md:h-10! lg:h-12! px-2.5! py-2! md:pl-5! mb-0! rounded-full! cursor-pointer bg-transparent neon border-none font-shield-condensed lg:font-shield text-white leading-none md:text-sm!" name="reservacion_fecha" id="date" readonly="" tabindex="-1" value="12/15/2025"/>
                </div> 
            </div>
        </label>
    </div>
    <div class="flex-1 md:flex-none rounded-full border border-[var(--accent-highlight-secondary)] border-opacity-50 hover:border-white hover:border-opacity-70 relative">
        <label>
            <div class="label-text absolute z-10 -top-3 left-1.5 md:left-3.5 uppercase font-(family-name:--font-shields-sans-semibold-condensed) lg:font-shield-black text-xxs md:text-md text-[var(--accent-highlight-secondary)] tracking-wide px-1.5 bg-[var(--surface-brand-secondary)] inline-block">Jugadores</div>
            <span class="select-container">
                <select id="pax_min" name="pax_min" class="!appearance-none pl-2.5 md:pl-5 py-2 pr-7 cursor-pointer w-full min-w-16 md:min-w-24 lg:min-w-[7.5rem] h-12 md:h-10 lg:h-12 bg-transparent text-white border-0 neon rounded md:rounded-full mb-0 font-shield-condensed lg:font-shield md:text-sm leading-none">
                    <option value="1" selected>1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4">4</option>
                    <option value="5">5</option>
                    <option value="6">6</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                    <option value="10">10</option>
                    <option value="11">11</option>
                    <option value="12">12</option>
                    <option value="13">13</option>
                    <option value="14">14</option>
                </select>
            </span>
        </label>
    </div>
</form>
    </div>

    <div class="w-full flex">
        <div id="packages">
            {Componente_40 && Componente_40.map(comp => (
                <Component_40_TGM {...comp} />
            ))}
        </div>
        {Modal && <Modal_TGM {...Modal} />}

        {/* Slot por si se usa de forma manual en el código */}
        <slot />
    </div>
</section>
<style define:vars={{ padding_top, arrowDataUri }}>
    #container-widget-background {
        padding-top: var(--padding_top);
    }

    :global(.flatpickr-calendar) {
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  

  .datepicker-input.neon, .flatpickr-input.neon, .select-container select.neon {
    background: var(--arrowDataUri) no-repeat right 10px center;
    background-color: transparent;
    background-size: 16px 16px;
    background-position: right 12px center;
}
</style>

<script>
    // 2. ZONA DE CLIENTE (Navegador)
  import flatpickr from "flatpickr";
  import 'flatpickr/dist/flatpickr.min.css';
  import { Spanish } from "flatpickr/dist/l10n/es.js"; // Importar idioma español

  // Función de inicialización para soportar View Transitions de Astro 5
  function initDatePickers() {
    const inputs = document.querySelectorAll('.flatpickr-input');

    inputs.forEach((input) => {
      // Leemos los datos que Astro inyectó en el HTML
      const disabledDatesRaw = input.getAttribute('data-disabled');

      flatpickr(input as HTMLInputElement, {
        locale: Spanish,
        dateFormat: "Y-m-d", // Formato amigable para Strapi (YYYY-MM-DD)
        altFormat: "Y-m-d", // Ej: Octubre 25, 2024
        minDate: "today",    // Opcional: no permitir fechas pasadas
        defaultDate: 'today',
      });
    });
  }

  // Ejecutar al cargar
  initDatePickers();
    const dynamicBtn = document.querySelectorAll('.dynamic_btn');
    const modal = document.getElementById('vmg');
    const date = document.getElementById('date');
    const pax = document.getElementById('pax_min');
    
    // Función para alternar el estado del modal
    const toggleModal = () => {
    modal?.showModal()
    };

    dynamicBtn.forEach(function(dBtn) {
        dBtn.addEventListener('click', function(btn) {
            const pluginIdValue = btn.currentTarget?.dataset.vendedor_id;
            btn.preventDefault()
            console.log(pluginIdValue)
            window.dispatchEvent(new CustomEvent('update-booking-plugin', {
                detail: { 
                    pluginId: 42,
                    vendedorId: pluginIdValue,
                    date: date.value,
                    pax: pax.value
                }
            }));
            toggleModal()


        })
    })

</script>