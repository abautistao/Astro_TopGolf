---
// src/components/Component_22.astro
import { stringifyRichText, getHeadingTag } from '../../lib/strapi.js';
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";

export interface Props {
    tag: string;
    titulo: string;
    contenido: any; // Rich Text
    Boton?: Boton[];
    nivel_heading_titulo?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    nivel_heading_tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

// 2. Recibimos las props y definimos placeholders
const { tag, titulo, contenido, Boton, nivel_heading_titulo, nivel_heading_tag } = Astro.props;

const placeholderData: Props = {
    tag: "JUEGOS DE TOPGOLF MONTERREY",
    titulo: "DIVERSIÓN PARA TODOS LOS NIVELES",
    contenido: [
        {
            type: "paragraph",
            children: [
                {
                    type: "text",
                    text: "Tanto si eres un aspirante a profesional del golf como si estás recogiendo un palo por primera vez, Topgolf es el juego de todos. Nuestros objetivos gigantes facilitan la puntuación sin importar tu swing. Y nuestras pelotas de golf con microchip se puntúan solas, para que puedas concentrarte en la diversión. ",
                },
                {
                    type: "link",
                    url: "#",
                    children: [
                        { type: "text", text: "¡Ven a jugar!", bold: true },
                    ],
                },
            ],
        },
    ],
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
    tag: tag || placeholderData.tag,
    titulo: titulo || placeholderData.titulo,
    contenido: stringifyRichText(contenido || placeholderData.contenido),
};

const componentButtons: Boton[] = (Boton && !Array.isArray(Boton)
    ? [Boton]
    : Boton) || [{ id: 1, texto: "Lorem Ipsum", url: "#", tipo: "version_3" }];

const HeadingTagTitulo = getHeadingTag(nivel_heading_titulo);
const HeadingTagSubtitulo = getHeadingTag(nivel_heading_tag);
---

<section class="w-full text-[var(--neutral-text-inverted)] bg-custom-gradient">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 py-20 lg:py-32">
        <div
            class="grid grid-cols-1 lg:grid-cols-2 gap-x-12 gap-y-10 items-center"
        >
            <div
                class="text-left max-w-lg font-(family-name:--font-shields-sans-bold)"
            >
                <HeadingTagSubtitulo
                    class="inline-block bg-[var(--accent-highlight-secondary)] text-[var(--surface-brand-primary)] text-xs font-bold tracking-wider uppercase px-3 py-1"
                >
                    {dataToRender.tag}
                </HeadingTagSubtitulo>
                <HeadingTagTitulo
                    class="font-(family-name:--font-shields-sans-semibold-condensed) text-[40px] md:text-[80px] uppercase mt-4 leading-none
                tracking-[0]"
                >
                    {dataToRender.titulo}
                </HeadingTagTitulo>
            </div>

            <div class="flex flex-col items-start">
                <div
                    class="font-(family-name:--font-shields-sans-regular) mb-8 text-base font-normal text-left prose strapi-rich-text"
                    set:html={dataToRender.contenido}
                />
                <ButtonGroup botones={componentButtons} />
            </div>
        </div>
    </div>
</section>

<style>
    .bg-custom-gradient {
        background-image: linear-gradient(
            to right,
            var(--surface-brand-primary),
            var(--brand-interactive-base)
        );
    }
    .prose :global(p) {
        color: var(--neutral-text-inverted);
        margin: 0;
    }
    .prose :global(a) {
        color: var(--neutral-text-inverted);
        font-weight: 700;
    }
    .prose :global(a:hover) {
        text-decoration: underline;
    }

    .text-shadow-md {
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
    }
    .strapi-rich-text :global(strong) {
        font-family: var(--font-tee-line-bold-italic);
        font-weight: bold;
    }

    .strapi-rich-text :global(u) {
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
    }

    .strapi-rich-text :global(a) {
        font-weight: bold;
        color: var(--brand-interactive-base);
    }

    /* --- Agrega esto aquí --- */
    .strapi-rich-text :global(li::marker) {
        /* Usa la variable de color que desees para el punto/número */
        color: var(--neutral-background-strong);

        /* Opcional: Si quieres que el bullet sea más grande o negrita */
        font-weight: bold;
        font-size: 1.2em;
    }
</style>
