---
// src/components/Component_21.astro
import { Image } from "astro:assets";
import { getStrapiUrl, formatUrl } from '../../lib/strapi.js';
import { stringifyRichText, getHeadingTag } from '../../lib/strapi.js';

const FALLBACK_IMAGE_URL =
    "https://placehold.co/600x400/4a5568/ffffff?text=Promoción";

// 1. Definimos las interfaces para las props de Strapi
export interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
}

export interface Promocion {
    id: number;
    titulo: string;
    descripcion: string;
    imagen: StrapiMedia | null;
    url: string;
    etiqueta: string | null;
    nivel_heading?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

export interface Props {
    tag: string;
    titulo_principal: string;
    promociones: Promocion[];
    nivel_heading?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    nivel_heading_tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
}

// 2. Recibimos las props y definimos placeholders
const { tag, titulo_principal, promociones, nivel_heading, nivel_heading_tag } = Astro.props;

const placeholderData: Props = {
    tag: "LA DIVERSIÓN SIGUE EN TOPGOLF MONTERREY",
    titulo_principal: "CONOCE NUESTRAS PROMOCIONES",
    promociones: [
        {
            id: 1,
            titulo: "JUEGA GRATIS TODO LO QUE QUIERAS",
            descripcion:
                "Consume $650 por persona en alimentos y bebidas, y nosotros te regalamos el juego.",
            imagen: null,
            url: "#",
            etiqueta: "PROMO ESPECIAL",
        },
        {
            id: 2,
            titulo: "LOS LUNES YA NO VAN A SER LO MISMO",
            descripcion:
                "Lunes vas a poder venir a jugar por solo $500 la hora, ahora sí, ¡ya no tienes excusas!",
            imagen: null,
            url: "#",
            etiqueta: null,
        },
    ],
};

// 3. Preparamos los datos para renderizar
const tagToRender = tag || placeholderData.tag;
const tituloToRender = titulo_principal || placeholderData.titulo_principal;
const promotionsToRender =
    promociones && promociones.length > 0
        ? promociones
        : placeholderData.promociones;

const HeadingTagTitulo = getHeadingTag(nivel_heading);
const HeadingTagSubtitulo = getHeadingTag(nivel_heading_tag);
---

<section class="w-full bg-(--neutral-text-inverted) py-12 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <HeadingTagSubtitulo class="font-(family-name:--font-shields-sans-bold) text-left text-sm font-semibold text-(--brand-interactive-base) uppercase tracking-[0] leading-none">
            {tagToRender}
        </HeadingTagSubtitulo>
        <HeadingTagTitulo
            class="font-(family-name:--font-shields-sans-condensed)
                text-3xl md:text-[80px]
                font-bold
                text-(--neutral-background-strong)
                mb-10 md:mb-16
                leading-none
                tracking-[0]
            ">
            {tituloToRender}
        </HeadingTagTitulo>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                promotionsToRender.map((promo) => {
                    const imageUrl = (promo.imagen
                        ? getStrapiUrl(promo.imagen)
                        : null) || FALLBACK_IMAGE_URL;
                    const imageAlt =
                        promo.imagen?.alternativeText || promo.titulo;

                    const HeadingTag = getHeadingTag(promo.nivel_heading);
                    return (
                        <a
                            href={formatUrl(promo.url)}
                            class="group flex flex-col bg-[var(--neutral-background-subtle)] shadow-md hover:shadow-xl transition-all duration-300 ease-in-out overflow-hidden hover:no-underline"
                        >
                            <div class="relative mb-4">
                                <Image
                                    src={imageUrl}
                                    alt={imageAlt}
                                    class="w-full h-52 object-cover object-center group-hover:scale-105 transition-transform duration-300 ease-in-out"
                                    inferSize={true}
                                />

                                {promo.etiqueta && (
                                    <div
                                        class="font-(family-name:--font-shields-sans-bold) absolute bottom-[-16px] right-0 py-2 px-20 bg-[var(--surface-brand-primary)] text-[var(--accent-highlight-primary)] font-bold uppercase text-base z-20"
                                        aria-label={promo.etiqueta}
                                    >
                                        {promo.etiqueta}
                                    </div>
                                )}
                            </div>

                            <div class="font-(family-name:--font-shields-sans-regular) p-6 pt-0 flex-grow flex justify-between items-start tracking-[0px]">
                                <div class="flex-1 pr-4">
                                    <HeadingTag class="text-[22px] md:text-[26px] leading-tight text-[var(--brand-interactive-base)]">
                                        {promo.titulo}
                                    </HeadingTag>
                                    <div
                                        class="mt-3 text-base text-[var(--neutral-background-strong)]"
                                        set:html={stringifyRichText(
                                            promo.descripcion,
                                        )}
                                    />
                                </div>
                                <div class="flex-shrink-0 pt-1">
                                    <i class="fa-solid fa-chevron-right text-2xl text-[var(--feedback-positive-base)]" />
                                </div>
                            </div>

                        </a>
                    );
                })
            }
        </div>
    </div>
</section>
