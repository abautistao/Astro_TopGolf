---
import { stringifyRichText } from '../../lib/strapi.js';
// Recibimos la prop "contenido", que es un campo de Rich Text de Strapi.
const { contenido, padding_top } = Astro.props;
const htmlContent = stringifyRichText(contenido);
---

<div id="bloque-de-texto" class="max-w-7xl mx-auto px-4 py-8">
  <div
    class="bloque-de-texto prose prose-lg max-w-none
      [&_h1]:text-4xl [&_h1]:font-bold [&_h1]:mb-6 [&_h1]:text-gray-900
      [&_h2]:text-3xl [&_h2]:font-bold [&_h2]:mb-5 [&_h2]:text-gray-800
      [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:mb-4 [&_h3]:text-gray-800
      [&_h4]:text-xl [&_h4]:font-bold [&_h4]:mb-3 [&_h4]:text-gray-800
      [&_p]:mb-4 [&_p]:text-gray-700 [&_p]:leading-relaxed
      [&_ul]:list-disc [&_ul]:list-inside [&_ul]:mb-4 [&_ul]:ml-4 [&_ul]:text-gray-700
      [&_ol]:list-decimal [&_ol]:list-inside [&_ol]:mb-4 [&_ol]:ml-4 [&_ol]:text-gray-700
      [&_li]:mb-2
      [&_blockquote]:border-l-4 [&_blockquote]:border-gray-300 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:my-6 [&_blockquote]:text-gray-600
      [&_a]:text-blue-600 [&_a]:hover:underline
      [&_img]:rounded-lg [&_img]:shadow-md [&_img]:my-6 [&_img]:max-w-full [&_img]:h-auto
      [&_pre]:bg-gray-900 [&_pre]:text-gray-100 [&_pre]:p-4 [&_pre]:rounded-lg [&_pre]:overflow-x-auto [&_pre]:mb-6
      [&_code]:font-mono [&_code]:text-sm [&_code]:bg-gray-100 [&_code]:px-1 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-red-500
      [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:text-base [&_pre_code]:text-gray-100"
    set:html={htmlContent}
  />
</div>
<style define:vars={{ padding_top }}>
  #bloque-de-texto {
    padding-top: var(--padding_top);
  }
</style>
