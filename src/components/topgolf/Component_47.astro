---
import { Image } from "astro:assets";
import { getStrapiUrl } from '../../lib/strapi.js';

const FALLBACK_IMAGE_URL =
  "https://placehold.co/1024x1280/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Definimos las interfaces para las props de Strapi
export interface Promo {
  id: number;
  descripcion: any;
  is_bold: boolean;
}

export interface StrapiMedia {
  id: number;
  url: string;
  alternativeText: string | null;
}

export interface Props {
  imagen_principal: StrapiMedia | null;
  titulo_seccion: string;
  is_reverse: boolean;
  promos: Promo[];
}

// 2. Recibimos las props y definimos placeholders
const {
  imagen_principal,
  titulo_seccion,
  promos,
  is_reverse
} = Astro.props;

const placeholderData: Props = {
  titulo_seccion: "EN TOPGOLF HACEMOS",
  imagen_principal: null,
  is_reverse: false,
  promos: [
    {
      id: 1,
      descripcion: "Ya sea que seas un aspirante a profesional del golf...",
      is_bold: false
    },
    {
      id: 2,
      descripcion: "Contamos con un equipo completo...",
      is_bold: true
    },
  ],
};

// 3. Preparamos los datos para renderizar
const dataToRender = {
  titulo_seccion: titulo_seccion || placeholderData.titulo_seccion,
  promos:
    promos && promos.length > 0
      ? promos
      : placeholderData.promos,
};

const imageUrl = (imagen_principal
  ? getStrapiUrl(imagen_principal)
  : null) || FALLBACK_IMAGE_URL;
const imageAlt =
  imagen_principal?.alternativeText || "Imagen principal de la sección";
---

<section class:list={[
    'px-3 lg:px-8 py-8 lg:py-16',
    {
        'bg-[#f1f9ff]': is_reverse,
        'bg-[var(--neutral-text-inverted)]': !is_reverse
    }
]}>
  <div class="w-full mx-auto max-w-7xl">

      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-8 font-sans relative"
      >
        <div class:list={[
            'self-center',
            {
                'lg:order-last': is_reverse
            }
        ]}>
          <Image
            src={imageUrl}
            alt={imageAlt}
            class="w-full h-full object-cover min-h-[500px] rounded-xl"
            inferSize={true}
          />
        </div>
    
        <div
          class="text-[var(--neutral-background-strong)] relative flex flex-col justify-center"
        >
          <div
            class="z-10 lg:p-0 xl:p-0 "
          >
            <h2 class="text-xl md:text-[28px] tracking-wider uppercase font-bold mb-8 font-(family-name:--font-shields-sans-bold)">
              {dataToRender.titulo_seccion}
            </h2>
            <div class="grid grid-cols-1">
              {
                dataToRender.promos.map((promo) => (
                  <div>
                    <h3 
                        class:list={[
                            'flex items-center mb-2 text-sm',
                            {
                                'font-(family-name:--font-shields-sans-bold)': promo.is_bold,
                                'font-(family-name:--font-shields-sans-regular)': !promo.is_bold,
                            }
                        ]}>
                      <i class="fas fa-circle-check text-[var(--brand-interactive-base)] mr-3 flex-shrink-0" />
                      {promo.descripcion}
                    </h3>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
  </div>
</section>

<style>
  .strapi-rich-text :global(strong) {
    color: var(--neutral_background_strong);
    font-family: var(--font-tee-line-bold-italic) !important;
    font-weight: bold;
  }
  .strapi-rich-text :global(u) {
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .strapi-rich-text :global(a) {
    text-decoration: underline;
    text-decoration-color: var(--accent-highlight-secondary);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    color: inherit;
  }
</style>
