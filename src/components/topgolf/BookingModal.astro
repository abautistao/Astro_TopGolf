---
// Tu lógica Server-Side de Astro se mantiene igual
import type { HTMLAttributes } from 'astro/types';

export interface Props extends HTMLAttributes<'div'> {
    plugin_id?: string | null;
    user_language?: string | null;
    producto_id?: string | null;
    set_producto_id?: string | null;
    promocode?: string | null;
    set_promocode?: string | null;
    pax_min?: number | null;
    pax_max?: number | null;
    reservacion_fecha?: string | null;
    vendedor_id?: string | null;
}

const rawParams = { ...Astro.props };
const vmgPluginUrl = import.meta.env.VMG_PLUGIN_URL;
const paramsLimpios: { [key: string]: any } = {};

for (const [key, value] of Object.entries(rawParams)) {
    if (value) { 
        paramsLimpios[key] = value;
    }
}
---

<div id="booking-container" class="font-(family-name:--font-shields-sans-bold)">
    <input id="vmg_plugin_id" type="hidden" value={paramsLimpios.plugin_id}>
    <input id="vmg_plugin_url" type="hidden" value={vmgPluginUrl}>
    <input id="vendedor_id" type="hidden" value={paramsLimpios.vendedor_id}>
    <input id="reservacion_fecha" type="hidden" value={paramsLimpios.reservacion_fecha}>
    <input id="pax_min" type="hidden" value={paramsLimpios.pax_min}>
    
    <div id="pluginContainer" class="container"></div>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.2/css/all.min.css" rel="stylesheet">
    <script is:inline src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script is:inline define:vars={{ paramsLimpios, vmgPluginUrl }}>
    jQuery(document).ready(function($){
        var paramsVMG = paramsLimpios;

        // Función reutilizable para recargar el plugin con un nuevo ID
        function cargarPlugin(pluginId, vendedorId, date, pax) {
            if (!pluginId) return;

            // Muestra un estado de carga mientras hace el request (opcional)
            $("#pluginContainer").html('<p>Cargando reservación...</p>');

            $.getScript(`https://plugin.venturae.com.mx/js/pluginscripts.js`, function() {
                "use strict";
                $.pluginUrl = `https://plugin.venturae.com.mx/requesterv2.php`;
                var params = {
                    ...paramsVMG,
                    'plugin_id': pluginId,
                    'vendedor_id': vendedorId,
                    'reservacion_fecha': date,
                    'pax': pax,
                };
                
                const urlParams = new URLSearchParams(window.location.search);
                urlParams.forEach((value, key) => {
                    params[key] = value;
                });
                
                $.post($.pluginUrl, params, function(data) {
                    $("#pluginContainer").html(data);
                });
            });
        }

        // Carga inicial con el ID enviado por Astro
        var initialPluginId = $('#vmg_plugin_id').val();
        var initialVendedorId = $('#vendedor_id').val();
        var initialDate = $('#reservacion_fecha').val();
        var initialPax = $('#pax_min').val();
        cargarPlugin(initialPluginId, initialVendedorId, initialDate, initialPax);

        // Escuchar el evento personalizado desde cualquier otro componente
        window.addEventListener('update-booking-plugin', function(e) {
            if (e.detail && e.detail.vendedorId) {
                // Actualizamos el input oculto por consistencia
                $('#vmg_plugin_id').val(e.detail.pluginId);
                $('#vendedor_id').val(e.detail.vendedorId);
                $('#reservacion_fecha').val(e.detail.date);
                $('#pax_min').val(e.detail.pax);
                // Re-ejecutamos la carga con el nuevo ID
                cargarPlugin(e.detail.pluginId,e.detail.vendedorId,e.detail.date,e.detail.pax);
            }
        });

        // --- El resto de tus event listeners (DataLayer, GA4, etc.) se quedan igual ---
        var checkoutItems = [];
        function getRandomInt(min, max) {
            min = Math.ceil(min);
            max = Math.floor(max);
            return Math.floor(Math.random() * (max - min + 1)) + min;
        }

        jQuery(document).on('click', '#next_one', function(e) { /* ... */ });
        jQuery(document).on('click', '#next_two', function(e) { /* ... */ });
        jQuery(document).on('click', '#next_three', function(e) { /* ... */ });
        jQuery(document).on('click', '.btn-select-prod', function(e) { /* ... */ });
    });
    </script>
</div>