---
// src/components/Component_42.astro

// ----------------------------------------
// UPDATED PROPS & INTERFACES
// ----------------------------------------
import type { Boton } from "./elements/Button.astro";

interface FormField {
    id: number;
    label: string;
    placeholder?: string;
    name: string;
    inputType:
        | "text"
        | "select"
        | "date"
        | "time"
        | "number"
        | "email"
        | "textarea";
    gridWidth: "full" | "half";
    options?: string; // Comma separated or JSON string
    required?: boolean;
}

interface Props {
    title?: string;
    description?: string;
    fields?: FormField[];
    submitUrl?: string;
    submitButton?: Boton;
}

const { title, description, fields, submitUrl, submitButton } = Astro.props;

// Mock Data for development/fallback
const mockFields: FormField[] = [
    {
        id: 1,
        label: "Tipo de evento",
        name: "eventType",
        inputType: "select",
        gridWidth: "half",
        options: "Cumpleaños, Corporativo, Despedida, Otro",
        placeholder: "Selecciona una opción",
        required: true,
    },
    {
        id: 2,
        label: "Número de invitados",
        name: "guestCount",
        inputType: "number",
        gridWidth: "half",
        required: true,
    },
    {
        id: 3,
        label: "Fecha del evento",
        name: "eventDate",
        inputType: "date",
        gridWidth: "full",
        placeholder: "dd/mm/aaaa",
        required: true,
    },
    {
        id: 4,
        label: "Hora preferente de comienzo",
        name: "startTime",
        inputType: "time",
        gridWidth: "half",
        placeholder: "Selecciona horario",
        required: true,
    },
    {
        id: 5,
        label: "Hora preferente de finalización",
        name: "endTime",
        inputType: "time",
        gridWidth: "half",
        placeholder: "Selecciona horario",
        required: true,
    },
    {
        id: 6,
        label: "¿Cómo supiste de Topgolf?",
        name: "referralSource",
        inputType: "select",
        gridWidth: "full",
        options: "Redes Sociales, Amigos, Publicidad, Otro",
        placeholder: "Selecciona una opción",
    },
];

// Mock Button Data
const mockButton: Boton = {
    id: 0,
    texto: "ENVIAR SOLICITUD",
    url: "",
    tipo: "version_6", // Matching the clean style
};

const data = {
    title: title || "DETALLES DEL EVENTO",
    fields: fields || mockFields,
    submitUrl: submitUrl || "",
    button: submitButton || mockButton,
};

// Helper to parse options
const getOptions = (optionsStr?: string) => {
    if (!optionsStr) return [];
    return optionsStr.split(",").map((o) => o.trim());
};
---

<section class="w-full max-w-4xl mx-auto p-6 bg-white font-sans">
    <h2 class="text-2xl font-bold uppercase mb-8 text-black tracking-tight">
        {data.title}
    </h2>

    <form class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-6" id="events-form">
        {
            data.fields.map((field) => {
                // RENDER SECTION TITLE
                if (field.inputType === "section_title") {
                    return (
                        <div class="col-span-1 md:col-span-2 mt-8 mb-4">
                            <h2 class="text-2xl font-bold uppercase mb-2 text-black tracking-tight border-b pb-2 border-gray-200">
                                {field.label}
                            </h2>
                        </div>
                    );
                }

                // RENDER CHECKBOX
                if (field.inputType === "checkbox") {
                    return (
                        <div class="col-span-1 md:col-span-2 flex items-start gap-3 mt-4">
                            <input
                                id={field.name}
                                name={field.name}
                                type="checkbox"
                                required={field.required}
                                class="mt-1 h-4 w-4 rounded border-gray-300 text-[#5b67c7] focus:ring-[#5b67c7]"
                            />
                            <label
                                for={field.name}
                                class="text-sm text-gray-600 leading-snug"
                            >
                                {field.label}
                            </label>
                        </div>
                    );
                }

                // RENDER STANDARD INPUTS
                return (
                    <div
                        class={`${field.gridWidth === "full" ? "col-span-1 md:col-span-2" : "col-span-1"}`}
                    >
                        <label
                            for={field.name}
                            class="block text-sm font-medium text-gray-700 mb-2"
                        >
                            {field.label}
                        </label>

                        {field.inputType === "select" ? (
                            <div class="relative">
                                <select
                                    id={field.name}
                                    name={field.name}
                                    required={field.required}
                                    class="appearance-none w-full bg-white border border-[#5b67c7] text-gray-500 rounded-md py-3 px-4 leading-tight focus:outline-none focus:ring-1 focus:ring-[#5b67c7] focus:border-[#5b67c7]"
                                >
                                    <option value="" disabled selected>
                                        {field.placeholder ||
                                            "Selecciona una opción"}
                                    </option>
                                    {getOptions(field.options).map((opt) => (
                                        <option value={opt}>{opt}</option>
                                    ))}
                                </select>
                                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-[#5b67c7]">
                                    <svg
                                        class="fill-current h-4 w-4"
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 20 20"
                                    >
                                        <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" />
                                    </svg>
                                </div>
                            </div>
                        ) : field.inputType === "textarea" ? (
                            <textarea
                                id={field.name}
                                name={field.name}
                                placeholder={field.placeholder}
                                required={field.required}
                                rows="4"
                                class="w-full bg-white border border-[#5b67c7] text-gray-700 rounded-md py-3 px-4 focus:outline-none focus:ring-1 focus:ring-[#5b67c7]"
                            />
                        ) : (
                            <div class="relative">
                                <input
                                    type={field.inputType}
                                    id={field.name}
                                    name={field.name}
                                    placeholder={field.placeholder}
                                    required={field.required}
                                    class="w-full bg-white border border-[#5b67c7] text-gray-700 rounded-md py-3 px-4 focus:outline-none focus:ring-1 focus:ring-[#5b67c7] placeholder-gray-400 text-[14px] leading-[1.5]"
                                />
                                {/* Icons specifically for layout matching if needed, though browser default date/time/number have their own controls. 
                For stricter visual match we might force custom icons but native inputs are better for a11y. 
                We can style the calendar/time icon color via CSS if browsers support it, or rely on browser defaults.
            */}
                            </div>
                        )}
                    </div>
                );
            })
        }

        {/* Submit Button Section */}
        {
            data.button && (
                <div class="col-span-1 md:col-span-2 mt-4 flex justify-end">
                    <button
                        type="submit"
                        class:list={[
                            "transform rounded-full font-bold uppercase transition-all hover:scale-105 font-(family-name:--font-shields-sans-bold)",
                            "w-full sm:w-auto",
                            "px-8 py-3",
                            "text-center flex justify-center items-center text-base",
                            {
                                "bg-[var(--neutral-text-inverted)] text-[var(--surface-brand-primary)] shadow-lg":
                                    data.button.tipo === "version_1",
                                "border-2 border-[var(--accent-highlight-secondary)] text-[var(--accent-highlight-secondary)]":
                                    data.button.tipo === "version_2",
                                "bg-[var(--brand-interactive-base)] text-[var(--neutral-text-inverted)]":
                                    data.button.tipo === "version_3",
                                "bg-[var(--surface-brand-primary)] text-[var(--accent-highlight-secondary)]":
                                    data.button.tipo === "version_4",
                                "border-2 border-[var(--brand-interactive-base)] text-[var(--brand-interactive-base)]":
                                    data.button.tipo === "version_5",
                                "border-2 border-[#5b67c7] text-[#5b67c7] hover:bg-[#5b67c7] hover:text-white":
                                    data.button.tipo === "version_6",
                            },
                        ]}
                    >
                        {data.button.texto}
                    </button>
                </div>
            )
        }
        <div
            id="form-message"
            class="col-span-1 md:col-span-2 text-xl mt-4 text-center text-sm font-semibold hidden "
        >
        </div>
    </form>
</section>

<style>
    /* Custom overrides for specific input types to match designs if needed */
    input[type="date"]::-webkit-calendar-picker-indicator {
        /* filter: invert(37%) sepia(34%) saturate(2256%) hue-rotate(213deg) brightness(96%) contrast(92%); */
        /* Matches standard purplish color roughly or we can leave default */
        cursor: pointer;
    }
</style>
<script define:vars={{ submitUrl }} >
    const form = document.getElementById("events-form");
    const messageDiv = document.getElementById("form-message");

    if (form) {
        form.addEventListener("submit", async (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const submitButton = form.querySelector(
                'button[type="submit"]',
            );

            if (submitButton) submitButton.disabled = true;
            if (messageDiv) {
                messageDiv.classList.add("hidden");
                messageDiv.textContent = "";
                messageDiv.className =
                    "mt-4 text-center text-sm font-semibold hidden";
            }

            try {
                const response = await fetch("/api/events-email", {
                    method: "POST",
                    body: formData,
                });

                const data = await response.json();

                if (response.ok) {
                    if (messageDiv) {
                        messageDiv.textContent =
                            "¡Gracias por contactarse! Hemos recibido tus datos.";
                        messageDiv.classList.remove("hidden");
                        messageDiv.classList.add("text-green-400");
                    }
                    form.reset();

                    setTimeout(() => {
                        messageDiv.classList.add("hidden");
                    }, 5000);
                } else {
                    throw new Error(
                        data.message || "Error al enviar el formulario",
                    );
                }
            } catch (error) {
                if (messageDiv) {
                    messageDiv.textContent =
                        error instanceof Error
                            ? error.message
                            : "Ocurrió un error inesperado. Por favor, intenta de nuevo.";
                    messageDiv.classList.remove("hidden");
                    messageDiv.classList.add("text-red-400");
                }
            } finally {
                if (submitButton) submitButton.disabled = false;
            }
        });
    }
</script>
