---
// src/components/Component_16.astro
import { Image } from "astro:assets";
import { getStrapiUrl, stringifyRichText, getHeadingTag } from '../../lib/strapi.js';
import ButtonGroup from "./elements/Button.astro";
import type { Boton } from "./elements/Button.astro";
const FALLBACK_IMAGE_URL =
    "https://placehold.co/600x400/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Interfaz para el objeto de imagen de Strapi
export interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
}

// 2. Interfaz para cada paquete
export interface Package {
    id: number;
    tag: string;
    titulo: string;
    subtitulo: string;
    descripcion: any;
    imagen: StrapiMedia | null;
    texto_boton: string;
    url_boton: string;
    Boton: Boton[];
    nivel_heading_titulo?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    nivel_heading_subtitulo?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    tag_background: string;
    tag_text_color: string;
}

export interface Props {
    paquetes: Package[];
    titulo: string;
    nivel_heading_tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
    columns: string;
}

const { paquetes, nivel_heading_tag, titulo, columns } = Astro.props;

const placeholderButton: Boton[] = [
    {
        id: 1,
        texto: "Lorem Ipsum",
        url: "#",
        tipo: "version_3", // Usamos version_1 para el estilo principal
    },
];
const placeholderPackages: Package[] = [
    {
        id: 1,
        tag: "REUNIÓN DE AMIGOS",
        titulo: "GAME & CREDIT",
        subtitulo: "7 A 12 PERSONAS",
        descripcion: [
            {
                type: "paragraph",
                children: [{ type: "text", text: "Contenido de ejemplo." }],
            },
        ],
        imagen: null,
        texto_boton: "¡RESERVA EN LÍNEA!",
        url_boton: "#",
        Boton: placeholderButton,
        tag_background: "#050786",
        tag_text_color: "#00FFFF",
    },
];

const packagesToRender =
    paquetes && paquetes.length > 0 ? paquetes : placeholderPackages;

const HeadingTag = getHeadingTag(nivel_heading_tag);
const cols = columns ? columns : 3;
---

<section class="w-full bg-(--neutral-text-inverted) py-10 sm:py-14 lg:pt-0">
    <div
        style="font-family: var(--font-shields-sans-regular);"
        class="container mx-auto px-4"
    >
        <HeadingTag
            class="font-(family-name:--font-shields-sans-condensed) text-3xl font-semibold uppercase text-(--neutral-background-strong) sm:text-5xl md:text-5xl text-center mb-12"
        >
            {titulo}
        </HeadingTag>

        <div class=`grid grid-cols-1 lg:grid-cols-${cols} justify-center gap-8 sm:py-4 max-w-7xl mx-auto`>
            {
                packagesToRender.map((pkg) => {
                    const contentHtml = stringifyRichText(pkg.descripcion);

                    // --- LÓGICA CORREGIDA ---
                    // Ahora pasamos el objeto de imagen COMPLETO a getStrapiUrl
                    const imageUrl = (pkg.imagen
                        ? getStrapiUrl(pkg.imagen)
                        : null) || FALLBACK_IMAGE_URL;
                    const imageAlt = pkg.imagen?.alternativeText || pkg.titulo;

                    const componentButtons: Boton[] = (pkg.Boton &&
                    !Array.isArray(pkg.Boton)
                        ? [pkg.Boton]
                        : pkg.Boton) || [
                        {
                            id: 1,
                            texto: pkg.texto_boton || "Lorem Ipsum",
                            url: pkg.url_boton || "#",
                            tipo: "version_3",
                        },
                    ];
                    
                    const HeadingTagTitulo = getHeadingTag(pkg.nivel_heading_titulo);
                    const HeadingTagSubtitulo = getHeadingTag(pkg.nivel_heading_subtitulo);

                    const tagBg = pkg.tag_background ? pkg.tag_background : "#050786";
                    const tagTextColor= pkg.tag_text_color ? pkg.tag_text_color : "#00FFFF";

                    return (
                        <div class="bg-[var(--neutral-background-subtle)] shadow-sm overflow-hidden flex flex-col text-center">
                            <div class="relative">
                                <Image
                                    src={imageUrl}
                                    alt={imageAlt}
                                    class="w-full h-60 object-cover"
                                    inferSize={true}
                                />
                                <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2">
                                    <span
                                        style={{ color: tagTextColor, background: tagBg }} 
                                        class="whitespace-nowrap font-(family-name:--font-shields-sans-bold) font-semibold tracking-wider px-4 py-2 uppercase text-[13px]">
                                        {pkg.tag}
                                    </span>
                                </div>
                            </div>
                            <div class="p-8 flex flex-col flex-grow">
                                <HeadingTagTitulo class="text-4xl font-semibold text-[var(--surface-brand-primary)] uppercase font-(family-name:--font-shields-sans-semibold-condensed) leading-none mb-0">
                                    {pkg.titulo}
                                </HeadingTagTitulo>
                                <HeadingTagSubtitulo class="text-base font-normal text-[var(--surface-brand-primary)] uppercase tracking-wider mt-0 font-(family-name:--font-shields-sans-regular)">
                                    {pkg.subtitulo}
                                </HeadingTagSubtitulo>
                                <div
                                    class="text-[var(--neutral-background-strong)] mt-6 text-sm space-y-3 flex-grow prose max-w-none font-normal font-(family-name:--font-shields-sans-regular)"
                                    set:html={contentHtml}
                                />
                                <div class="mt-8 flex justify-center">
                                    <ButtonGroup botones={componentButtons} />
                                </div>
                            </div>
                        </div>
                    );
                })
            }
        </div>
    </div>
</section>

<style>
    .prose :global(strong) {
        color: var(--brand-interactive-base);
    }
    .prose :global(a) {
        text-decoration: underline;
        text-decoration-color: var(--accent-highlight-secondary);
        text-decoration-thickness: 2px;
        text-underline-offset: 3px;
        color: var(--brand-interactive-base);
    }
    .prose :global(u) {
        color: var(--accent-highlight-secondary) !important;
        font-weight: 600;
        text-decoration-thickness: 2px;
    }
    .prose :global(a:hover) {
        text-decoration: underline;
    }
</style>
