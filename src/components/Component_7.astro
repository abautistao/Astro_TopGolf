---
// src/components/Component_7.astro
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";

// 1. Definimos la interfaz de las props que el componente recibirá desde Strapi.
export interface Props {
  titulo_pequeno: string;
  titulo_principal: string;
  descripcion: any; // Rich Text de Strapi
  cta_titulo: string;
  cta_boton_texto: string;
  cta_boton_url: string;
  imagen_fondo: any; // Media de Strapi
}

// 2. Recibimos las props de Strapi a través de Astro.props
const {
  titulo_pequeno,
  titulo_principal,
  descripcion,
  cta_titulo,
  cta_boton_texto,
  cta_boton_url,
  imagen_fondo,
} = Astro.props;

// 3. Procesamos la URL de la imagen, el texto enriquecido y los alternativos
const heroBackgroundUrl = getStrapiUrl(imagen_fondo);
const alt_imagen_fondo = imagen_fondo?.data?.attributes?.alternativeText;
const descriptionHtml = stringifyRichText(descripcion);

// 4. URLs y contenido de placeholder en caso de que no haya datos en Strapi
const placeholderBgUrl = `https://placehold.co/1280x720/2d3748/ffffff?text=Imagen+Fondo`;
const placeholderDescriptionHtml = `<p>Esta es una descripción de ejemplo. <strong>Reemplázala</strong> con tu contenido desde Strapi.</p>`;
---

<section
  class="relative flex items-center w-full text-[var(--neutral-text-inverted)] min-h-[550px] md:min-h-[650px]"
>
  <img
    src={heroBackgroundUrl || placeholderBgUrl}
    alt={alt_imagen_fondo || "Imagen de fondo de la sección"}
    class="absolute inset-0 object-cover w-full h-full"
  />
  <div class="absolute inset-0 bg-[var(--neutral-background-strong)]/30"></div>
  <div class="relative w-full mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="grid grid-cols-1 items-center gap-y-12 lg:grid-cols-2 lg:gap-x-16"
    >
      <div class="text-center lg:text-left">
        <h3
          class="mt-5 lg:mt-0  py-1 px-2 text-sm font-bold uppercase tracking-wider text-[var(--accent-highlight-secondary)] bg-[var(--surface-brand-primary)]"
        >
          {titulo_pequeno || "Título Pequeño"}
        </h3>

        <h2
          class="mt-4 text-4xl font-extrabold text-[var(--neutral-text-inverted)] sm:text-5xl lg:text-6xl"
        >
          {titulo_principal || "Título Principal de la Sección"}
        </h2>

        <div class="mt-6 text-lg text-[var(--neutral-text-inverted)] prose prose-invert">
            <div set:html={descriptionHtml || placeholderDescriptionHtml} />
        </div>
      </div>

      <div class="flex justify-center lg:justify-end">
        <div
          class="relative w-full max-w-md bg-[var(--surface-brand-primary)] p-8 sm:p-10"
        >
          <div
            class="absolute left-0 top-0 h-full w-1.5 bg-[var(--accent-highlight-primary)]"
          ></div>
          <div class="flex h-full flex-col justify-center">
            <h3 class="text-xl font-bold text-[var(--neutral-text-inverted)]">
              {cta_titulo || "Título del Llamado a la Acción"}
            </h3>
            <div class="mt-8">
              <a
                href={cta_boton_url || "#"}
                class="inline-flex items-center justify-center rounded-full bg-[var(--neutral-text-inverted)] px-6 py-3 font-semibold text-[var(--surface-brand-secondary)] shadow-sm transition hover:bg-gray-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
              >
                <i class="fa-solid fa-arrow-right mx-2"></i>
                {cta_boton_texto || "Botón CTA"}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
    /* Estilos para asegurar que el contenido de Strapi se vea bien */
    .prose :global(strong) {
        color: var(--accent-highlight-primary);
    }
    .prose :global(a) {
        color: var(--accent-highlight-secondary);
        text-decoration: underline;
    }
</style>