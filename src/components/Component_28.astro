---
// src/components/Component_28.astro
import { stringifyRichText } from "../lib/strapi.js";

// 1. Definimos las interfaces para las props de Strapi
export interface Props {
  titulo: string;
  terminos: any; // Rich Text
}

// 2. Recibimos las props y definimos placeholders
const { titulo, terminos } = Astro.props;

const placeholderData: Props = {
  titulo: "Términos y condiciones",
  terminos: [
    {
      type: 'list',
      format: 'unordered',
      children: [
        { type: 'list-item', children: [{ type: 'text', text: 'Venta exclusiva en línea.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'El saldo de la tarjeta de regalo no es reembolsable por dinero en efectivo.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'El saldo de la tarjeta de regalo no puede transferirse a otra tarjeta.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'El monto en dinero cargado en la tarjeta de regalo se encuentra en moneda nacional (MXN).' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'Cualquier saldo cargado por el usuario podrá ser utilizado como método de pago para adquirir cualquier producto o servicio dentro de Topgolf Monterrey.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'Cualquier saldo regalado como promoción por Topgolf (en este caso las cargas de saldo, otorgarán puntos promocionales equivalentes al 10% de lo abonado) sólo podrá ser utilizado para tiempo de juego con una vigencia de 6 meses a partir de la fecha de la carga.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'El saldo en la tarjeta de regalo abonado no expira, solo el saldo promocional.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'Los puntos regalados no pueden ser utilizados el mismo día de la compra, estos serán válidos 24hrs después de la compra.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'En caso de robo o extravío de la tarjeta de regalo, el propietario y/o titular de la misma, deberá reportarlo de inmediato a Topgolf Monterrey para llevar a cabo la cancelación del plástico y transferencia de saldo, el cual estará condicionado sin excepción a la presentación del ticket de compra original o digital, la falta de ticket deslinda a Topgolf Monterrey de llevar a cabo cualquier transferencia de saldo sin responsabilidad alguna.' }] },
        { type: 'list-item', children: [{ type: 'text', text: 'Vigencia a diciembre de 2025.', bold: true }] },
      ]
    }
  ]
};

// 3. Preparamos los datos para renderizar
const tituloToRender = titulo || placeholderData.titulo;
const terminosHtml = stringifyRichText(terminos || placeholderData.terminos);
---

<section class="w-full bg-[var(--neutral-background-subtle)] py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-center text-3xl lg:text-4xl font-bold text-[var(--neutral-background-strong)]">
            {tituloToRender}
        </h2>
        <div class="mt-8 text-[var(--neutral-background-strong)] prose max-w-none" set:html={terminosHtml}></div>
    </div>
</section>

<style>
    .prose :global(ul) {
        list-style-type: disc;
        padding-left: 1.25rem;
    }
</style>