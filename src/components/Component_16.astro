---
// src/components/Component_16.astro
import { getStrapiUrl, stringifyRichText } from "../lib/strapi.js";
import ButtonGroup from './elements/Button.astro';
import type { Boton } from './elements/Button.astro';
const FALLBACK_IMAGE_URL = "https://placehold.co/600x400/4a5568/ffffff?text=Imagen+no+disponible";

// 1. Interfaz para el objeto de imagen de Strapi
export interface StrapiMedia {
    id: number;
    url: string;
    alternativeText: string | null;
}

// 2. Interfaz para cada paquete
export interface Package {
    id: number;
    tag: string;
    titulo: string;
    subtitulo: string;
    descripcion: any;
    imagen: StrapiMedia | null;
    texto_boton: string;
    url_boton: string;
    Boton: Boton[];
}

export interface Props {
    paquetes: Package[];
}

const { paquetes } = Astro.props;


const placeholderButton: Boton[] = [{
    id: 1,
    texto: "Lorem Ipsum",
    url: "#",
    tipo: "version_3" // Usamos version_1 para el estilo principal
}];
const placeholderPackages: Package[] = [
    {
        id: 1,
        tag: "REUNIÓN DE AMIGOS",
        titulo: "GAME & CREDIT",
        subtitulo: "7 A 12 PERSONAS",
        descripcion: [{ type: 'paragraph', children: [{ type: 'text', text: "Contenido de ejemplo." }] }],
        imagen: null,
        texto_boton: "¡RESERVA EN LÍNEA!",
        url_boton: "#",
        Boton: placeholderButton
    },
];

const packagesToRender = paquetes && paquetes.length > 0 ? paquetes : placeholderPackages;
---

<section class="w-full bg-[var(--neutral-text-inverted)] py-16 sm:py-24">
    <div style="font-family: var(--font-shields-sans-regular);" class="container mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {packagesToRender.map((pkg) => {
                const contentHtml = stringifyRichText(pkg.descripcion);


                // --- LÓGICA CORREGIDA ---
                // Ahora pasamos el objeto de imagen COMPLETO a getStrapiUrl
                const imageUrl = pkg.imagen
                    ? getStrapiUrl(pkg.imagen)
                    : FALLBACK_IMAGE_URL;
                const imageAlt = pkg.imagen?.alternativeText || pkg.titulo;

                const componentButtons: Boton[] = (pkg.Boton && !Array.isArray(pkg.Boton) ? [pkg.Boton] : pkg.Boton) || [
                {   id: 1,
                    texto: pkg.texto_boton || "Lorem Ipsum",
                    url: pkg.url_boton || "#",
                    tipo: "version_3"
                }];


                return (
                    <div class="bg-[var(--neutral-background-subtle)] shadow-sm overflow-hidden flex flex-col text-center">
                        <div class="relative">
                            <img src={imageUrl} alt={imageAlt} class="w-full h-60 object-cover" />
                            <div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2">

                                <span class="whitespace-nowrap font-(family-name:--font-shields-sans-regular) bg-[var(--surface-brand-primary)] text-[var(--accent-highlight-secondary)] font-semibold tracking-wider px-4 py-2 uppercase text-[13px]">
                                    {pkg.tag}
                                </span>
                            </div>
                        </div>
                        <div class="p-8 flex flex-col flex-grow">
                            <h2 class="text-4xl font-semibold text-[var(--surface-brand-primary)] uppercase font-(family-name:--font-shields-sans-condensed) whitespace-nowrap leading-none mb-0">{pkg.titulo}</h2>
                            <p class="text-base font-normal text-[var(--surface-brand-primary)] uppercase tracking-wider mt-0 font-(family-name:--font-shields-sans-regular)">{pkg.subtitulo}</p>
                            <div class="text-[var(--neutral-background-strong)] mt-6 text-sm space-y-3 flex-grow prose max-w-none font-normal font-(family-name:--font-shields-sans-regular)" set:html={contentHtml} />
                            <div class="mt-8 flex justify-center">
                                <ButtonGroup botones={componentButtons} />
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</section>

<style>
    .prose :global(strong) { color: var(--brand-interactive-base); }
    .prose :global(a) { color: var(--accent-highlight-secondary) !important; font-weight: 600; text-decoration-thickness: 2px;}
    .prose :global(u) { color: var(--accent-highlight-secondary) !important; font-weight: 600; text-decoration-thickness: 2px;}
    .prose :global(a:hover) { text-decoration: underline; }
</style>