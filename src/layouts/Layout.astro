---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const response = await fetch("https://cms-topgolf.venturaentertainment.mx/api/setup-site");
const { data } = await response.json();

const customStyles = `
    :root {
        --primary-color: ${data.primary_color};
        --secondary-color: ${data.secondary_color};
        --font-family-base: "${data.font_family_base}", sans-serif;
        --h1-font-size: ${data.h1_font_size}px;
    }
`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro Basics</title>
        <style is:global set:html={customStyles} />
    </head>
    <body>
        <Header />
        <slot />
		<Footer />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>