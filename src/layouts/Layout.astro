---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSiteSetup } from '../lib/strapi.js';

const setupData = await getSiteSetup();

const customStyles = setupData ? `
    :root {
        --primary-color: ${setupData.primary_color};
        --secondary-color: ${setupData.secondary_color};
        --font-family-base: "${setupData.font_family_base}", sans-serif;
        --h1-font-size: ${setupData.h1_font_size}px;
    }
` : '';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro Basics</title>
        <style is:global set:html={customStyles} />
    </head>
    <body>
        <Header />
        <slot />
		<Footer />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>