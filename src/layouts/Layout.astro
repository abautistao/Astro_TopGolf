---
// Importa los estilos y componentes necesarios.
import "../styles/global.css";
import Header from "../components/shared/SmartHeader.astro";
import Footer from "../components/shared/SmartFooter.astro";
import SEO from "../components/shared/SEO.astro";
import LanguageSwitcher from "../components/shared/LanguageSwitcher.astro";
// Importa las funciones para obtener datos de configuración y generar fuentes desde Strapi.
import {
    getSiteSetup,
    generateFontFaces,
    getStrapiUrl,
} from "../lib/strapi.js";

// Obtiene los datos de configuración del sitio.
// Obtiene los datos de configuración del sitio.
const { lang: paramsLang } = Astro.params;
const { lang: propsLang, seo, title, alternateLinks } = Astro.props;

const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

let locale = propsLang || paramsLang || defaultLocale;
if (!isMultiLanguage) {
    locale = defaultLocale;
}

const setupData = await getSiteSetup(locale);

// ============================================================================
// TEMPORAL PARA DESARROLLO: Sobreescritura de colores por query param o .env
// Permite ver el sitio como Acuario o Sealands sin cambiar Strapi.
// Uso en navegador: http://localhost:4321/?theme=acuario o ?theme=sealands
// ============================================================================
const queryTheme = Astro.url.searchParams.get('theme');
const devTheme = queryTheme || import.meta.env.PUBLIC_DEV_THEME;

if (setupData && devTheme) {
    if (devTheme === 'acuario') {
        setupData.surface_brand_primary = '#003F7F';
        setupData.surface_brand_secondary = '#005DA8';
        setupData.neutral_background_strong = '#1A1A2E';
        setupData.brand_interactive_base = '#F5A623';
        setupData.neutral_text_inverted = '#FFFFFF';
        setupData.accent_highlight_primary = '#00BFCF';
        setupData.accent_highlight_secondary = '#0097C4';
        setupData.accent_highlight_tertiary = '#FFFFFF';
        setupData.neutral_background_subtle = '#F0F4F8';
        setupData.accent_feedback_strong = '#F5A623';
        setupData.feedback_positive_dark = '#003F7F';
        setupData.feedback_positive_base = '#00BFCF';
        setupData.feedback_info_background = '#005DA8';
    } else if (devTheme === 'sealands') {
        setupData.surface_brand_primary = '#0080BB';
        setupData.surface_brand_secondary = '#4B9C38';
        setupData.neutral_background_strong = '#0080BB';
        setupData.brand_interactive_base = '#FD7E14';
        setupData.neutral_text_inverted = '#FFFFFF';
        setupData.accent_highlight_primary = '#17A4F3';
        setupData.accent_highlight_secondary = '#4B9C38';
        setupData.accent_highlight_tertiary = '#FFFFFF';
        setupData.neutral_background_subtle = '#FFFFFF';
        setupData.accent_feedback_strong = '#FD7E14';
        setupData.feedback_positive_dark = '#0080BB';
        setupData.feedback_positive_base = '#4B9C38';
        setupData.feedback_info_background = '#17A4F3';
    }
}
// ============================================================================
const faviconUrl = setupData?.favicon
    ? getStrapiUrl(setupData.favicon)
    : "/favicon.svg";

// Genera las declaraciones @font-face si los datos de tipografía existen.
const fontStyles = setupData ? generateFontFaces(setupData.tipografias) : '';

// Define variables CSS personalizadas y otros estilos basados en los datos de configuración.
const customStyles = setupData
    ? `
    :root {
        --surface-brand-primary: ${setupData.surface_brand_primary};
        --surface-brand-secondary: ${setupData.surface_brand_secondary};
        --brand-interactive-base: ${setupData.brand_interactive_base};
        --neutral-background-subtle: ${setupData.neutral_background_subtle};
        --neutral-text-inverted: ${setupData.neutral_text_inverted};
        --accent-feedback-strong: ${setupData.accent_feedback_strong};
        --accent-highlight-secondary: ${setupData.accent_highlight_secondary};
        --accent-highlight-primary: ${setupData.accent_highlight_primary};
        --feedback-positive-dark: ${setupData.feedback_positive_dark};
        --feedback-positive-base: ${setupData.feedback_positive_base};
        --feedback-info-background: ${setupData.feedback_info_background};
        --neutral-background-strong: ${setupData.neutral_background_strong};
        --accent-highlight-tertiary: ${setupData.accent_highlight_tertiary};
    }
    .bg-custom-gradient {
        background-image: linear-gradient(to right, var(--surface-brand-secondary), var(--brand-interactive-base));
    }
`
    : "";

// Combina los estilos de fuente y los estilos personalizados en una sola cadena.
const allStyles = fontStyles + customStyles;

const defaultSeo = {
    metaTitle: title || "Astro Basics",
    metaDescription: "Sitio web desarrollado con Astro y Strapi",
};

const seoProps = seo || defaultSeo;
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
    <head>
        { setupData?.google_tag_manager_id && (
            <script is:inline>
                window.dataLayer = window.dataLayer || [];
            </script>

            <script type="text/partytown" define:vars={{ setupData }}>;(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer',setupData.google_tag_manager_id);</script>
        )}
        
        <meta charset="UTF-8" />
        <link rel="icon" href={faviconUrl} />
        <meta name="generator" content={Astro.generator} />
    
        <SEO {...seoProps} />

        <!-- Inyecta todos los estilos dinámicos en una etiqueta de estilo global. -->
        <style is:global set:html={allStyles}></style>
    </head>
    <body>
        
        {setupData?.google_tag_manager_id && (
            <noscript><iframe src=`https://www.googletagmanager.com/ns.html?id=${setupData.google_tag_manager_id}`
            height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
        )}
        
        <Header locale={locale} alternateLinks={alternateLinks} />
        <!-- El contenido de la página se insertará aquí. -->
        <slot />
        <Footer locale={locale} />
        <LanguageSwitcher
            alternateLinks={alternateLinks}
            class="fixed bottom-20 right-4 z-50 bg-white text-black p-2 rounded shadow border border-gray-200"
        />
    </body>
</html>

<style>
    /* Estilos básicos para asegurar que el HTML y el body ocupen toda la pantalla. */
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
