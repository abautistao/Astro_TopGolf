    { id: "planes", label: "Elige tu jugada" },
    { id: "juegos", label: "Nuestros juegos" },
    { id: "espacios", label: "Nuestros espacios" },
    { id: "formatos", label: "Elige tu formato" },
    { id: "promociones", label: "Precios por persona" },
    { id: "sedes", label: "Sedes" },
    { id: "tarifas", label: "Tarifas por día" },
    { id: "articulos", label: "Lo nuevo en TOCA" },
    { id: "experiencias", label: "Vive la experiencia" },
    { id: "pilares", label: "Steps · Pilares" },
    { id: "pasos-experiencia", label: "Steps · Experiencia" },
    { id: "niveles-juego", label: "Steps · Niveles" },
    { id: "pasos-promo", label: "Steps · Promo" },
    { id: "ocasiones", label: "Steps · Ocasiones" },
    { id: "pasos-cumpleanos", label: "Steps · Cumpleaños" },
    { id: "pasos-evento", label: "Steps · Evento" },
    { id: "info-visita", label: "Steps · Info visita" },
    { id: "tecnologia", label: "Steps · Tecnología" }
];
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Catálogo de cards TOCA</title>
        <meta name="description" content="Catálogo de los componentes de cards del rediseño TOCA con datos dummy" />
        <!-- Evita la peticion a /favicon.ico: cae en el catch-all [...slug] y su Layout
             revienta con el footer del CMS, lo que paints el overlay de error de Vite. -->
        <link rel="icon" href="data:," />
    </head>
    <body>
    <div
        class="catalogo-toca"
        style="
            --surface-brand-primary: #0A0037;
            --surface-brand-secondary: #FA8CFF;
            --brand-interactive-base: #59FFC6;
            --neutral-background-strong: #000000;
            --neutral-text-inverted: #FFFFFF;
            --custom-color-01: #1A1052;
            --accent-highlight-primary: #B9B2DE;
            --accent-highlight-secondary: #6EC1E4;
        "
    >
        <nav class="barra">
            <span class="barra-titulo">Cards TOCA · catálogo</span>
            <select id="saltar" class="barra-select">
                {grupos.map((g) => <option value={'#' + g.id}>{g.label}</option>)}
            </select>
            <span class="barra-links">
                {grupos.map((g) => <a href={'#' + g.id}>{g.label}</a>)}
            </span>
        </nav>

        <div id="planes" class="bloque"><Planes {...planes} /></div>
        <div id="juegos" class="bloque"><Juegos {...juegos} /></div>
        <div id="espacios" class="bloque"><Espacios {...espacios} /></div>
        <div id="formatos" class="bloque"><Formatos {...formatos} /></div>
        <div id="promociones" class="bloque"><PreciosPersona {...promos} /></div>
        <div id="sedes" class="bloque"><Sedes {...sedes} /></div>
        <div id="tarifas" class="bloque"><Tarifas {...tarifas} /></div>
        <div id="articulos" class="bloque"><Articulos {...articulos} /></div>
        <div id="experiencias" class="bloque"><Experiencias {...experiencias} /></div>
        <div id="pilares" class="bloque"><Pilares {...pilares} /></div>
        <div id="pasos-experiencia" class="bloque"><PasosExperiencia {...pasosExperiencia} /></div>
        <div id="niveles-juego" class="bloque"><NivelesJuego {...nivelesJuego} /></div>
        <div id="pasos-promo" class="bloque"><PasosPromo {...pasosPromo} /></div>
        <div id="ocasiones" class="bloque"><Ocasiones {...ocasiones} /></div>
        <div id="pasos-cumpleanos" class="bloque"><PasosCumpleanos {...pasosCumpleanos} /></div>
        <div id="pasos-evento" class="bloque"><PasosEvento {...pasosEvento} /></div>
        <div id="info-visita" class="bloque"><InfoVisita {...infoVisita} /></div>
        <div id="tecnologia" class="bloque"><Tecnologia {...tecnologia} /></div>
    </div>

    <script is:inline>
        const sel = document.getElementById("saltar");
        if (sel) {
            sel.addEventListener("change", () => {
                document.querySelector(sel.value)?.scrollIntoView({ behavior: "smooth", block: "start" });
            });
        }
    </script>
</body>
</html>

<style>
    .catalogo-toca {
        background: var(--surface-brand-primary);
    }

    .barra {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.75rem;
        padding: 0.6rem 1rem;
        background: var(--neutral-text-inverted);
        color: var(--surface-brand-primary);
        font-size: 0.85rem;
    }

    .barra-titulo {
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .barra-select {
        padding: 0.25rem 0.5rem;
        border: 1px solid var(--surface-brand-primary);
        background: var(--neutral-text-inverted);
        color: var(--surface-brand-primary);
        font-size: 0.8rem;
    }

    .barra-links {
        display: none;
    }

    @media (min-width: 900px) {
        .barra-links {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            margin-left: auto;
        }

        .barra-links a {
            color: var(--surface-brand-primary);
            text-decoration: underline;
        }
    }

    .bloque {
        scroll-margin-top: 60px;
    }
</style>
