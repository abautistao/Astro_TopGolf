---
import Layout from "../../layouts/Layout.astro"; // Importamos el Layout principal
import { getAllBlogs, getBlogBySlug } from "../../lib/strapi.js";
import RenderBlocks from "../../components/RenderBlocks.astro";
import Blu_404 from "../../components/errors/Blu_404.astro";
import Toca_404 from "../../components/errors/Toca_404.astro";
import Component_404 from "../../components/errors/Component_404.astro";
import Generic_404 from "../../components/errors/Generic_404.astro";

// ==========================================================================================
// SECCIÓN 3: GENERACIÓN DE RUTAS (getStaticPaths)
// ==========================================================================================
export async function getStaticPaths() {
  const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
  const fallbackLocale = "es";

  // Fetch both locales in parallel. When defaultLocale=en but content lives in es,
  // the default-only fetch returns nothing and every blog 404s. Dedupe by slug,
  // preferring defaultLocale so URLs resolve to the canonical version when both exist.
  const [defaultBlogs, esBlogs] = await Promise.all([
    getAllBlogs(defaultLocale),
    getAllBlogs(fallbackLocale),
  ]);

  const seenSlugs = new Set<string>();
  const routes: any[] = [];

  for (const blog of [...(defaultBlogs || []), ...(esBlogs || [])]) {
    if (!blog) continue;
    if (!blog.slug) {
      console.warn(`[getStaticPaths] Saltando blog sin slug: id=${blog.id} titulo="${blog.titulo}" locale=${blog.locale}`);
      continue;
    }
    if (seenSlugs.has(blog.slug)) continue; // defaultLocale wins on duplicate slugs
    seenSlugs.add(blog.slug);
    routes.push({ params: { slug: blog.slug } });
  }

  return routes;
}

// ==========================================================================================
// SECCIÓN 4: OBTENCIÓN DE DATOS PARA CADA PÁGINA
// ==========================================================================================
const { slug } = Astro.params;
const theme = import.meta.env.PUBLIC_THEME || "toca";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

let notFound = false;
let pagina = null;

if (!notFound) {
  pagina = await getBlogBySlug(slug, defaultLocale);
  if (!pagina) {
    // Fallback when defaultLocale has no localization for this slug (e.g. default=en,
    // content lives in es): try es before declaring 404.
    pagina = await getBlogBySlug(slug, 'es');
  }
  if (!pagina) notFound = true;
}

if (notFound) {
  Astro.response.status = 404;
}

const { titulo, ContenidoPagina, SEO, localizations } = pagina || {};

const alternateLinks: any = {};
const defaultLocaleStr = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const locs = Array.isArray(localizations) ? localizations : (localizations?.data || []);
locs.forEach((loc: any) => {
  const attributes = loc.attributes || loc;
  const localeCode = attributes.locale;
  const locSlug = attributes.slug;

  if (localeCode && locSlug) {
    alternateLinks[localeCode] = localeCode === defaultLocaleStr ? `/blog/${locSlug}` : `/${localeCode}/blog/${locSlug}`;
  }
});

console.log(
  `[Blog] Loaded '${slug}' (Lang: ${defaultLocale}). Alternate Links:`,
  alternateLinks,
);
---

<Layout
  seo={SEO}
  alternateLinks={alternateLinks}
  lang={defaultLocale}
  title={notFound ? "Page Not Found" : titulo}
>
  {
    notFound ? (
      theme === "blu" ? (
        <Blu_404 lang={defaultLocale} />
      ) : theme === "toca" ? (
        <Toca_404 lang={defaultLocale} />
      ) : theme === "topgolf" ? (
        <Component_404 />
      ) : (
        <Generic_404 lang={defaultLocale} />
      )
    ) : (
      <main class="mx-auto container-full">
        <RenderBlocks blocks={ContenidoPagina} />
      </main>
    )
  }
</Layout>
