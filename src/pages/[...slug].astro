---
// src/pages/[...slug].astro
// This file handles dynamic routes at the ROOT level (e.g. /about, /contact)
// specifically for Single-Language mode where we don't want /es/ or /en/ prefixes.

import Layout from "../layouts/Layout.astro";
import { getAllPages, getPageBySlug } from "../lib/strapi.js";
import RenderBlocks from "../components/RenderBlocks.astro";

// 1. Get configuration
const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

// 2. Static Paths (for SSG)
export async function getStaticPaths() {
    // Generate these paths ALWAYS for the default locale, 
    // because even in multi-language mode, the default locale should be at the root.
    const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
    const pages = await getAllPages(defaultLocale);

    if (!pages) return [];

    return pages.map((page) => ({
        params: { slug: page.slug }
    }));
}

// 3. Runtime Logic
const { slug } = Astro.params;

// Fetch fully populated page from Strapi
const page = await getPageBySlug(slug, defaultLocale);

if (!page) {
    return new Response(null, {
        status: 404,
        statusText: "Prop not found",
    });
}

const { titulo, ContenidoPagina, SEO } = page;
---

<Layout seo={SEO}>
    <main class="mx-auto container-full">
        <RenderBlocks blocks={ContenidoPagina} />
    </main>
</Layout>
