---
// ==========================================================================================
// SECCIÓN 1: IMPORTACIÓN DE COMPONENTES
// ==========================================================================================
import BloqueDeTexto from '../components/BloqueDeTexto.astro';
import Component_1 from '../components/Component_1.astro';
import Component_2 from '../components/Component_2.astro'; // <- IMPORTAMOS COMPONENTE 2
import Component_3 from '../components/Component_3.astro';
import Component_4 from '../components/Component_4.astro';
import Component_5 from '../components/Component_5.astro';
import Component_6 from '../components/Component_6.astro';
import Component_7 from '../components/Component_7.astro';
import Component_8 from '../components/Component_8.astro';
import Component_9 from '../components/Component_9.astro';
import Component_10 from '../components/Component_10.astro';
import Component_11 from '../components/Component_11.astro';
import Component_12 from '../components/Component_12.astro';
import Component_13 from '../components/Component_13.astro';
import Component_14 from '../components/Component_14.astro';
import Layout from '../layouts/Layout.astro'; // Importamos el Layout principal
import { getAllPages, getPageBySlug } from '../lib/strapi.js';

// ==========================================================================================
// SECCIÓN 2: MAPA DE COMPONENTES
// ==========================================================================================
const componentsMap = {
  'secciones.bloque-de-texto': BloqueDeTexto,
  'secciones.hero-principal': Component_1,
  'secciones.carrusel': Component_2, 
  'secciones.componente-3': Component_3,
  'secciones.componente-4': Component_4, 
  'secciones.componente-5': Component_5, 
  'secciones.componente-6': Component_6, 
  'secciones.componente-7': Component_7, 
  'secciones.componente-8': Component_8, 
  'secciones.componente-9': Component_9, 
  'secciones.componente-10': Component_10,
  'secciones.componente-11': Component_11,
  'secciones.componente-12': Component_12,
  'secciones.componente-13': Component_13,
  'secciones.componente-14': Component_14,
  
};

// ==========================================================================================
// SECCIÓN 3: GENERACIÓN DE RUTAS (getStaticPaths)
// ==========================================================================================
export async function getStaticPaths() {
  const pages = await getAllPages();
  console.log("Datos recibidos para getStaticPaths:", pages);
  if (!pages) {
    return [];
  }
  return pages.map((page) => ({
    params: { slug: page.slug },
  }));
}

// ==========================================================================================
// SECCIÓN 4: OBTENCIÓN DE DATOS PARA CADA PÁGINA
// ==========================================================================================
const { slug } = Astro.params;
const pagina = await getPageBySlug(slug);

// Si la página no se encuentra, mostramos un error 404.
if (!pagina) {
  return new Response(null, {
    status: 404,
    statusText: 'No Encontrado'
  });
}

const { titulo, ContenidoPagina } = pagina;
---

<Layout>
  <main class="mx-auto container-full">

    {ContenidoPagina && ContenidoPagina.map(bloque => {
      const Componente = componentsMap[bloque.__component];
      return Componente ? <Componente {...bloque} /> : <p>Componente no encontrado: {bloque.__component}</p>;
    })}
  </main>
</Layout>