---
import Layout from "../../../layouts/Layout.astro"; // Importamos el Layout principal
import { getAllBlogs, getBlogBySlug } from "../../../lib/strapi.js";
import RenderBlocks from "../../../components/RenderBlocks.astro";
import Blu_404 from "../../../components/errors/Blu_404.astro";
import Toca_404 from "../../../components/errors/Toca_404.astro";
import Component_404 from "../../../components/errors/Component_404.astro";
import Generic_404 from "../../../components/errors/Generic_404.astro";

// export const prerender = true;

// ==========================================================================================
// SECCIÓN 3: GENERACIÓN DE RUTAS (getStaticPaths)
// ==========================================================================================
export async function getStaticPaths() {
  const pages = await getAllBlogs();
  console.log("Datos recibidos para getStaticPaths:", pages);
  if (!pages) {
    return [];
  }
  return pages.map((page) => ({
    params: { slug: page.slug },
  }));
}

// ==========================================================================================
// SECCIÓN 4: OBTENCIÓN DE DATOS PARA CADA PÁGINA
// ==========================================================================================
const { slug, lang } = Astro.params;
const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const theme = import.meta.env.PUBLIC_THEME || "toca";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

let notFound = false;
let pagina = null;

if (!isMultiLanguage) {
  notFound = true;
}

if (!notFound) {
  pagina = await getBlogBySlug(slug, lang);
  if (!pagina) notFound = true;
}

if (notFound) {
  Astro.response.status = 404;
}

const { titulo, ContenidoPagina, SEO, localizations } = pagina || {};

const alternateLinks = {};
if (pagina && localizations && localizations.data) {
  localizations.data.forEach((loc) => {
    const attributes = loc.attributes || loc;
    const localeCode = attributes.locale;
    const locSlug = attributes.slug;

    if (localeCode && locSlug) {
      alternateLinks[localeCode] = `/${localeCode}/blog/${locSlug}`;
    }
  });
}

console.log(
  `[Blog] Loaded '${slug}' (Lang: ${lang}). Alternate Links:`,
  alternateLinks,
);
---

<Layout
  seo={SEO}
  alternateLinks={alternateLinks}
  lang={lang || defaultLocale}
  title={notFound ? "Page Not Found" : titulo}
>
  {
    notFound ? (
      theme === "blu" ? (
        <Blu_404 lang={lang} />
      ) : theme === "toca" ? (
        <Toca_404 lang={lang} />
      ) : theme === "topgolf" ? (
        <Component_404 />
      ) : (
        <Generic_404 lang={lang} />
      )
    ) : (
      <main class="mx-auto container-full">
        <RenderBlocks blocks={ContenidoPagina} />
      </main>
    )
  }
</Layout>
