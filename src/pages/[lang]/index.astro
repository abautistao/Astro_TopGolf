---
// =========================================================================================
// SECCIÓN 1: IMPORTACIÓN DE COMPONENTES
// ==========================================================================================
import Layout from "../../layouts/Layout.astro"; // Importamos el Layout principal
import { getPageBySlug } from "../../lib/strapi.js";
import RenderBlocks from "../../components/RenderBlocks.astro";
import { getAllPages } from "../../lib/strapi.js";
// export const prerender = true; // Disabled for dynamic [lang] SSR

// ==========================================================================================
// SECCIÓN 3: OBTENCIÓN DE DATOS PARA LA PÁGINA DE INICIO
// ==========================================================================================
const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

const { lang } = Astro.params;
export async function getStaticPaths(page) {
  const pages = await getAllPages();

  if (!pages) {
    return [];
  }
  return [
    {
      params: { lang: page.locale ?? "en", slug: page.slug },
    },
  ];
}

let pagina;

if (isMultiLanguage) {
  // Multi-language: /es/ -> Home page in Spanish
  pagina = await getPageBySlug("home", lang);
} else {
  // Single-language: /about -> Page 'about' in Default Locale
  // Here 'lang' param captures the first segment which is the slug
  pagina = await getPageBySlug(lang, defaultLocale);
}

// Si la página no se encuentra, mostramos un error 404.
if (!pagina) {
  return new Response(
    'Contenido de la página principal no encontrado en Strapi. Asegúrate de que el slug "home" existe y que la API tiene permisos para acceder.',
    {
      status: 404,
      statusText: "No Encontrado",
    },
  );
}

const { titulo, ContenidoPagina, SEO } = pagina;
---

<Layout seo={SEO}>
  <main class="mx-auto container-full">
    <RenderBlocks blocks={ContenidoPagina} />
  </main>
</Layout>
