---
// ==========================================================================================
// SECCIÓN 1: IMPORTACIÓN DE COMPONENTES
// ==========================================================================================
import Layout from "../../layouts/Layout.astro"; // Importamos el Layout principal
import { getAllPages, getPageBySlug, getBlogBySlug } from "../../lib/strapi.js";
import RenderBlocks from "../../components/RenderBlocks.astro";
import Blu_404 from "../../components/errors/Blu_404.astro";
import Toca_404 from "../../components/errors/Toca_404.astro";
import Component_404 from "../../components/errors/Component_404.astro";
import Generic_404 from "../../components/errors/Generic_404.astro";

// export const prerender = true;

// ==========================================================================================
// SECCIÓN 3: GENERACIÓN DE RUTAS (getStaticPaths)
// ==========================================================================================
export async function getStaticPaths() {
  const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
  const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

  if (!isMultiLanguage) {
    return [];
  }

  const locales = ["es", "en"];
  const nonDefaultLocales = locales.filter(l => l !== defaultLocale);
  let allPaths = [];

  for (const lang of nonDefaultLocales) {
    const pages = await getAllPages(lang);
    if (pages && Array.isArray(pages)) {
      pages.forEach((page: any) => {
        if (!page || !page.slug) {
          if (page && !page.slug) console.warn(`[getStaticPaths] Saltando página [${lang}] sin slug: id=${page.id} titulo="${page.titulo}"`);
          return;
        }
        allPaths.push({
          params: { lang, slug: page.slug },
        });
      });
    }
  }

  return allPaths;
}

// ==========================================================================================
// SECCIÓN 4: OBTENCIÓN DE DATOS PARA CADA PÁGINA
// ==========================================================================================
const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const theme = import.meta.env.PUBLIC_THEME || "toca";

const { slug, lang } = Astro.params;

let pagina;

if (isMultiLanguage) {
  // Multi-language: /es/about -> Page 'about' in 'es'
  if (lang === defaultLocale) {
      Astro.response.status = 404;
  } else {
      pagina = await getPageBySlug(slug || "home", lang);
  }
}

const notFound = !pagina;
if (notFound) {
  Astro.response.status = 404;
  Astro.response.statusText = "Not Found";
}

const { titulo, ContenidoPagina, SEO, localizations } = pagina || {};

const alternateLinks: any = {};
const defaultLocaleStr = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const locs = Array.isArray(localizations) ? localizations : (localizations?.data || []);
locs.forEach((loc: any) => {
  const attributes = loc.attributes || loc;
  const localeCode = attributes.locale;
  const locSlug = attributes.slug;

  if (localeCode && locSlug) {
    alternateLinks[localeCode] = localeCode === defaultLocaleStr ? `/${locSlug}` : `/${localeCode}/${locSlug}`;
  }
});
---

<Layout
  seo={SEO}
  alternateLinks={alternateLinks}
  lang={lang || defaultLocale}
  title={notFound ? "Page Not Found" : titulo}
>
  {
    notFound ? (
      theme === "blu" ? (
        <Blu_404 lang={lang} />
      ) : theme === "toca" ? (
        <Toca_404 lang={lang} />
      ) : theme === "topgolf" ? (
        <Component_404 />
      ) : (
        <Generic_404 lang={lang} />
      )
    ) : (
      <main class="mx-auto container-full">
        <RenderBlocks blocks={ContenidoPagina} />
      </main>
    )
  }
</Layout>
