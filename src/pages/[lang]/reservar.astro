---
import Layout from "../../layouts/Layout.astro";
import Booking from "../../components/topgolf/Booking.astro";
import { getAllPages } from "../../lib/strapi.js";
export async function getStaticPaths(page) {
  
  const pages = await getAllPages();

  if (!pages) {
    return [];
  }
  return [{
    params: { lang: page.locale ?? 'en', slug: page.slug },
  }];
}
---

<Layout>
  <main class="py-12">
    <!-- 
      El componente Booking ahora se encargará de leer los parámetros 
      de la URL en el lado del cliente.
    -->
    <Booking />
  </main>
</Layout>
