---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import { getPageBySlug } from "../lib/strapi.js";
import RenderBlocks from "../components/RenderBlocks.astro";

// Environment Configuration
const isMultiLanguage = import.meta.env.PUBLIC_MULTILANGUAGE !== "false";
const defaultLocale = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";

// LOGIC 1: Rendering Home Page directly at root (/)
// Fetch home page content for the default locale
// Fetch home page content
const pagina = await getPageBySlug("home", defaultLocale);

if (!pagina) {
    return new Response(
        'Contenido de la página principal no encontrado en Strapi. Asegúrate de que el slug "home" existe y que la API tiene permisos para acceder.',
        { status: 404, statusText: "No Encontrado" },
    );
}

const { titulo, ContenidoPagina, SEO, localizations } = pagina || {};

const alternateLinks: any = {};
const defaultLocaleStr = import.meta.env.PUBLIC_DEFAULT_LOCALE || "en";
const locs = Array.isArray(localizations) ? localizations : (localizations?.data || []);
locs.forEach((loc: any) => {
  const attributes = loc.attributes || loc;
  const localeCode = attributes.locale;
  // For the homepage, we route to root / or /es
  
  if (localeCode) {
    alternateLinks[localeCode] = localeCode === defaultLocaleStr ? `/` : `/${localeCode}`;
  }
});
---

<Layout seo={SEO} alternateLinks={alternateLinks}>
    <main class="mx-auto container-full">
        <RenderBlocks blocks={ContenidoPagina} />
    </main>
</Layout>
