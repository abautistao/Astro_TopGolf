---

<Layout title="Librería de Componentes">
  <main class="container p-4 mx-auto my-12 md:p-8">
    <h1 class="mb-8 text-4xl font-bold text-center">Librería de Componentes</h1>
    <div class="grid grid-cols-1 gap-12">
      {
        components.map(({ name, Comp, props }) => (
          <section class="p-4 border rounded-lg shadow-lg md:p-8">
            <h2 class="mb-6 text-2xl font-semibold text-center">{name}</h2>
            <div class="component-wrapper">
              <Comp {...props} />
            </div>
          </section>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .component-wrapper {
    border: 2px dashed #e2e8f0;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background-color: #fdfdff;
    overflow: hidden;
  }
</style>
