const IMG = (label: string, w = 800, h = 600) =>
    `https://placehold.co/${w}x${h}/0080BB/FFFFFF?text=${encodeURIComponent(label)}`;

const media = (label: string, w = 800, h = 600) => ({
    url: IMG(label, w, h),
    alternativeText: label,
});

const boton = (texto: string, url = "#") => ({ texto, url });

const slug = (name: string) =>
    name
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "") // quita acentos: "Galería" -> "galeria"
        .replace(/[—–]/g, "-")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/^-|-$/g, "");

