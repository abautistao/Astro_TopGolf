<Layout title="Librería de Componentes — Sealand" siteChrome={false}>
  <main class="w-full p-4 mx-auto my-12 md:p-8">
    <h1 class="mb-2 text-3xl font-bold text-center">Librería de Componentes — Sealand</h1>
    <p class="mb-2 text-center text-gray-500">Catálogo visual para identificar cada componente del theme <code class="px-1 bg-gray-100 rounded">sealand</code>.</p>
    <p class="mb-2 text-xs text-center text-amber-600">⚠ Datos dummy. La BD de Strapi está vacía; este render no representa contenido real.</p>
    <p class="mb-10 text-xs text-center text-gray-500">ℹ Dentro de las previews los elementos <code>sticky</code> y <code>fixed</code> se muestran estáticos, para que nada flote sobre el catálogo.</p>

    <!-- Barra fija compacta: sólo el selector de salto. El índice completo vive
         abajo, en un desplegable que NO es sticky, para que no tape el catálogo. -->
    <nav class="sticky top-0 z-50 mb-8 bg-white border-b shadow-sm">
      <div class="flex flex-wrap items-center gap-3 px-4 py-2">
        <span class="text-sm font-semibold">Catálogo Sealand</span>
        <select id="catalogo-salto" class="flex-1 min-w-[220px] px-2 py-1 text-sm border rounded">
          <option value="">Saltar a un componente…</option>
          {componentsBlock.map(({ name }) => (
            <option value={slug(name)}>{name}</option>
          ))}
        </select>
        <a href="#indice" class="text-sm text-blue-700 underline">Índice completo</a>
      </div>
    </nav>

    <details id="indice" class="mb-12 border rounded-lg shadow-sm">
      <summary class="px-4 py-3 font-semibold cursor-pointer">
        Índice completo ({componentsBlock.length} bloques)
      </summary>
      <div class="max-h-[40vh] overflow-y-auto px-4 pb-4">
        <div class="flex flex-wrap gap-2 text-sm">
          {componentsBlock.map(({ name }) => (
            <a href={`#${slug(name)}`} class="px-2 py-1 text-blue-700 underline rounded hover:bg-blue-50">
              {name}
            </a>
          ))}
        </div>
      </div>
    </details>

    <div class="grid grid-cols-1 gap-12">
      {componentsBlock.map(({ name, Comp, props }) => (
        <section id={slug(name)} class="scroll-mt-24 p-4 border rounded-lg shadow-lg md:p-8">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-2xl font-semibold">{name}</h2>
            <span class="px-2 py-1 text-xs text-gray-500 bg-gray-100 rounded">
              frontend/src/components/sealand/{name.startsWith("Component_") ? name.split(" ")[0] + "_Sealand" : name === "HeaderSimple" ? "HeaderSimpleSealand" : name === "Booking" ? "Booking_Sealand" : name}.astro
            </span>
          </div>
          <div class="component-wrapper">
            <Comp {...props} />
          </div>
        </section>
      ))}
    </div>
  </main>
</Layout>

<style>
  .component-wrapper {
    border: 2px dashed #e2e8f0;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background-color: #fdfdff;
    overflow: hidden;
  }

  /* Aislamiento de la preview: si un componente trae una barra fija o pegajosa
     (el ToC del blog, el botón flotante del footer), dentro del catálogo se
     queda en su sitio; si no, flotaría sobre las demás previews.
     `:global()` es obligatorio: sin él el ámbito de Astro NO alcanza los
     elementos de los componentes hijos. */
  .component-wrapper :global([class*="sticky"]),
  .component-wrapper :global([class*="fixed"]) {
    position: static !important;
  }
</style>

<script>
  const select = document.getElementById("catalogo-salto") as HTMLSelectElement | null;

  select?.addEventListener("change", () => {
    if (!select.value) return;
    document.getElementById(select.value)?.scrollIntoView({ behavior: "smooth", block: "start" });
  });
</script>
